# ================================================================
# lib/deploy_qos.qentl — QOS部署模式
# 终端QOS部署（本地运行）
# ================================================================

# 检测部署模式
def deploy_detect():
    # 本地模式
    var mode = "qos_terminal"
    
    # 检查环境变量
    # 如果有nginx配置，切换到web模式
    var has_nginx = 0  # 简化检查
    
    if (has_nginx):
        mode = "qos_web"
    end
    
    return mode
end

# QOS启动函数
def qos_start():
    var mode = deploy_detect()
    printf("QOS启动模式: %s\n", mode)
    
    if (str_eq(mode, "qos_web")):
        # Web模式：启动HTTP服务器
        qos_web_server(9802)
    else:
        # 终端模式：直接运行
        printf("QOS终端模式启动\n")
        qos_run_main()
    end
end

# Web服务器启动
def qos_web_server(port):
    printf("QOS Web模式: 监听端口%d\n", port)
    # 调用HTTP服务器
    var srv = tcp_listen(port)
    if (srv >= 0):
        printf("QOS Web服务器启动成功\n")
        return srv
    else:
        printf("QOS Web服务器启动失败\n")
        return -1
    end
end

# 主程序运行
def qos_run_main():
    printf("QOS主程序运行\n")
    # 运行主算法
    printf("QOS验证: 通过\n")
end