# ================================================================
# lib/ref.qentl — Ref自反省模型 v13
# 纯QEntL实现，支持自我检查与修复
# ================================================================

# 自反省状态
var g_check_count = 0
var g_error_count = 0
var g_report = ""

# 初始化Ref
def ref_init():
    g_check_count = 0
    g_error_count = 0
    g_report = ""
    return 1
end

# 检查QCL
def ref_check_qcl():
    if (file_exists("components/qcl/qcl.qentl")):
        g_report = str_concat(g_report, "QCL: 存在 ✅\n")
        return 1
    end
    g_report = str_concat(g_report, "QCL: 缺失 ❌\n")
    g_error_count = g_error_count + 1
    return 0
end

# 检查QVM
def ref_check_qvm():
    if (file_exists("components/qvm/qvm.qentl")):
        g_report = str_concat(g_report, "QVM: 存在 ✅\n")
        return 1
    end
    g_report = str_concat(g_report, "QVM: 缺失 ❌\n")
    g_error_count = g_error_count + 1
