# ================================================================
# examples/ref_self_enhanced.qentl — Ref自反省模型增强版
# 量子自反省与学习
# ================================================================
qreg q[4]

# 自我状态
h q[0]
h q[1]
h q[2]
h q[3]

# 反思回路
cx q[0], q[1]
cx q[1], q[2]
cx q[2], q[3]

# 输入
x q[0]
x q[3]

# 测量
var r0 = measure q[0]
var r1 = measure q[1]
var r2 = measure q[2]
var r3 = measure q[3]

printf("Ref自反省状态: %d%d%d%d\n", r3, r2, r1, r0)

# 自省逻辑
var reflect = 0
if (r0 == r3):
    reflect = 1
else:
    reflect = 0
end

printf("自反省结果: %d\n", reflect)

if (reflect >= 0 and reflect <= 1):
    printf("Ref自反省模型验证: 通过\n")
else:
    printf("Ref自反省模型验证: 失败\n")
end