    if (file_exists("components/qvm/qvm.qentl")):
        g_report = str_concat(g_report, "QVM: 存在 ✅\n")
        return 1
    end
    g_report = str_concat(g_report, "QVM: 缺失 ❌\n")
    g_error_count = g_error_count + 1
    return 0
end

