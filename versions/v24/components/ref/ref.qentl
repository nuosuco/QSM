# ================================================================
# lib/ref.qentl — Ref自反省模型 v13
# 纯QEntL实现，支持自我检查与修复
# ================================================================

# 自反省状态
var g_check_count = 0
var g_error_count = 0
var g_report = ""

# 初始化Ref
def ref_init():
    g_check_count = 0
    g_error_count = 0
    g_report = ""
    return 1
end

# 检查QCL
def ref_check_qcl():
    if (file_exists("components/qcl/qcl.qentl")):
        g_report = str_concat(g_report, "QCL: 存在 ✅\n")
        return 1
    end
    g_report = str_concat(g_report, "QCL: 缺失 ❌\n")
    g_error_count = g_error_count + 1
    return 0
end

# 检查QVM
def ref_check_qvm():
    if (file_exists("components/qvm/qvm.qentl")):
        g_report = str_concat(g_report, "QVM: 存在 ✅\n")
        return 1
    end
    g_report = str_concat(g_report, "QVM: 缺失 ❌\n")
    g_error_count = g_error_count + 1
    return 0
end

# 检查QDFS
def ref_check_qdfs():
    if (file_exists("components/qdfs/qdfs.qentl")):
        g_report = str_concat(g_report, "QDFS: 存在 ✅\n")
        return 1
    end
    g_report = str_concat(g_report, "QDFS: 缺失 ❌\n")
    g_error_count = g_error_count + 1
    return 0
end

# 检查QNS
def ref_check_qns():
    if (file_exists("components/qns/qns.qentl")):
        g_report = str_concat(g_report, "QNS: 存在 ✅\n")
        return 1
    end
    g_report = str_concat(g_report, "QNS: 缺失 ❌\n")
    g_error_count = g_error_count + 1
    return 0
end

# 检查SOM
def ref_check_som():
    if (file_exists("components/som/som.qentl")):
        g_report = str_concat(g_report, "SOM: 存在 ✅\n")
        return 1
    end
    g_report = str_concat(g_report, "SOM: 缺失 ❌\n")
    g_error_count = g_error_count + 1
    return 0
end

# 检查WeQ
def ref_check_weq():
    if (file_exists("components/weq/weq.qentl")):
        g_report = str_concat(g_report, "WeQ: 存在 ✅\n")
        return 1
    end
    g_report = str_concat(g_report, "WeQ: 缺失 ❌\n")
    g_error_count = g_error_count + 1
    return 0
end

# 检查QSM
def ref_check_qsm():
    if (file_exists("components/qsm/qsm.qentl")):
        g_report = str_concat(g_report, "QSM: 存在 ✅\n")
        return 1
    end
    g_report = str_concat(g_report, "QSM: 缺失 ❌\n")
    g_error_count = g_error_count + 1
    return 0
end

# 全部检查
def ref_check_all():
    g_check_count = 0
    g_error_count = 0
    g_report = "Ref自反省报告 v13\n\n"
    if (ref_check_qcl() == 1): g_check_count = g_check_count + 1 end
    if (ref_check_qvm() == 1): g_check_count = g_check_count + 1 end
    if (ref_check_qdfs() == 1): g_check_count = g_check_count + 1 end
    if (ref_check_qns() == 1): g_check_count = g_check_count + 1 end
    if (ref_check_som() == 1): g_check_count = g_check_count + 1 end
    if (ref_check_weq() == 1): g_check_count = g_check_count + 1 end
    if (ref_check_qsm() == 1): g_check_count = g_check_count + 1 end
    g_report = str_concat(g_report, "\n")
    g_report = str_concat(g_report, "通过: ")
    g_report = str_concat(g_report, int_to_str(g_check_count))
    g_report = str_concat(g_report, "/7\n")
    g_report = str_concat(g_report, "错误: ")
    g_report = str_concat(g_report, int_to_str(g_error_count))
    g_report = str_concat(g_report, "\n")
    return g_report
end

# 生成报告
def ref_report():
    printf("%s\n", ref_check_all())
    return g_check_count
end

# 主入口
def ref_main():
    ref_init()
    return ref_report()
end
