# ================================================================
# examples/shor.qentl — Shor算法核心: 量子周期查找
#
# Shor的量子核心: 用相位估计提取酉算子 U|x>=|a·x mod N> 的周期
# 本例: U = +1 mod 4 (4阶酉算子, U^4 = I), 对应 Shor 中 r=4 的情形
#   电路: cx w0,w1; x w0  (二进制计数器 +1 mod 4)
#   U|0>=|1>, U|1>=|2>, U|2>=|3>, U|3>=|0>
#
# 特征态 |ψ₂> = (|0>-|1>+|2>-|3>)/2, 特征值 -1 = e^(2πi·1/2)
# 相位估计 → φ = 1/2 = 2/4 → 分母 r = 4 = 周期
#
# 真实Shor需模幂运算电路(更大N), 量子核心逻辑与此完全一致
# ================================================================

qreg q[4]
# q[0]=c0 计数MSB(权重2), q[1]=c1 计数LSB(权重1)
# q[2]=w0 工作LSB, q[3]=w1 工作MSB

# ---- 1. 准备U的特征态 |ψ₂> = (|0>-|1>+|2>-|3>)/2 ----
h q[2]
h q[3]
z q[2]

# ---- 2. 计数寄存器叠加 ----
h q[0]
h q[1]

# ---- 3. 受控 U^j (j = 2·c0 + c1) ----
# c1控制 U^1: U = cx(w0,w1); x(w0)
ccx q[1], q[2], q[3]
cx q[1], q[2]
# c0控制 U^2: U² = x(w1)
cx q[0], q[3]

# ---- 4. 计数寄存器逆QFT (2量子位) ----
cx q[0], q[1]
cx q[1], q[0]
cx q[0], q[1]
h q[1]
icphase q[0], q[1], 1
h q[0]

# ---- 5. 测量: 期望 m = φ·4 = 2, 即 m0=1 m1=0 ----
var m0 = measure q[0]
var m1 = measure q[1]
printf("Shor周期查找: m=%d (二进制%d%d)\n", m0 * 2 + m1, m0, m1)
if (m0 == 1 and m1 == 0):
    printf("相位φ=1/2, 连分数恢复周期 r=4: 通过\n")
else:
    printf("周期查找: 失败\n")
end
