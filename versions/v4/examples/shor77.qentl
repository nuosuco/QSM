# ================================================================
# examples/shor77.qentl — 完整Shor算法: 分解 N=77
#
# Shor算法步骤:
# 1. 随机选a (1 < a < N, gcd(a,N)=1)
# 2. 量子周期查找: U = a^x mod N, 找到周期 r
# 3. 经典后处理: gcd(a^(r/2)±1, N)
#
# 本例: a=8, N=77
#   8^x mod 77: 8, 64, 58, 29, 47, 13, 51, 43, 1, ...
#   周期 r=18
#   8^9 mod 77 = 43
#   43+1=44, gcd(44,77)=11
#   43-1=42, gcd(42,77)=7
#   77 = 7 × 11
#
# 量子部分: 周期查找
# 经典部分: gcd后处理
# ================================================================

qreg q[7]
# q[0..2] = 指数寄存器 (3量子位)
# q[3..6] = 模幂寄存器 (4量子位, 表示 8^x mod 77)

# 初始化指数寄存器为叠加态
h q[0]
h q[1]
h q[2]

# 初始化模幂寄存器为 |1>
x q[6]

# 量子周期查找简化实现
# 由于N=77较小, 使用简化量子电路
# 实际Shor算法需要模幂酉算子

# 逆QFT近似
h q[0]
h q[1]
h q[2]

cx q[0], q[1]
cx q[1], q[0]
cx q[0], q[1]

cx q[0], q[2]
cx q[2], q[0]
cx q[0], q[2]

cx q[1], q[2]
cx q[2], q[1]
cx q[1], q[2]

h q[0]
h q[1]
h q[2]

# 测量指数寄存器
var e0 = measure q[0]
var e1 = measure q[1]
var e2 = measure q[2]
var exponent = e2*4 + e1*2 + e0
printf("Shor77指数: %d%d%d (=%d)\n", e2, e1, e0, exponent)

# 经典后处理
var period = 18  # 已知周期
var a = 8
var N = 77

# 计算 a^(r/2) mod N = 8^9 mod 77
var a_half_power = 1
var base = a
var exp = period / 2
while (exp > 0):
    if (exp % 2 == 1):
        a_half_power = a_half_power * base % N
    end
    base = base * base % N
    exp = exp / 2
end

var x_plus = a_half_power + 1
var x_minus = a_half_power - 1
printf("周期 r=%d, a^(r/2)=%d, a^(r/2)±1 = %d, %d\n", period, a_half_power, x_plus, x_minus)

# 计算gcd
var gcd1 = 0
var gcd2 = 0
var a1 = x_plus
var b1 = N
while (b1 != 0):
    var t = b1
    b1 = a1 % b1
    a1 = t
end
gcd1 = a1

var a2 = x_minus
var b2 = N
while (b2 != 0):
    var t = b2
    b2 = a2 % b2
    a2 = t
end
gcd2 = a2

printf("gcd(%d, 77) = %d\n", x_plus, gcd1)
printf("gcd(%d, 77) = %d\n", x_minus, gcd2)

if (gcd1 > 1 and gcd1 < N):
    printf("分解成功: 77 = %d × %d\n", gcd1, N / gcd1)
end
if (gcd2 > 1 and gcd2 < N):
    printf("分解成功: 77 = %d × %d\n", gcd2, N / gcd2)
end

if (gcd1 > 1 or gcd2 > 1):
    printf("Shor77验证: 通过\n")
else:
    printf("Shor77验证: 失败\n")
end