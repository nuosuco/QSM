# ================================================================
# 量子纠错码比较 — 性能benchmark
# 对比不同纠错码的纠错能力
# ================================================================

printf("=== 量子纠错码性能比较 ===\n\n")

# 3比特翻转码: 160/160
printf("--- 3比特翻转码 (重复码) ---\n")
printf("编码: |0>→|000>, |1>→|111>\n")
printf("纠错: 单比特X错误\n")

var rep_ok = 0
var rep_total = 0
var b = 0
while (b <= 1):
    var err = -1
    while (err <= 2):
        var r = 0
        while (r < 20):
            rep_total = rep_total + 1
            var q = qreg_create(3)
            if (b == 1): x q[0] end
            cx q[0], q[1]
            cx q[0], q[2]
            if (err == 0): x q[0] end
            if (err == 1): x q[1] end
            if (err == 2): x q[2] end
            var m0 = measure(q, 0)
            var m1 = measure(q, 1)
            var m2 = measure(q, 2)
            var ones = m0 + m1 + m2
            var recovered = 0
            if (ones >= 2): recovered = 1 end
            if (recovered == b): rep_ok = rep_ok + 1 end
            qreg_free(q)
            r = r + 1
        end
        err = err + 1
    end
    b = b + 1
end
printf("  结果: %d/%d (%d%%)\n", rep_ok, rep_total, rep_ok * 100 / rep_total)

# 3比特相位翻转码: 160/160
printf("\n--- 3比特相位翻转码 (X基) ---\n")
printf("编码: |0>→|+++>, |1>→|--->\n")
printf("纠错: 单比特Z错误\n")

var ph_ok = 0
var ph_total = 0
b = 0
while (b <= 1):
    var err = -1
    while (err <= 2):
        var r = 0
        while (r < 20):
            ph_total = ph_total + 1
            var q = qreg_create(3)
            # 编码到X基: |0>→|+++>, |1>→|--->
            if (b == 1):
                x q[0]
                x q[1]
                x q[2]
            end
            h q[0]
            h q[1]
            h q[2]
            # 注入Z错误 (在X基下, Z翻转比特)
            if (err == 0): z q[0] end
            if (err == 1): z q[1] end
            if (err == 2): z q[2] end
            # 解码: H转回Z基
            h q[0]
            h q[1]
            h q[2]
            # 测量Z基, 多数表决
            var m0 = measure(q, 0)
            var m1 = measure(q, 1)
            var m2 = measure(q, 2)
            var ones = m0 + m1 + m2
            var recovered = 0
            if (ones >= 2): recovered = 1 end
            if (recovered == b): ph_ok = ph_ok + 1 end
            qreg_free(q)
            r = r + 1
        end
        err = err + 1
    end
    b = b + 1
end
printf("  结果: %d/%d (%d%%)\n", ph_ok, ph_total, ph_ok * 100 / ph_total)

# 比较
printf("\n=== 性能比较 ===\n")
printf("3比特翻转码: %d%% 纠错率\n", rep_ok * 100 / rep_total)
printf("3比特相位码: %d%% 纠错率\n", ph_ok * 100 / ph_total)
printf("理论: 100%% (单比特可纠)\n")

printf("\n=== QEC性能比较完成 ===\n")