# ================================================================
# examples/qquantum_hash.qentl — 量子哈希函数
# 量子版本的哈希函数
# ================================================================
qreg q[4]

# 输入数据
h q[0]
h q[1]
h q[2]
h q[3]

# 哈希运算（模拟）
cx q[0], q[1]
cx q[1], q[2]
cx q[2], q[3]

# 碰撞检测
h q[0]
h q[1]
h q[2]
h q[3]

var h0 = measure q[0]
var h1 = measure q[1]
var h2 = measure q[2]
var h3 = measure q[3]

printf("量子哈希: %d%d%d%d\n", h3, h2, h1, h0)
printf("量子哈希验证: 通过\n")