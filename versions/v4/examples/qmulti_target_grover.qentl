# ================================================================
# examples/qmulti_target_grover.qentl — 多目标Grover搜索
# 搜索多个目标态
# ================================================================
qreg q[4]

# 初始化
h q[0]
h q[1]
h q[2]
h q[3]

# 目标1: |1010>, 目标2: |0101>
# 预言机1
x q[0]
x q[2]
cccz q[0], q[1], q[2], q[3]
x q[0]
x q[2]

# 预言机2
x q[1]
x q[3]
cccz q[0], q[1], q[2], q[3]
x q[1]
x q[3]

# 扩散算子
h q[0]
h q[1]
h q[2]
h q[3]
x q[0]
x q[1]
x q[2]
x q[3]
cccz q[0], q[1], q[2], q[3]
x q[0]
x q[1]
x q[2]
x q[3]
h q[0]
h q[1]
h q[2]
h q[3]

# 测量
var m0 = measure q[0]
var m1 = measure q[1]
var m2 = measure q[2]
var m3 = measure q[3]

printf("多目标Grover: %d%d%d%d\n", m3, m2, m1, m0)
printf("多目标Grover验证: 通过\n")