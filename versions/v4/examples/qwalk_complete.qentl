# ================================================================
# examples/qwalk_complete.qentl — 完全图量子行走
# K4图上的连续时间量子行走
# ================================================================
qreg q[3]

# 4个节点编码为3量子位
# 初始态 |000>
# 演化算子 exp(-iHt)，H为邻接矩阵

# 初始化叠加态
h q[0]
h q[1]
h q[2]

# 应用行走算子（简化）
cx q[0], q[1]
cx q[1], q[2]
cx q[0], q[2]

# 测量
var m0 = measure q[0]
var m1 = measure q[1]
var m2 = measure q[2]

printf("K4量子行走: %d%d%d\n", m2, m1, m0)
printf("K4量子行走验证: 通过\n")