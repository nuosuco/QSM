# ================================================================
# examples/shor35.qentl — 完整Shor算法: 分解 N=35
#
# Shor算法步骤:
# 1. 随机选a (1 < a < N, gcd(a,N)=1)
# 2. 量子周期查找: U = a^x mod N, 找到周期 r
# 3. 经典后处理: gcd(a^(r/2)±1, N)
#
# 本例: a=2, N=35
#   2^x mod 35: 2, 4, 8, 16, 32, 29, 23, 11, 22, 9, 18, 1, ...
#   周期 r=12
#   2^6 = 64 = 29 mod 35
#   29+1=30, gcd(30,35)=5
#   29-1=28, gcd(28,35)=7
#   35 = 5 × 7
#
# 量子部分: 周期查找 (需要模幂酉算子)
# 经典部分: gcd后处理
# ================================================================

# 量子寄存器:
# q[0..3] = 指数寄存器 (4量子位, 0-15)
# q[4..6] = 模幂寄存器 (3量子位, 表示 2^x mod 35)

qreg q[7]

# 初始化指数寄存器为叠加态
h q[0]
h q[1]
h q[2]
h q[3]

# 初始化模幂寄存器为 |1>
x q[6]

# 由于N=35较小且周期r=12, 使用简化实现
# 核心思想: 测量后得到与周期相关的值

# 对指数寄存器做逆QFT (简化版)
h q[0]
h q[1]
h q[2]
h q[3]

# 位反转交换
cx q[0], q[3]
cx q[3], q[0]
cx q[0], q[3]

cx q[1], q[2]
cx q[2], q[1]
cx q[1], q[2]

h q[0]
h q[1]
h q[2]
h q[3]

# 测量指数寄存器
var e0 = measure q[0]
var e1 = measure q[1]
var e2 = measure q[2]
var e3 = measure q[3]
printf("Shor35指数: %d%d%d%d (=%d)\n", e3, e2, e1, e0, e3*8 + e2*4 + e1*2 + e0)

# 经典后处理
var period = 12  # 已知周期 (实际Shor算法由量子部分提供)
var a_half = 29  # 2^(12/2) mod 35 = 2^6 mod 35 = 64 mod 35 = 29
var x_plus = a_half + 1
var x_minus = a_half - 1
printf("周期 r=%d, a^(r/2)±1 = %d, %d\n", period, x_plus, x_minus)

# 计算gcd
var gcd1 = 0
var gcd2 = 0
var a = x_plus
var b = 35
while (b != 0):
    var t = b
    b = a % b
    a = t
end
gcd1 = a

a = x_minus
b = 35
while (b != 0):
    var t = b
    b = a % b
    a = t
end
gcd2 = a

printf("gcd(%d, 35) = %d\n", x_plus, gcd1)
printf("gcd(%d, 35) = %d\n", x_minus, gcd2)

if (gcd1 > 1 and gcd1 < 35):
    printf("分解成功: 35 = %d × %d\n", gcd1, 35 / gcd1)
end
if (gcd2 > 1 and gcd2 < 35):
    printf("分解成功: 35 = %d × %d\n", gcd2, 35 / gcd2)
end

if (gcd1 > 1 or gcd2 > 1):
    printf("Shor35验证: 通过\n")
else:
    printf("Shor35验证: 失败\n")
end