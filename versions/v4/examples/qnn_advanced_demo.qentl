# ================================================================
# examples/qnn_advanced_demo.qentl — 量子神经网络高级演示
# ================================================================
qreg q[4]

# 初始化叠加态
h q[0]
h q[1]
h q[2]
h q[3]

# 创建纠缠（模拟卷积层）
cx q[0], q[1]
cx q[2], q[3]

# 测量提取特征
var f0 = measure q[0]
var f1 = measure q[1]
var f2 = measure q[2]
var f3 = measure q[3]

printf("QNN高级特征: %d %d %d %d\n", f0, f1, f2, f3)

# 验证纠缠一致性
if (f0 == f1 and f2 == f3):
    printf("量子卷积层验证: 通过\n")
else:
    printf("量子卷积层验证: 失败\n")
end