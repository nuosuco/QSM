# ================================================================
# examples/qnn_demo.qentl — 量子神经网络演示
# 展示QNN基础概念
# ================================================================

# 初始化量子寄存器
qreg q[4]

# 创建叠加态 (模拟神经网络输入层)
h q[0]
h q[1]
h q[2]
h q[3]

# 应用量子逻辑门 (模拟神经网络权重)
# X门表示正权重
x q[0]
# T门表示非线性激活
t q[1]
# CNOT门表示连接权重
cx q[0], q[2]
cx q[1], q[3]

# 测量输出层
var out0 = measure q[0]
var out1 = measure q[1]
var out2 = measure q[2]
var out3 = measure q[3]

printf("QNN输出: %d %d %d %d\n", out0, out1, out2, out3)

# 验证量子并行性
# 叠加态同时表示2^4=16种状态
if (out0 >= 0 and out0 <= 1):
    printf("QNN验证: 通过\n")
else:
    printf("QNN验证: 失败\n")
end