# ================================================================
# 量子Deutsch-Jozsa — 判断函数类型
# 常数 vs 平衡: 量子O(1)查询
# ================================================================

printf("=== Deutsch-Jozsa算法 ===\n\n")
printf("判断f(x)是常数还是平衡\n")
printf("经典: 最坏2^n+1次查询\n")
printf("量子: 只需1次查询\n\n")

# DJ算法: 3比特输入
# 测试两种函数: 常数(全0) 和 平衡(奇偶)

printf("--- 测试: 常数函数 ---\n")
var dj_const_ok = 0
var i = 0
while (i < 10):
    var q = qreg_create(4)
    x q[3]  # 工作比特|1>
    h q[0]
    h q[1]
    h q[2]
    h q[3]
    # 常数函数f=0: 无Oracle操作
    h q[0]
    h q[1]
    h q[2]
    var m0 = measure(q, 0)
    var m1 = measure(q, 1)
    var m2 = measure(q, 2)
    # 常数: 结果全0
    if (m0 == 0 and m1 == 0 and m2 == 0):
        dj_const_ok = dj_const_ok + 1
    end
    qreg_free(q)
    i = i + 1
end
printf("  常数函数识别: %d/10\n", dj_const_ok)

printf("\n--- 测试: 平衡函数 ---\n")
var dj_bal_ok = 0
i = 0
while (i < 10):
    var q = qreg_create(4)
    x q[3]
    h q[0]
    h q[1]
    h q[2]
    h q[3]
    # 平衡函数: f(x)=x0 (奇偶)
    cx q[0], q[3]
    h q[0]
    h q[1]
    h q[2]
    var m0 = measure(q, 0)
    var m1 = measure(q, 1)
    var m2 = measure(q, 2)
    # 平衡: 结果非全0
    if (m0 == 1 or m1 == 1 or m2 == 1):
        dj_bal_ok = dj_bal_ok + 1
    end
    qreg_free(q)
    i = i + 1
end
printf("  平衡函数识别: %d/10\n", dj_bal_ok)

if (dj_const_ok == 10 and dj_bal_ok == 10):
    printf("\nDJ算法: 通过 ✅ (O(1)查询优势)\n")
end

printf("\n=== DJ算法完成 ===\n")