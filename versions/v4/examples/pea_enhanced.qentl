# ================================================================
# 量子相位估计增强版 (PEA)
# 精确估算酉矩阵U的特征相位
# 量子算法之核心: 用于Shor分解/化学模拟
# ================================================================

printf("=== 量子相位估计(PEA)增强 ===\n\n")

printf("--- 原理 ---\n")
printf("估计U|ψ> = e^(2πi·θ)|ψ> 中的相位θ\n")
printf("辅助比特: H门创建叠加\n")
printf("受控U: 相位编码到辅助比特\n")
printf("逆QFT: 读出相位\n\n")

# 简化演示: 用Z门作为U (Z|1> = -|1>, 相位π)
printf("--- 用Z门估相 ---\n")
printf("U = Z, |1>本征态, 相位θ = 0.5 (π/2π)\n\n")

var q = qreg_create(3)
# 制备本征态 |1> 在 q[1]
apply_x(q, 1)
# 辅助比特q[0]上施加H
apply_h(q, 0)
# 受控-U: 控制q[0], 目标q[1], 应用Z
apply_cz(q, 0, 1)
# 测量辅助比特
var m = measure(q, 0)
printf("  辅助比特测量: %d\n", m)
printf("  相位提取: 0.5 (理论值)\n\n")

# 验证多重估值
printf("--- 统计验证 ---\n")
var ones = 0
var trials = 50
var i = 0
while (i < trials):
    var q2 = qreg_create(3)
    apply_x(q2, 1)
    apply_h(q2, 0)
    apply_cz(q2, 0, 1)
    var m2 = measure(q2, 0)
    if (m2 == 1): ones = ones + 1 end
    i = i + 1
end
printf("  测量到1的次数: %d/%d\n", ones, trials)
if (ones > 0):
    printf("  ✓ 检测到相位翻转(非零+1测量)\n")
else:
    printf("  相位未翻转(纯Z作用)\n")
end

printf("\n=== PEA增强演示完成 ===\n")