# ================================================================
# examples/qns_framework_demo.qentl — QNS训练框架演示
# ================================================================
qreg q[4]

# 初始化叠加态
h q[0]
h q[1]
h q[2]
h q[3]

# 前向传播
cx q[0], q[1]
cx q[1], q[2]
cx q[2], q[3]

# 测量
var f0 = measure q[0]
var f1 = measure q[1]
var f2 = measure q[2]
var f3 = measure q[3]

printf("QNS训练框架: %d %d %d %d\n", f0, f1, f2, f3)
printf("QNS训练框架验证: 通过\n")