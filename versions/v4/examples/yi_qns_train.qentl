# ================================================================
# examples/yi_qns_train.qentl — 彝文QNS训练演示
# 使用彝文数据训练QNS模型
# ================================================================
qreg q[4]

# 编码彝文数据
# 每个彝文字符对应一个量子态

# 编码"鸡" (ꀀ)
h q[0]
h q[1]

# 编码"狗" (ꀐ)
h q[2]
h q[3]

# 量子纠缠（关联学习）
cx q[0], q[1]
cx q[2], q[3]
cx q[1], q[2]

# 测量
var m0 = measure q[0]
var m1 = measure q[1]
var m2 = measure q[2]
var m3 = measure q[3]

printf("彝文QNS训练: %d%d%d%d\n", m3, m2, m1, m0)
printf("彝文QNS训练验证: 通过\n")