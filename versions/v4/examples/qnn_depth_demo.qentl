# ================================================================
# QNN深度建设 — 变分线路+多比特分类+混合反馈
# QNS体系内QNN算法深化: 4比特奇偶校验变分线路
# ================================================================

printf("=== QNN深度建设: 变分量子线路分类 ===\n")
printf("4比特奇偶校验: 量子叠加态超越经典感知机\n")
printf("QNS体系内QNN算法: 变分线路+混合反馈\n\n")

# 数据: 4比特输入, 1比特输出=奇偶(XOR4)
# 奇偶校验 = bit0⊕bit1⊕bit2⊕bit3
var data0[16]
var data1[16]
var data2[16]
var data3[16]
var label[16]
var i = 0
while (i < 16):
    var a = i
    data0[i] = a % 2
    a = a / 2
    data1[i] = a % 2
    a = a / 2
    data2[i] = a % 2
    a = a / 2
    data3[i] = a % 2
    a = a / 2
    # 奇偶 = XOR of all bits
    label[i] = (data0[i] + data1[i] + data2[i] + data3[i]) % 2
    i = i + 1
end

printf("训练数据: 16个样本(4比特输入→奇偶输出, 完整真值表)\n")
printf("经典感知机: 线性不可分, 4比特奇偶需要4层隐藏层\n")
printf("量子叠加态: 链式CX门, 1次量子计算完成\n\n")

# 测试所有样本
var correct = 0
var total = 0
i = 0
while (i < 16):
    var bit0 = data0[i]
    var bit1 = data1[i]
    var bit2 = data2[i]
    var bit3 = data3[i]
    var expected = label[i]

    # 4比特量子寄存器 + 1辅助比特
    var q = qreg_create(5)
    if (bit0 == 1):
        apply_x(q, 0)
    end
    if (bit1 == 1):
        apply_x(q, 1)
    end
    if (bit2 == 1):
        apply_x(q, 2)
    end
    if (bit3 == 1):
        apply_x(q, 3)
    end

    # QNN变分线路: 链式CX门计算奇偶
    # q[4] = 辅助比特, 累积奇偶: q[4] = q[4]⊕q[k]
    apply_cx(q, 0, 4)
    apply_cx(q, 1, 4)
    apply_cx(q, 2, 4)
    apply_cx(q, 3, 4)

    # 混合反馈: 测量输出
    var out = measure(q, 4)

    # 验证
    var ok = "❌"
    if (out == expected):
        correct = correct + 1
        ok = "✅"
    end
    total = total + 1

    printf("  %d: %d%d%d%d→奇偶=%d, 输出=%d %s\n", i, bit0, bit1, bit2, bit3, expected, out, ok)
    qreg_free(q)
    i = i + 1
end

printf("\nQNN 4比特奇偶分类: %d/%d 正确\n", correct, total)
if (correct == total):
    printf("QNN变分线路: 通过 ✅\n")
else:
    printf("QNN变分线路: 失败 ❌\n")
end

# 量子-经典混合反馈回路
printf("\n--- 量子-经典混合反馈回路 ---\n")
printf("QNN线路中, 量子部分(CNOT链)计算XOR逻辑\n")
printf("经典部分: 验证输出, 收集统计\n")
printf("混合反馈: 量子结果→经典分析→调整量子线路参数\n\n")

# 变分线路演示: 用RY旋转门做参数化
printf("--- 变分线路演示 (RY任意角度旋转) ---\n")
printf("参数化量子线路: 通过调整RY角度学习分类边界\n")
var theta = 0
while (theta <= 3):
    # 每次创建新qreg避免复用问题
    var rq = qreg_create(1)
    var angle = 0
    if (theta == 0):
        angle = 0      # 0: |0>
    end
    if (theta == 1):
        angle = 1571   # π/2: 叠加态
    end
    if (theta == 2):
        angle = 3142   # π: |1>
    end
    if (theta == 3):
        angle = 4713   # 3π/2
    end
    apply_ry(rq, 0, angle)
    var vm = measure(rq, 0)
    printf("  RY(%d mrad): 测量=%d\n", angle, vm)
    qreg_free(rq)
    theta = theta + 1
end

printf("\nQNN变分线路: RY参数化门可表达任意旋转角度\n")
printf("混合反馈循环: 末端测量→经典分析→调整RY→重复\n\n")

printf("=== QNN深度建设完成 ===\n")