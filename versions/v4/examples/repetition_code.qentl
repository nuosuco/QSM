# ================================================================
# examples/repetition_code.qentl — 3比特比特翻转码(量子纠错第一课)
# QEntL全栈v0.2.0能力实战: 编码/注错/综合征/纠正完整闭环
#
# 原理: 逻辑态 |0>L = |000>, |1>L = |111>
#   编码: |b> -> CX(0,1) CX(0,2) 复制经典比特
#   注错: 对某一比特施加X(比特翻转噪声)
#   综合征: Z1Z2 和 Z2Z3 (奇偶校验, 不破坏逻辑信息)
#   纠正: 按综合征多数表决翻转回正确值
# ================================================================

# 综合征测量: 返回 s12*10 + s23
# s12=1 表示q0!=q1, s23=1 表示q1!=q2
def syndrome(r):
    var m0 = measure(r, 0)
    var m1 = measure(r, 1)
    var m2 = measure(r, 2)
    var s12 = 0
    if (m0 != m1): s12 = 1 end
    var s23 = 0
    if (m1 != m2): s23 = 1 end
    return s12 * 10 + s23
end

# 一轮完整实验: 逻辑比特b, 错误位置err_pos(-1=无错)
# 返回 1=纠错成功恢复b, 0=失败
def one_round(b, err_pos):
    var r = qreg_create(3)
    # 编码: 准备逻辑态
    if (b == 1):
        x r[0]
    end
    cx r[0], r[1]
    cx r[0], r[2]
    # 注错: 单比特翻转噪声
    if (err_pos == 0):
        x r[0]
    end
    if (err_pos == 1):
        x r[1]
    end
    if (err_pos == 2):
        x r[2]
    end
    # 综合征测量
    var m0 = measure(r, 0)
    var m1 = measure(r, 1)
    var m2 = measure(r, 2)
    var s12 = 0
    if (m0 != m1): s12 = 1 end
    var s23 = 0
    if (m1 != m2): s23 = 1 end
    # 纠正: 多数表决恢复逻辑比特
    var recovered = 0
    var ones = m0 + m1 + m2
    if (ones >= 2): recovered = 1 end
    qreg_free(r)
    if (recovered == b): return 1 end
    return 0
end

printf("=== 3比特比特翻转码 ===\n")
printf("逻辑态: |0>L=|000>, |1>L=|111>\n\n")

# 测试矩阵: b ∈ {0,1} × err_pos ∈ {-1,0,1,2} = 8种组合
var total = 0
var ok = 0
var b = 0
while (b <= 1):
    var err = 0 - 1
    while (err <= 2):
        var i = 0
        while (i < 20):
            total = total + 1
            if (one_round(b, err) == 1):
                ok = ok + 1
            end
            i = i + 1
        end
        err = err + 1
    end
    b = b + 1
end

printf("测试矩阵: 2逻辑态 x 4错误位置 x 20轮 = %d 次\n", total)
printf("纠错成功: %d/%d\n", ok, total)

if (ok == total):
    printf("3比特码纠错: 通过 (单比特翻转全部纠正)\n")
else:
    printf("3比特码纠错: 失败 (%d次未纠正)\n", total - ok)
end