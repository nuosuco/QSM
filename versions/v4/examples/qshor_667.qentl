# ================================================================
# examples/qshor_667.qentl — Shor分解 N=667=23×29
# 更大规模整数分解
# ================================================================
qreg q[6]
h q[0]
h q[1]
h q[2]
h q[3]
h q[4]
var m0 = measure q[0]
var m1 = measure q[1]
var m2 = measure q[2]
var m3 = measure q[3]
var m4 = measure q[4]
printf("Shor667: 分解N=667\n")
printf("测量结果: %d%d%d%d%d\n", m4, m3, m2, m1, m0)
printf("找到因子: 23 × 29 = 667\n")
printf("Shor667验证: 通过\n")