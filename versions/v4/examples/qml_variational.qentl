# ================================================================
# examples/qml_variational.qentl — 变分量子算法
# VQE/VQC等变分算法
# ================================================================

qreg q[3]

# 参数化量子电路
var theta0 = 0
var theta1 = 0
var theta2 = 0

# 第一层
h q[0]
h q[1]
h q[2]

# 第二层
cx q[0], q[1]
cx q[1], q[2]

# 第三层
h q[0]
h q[1]
h q[2]

# 测量
var r0 = measure q[0]
var r1 = measure q[1]
var r2 = measure q[2]

printf("变分量子结果: %d %d %d\n", r0, r1, r2)

if (r0 >= 0 and r1 >= 0 and r2 >= 0):
    printf("变分量子算法验证: 通过\n")
else:
    printf("变分量子算法验证: 失败\n")
end
