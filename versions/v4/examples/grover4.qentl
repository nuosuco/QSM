# ================================================================
# examples/grover4.qentl — 4量子位Grover搜索 (16候选)
# 搜索目标 |1011> (q0=1, q1=1, q2=0, q3=1)
#
# 经典: 平均8次, 最坏16次
# Grover: 3次迭代, 理论命中率≈96%
#
# 核心门: CCCZ(三控制Z, 4量子位门)
# ================================================================

qreg q[4]

# 初始化: 均匀叠加 |++++>
h q[0]
h q[1]
h q[2]
h q[3]

var iter = 0
while (iter < 3):
    # ---- 预言机: 标记|1011> ----
    # q[2]目标值为0, 先X
    x q[2]
    cccz q[0], q[1], q[2], q[3]
    x q[2]

    # ---- 扩散算子: 2|0000><0000| - I ----
    h q[0]
    h q[1]
    h q[2]
    h q[3]
    x q[0]
    x q[1]
    x q[2]
    x q[3]
    cccz q[0], q[1], q[2], q[3]
    x q[0]
    x q[1]
    x q[2]
    x q[3]
    h q[0]
    h q[1]
    h q[2]
    h q[3]

    iter = iter + 1
end

# 测量
var m0 = measure q[0]
var m1 = measure q[1]
var m2 = measure q[2]
var m3 = measure q[3]
printf("Grover4结果: %d%d%d%d\n", m0, m1, m2, m3)
if (m0 == 1 and m1 == 1 and m2 == 0 and m3 == 1):
    printf("命中目标|1011>\n")
else:
    printf("未命中\n")
end