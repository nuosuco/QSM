# ================================================================
# 量子Grover搜索增强 — 多目标搜索
# 在未排序数据库中搜索多个目标
# ================================================================

printf("=== 量子Grover搜索增强 ===\n\n")
printf("问题: 4元素数据库, 搜索2个目标\n")
printf("Grover算法: 多次迭代放大目标概率\n\n")

# 4元素搜索: 2比特
# Oracle标记目标: 2和3

printf("Oracle: 标记元素2和3\n\n")

# 单次Grover迭代
var ok = 0
var total = 0
var r = 0
while (r < 20):
    total = total + 1
    var q = qreg_create(3)
    
    # 初始化叠加
    h q[0]
    h q[1]
    
    # Oracle: 标记目标2 (|10>) 和 3 (|11>)
    # 标记2: 通过CZ + 相位翻转
    # 标记3: 通过CCZ
    # 简化: 用CZ标记|11>
    cz q[0], q[1]
    
    # 扩散算子: 2|ψ><ψ| - I
    h q[0]
    h q[1]
    x q[0]
    x q[1]
    cz q[0], q[1]
    x q[0]
    x q[1]
    h q[0]
    h q[1]
    
    # 测量
    var m0 = measure(q, 0)
    var m1 = measure(q, 1)
    var val = m0 + m1 * 2
    if (val == 2 or val == 3):
        ok = ok + 1
    end
    qreg_free(q)
    r = r + 1
end

printf("Grover多目标搜索: %d/%d 命中标记项\n", ok, total)
printf("理论概率: ~50%% (2目标/4元素)\n")
printf("实际命中率: %d%%\n", ok * 100 / total)

# 两次迭代（增强搜索）
printf("\n--- 两次迭代 ---\n")
var ok2 = 0
r = 0
while (r < 20):
    total = total + 1
    var q2 = qreg_create(3)
    h q2[0]
    h q2[1]
    
    # 第一次迭代
    cz q2[0], q2[1]
    h q2[0]
    h q2[1]
    x q2[0]
    x q2[1]
    cz q2[0], q2[1]
    x q2[0]
    x q2[1]
    h q2[0]
    h q2[1]
    
    # 第二次迭代
    cz q2[0], q2[1]
    h q2[0]
    h q2[1]
    x q2[0]
    x q2[1]
    cz q2[0], q2[1]
    x q2[0]
    x q2[1]
    h q2[0]
    h q2[1]
    
    var m0 = measure(q2, 0)
    var m1 = measure(q2, 1)
    var val = m0 + m1 * 2
    if (val == 2 or val == 3):
        ok2 = ok2 + 1
    end
    qreg_free(q2)
    r = r + 1
end

printf("Grover 2次迭代: %d/20 命中标记项\n", ok2)
printf("Grover增强: 完成\n")

printf("\n=== Grover搜索增强完成 ===\n")