# ================================================================
# examples/qns_full_pipeline.qentl — QNS完整训练流水线
# 演示QNS从数据编码到模型推理的完整流程
# ================================================================
qreg q[6]

# ===== 阶段1: 数据编码 =====
# 将输入数据编码为量子态
h q[0]  # 特征1
h q[1]  # 特征2
h q[2]  # 特征3
h q[3]  # 特征4

# ===== 阶段2: 量子神经网络层 =====
# 第一层：纠缠层
cx q[0], q[1]
cx q[2], q[3]

# 第二层：门操作
h q[0]
h q[1]
h q[2]
h q[3]

# 第三层：再次纠缠
cx q[1], q[2]
cx q[3], q[4]

# ===== 阶段3: 量子池化 =====
# 测量压缩信息
h q[4]
h q[5]

# ===== 阶段4: 输出层 =====
cx q[4], q[5]
h q[5]

# ===== 阶段5: 测量输出 =====
var f0 = measure q[0]
var f1 = measure q[1]
var f2 = measure q[2]
var f3 = measure q[3]
var h0 = measure q[4]
var h1 = measure q[5]

# ===== 阶段6: 结果分析 =====
printf("QNS完整流水线:\n")
printf("  输入特征: %d %d %d %d\n", f0, f1, f2, f3)
printf("  隐藏层: %d %d\n", h0, h1)

# 计算输出
var output = h0 * 2 + h1
printf("  模型输出: %d\n", output)

# 验证
if (output >= 0 and output <= 3):
    printf("QNS完整流水线验证: 通过\n")
else:
    printf("QNS完整流水线验证: 失败\n")
end