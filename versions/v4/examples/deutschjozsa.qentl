# ================================================================
# examples/deutschjozsa.qentl — Deutsch-Jozsa算法
# 判断函数 f: {0,1}^n → {0,1} 是常数还是平衡
# 经典最坏情况: 2^(n-1)+1次查询
# 量子: 只需1次查询
#
# 本例: n=3, 函数f(x) = x[0] XOR x[1] XOR x[2] (平衡函数)
# 期望: 测量全0 → 不是常数函数(因为平衡)
# ================================================================

qreg q[4]
# q[0..2] = 输入量子位 |x>
# q[3] = 输出量子位 |->

# 初始化: 输入叠加态, 输出 |->
h q[0]
h q[1]
h q[2]
# |-> = (|0> - |1>)/√2
x q[3]
h q[3]

# 预言机: 实现 f(x) = x0 XOR x1 XOR x2
# U_f |x>|-> = (-1)^f(x) |x>|->
cx q[0], q[3]
cx q[1], q[3]
cx q[2], q[3]

# 对输入量子位再次做Hadamard变换
h q[0]
h q[1]
h q[2]

# 测量输入量子位
var m0 = measure q[0]
var m1 = measure q[1]
var m2 = measure q[2]
printf("Deutsch-Jozsa n=3: %d%d%d\n", m0, m1, m2)

# 如果全为0, 函数是常数; 否则是平衡函数
if (m0 == 0 and m1 == 0 and m2 == 0):
    printf("函数是常数函数\n")
else:
    printf("函数是平衡函数 (正确)\n")
end
