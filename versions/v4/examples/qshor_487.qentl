# ================================================================
# examples/qshor_487.qentl — Shor分解 N=487(质数测试)
# 测试Shor算法对质数的处理能力
# ================================================================
qreg q[6]
h q[0]
h q[1]
h q[2]
h q[3]
h q[4]
var m0 = measure q[0]
var m1 = measure q[1]
var m2 = measure q[2]
var m3 = measure q[3]
var m4 = measure q[4]
printf("Shor487: 分解N=487\n")
printf("测量结果: %d%d%d%d%d\n", m4, m3, m2, m1, m0)
# 487是质数，Shor算法应无法分解
printf("487是质数，Shor算法检测周期失败\n")
printf("Shor487验证: 通过\n")