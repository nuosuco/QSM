# ================================================================
# examples/steane_syndrome.qentl — 7比特Steane码真实综合征提取
# QEntL全栈v0.2.0能力实战: CSS码完整量子纠错(叠加态编码)
#
# Steane码 CSS构造: |0>_L = (1/sqrt8) Σ_{x∈C⊥} |x>
# C⊥=[7,3,4]单形码, 生成矩阵H的行: r1=1010101, r2=0110011, r3=0001111
# 编码电路: H(q0,q1,q3) + CX扇出计算其余4比特
# 稳定子: X型(检Z错)和Z型(检X错)各3个, 辅助比特提取综合征
# 解码验证: 逆编码电路回到|0000000>, 确定性测量
# ================================================================

# 编码: 制备 |0>_L (7比特叠加态)
def encode_zero(r):
    h r[0]
    h r[1]
    h r[3]
    cx r[0], r[2]
    cx r[1], r[2]
    cx r[0], r[4]
    cx r[3], r[4]
    cx r[1], r[5]
    cx r[3], r[5]
    cx r[0], r[6]
    cx r[1], r[6]
    cx r[3], r[6]
end

# 编码 |1>_L = X^7 |0>_L
def encode_one(r):
    encode_zero(r)
    x r[0]
    x r[1]
    x r[2]
    x r[3]
    x r[4]
    x r[5]
    x r[6]
end

# 解码: 逆编码电路, |0>_L -> |0000000>
def decode(r):
    cx r[3], r[6]
    cx r[1], r[6]
    cx r[0], r[6]
    cx r[3], r[5]
    cx r[1], r[5]
    cx r[3], r[4]
    cx r[0], r[4]
    cx r[1], r[2]
    cx r[0], r[2]
    h r[0]
    h r[1]
    h r[3]
end

# 综合征解码: 3比特综合征 -> 错误位置 (-1=无错)
# H矩阵列: col0=100,col1=010,col2=110,col3=001,col4=101,col5=011,col6=111
def syndrome_to_pos(s1, s2, s3):
    if (s1 == 0 and s2 == 0 and s3 == 0): return 0 - 1 end
    if (s1 == 1 and s2 == 0 and s3 == 0): return 0 end
    if (s1 == 0 and s2 == 1 and s3 == 0): return 1 end
    if (s1 == 1 and s2 == 1 and s3 == 0): return 2 end
    if (s1 == 0 and s2 == 0 and s3 == 1): return 3 end
    if (s1 == 1 and s2 == 0 and s3 == 1): return 4 end
    if (s1 == 0 and s2 == 1 and s3 == 1): return 5 end
    return 6
end

# 一轮: 逻辑比特b, 错误类型etype(0=X,1=Z), 错误位置err_pos(-1=无错)
# 返回 1=纠错成功, 0=失败
def one_round(b, etype, err_pos):
    var r = qreg_create(13)  # 7数据 + 6辅助
    # 编码
    if (b == 0):
        encode_zero(r)
    else:
        encode_one(r)
    end
    # 注错
    if (err_pos == 0):
        if (etype == 0): x r[0] end
        if (etype == 1): z r[0] end
    end
    if (err_pos == 1):
        if (etype == 0): x r[1] end
        if (etype == 1): z r[1] end
    end
    if (err_pos == 2):
        if (etype == 0): x r[2] end
        if (etype == 1): z r[2] end
    end
    if (err_pos == 3):
        if (etype == 0): x r[3] end
        if (etype == 1): z r[3] end
    end
    if (err_pos == 4):
        if (etype == 0): x r[4] end
        if (etype == 1): z r[4] end
    end
    if (err_pos == 5):
        if (etype == 0): x r[5] end
        if (etype == 1): z r[5] end
    end
    if (err_pos == 6):
        if (etype == 0): x r[6] end
        if (etype == 1): z r[6] end
    end
    # X型稳定子测量(检Z错): 辅助q7,q8,q9
    # S_X1 = X(q0)X(q2)X(q4)X(q6)
    h r[7]
    cx r[7], r[0]
    cx r[7], r[2]
    cx r[7], r[4]
    cx r[7], r[6]
    h r[7]
    var sx1 = measure(r, 7)
    # S_X2 = X(q1)X(q2)X(q5)X(q6)
    h r[8]
    cx r[8], r[1]
    cx r[8], r[2]
    cx r[8], r[5]
    cx r[8], r[6]
    h r[8]
    var sx2 = measure(r, 8)
    # S_X3 = X(q3)X(q4)X(q5)X(q6)
    h r[9]
    cx r[9], r[3]
    cx r[9], r[4]
    cx r[9], r[5]
    cx r[9], r[6]
    h r[9]
    var sx3 = measure(r, 9)
    # Z型稳定子测量(检X错): 辅助q10,q11,q12
    # S_Z1 = Z(q0)Z(q2)Z(q4)Z(q6)
    cx r[0], r[10]
    cx r[2], r[10]
    cx r[4], r[10]
    cx r[6], r[10]
    var sz1 = measure(r, 10)
    # S_Z2 = Z(q1)Z(q2)Z(q5)Z(q6)
    cx r[1], r[11]
    cx r[2], r[11]
    cx r[5], r[11]
    cx r[6], r[11]
    var sz2 = measure(r, 11)
    # S_Z3 = Z(q3)Z(q4)Z(q5)Z(q6)
    cx r[3], r[12]
    cx r[4], r[12]
    cx r[5], r[12]
    cx r[6], r[12]
    var sz3 = measure(r, 12)
    # 纠错: X综合征定位Z错, Z综合征定位X错
    var zpos = syndrome_to_pos(sx1, sx2, sx3)
    var xpos = syndrome_to_pos(sz1, sz2, sz3)
    if (zpos == 0): z r[0] end
    if (zpos == 1): z r[1] end
    if (zpos == 2): z r[2] end
    if (zpos == 3): z r[3] end
    if (zpos == 4): z r[4] end
    if (zpos == 5): z r[5] end
    if (zpos == 6): z r[6] end
    if (xpos == 0): x r[0] end
    if (xpos == 1): x r[1] end
    if (xpos == 2): x r[2] end
    if (xpos == 3): x r[3] end
    if (xpos == 4): x r[4] end
    if (xpos == 5): x r[5] end
    if (xpos == 6): x r[6] end
    # 逻辑读出: 测量全部7比特, 奇偶校验 = 逻辑Z̄
    # |0>_L 码字全偶权重(校验0), |1>_L 码字全奇权重(校验1)
    # (不能用decode后测q0: |1>_L=X⊗7|0>_L解码后信息在q2,q4,q5,q6)
    var m0 = measure(r, 0)
    var m1 = measure(r, 1)
    var m2 = measure(r, 2)
    var m3 = measure(r, 3)
    var m4 = measure(r, 4)
    var m5 = measure(r, 5)
    var m6 = measure(r, 6)
    var parity = (m0 + m1 + m2 + m3 + m4 + m5 + m6) % 2
    qreg_free(r)
    if (parity == b): return 1 end
    return 0
end

printf("=== 7比特Steane码 真实综合征提取 ===\n")
printf("CSS码: 叠加态编码, 6稳定子, 辅助比特提取综合征\n\n")

var total = 0
var ok = 0
var b = 0
while (b <= 1):
    var et = 0
    while (et <= 1):
        var err = 0 - 1
        while (err <= 6):
            var i = 0
            while (i < 5):
                total = total + 1
                if (one_round(b, et, err) == 1):
                    ok = ok + 1
                end
                i = i + 1
            end
            err = err + 1
        end
        et = et + 1
    end
    b = b + 1
end

printf("测试矩阵: 2逻辑态 x 2错误类型 x 8位置 x 5轮 = %d 次\n", total)
printf("纠错成功: %d/%d\n", ok, total)

if (ok == total):
    printf("Steane码真实纠错: 通过 (X+Z单比特错误全部纠正)\n")
else:
    printf("Steane码真实纠错: 失败 (%d次未纠正)\n", total - ok)
end