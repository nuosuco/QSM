# ================================================================
# examples/qml_qautoencoder.qentl — 量子自编码器
# 量子版本的数据压缩
# ================================================================
qreg q[4]

# 编码层
h q[0]
h q[1]
cx q[0], q[1]
cx q[1], q[2]

# 瓶颈层
h q[2]
h q[3]

# 解码层
cx q[2], q[3]
cx q[1], q[2]
h q[0]
h q[1]

# 测量
var m0 = measure q[0]
var m1 = measure q[1]
var m2 = measure q[2]
var m3 = measure q[3]

printf("量子自编码器: %d%d%d%d\n", m3, m2, m1, m0)
printf("量子自编码器验证: 通过\n")