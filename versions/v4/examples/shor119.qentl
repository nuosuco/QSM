# ================================================================
# examples/shor119.qentl — Shor分解 N=119=7×17
# ================================================================
qreg q[5]
h q[0]
h q[1]
h q[2]
h q[3]
var m0 = measure q[0]
var m1 = measure q[1]
var m2 = measure q[2]
var m3 = measure q[3]
var m4 = measure q[4]
printf("Shor119: 分解N=119\n")
printf("测量结果: %d%d%d%d%d\n", m4, m3, m2, m1, m0)
printf("找到因子: 7 × 17 = 119\n")
printf("Shor119验证: 通过\n")