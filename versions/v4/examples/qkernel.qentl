# ================================================================
# examples/qkernel.qentl — 量子核函数
# 用于量子机器学习的核方法
# ================================================================

qreg q[3]

# 初始化
h q[0]
h q[1]
h q[2]

# 纠缠
cx q[0], q[1]
cx q[1], q[2]

# 测量
var r0 = measure q[0]
var r1 = measure q[1]
var r2 = measure q[2]

# 计算核值
var kernel = r0 * r1 + r1 * r2
printf("量子核函数: %d\n", kernel)

if (kernel >= 0):
    printf("量子核函数验证: 通过\n")
else:
    printf("量子核函数验证: 失败\n")
end
