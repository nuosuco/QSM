# ================================================================
# examples/vqe_h2.qentl — VQE变分量子本征求解器
# QEntL全栈v0.2.0能力实战: 浮点(定点数) + RY旋转门 + 变分优化
#
# 任务: 求解 H = Z 的基态能量 (最小化 <ψ|Z|ψ>)
# 拟设: |ψ(θ)> = RY(θ)|0>
# 期望值: <Z> = cos(θ), 最小值 -1 在 θ=π 处
# 优化: 坐标下降法(参数偏移采样估计梯度)
# ================================================================
var FIXED_SCALE = 1000

def fx_mul(a, b):
    return a * b / FIXED_SCALE
end

def fx_to_str(a):
    var neg = 0
    if (a < 0):
        neg = 1
        a = 0 - a
    end
    var ip = a / FIXED_SCALE
    var frac = a % FIXED_SCALE
    var fs = int_to_str(frac)
    while (str_len(fs) < 3):
        fs = str_concat("0", fs)
    end
    var s = str_concat(int_to_str(ip), str_concat(".", fs))
    if (neg == 1):
        s = str_concat("-", s)
    end
    return s
end

# 估计 <Z>: 测量N次, <Z> = (N0 - N1)/N, 定点返回
def estimate_z(theta_mrad, shots):
    var cnt1 = 0
    var i = 0
    while (i < shots):
        var r = qreg_create(1)
        apply_ry(r, 0, theta_mrad)
        var m = measure(r, 0)
        if (m == 1): cnt1 = cnt1 + 1 end
        qreg_free(r)
        i = i + 1
    end
    # <Z> = (shots - 2*cnt1) / shots, 定点×1000
    var num = (shots - 2 * cnt1) * FIXED_SCALE
    return num / shots
end

printf("=== VQE变分量子本征求解器 ===\n")
printf("哈密顿量: H = Z\n")
printf("拟设: RY(theta)|0>, 理论基态能量 = -1.000 (theta=pi)\n\n")

# 初始参数 θ = 0.5 rad = 500 mrad
var theta = 500
var lr = 200
printf("初始 theta = %s rad\n", fx_to_str(theta))

var ez = estimate_z(theta, 200)
printf("初始 <Z> = %s\n\n", fx_to_str(ez))

# 变分优化循环: 参数偏移法估计梯度
var step = 0
while (step < 25):
    var delta = 100
    var ep = estimate_z(theta + delta, 100)
    var em = estimate_z(theta - delta, 100)
    # 梯度 ≈ (ep - em) / (2*delta), 定点: (ep-em)*1000/200
    var grad = (ep - em) * FIXED_SCALE / 200
    # θ = θ - lr * grad (定点乘法)
    theta = theta - fx_mul(lr, grad)
    # θ限制在 [0, 2π] = [0, 6283] mrad
    if (theta < 0): theta = 0 end
    if (theta > 6283): theta = 6283 end
    if (step % 5 == 0):
        var ez_now = estimate_z(theta, 200)
        printf("step %d: theta=%s rad, <Z>=%s, grad=%s\n", step, fx_to_str(theta), fx_to_str(ez_now), fx_to_str(grad))
    end
    step = step + 1
end

var final_e = estimate_z(theta, 500)
printf("\n=== VQE结果 ===\n")
printf("最优 theta = %s rad (理论 pi=3.142)\n", fx_to_str(theta))
printf("基态能量 <Z> = %s (理论 -1.000)\n", fx_to_str(final_e))

if (final_e < 0 - 800):
    printf("VQE求解: 通过 (能量<-0.8, 接近基态)\n")
else:
    printf("VQE求解: 未收敛\n")
end