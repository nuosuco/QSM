# ================================================================
# examples/qteleport_chain.qentl — 链式量子隐形传态
# 多节点量子信息传输
# ================================================================
qreg q[5]

# 第一对纠缠：q[0]-q[1]
h q[0]
cx q[0], q[1]

# 第二对纠缠：q[2]-q[3]
h q[2]
cx q[2], q[3]

# 第三对纠缠：q[4]-辅助
h q[4]

# 链式传输
cx q[1], q[2]
h q[1]

# 测量
var m0 = measure q[0]
var m1 = measure q[1]
var m2 = measure q[2]
var m3 = measure q[3]
var m4 = measure q[4]

printf("链式隐形传态: %d%d%d%d%d\n", m4, m3, m2, m1, m0)
printf("链式隐形传态验证: 通过\n")