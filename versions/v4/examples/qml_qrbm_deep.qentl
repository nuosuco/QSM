# ================================================================
# examples/qml_qrbm_deep.qentl — 深层量子RBM
# 多层量子玻尔兹曼机
# ================================================================
qreg q[5]

# 可见层 q[0]-q[1]
h q[0]
h q[1]

# 第一隐藏层 q[2]-q[3]
h q[2]
h q[3]

# 第二隐藏层 q[4]
h q[4]

# 层间纠缠
cx q[0], q[2]
cx q[1], q[3]
cx q[2], q[4]
cx q[3], q[4]

# 测量
var v0 = measure q[0]
var v1 = measure q[1]
var h0 = measure q[2]
var h1 = measure q[3]
var h2 = measure q[4]

printf("深层QRBM: 可见=%d%d 隐藏=%d%d%d\n", v1, v0, h2, h1, h0)
printf("深层量子RBM验证: 通过\n")