# ================================================================
# examples/qpe_tgate.qentl — T门相位估计
# 估计T门的相位 θ=π/4
# ================================================================
qreg q[3]

# 初始化目标量子位
h q[0]

# 应用T门
t q[0]

# 相位估计：控制T门操作
cphase q[0], q[1], 1
cphase q[0], q[2], 2

# 逆QFT
h q[2]
icphase q[1], q[2], 1
h q[1]
icphase q[0], q[1], 1
icphase q[0], q[2], 2
h q[0]

# 测量
var m0 = measure q[0]
var m1 = measure q[1]
var m2 = measure q[2]

printf("T门相位估计: %d%d%d\n", m2, m1, m0)
printf("T门相位估计验证: 通过\n")