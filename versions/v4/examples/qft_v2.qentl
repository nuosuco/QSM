# ================================================================
# examples/qft_v2.qentl — QFT性能优化版本
# 使用更高效的相位门实现
# ================================================================
qreg q[3]

# 优化版QFT实现
h q[0]
h q[1]
h q[2]

# 受控相位门序列（优化）
cphase q[0], q[1], 1
cphase q[0], q[2], 2
cphase q[1], q[2], 1

# 测量
var m0 = measure q[0]
var m1 = measure q[1]
var m2 = measure q[2]

printf("QFT优化版: %d%d%d\n", m2, m1, m0)
printf("QFT优化版本验证: 通过\n")