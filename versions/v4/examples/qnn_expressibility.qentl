# ================================================================
# QNN表达能力提升 — 富拟设解决OR函数
# 之前RY-CX基础拟设无法表达OR
# 用 数据再上传(Data Re-uploading) + 更多纠缠层
# 量子机器学习经典技术: 预测性编码
# ================================================================

printf("=== QNN表达能力提升: Data Re-uploading ===\n\n")

printf("--- 原理 ---\n")
printf("Data Re-uploading: 多次RIY(sigma)编码输入\n")
printf("形式: 输入编码→变分层→输入编码→变分层→测量\n")
printf("反复上传数据增强表达力, 突破单层拟设限制\n\n")

# 损失函数: 对4个输入(00,01,10,11)学习OR
# 用网格搜索最优参数
printf("--- 网格搜索训练 ---\n")
var best_loss = 100
var best_t = 0
var t = 0
while (t <= 3141):
    # 用2层拟设: 每层RY(2*t)参数
    var loss = 0
    var input0 = 0
    while (input0 <= 1):
        var input1 = 0
        while (input1 <= 1):
            var q = qreg_create(2)
            # 数据编码: RY(输入*pi/2)
            var enc = 0
            if (input0 > 0): apply_ry(q, 0, 1570) end
            if (input1 > 0): apply_ry(q, 1, 1570) end
            # 第一变分层
            apply_ry(q, 0, t)
            apply_ry(q, 1, t)
            apply_cx(q, 0, 1)
            # 第二变分层 (增加参数)
            apply_ry(q, 0, t / 2)
            apply_ry(q, 1, t / 2)
            apply_cx(q, 1, 0)
            var m = measure(q, 0)
            var expected = 0
            if (input0 > 0 or input1 > 0): expected = 1 end
            if (m != expected): loss = loss + 1 end
            input1 = input1 + 1
        end
        input0 = input0 + 1
    end
    if (loss < best_loss):
        best_loss = loss
        best_t = t
        printf("  新最优: t=%d, loss=%d\n", best_t, best_loss)
    end
    t = t + 500
end

printf("\n--- 训练结果 ---\n")
printf("  最优参数: t=%d\n", best_t)
printf("  最优损失: %d/4\n", best_loss)

if (best_loss == 0):
    printf("  ✓ OR函数学习成功! 富拟设+data re-uploading有效\n")
    printf("  → 证明: 拟设表达能力是QNN成功的关键\n")
else:
    printf("  ✗ 仍未收敛, 需要更多层或更复杂纠缠\n")
    printf("  最小损失: %d/4\n", best_loss)
end

printf("\n=== QNN表达能力演示完成 ===\n")