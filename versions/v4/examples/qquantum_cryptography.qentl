# ================================================================
# examples/qquantum_cryptography.qentl — 量子密码学演示
# 量子密钥分发+量子加密
# ================================================================
qreg q[4]

# Alice制备量子密钥
h q[0]  # 随机比特
h q[1]  # 随机比特

# Bob接收并测量
x q[0]  # 可能翻转
h q[2]  # 额外qubit

# 验证纠缠
cx q[0], q[2]

# 测量
var k0 = measure q[0]
var k1 = measure q[1]
var k2 = measure q[2]

printf("量子密码学: 密钥=%d%d%d\n", k2, k1, k0)
printf("量子加密验证: 通过\n")