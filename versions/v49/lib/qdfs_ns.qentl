# ================================================================
# lib/qdfs_ns.qentl — QDFS量子动态文件系统 (命名空间版, 统一数据层)
# 
# 平行宇宙哲学: 整个QEntL=一个量子基因=一个宇宙
# QDFS=统一数据层, 所有数据(系统/模型/用户/应用)都存这里
# 命名空间隔离: /system/ /models/ /users/ /apps/
# 用户能管理自己的数据, 系统/模型数据用户不可见
# 跨命名空间可量子纠缠
#
# 核心概念:
#   命名空间 = 数据的归属隔离 (system/models/users/apps/<用户名>)
#   叠加态文件 = 内容处于多个分支的叠加, 读取(观测)时坍缩
#   纠缠文件对 = 两个文件共享分支, 观测任一双方同步坍缩
#
# 存储布局:
#   <root>/meta        ← 全局元数据表 name带着命名空间前缀
#   <root>/ns/<ns>/<name>.data        经典文件
#   <root>/ns/<ns>/branches/<owner>/b0,b1  叠加态/纠缠分支
# ================================================================

var g_root = "/tmp/qdfs"
var g_meta = ""

# ---- 命名空间常量 ----
var NS_SYSTEM = "system"
var NS_MODELS = "models"
var NS_USERS  = "users"
var NS_APPS   = "apps"

# ---- 工具: 元数据表操作 ----

# 取字段: line按|分隔取第idx个
def meta_field(line, idx):
    var i = 0
    var n = str_len(line)
    var f = 0
    var start = 0
    while (i <= n):
        var issep = 0
        if (i == n):
            issep = 1
        else:
            var ch = str_char_at(line, i)
            if (str_eq(ch, "|")):
                issep = 1
            end
        end
        if (issep == 1):
            if (f == idx):
                return str_substring(line, start, i - start)
            end
            f = f + 1
            start = i + 1
        end
        i = i + 1
    end
    return ""
end

# 查找name的元数据行
def meta_find(name):
    var s = str_concat("\n", g_meta)
    var key = str_concat(str_concat("\n", name), "|")
    var i = str_index_of(s, key)
    if (i < 0):
        return ""
    end
    var rest = str_substring(s, i + 1, str_len(s) - i - 1)
    var j = str_index_of(rest, "\n")
    if (j < 0):
        return rest
    end
    return str_substring(rest, 0, j)
end

# 从元数据表删除一行并持久化
def meta_remove(name):
    var s = str_concat("\n", g_meta)
    var key = str_concat(str_concat("\n", name), "|")
    var i = str_index_of(s, key)
    if (i < 0):
        return 0
    end
    var rest = str_substring(s, i + 1, str_len(s) - i - 1)
    var j = str_index_of(rest, "\n")
    var oldlen = j + 1
    if (j < 0):
        oldlen = str_len(rest)
    end
    g_meta = str_concat(str_substring(g_meta, 0, i), str_substring(g_meta, i + oldlen, str_len(g_meta) - i - oldlen))
    file_write_bytes(str_concat(g_root, "/meta"), g_meta)
    return 1
end

# 设置(新增或更新)一行元数据并持久化
def meta_set(name, state, partner, collapsed, owner):
    meta_remove(name)
    var l1 = str_concat(name, "|")
    var l2 = str_concat(l1, state)
    var l3 = str_concat(l2, "|")
    var l4 = str_concat(l3, partner)
    var l5 = str_concat(l4, "|")
    var l6 = str_concat(l5, collapsed)
    var l7 = str_concat(l6, "|")
    var newline = str_concat(str_concat(l7, owner), "\n")
    g_meta = str_concat(g_meta, newline)
    file_write_bytes(str_concat(g_root, "/meta"), g_meta)
    return 1
end

# 标记某文件已坍缩到分支idx
def meta_set_collapse(name, idx):
    var line = meta_find(name)
    if (str_len(line) == 0):
        return 0
    end
    meta_set(name, meta_field(line, 1), meta_field(line, 2), int_to_str(idx), meta_field(line, 4))
    return 1
end

# ---- 命名空间路径构造 ----
# name格式: "ns:文件名"  (如 "users:zhonghua/config")
# 返回磁盘路径 <root>/ns/<ns>/<name>.data

# 从组合名取命名空间
def ns_of(name):
    var i = str_index_of(name, ":")
    if (i < 0):
        return NS_SYSTEM
    end
    return str_substring(name, 0, i)
end

# 从组合名去掉命名空间前缀
def ns_name(name):
    var i = str_index_of(name, ":")
    if (i < 0):
        return name
    end
    return str_substring(name, i + 1, str_len(name) - i - 1)
end

# 组合命名空间+文件名
def ns_key(ns, name):
    return str_concat(str_concat(ns, ":"), name)
end

# 经典文件磁盘路径
def ns_path(name):
    var ns = ns_of(name)
    var nm = ns_name(name)
    return str_concat(str_concat(str_concat(str_concat(str_concat(g_root, "/ns/"), ns), "/"), nm), ".data")
end

# 分支目录基础路径
def ns_branch_dir(name):
    var ns = ns_of(name)
    var nm = ns_name(name)
    return str_concat(str_concat(str_concat(str_concat(g_root, "/ns/"), ns), "/branches/"), nm)
end

# 确保命名空间名称的父目录存在 (处理嵌套路径如 zhonghua/config)
def ns_ensure_dir(ns, name):
    var base = str_concat(str_concat(str_concat(g_root, "/ns/"), ns), "/")
    mkdir(base)
    # 为嵌套路径逐段创建目录
    var rest = name
    var slash = str_index_of(rest, "/")
    while (slash >= 0):
        var seg = str_substring(rest, 0, slash)
        base = str_concat(base, seg)
        mkdir(base)
        base = str_concat(base, "/")
        rest = str_substring(rest, slash + 1, str_len(rest) - slash - 1)
        slash = str_index_of(rest, "/")
    end
    return 1
end

# ---- QDFS公共API ----

# 初始化QDFS根目录
def qdfs_init(root):
    g_root = root
    mkdir(root)
    var mp = str_concat(root, "/meta")
    if (file_exists(mp) == 0):
        file_write_bytes(mp, "")
    end
    g_meta = file_read(mp)
    # 预建命名空间目录
    mkdir(str_concat(root, "/ns"))
    mkdir(str_concat(str_concat(root, "/ns/"), NS_SYSTEM))
    mkdir(str_concat(str_concat(root, "/ns/"), NS_MODELS))
    mkdir(str_concat(str_concat(root, "/ns/"), NS_USERS))
    mkdir(str_concat(str_concat(root, "/ns/"), NS_APPS))
    return 1
end

# 写经典文件(确定态)到指定命名空间
def qdfs_ns_write(ns, name, content):
    var key = ns_key(ns, name)
    var path = ns_path(key)
    ns_ensure_dir(ns, name)
    file_write_bytes(path, content)
    meta_set(key, "0", "", "-1", ns)
    return 1
end

# 兼容旧API: 写经典文件到system命名空间
def qdfs_write(name, content):
    return qdfs_ns_write(NS_SYSTEM, name, content)
end

# 写叠加态文件到指定命名空间
def qdfs_ns_superpose(ns, name, c0, c1):
    var key = ns_key(ns, name)
    var bd = ns_branch_dir(key)
    ns_ensure_dir(ns, name)
    mkdir(bd)
    file_write_bytes(str_concat(bd, "/b0"), c0)
    file_write_bytes(str_concat(bd, "/b1"), c1)
    meta_set(key, "1", "", "-1", ns)
    return 1
end

# 兼容旧API
def qdfs_superpose(name, c0, c1):
    return qdfs_ns_superpose(NS_SYSTEM, name, c0, c1)
end

# 纠缠两个文件(可跨命名空间!): 共享c0/c1分支, 观测任一方双方同步坍缩
def qdfs_ns_entangle(ns_a, a, ns_b, b, c0, c1):
    var key_a = ns_key(ns_a, a)
    var key_b = ns_key(ns_b, b)
    var bd = ns_branch_dir(key_a)
    ns_ensure_dir(ns_a, a)
    mkdir(bd)
    file_write_bytes(str_concat(bd, "/b0"), c0)
    file_write_bytes(str_concat(bd, "/b1"), c1)
    meta_set(key_a, "2", key_b, "-1", ns_a)
    meta_set(key_b, "2", key_a, "-1", ns_b)
    return 1
end

# 兼容旧API: 同命名空间纠缠
def qdfs_entangle(a, b, c0, c1):
    return qdfs_ns_entangle(NS_SYSTEM, a, NS_SYSTEM, b, c0, c1)
end

# 读取(观测)命名空间文件
def qdfs_ns_read(ns, name):
    var key = ns_key(ns, name)
    var line = meta_find(key)
    if (str_len(line) == 0):
        return ""
    end
    var state = meta_field(line, 1)
    if (str_eq(state, "0")):
        return file_read(ns_path(key))
    end
    var collapsed = str_to_int(meta_field(line, 3))
    if (collapsed < 0):
        collapsed = rand_int(2)
        meta_set_collapse(key, collapsed)
        var partner = meta_field(line, 2)
        if (str_len(partner) > 0):
            meta_set_collapse(partner, collapsed)
        end
    end
    var owner = meta_field(line, 4)
    var bd = str_concat(ns_branch_dir(key), "/")
    if (collapsed == 0):
        return file_read(str_concat(bd, "b0"))
    end
    return file_read(str_concat(bd, "b1"))
end

# 兼容旧API
def qdfs_read(name):
    return qdfs_ns_read(NS_SYSTEM, name)
end

# 文件状态信息
def qdfs_info(name):
    var line = meta_find(name)
    if (str_len(line) == 0):
        return str_concat(name, ": 不存在")
    end
    var state = meta_field(line, 1)
    var collapsed = meta_field(line, 3)
    if (str_eq(state, "0")):
        return str_concat(name, ": 经典态")
    end
    if (str_eq(state, "1")):
        if (str_eq(collapsed, "-1")):
            return str_concat(name, ": 叠加态(未观测)")
        end
        return str_concat(str_concat(str_concat(name, ": 叠加态 已坍缩->"), collapsed), "分支")
    end
    var partner = meta_field(line, 2)
    if (str_eq(collapsed, "-1")):
        return str_concat(str_concat(str_concat(name, ": 纠缠<->"), partner), "(未观测)")
    end
    return str_concat(str_concat(str_concat(str_concat(name, ": 纠缠<->"), partner), " 已坍缩->"), collapsed)
end

# 按命名空间列出所有文件及状态
def qdfs_ns_ls(ns):
    var out = ""
    var s = g_meta
    while (str_len(s) > 0):
        var j = str_index_of(s, "\n")
        var line = s
        var rest = ""
        if (j >= 0):
            line = str_substring(s, 0, j)
            rest = str_substring(s, j + 1, str_len(s) - j - 1)
        end
        if (str_len(line) > 0):
            var fname = meta_field(line, 0)
            if (str_eq(ns_of(fname), ns)):
                out = str_concat(str_concat(out, qdfs_info(fname)), "\n")
            end
        end
        s = rest
    end
    if (str_len(out) == 0):
        return str_concat(ns, ": 空")
    end
    return out
end

# 兼容旧API: 列出全部
def qdfs_ls():
    return qdfs_ns_ls(NS_SYSTEM)
end

# 删除命名空间文件
def qdfs_ns_delete(ns, name):
    var key = ns_key(ns, name)
    var line = meta_find(key)
    if (str_len(line) == 0):
        return 0
    end
    file_delete(ns_path(key))
    var bd = str_concat(ns_branch_dir(key), "/")
    file_delete(str_concat(bd, "b0"))
    file_delete(str_concat(bd, "b1"))
    meta_remove(key)
    return 1
end

# 兼容旧API
def qdfs_delete(name):
    return qdfs_ns_delete(NS_SYSTEM, name)
end

# ---- 权限模型 ----
# 用户只能访问自己的 users/<用户名> 和 apps/<自己的应用>
# 系统/模型数据对用户不可见
# 简化: 权限在调用层强制, 这里提供可见性过滤

# 列出用户可见的数据(用户自己 + 系统公开只读)
def qdfs_user_view(username):
    var out = ""
    # 用户自己的 users/<username> 可读写
    var uout = qdfs_ns_ls(str_concat(NS_USERS, "/"))
    if (str_len(uout) > 0):
        out = str_concat(out, uout)
    end
    return out
end

# ---- 量子搜索(命名空间版) ----

# 在命名空间叠加态文件中搜索关键词
def qdfs_ns_search(ns, name, keyword):
    var key = ns_key(ns, name)
    var line = meta_find(key)
    if (str_len(line) == 0):
        return -3
    end
    var state = meta_field(line, 1)
    if (str_eq(state, "0")):
        var content = file_read(ns_path(key))
        if (str_index_of(content, keyword) >= 0):
            return 0
        end
        return -1
    end
    var owner = meta_field(line, 4)
    var bd = str_concat(ns_branch_dir(key), "/")
    var c0 = file_read(str_concat(bd, "b0"))
    var c1 = file_read(str_concat(bd, "b1"))
    var found_b0 = 0
    var found_b1 = 0
    if (str_index_of(c0, keyword) >= 0):
        found_b0 = 1
    end
    if (str_index_of(c1, keyword) >= 0):
        found_b1 = 1
    end
    if (found_b0 == 1 and found_b1 == 1):
        return -2
    end
    if (found_b0 == 1):
        return 0
    end
    if (found_b1 == 1):
        return 1
    end
    return -1
end

# 兼容旧API
def qdfs_search(name, keyword):
    return qdfs_ns_search(NS_SYSTEM, name, keyword)
end

# 全库叠加态搜索
def qdfs_ns_search_all(ns, keyword):
    var out = ""
    var s = g_meta
    while (str_len(s) > 0):
        var j = str_index_of(s, "\n")
        var line = s
        var rest = ""
        if (j >= 0):
            line = str_substring(s, 0, j)
            rest = str_substring(s, j + 1, str_len(s) - j - 1)
        end
        if (str_len(line) > 0):
            var fname = meta_field(line, 0)
            if (str_eq(ns_of(fname), ns)):
                var r = qdfs_ns_search(ns, ns_name(fname), keyword)
                if (r == -2):
                    out = str_concat(str_concat(fname, ":b0|"), str_concat(fname, ":b1\n"))
                else:
                    if (r == 0):
                        out = str_concat(str_concat(out, fname), ":b0\n")
                    end
                    if (r == 1):
                        out = str_concat(str_concat(out, fname), ":b1\n")
                    end
                end
            end
        end
        s = rest
    end
    if (str_len(out) == 0):
        return str_concat(ns, ": 未找到匹配")
    end
    return out
end

# 兼容旧API
def qdfs_search_all(keyword, state_filter):
    return qdfs_ns_search_all(NS_SYSTEM, keyword)
end

# ---- 动态合并/分离（QDFS叫"动态"文件系统的核心能力）----

# 合并两个命名空间: ns_b 的所有文件和目录合并到 ns_a
# 合并后 ns_b 消失，其文件全部归入 ns_a
# 这是 "及时瞬时瞬间移动、传送数据" 的体现
def qdfs_ns_merge(ns_a, ns_b):
    var out = ""
    var s = g_meta
    while (str_len(s) > 0):
        var j = str_index_of(s, "\n")
        var line = s
        var rest = ""
        if (j >= 0):
            line = str_substring(s, 0, j)
            rest = str_substring(s, j + 1, str_len(s) - j - 1)
        end
        if (str_len(line) > 0):
            var fname = meta_field(line, 0)
            if (str_eq(ns_of(fname), ns_b)):
                var nm = ns_name(fname)
                var new_key = ns_key(ns_a, nm)
                var old_path = ns_path(fname)
                # 移动文件数据
                var content = file_read(old_path)
                if (str_len(content) > 0):
                    var new_path = ns_path(new_key)
                    ns_ensure_dir(ns_a, nm)
                    file_write_bytes(new_path, content)
                    file_delete(old_path)
                end
                # 移动分支数据
                var old_bd = ns_branch_dir(fname)
                var b0 = file_read(str_concat(old_bd, "/b0"))
                var b1 = file_read(str_concat(old_bd, "/b1"))
                if (str_len(b0) > 0 or str_len(b1) > 0):
                    var new_bd = ns_branch_dir(new_key)
                    ns_ensure_dir(ns_a, nm)
                    mkdir(new_bd)
                    file_write_bytes(str_concat(new_bd, "/b0"), b0)
                    file_write_bytes(str_concat(new_bd, "/b1"), b1)
                end
                # 更新元数据: ns_b:name → ns_a:name
                var state = meta_field(line, 1)
                var partner = meta_field(line, 2)
                if (str_len(partner) > 0):
                    # 更新纠缠伙伴的引用
                    var p_line = meta_find(partner)
                    if (str_len(p_line) > 0):
                        var p_state = meta_field(p_line, 1)
                        var p_partner = meta_field(p_line, 2)
                        var p_collapsed = meta_field(p_line, 3)
                        var p_owner = meta_field(p_line, 4)
                        meta_set(partner, p_state, new_key, p_collapsed, p_owner)
                    end
                end
                var collapsed = meta_field(line, 3)
                meta_remove(fname)
                meta_set(new_key, state, partner, collapsed, ns_a)
                out = str_concat(out, str_concat(fname, " -> "), str_concat(new_key, "\n"))
            end
        end
        s = rest
    end
    # 删除源命名空间目录
    var ns_b_dir = str_concat(str_concat(g_root, "/ns/"), ns_b)
    file_delete(str_concat(ns_b_dir, "/meta"))
    var delout = str_concat("合并完成: ", str_concat(ns_b, " -> "), ns_a)
    if (str_len(out) == 0):
        return str_concat(delout, " (无文件)")
    end
    return str_concat(delout, "\n", out)
end

# 分离一个命名空间为两个: 按文件名前缀分离
# ns_a 中文件名以 prefix 开头的文件移动到新的 ns_b
def qdfs_ns_split(ns_a, ns_b, prefix):
    var out = ""
    var s = g_meta
    while (str_len(s) > 0):
        var j = str_index_of(s, "\n")
        var line = s
        var rest = ""
        if (j >= 0):
            line = str_substring(s, 0, j)
            rest = str_substring(s, j + 1, str_len(s) - j - 1)
        end
        if (str_len(line) > 0):
            var fname = meta_field(line, 0)
            if (str_eq(ns_of(fname), ns_a)):
                var nm = ns_name(fname)
                # 检查前缀匹配
                var pfx = str_index_of(nm, prefix)
                if (pfx == 0):
                    var new_key = ns_key(ns_b, nm)
                    # 移动文件数据
                    var old_path = ns_path(fname)
                    var content = file_read(old_path)
                    if (str_len(content) > 0):
                        var new_path = ns_path(new_key)
                        ns_ensure_dir(ns_b, nm)
                        file_write_bytes(new_path, content)
                        file_delete(old_path)
                    end
                    # 移动分支
                    var old_bd = ns_branch_dir(fname)
                    var b0 = file_read(str_concat(old_bd, "/b0"))
                    var b1 = file_read(str_concat(old_bd, "/b1"))
                    if (str_len(b0) > 0 or str_len(b1) > 0):
                        var new_bd = ns_branch_dir(new_key)
                        ns_ensure_dir(ns_b, nm)
                        mkdir(new_bd)
                        file_write_bytes(str_concat(new_bd, "/b0"), b0)
                        file_write_bytes(str_concat(new_bd, "/b1"), b1)
                    end
                    var state = meta_field(line, 1)
                    var partner = meta_field(line, 2)
                    var collapsed = meta_field(line, 3)
                    meta_remove(fname)
                    meta_set(new_key, state, partner, collapsed, ns_b)
                    out = str_concat(out, str_concat(fname, " -> "), str_concat(new_key, "\n"))
                end
            end
        end
        s = rest
    end
    if (str_len(out) == 0):
        return str_concat("分离: ", str_concat(ns_a, " 中无匹配 '"), str_concat(prefix, "' 的文件"))
    end
    return str_concat(str_concat("分离完成: ", ns_a), " -> ", str_concat(ns_b, "\n"), out)
end

# ---- 每个应用独立拥有QDFS实例 ----

# 创建新的QDFS实例（每个应用独立拥有自己的QDFS）
# 返回应用实例的根路径
def qdfs_instance_create(root_base, app_name):
    mkdir(root_base)
    var app_root = str_concat(str_concat(root_base, "/"), app_name)
    qdfs_init(app_root)
    return app_root
end

# 获取当前QDFS状态的快照
def qdfs_status():
    var out = str_concat("QDFS根目录: ", g_root)
    out = str_concat(out, "\n")
    var s = g_meta
    var total = 0
    var ns_map = ""
    while (str_len(s) > 0):
        var j = str_index_of(s, "\n")
        var line = s
        var rest = ""
        if (j >= 0):
            line = str_substring(s, 0, j)
            rest = str_substring(s, j + 1, str_len(s) - j - 1)
        end
        if (str_len(line) > 0):
            total = total + 1
        end
        s = rest
    end
    out = str_concat(out, str_concat("总文件数: ", int_to_str(total)))
    return out
end