# ================================================================
# lib/core.qentl — QEntL标准库核心
# 纯QEntL实现，不依赖任何第三方
# 测试覆盖全部函数
# ================================================================

# ---- 数值 ----
def max(a, b):
    if (a > b): return a end
    return b
end

def min(a, b):
    if (a < b): return a end
    return b
end

def abs_val(x):
    if (x < 0): return 0 - x end
    return x
end

def pow_int(base, exp):
    var r = 1
    var i = 0
    while (i < exp):
        r = r * base
        i = i + 1
    end
    return r
end

def gcd(a, b):
    while (b != 0):
        var t = a % b
        a = b
        b = t
    end
    return a
end

def lcm(a, b):
    return a / gcd(a, b) * b
end

def is_prime(n):
    if (n < 2): return 0 end
    if (n == 2): return 1 end
    if (n % 2 == 0): return 0 end
    var i = 3
    while (i * i <= n):
        if (n % i == 0): return 0 end
        i = i + 2
    end
    return 1
end

def fib_nth(n):
    if (n <= 1): return n end
    var a = 0
    var b = 1
    var i = 2
    while (i <= n):
        var t = a + b
        a = b
        b = t
        i = i + 1
    end
    return b
end

def factorial(n):
    var r = 1
    var i = 2
    while (i <= n):
        r = r * i
        i = i + 1
    end
    return r
end

# ---- 字符串扩展 ----
def str_reverse(s):
    var r = ""
    var i = str_len(s) - 1
    while (i >= 0):
        r = str_concat(r, str_char_at(s, i))
        i = i - 1
    end
    return r
end

def str_upper(s):
    var r = ""
    var i = 0
    while (i < str_len(s)):
        var c = ord(str_char_at(s, i))
        if (c >= 97 and c <= 122): c = c - 32 end
        r = str_concat(r, chr(c))
        i = i + 1
    end
    return r
end

def str_lower(s):
    var r = ""
    var i = 0
    while (i < str_len(s)):
        var c = ord(str_char_at(s, i))
        if (c >= 65 and c <= 90): c = c + 32 end
        r = str_concat(r, chr(c))
        i = i + 1
    end
    return r
end

def str_repeat(s, n):
    var r = ""
    var i = 0
    while (i < n):
        r = str_concat(r, s)
        i = i + 1
    end
    return r
end

def str_starts_with(s, prefix):
    if (str_len(prefix) > str_len(s)): return 0 end
    return str_eq(str_substring(s, 0, str_len(prefix)), prefix)
end

def str_ends_with(s, suffix):
    var sl = str_len(s)
    var pl = str_len(suffix)
    if (pl > sl): return 0 end
    return str_eq(str_substring(s, sl - pl, pl), suffix)
end

def str_count(s, needle):
    var count = 0
    var i = 0
    var nl = str_len(needle)
    if (nl == 0): return 0 end
    while (i <= str_len(s) - nl):
        if (str_eq(str_substring(s, i, nl), needle)):
            count = count + 1
            i = i + nl
        else:
            i = i + 1
        end
    end
    return count
end

def str_replace_all(s, old, new):
    var r = ""
    var i = 0
    var ol = str_len(old)
    var sl = str_len(s)
    if (ol == 0): return s end
    while (i < sl):
        if (i + ol <= sl and str_eq(str_substring(s, i, ol), old)):
            r = str_concat(r, new)
            i = i + ol
        else:
            r = str_concat(r, str_char_at(s, i))
            i = i + 1
        end
    end
    return r
end

# ---- 数组工具（操作整数数组） ----
def arr_sum(arr, n):
    var s = 0
    var i = 0
    while (i < n):
        s = s + arr[i]
        i = i + 1
    end
    return s
end

def arr_max(arr, n):
    var m = arr[0]
    var i = 1
    while (i < n):
        if (arr[i] > m): m = arr[i] end
        i = i + 1
    end
    return m
end

def arr_min(arr, n):
    var m = arr[0]
    var i = 1
    while (i < n):
        if (arr[i] < m): m = arr[i] end
        i = i + 1
    end
    return m
end

def arr_fill(arr, n, v):
    var i = 0
    while (i < n):
        arr[i] = v
        i = i + 1
    end
end

def arr_iota(arr, n):
    var i = 0
    while (i < n):
        arr[i] = i
        i = i + 1
    end
end

# ---- 排序（冒泡，整数） ----
def arr_sort_asc(arr, n):
    var i = 0
    while (i < n - 1):
        var j = 0
        while (j < n - 1 - i):
            if (arr[j] > arr[j + 1]):
                var t = arr[j]
                arr[j] = arr[j + 1]
                arr[j + 1] = t
            end
            j = j + 1
        end
        i = i + 1
    end
end

def arr_sort_desc(arr, n):
    var i = 0
    while (i < n - 1):
        var j = 0
        while (j < n - 1 - i):
            if (arr[j] < arr[j + 1]):
                var t = arr[j]
                arr[j] = arr[j + 1]
                arr[j + 1] = t
            end
            j = j + 1
        end
        i = i + 1
    end
end

def arr_binary_search(arr, n, target):
    var lo = 0
    var hi = n - 1
    while (lo <= hi):
        var mid = (lo + hi) / 2
        if (arr[mid] == target): return mid end
        if (arr[mid] < target):
            lo = mid + 1
        else:
            hi = mid - 1
        end
    end
    return -1
end

# ================================================================
# 测试
# ================================================================
printf("=== lib/core.qentl 测试 ===\n")

# 数值
printf("max(3,7)=%d min(3,7)=%d abs(-5)=%d\n", max(3, 7), min(3, 7), abs_val(-5))
printf("pow(2,10)=%d gcd(48,18)=%d lcm(4,6)=%d\n", pow_int(2, 10), gcd(48, 18), lcm(4, 6))
printf("is_prime(97)=%d is_prime(100)=%d\n", is_prime(97), is_prime(100))
printf("fib(20)=%d fact(10)=%d\n", fib_nth(20), factorial(10))

# 字符串
printf("reverse=%s\n", str_reverse("QEntL"))
printf("upper=%s lower=%s\n", str_upper("hello"), str_lower("WORLD"))
printf("repeat=%s\n", str_repeat("ab", 3))
printf("starts=%d ends=%d\n", str_starts_with("quantum", "quant"), str_ends_with("quantum", "tum"))
printf("count=%d replace=%s\n", str_count("banana", "an"), str_replace_all("aaa", "a", "bb"))

# 数组
var arr[8]
arr_iota(arr, 8)
printf("iota sum=%d max=%d min=%d\n", arr_sum(arr, 8), arr_max(arr, 8), arr_min(arr, 8))
arr_fill(arr, 8, 42)
printf("fill sum=%d\n", arr_sum(arr, 8))

# 排序+二分查找
var sarr[10]
var i = 0
while (i < 10):
    sarr[i] = (i * 7 + 3) % 10
    i = i + 1
end
arr_sort_asc(sarr, 10)
printf("sorted=[")
i = 0
while (i < 10):
    printf("%d", sarr[i])
    if (i < 9): printf(",") end
    i = i + 1
end
printf("]\n")
printf("bs(5)=%d bs(99)=%d\n", arr_binary_search(sarr, 10, 5), arr_binary_search(sarr, 10, 99))

printf("=== 全部测试完成 ===\n")
