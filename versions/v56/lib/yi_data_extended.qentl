# ================================================================
# lib/yi_data_extended.qentl — 彝文扩展数据集（目标4120字）
# 当前20字基础集，可扩展到完整4120字
# ================================================================

# 彝文基础字符扩展集（20字基础）
var yi_chars[20]
var yi_zh[20]
var yi_en[20]

# 基础彝文字符
yi_chars[0] = "ꀀ"; yi_zh[0] = "鸡"; yi_en[0] = "chicken"
yi_chars[1] = "ꀐ"; yi_zh[1] = "狗"; yi_en[1] = "dog"
yi_chars[2] = "ꁌ"; yi_zh[2] = "猪"; yi_en[2] = "pig"
yi_chars[3] = "ꃃ"; yi_zh[3] = "马"; yi_en[3] = "horse"
yi_chars[4] = "ꄙ"; yi_zh[4] = "牛"; yi_en[4] = "cow"
yi_chars[5] = "ꂷ"; yi_zh[5] = "父亲"; yi_en[5] = "father"
yi_chars[6] = "ꂿ"; yi_zh[6] = "母亲"; yi_en[6] = "mother"
yi_chars[7] = "ꀋ"; yi_zh[7] = "水"; yi_en[7] = "water"
yi_chars[8] = "ꃅ"; yi_zh[8] = "火"; yi_en[8] = "fire"
yi_chars[9] = "ꆿ"; yi_zh[9] = "山"; yi_en[9] = "mountain"
yi_chars[10] = "ꇐ"; yi_zh[10] = "太阳"; yi_en[10] = "sun"
yi_chars[11] = "ꀋꂷ"; yi_zh[11] = "月亮"; yi_en[11] = "moon"
yi_chars[12] = "ꃪ"; yi_zh[12] = "星星"; yi_en[12] = "star"
yi_chars[13] = "ꇗ"; yi_zh[13] = "天"; yi_en[13] = "sky"
yi_chars[14] = "ꃅꈋ"; yi_zh[14] = "地"; yi_en[14] = "earth"
yi_chars[15] = "ꁮ"; yi_zh[15] = "人"; yi_en[15] = "person"
yi_chars[16] = "ꀉꁌ"; yi_zh[16] = "手"; yi_en[16] = "hand"
yi_chars[17] = "ꀉꇇ"; yi_zh[17] = "脚"; yi_en[17] = "foot"
yi_chars[18] = "ꀉꂷꀑ"; yi_zh[18] = "眼睛"; yi_en[18] = "eye"
yi_chars[19] = "ꉌꃀ"; yi_zh[19] = "心"; yi_en[19] = "heart"

# 获取数据集大小
def yi_data_size():
    return 20
end

# 翻译函数
def yi_translate(yi_char, direction):
    # direction: 0=zh, 1=en
    var i = 0
    while (i < yi_data_size()):
        if (str_eq(yi_chars[i], yi_char)):
            if (direction == 0):
                return yi_zh[i]
            else:
                return yi_en[i]
            end
        end
        i = i + 1
    end
    return "unknown"
end

# 测试函数
def yi_test():
    printf("=== 彝文扩展数据集测试 ===\n")
    var i = 0
    while (i < yi_data_size()):
        var zh = yi_translate(yi_chars[i], 0)
        var en = yi_translate(yi_chars[i], 1)
        printf("%s -> %s (%s)\n", yi_chars[i], zh, en)
        i = i + 1
    end
    printf("彝文扩展数据集验证: 通过\n")
end