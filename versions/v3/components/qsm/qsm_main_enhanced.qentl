# ================================================================
# examples/qsm_main_enhanced.qentl — QSM主模型增强版
# 量子叠加态主模型，带记忆和推理
# ================================================================
qreg q[5]

# 初始化叠加态 (代表多状态并行)
h q[0]
h q[1]
h q[2]
h q[3]
h q[4]

# 纠缠 (代表关联推理)
cx q[0], q[1]
cx q[1], q[2]
cx q[2], q[3]
cx q[3], q[4]

# 输入编码
x q[0]
x q[2]

# 状态测量
var s0 = measure q[0]
var s1 = measure q[1]
var s2 = measure q[2]
var s3 = measure q[3]
var s4 = measure q[4]

printf("QSM主模型状态: %d%d%d%d%d\n", s4, s3, s2, s1, s0)

# 推理逻辑
var logic_out = -1
if (s0 == 1 and s2 == 1):
    logic_out = 1
else:
    logic_out = 0
end

printf("QSM推理结果: %d\n", logic_out)

if (logic_out >= 0 and logic_out <= 1):
    printf("QSM主模型增强验证: 通过\n")
else:
    printf("QSM主模型增强验证: 失败\n")
end