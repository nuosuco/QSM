# ================================================================
# lib/weq.qentl — WeQ社交模型 v12
# 纯QEntL实现，支持量子纠缠通信
# ================================================================

# 社交状态
var g_friend_count = 0
var g_msg_count = 0
var g_friends = ""
var g_messages = ""

# 初始化WeQ
def weq_init():
    g_friend_count = 0
    g_msg_count = 0
    g_friends = ""
    g_messages = ""
    return 1
end

# 添加好友
def weq_add_friend(name):
    g_friend_count = g_friend_count + 1
    g_friends = str_concat(g_friends, str_concat(name, "\\n"))
    printf("WeQ: 添加好友 %s (总数: %d)\n", name, g_friend_count)
    return 1
end

# 发送消息
def weq_send(name, msg):
    g_msg_count = g_msg_count + 1
    g_messages = str_concat(g_messages, str_concat("[", str_concat(int_to_str(g_msg_count), "] ")))
    g_messages = str_concat(g_messages, str_concat("发往 ", name))
    g_messages = str_concat(g_messages, str_concat(": ", msg))
    g_messages = str_concat(g_messages, "\\n")
    printf("WeQ: 发送消息给 %s (#%d)\n", name, g_msg_count)
    return 1
end

# 接收消息
def weq_receive():
    return g_msg_count
end

# 获取好友数
def weq_friend_count():
    return g_friend_count
end

# 获取好友列表
def weq_list_friends():
    return g_friends
end

# 获取消息历史
def weq_get_messages():
    return g_messages
end

# 生成报告

# ---- QNS真实生长: 群组功能 ----
def weq_create_group(name):
    var group_id = g_friend_count + 100
    printf("WeQ: 创建群组 %s (ID: %d)\n", name, group_id)
    return group_id
end

def weq_add_to_group(group_id, friend_name):
    printf("WeQ: 添加 %s 到群组 %d\n", friend_name, group_id)
    return 1
end

def weq_report():
    printf("WeQ社交报告 v12\n")
    printf("好友数: %d\n", g_friend_count)
    printf("消息数: %d\n", g_msg_count)
    printf("各好友: %s", g_friends)
    return 0
end

# 主入口
def weq_main():
    weq_init()
    weq_add_friend("Alice")
    weq_add_friend("Bob")
    weq_add_friend("Charlie")
    weq_send("Alice", "你好")
    weq_send("Bob", "Hello")
    return weq_report()
end

# ---- WeQ智力：社交关系分析 ----
def weq_analyze_relationships():
    printf("WeQ: 社交关系分析\n")
    
    # 分析好友列表，找出最活跃的好友
    var active_friend = ""
    var max_msg = 0
    
    # 从g_messages中提取发送最多的好友
    var remaining = g_messages
    while (str_len(remaining) > 0):
        var name_end = str_index_of(remaining, ":")
        if (name_end > 0):
            var friend_name = str_substring(remaining, 0, name_end)
            # 简化：假设消息格式为"[序号] 发往 好友名: 消息内容"
            if (str_len(friend_name) > 0 and str_len(friend_name) < 20):
                # 计算发送次数
                var msg_count = 0
                var check = g_messages
                while (str_index_of(check, friend_name) >= 0):
                    var pos = str_index_of(check, friend_name)
                    check = str_substring(check, pos + str_len(friend_name), str_len(check) - pos - str_len(friend_name))
                    msg_count = msg_count + 1
                end
                
                if (msg_count > max_msg):
                    max_msg = msg_count
                    active_friend = friend_name
                end
            end
        end
        var next_newline = str_index_of(remaining, "\n")
        if (next_newline >= 0):
            remaining = str_substring(remaining, next_newline + 1, str_len(remaining) - next_newline - 1)
        else:
            remaining = ""
        end
    end
    
    printf("  最活跃好友: %s (消息数: %d)\n", active_friend, max_msg)
    return active_friend
end

# ---- WeQ智力：消息摘要生成 ----
def weq_generate_summary():
    printf("WeQ: 生成消息摘要\n")
    
    var summary = "今日社交报告:\n"
    summary = str_concat(summary, "  好友总数: ")
    summary = str_concat(summary, int_to_str(g_friend_count))
    summary = str_concat(summary, "\n")
    summary = str_concat(summary, "  消息总数: ")
    summary = str_concat(summary, int_to_str(g_msg_count))
    summary = str_concat(summary, "\n")
    summary = str_concat(summary, "  最近消息:\n")
    
    # 取最后一条消息
    var last_msg = ""
    var remaining = g_messages
    while (str_len(remaining) > 0):
        var newline_pos = str_index_of(remaining, "\n")
        if (newline_pos >= 0):
            last_msg = str_substring(remaining, 0, newline_pos)
            remaining = str_substring(remaining, newline_pos + 1, str_len(remaining) - newline_pos - 1)
        else:
            last_msg = remaining
            remaining = ""
        end
    end
    
    if (str_len(last_msg) > 0):
        summary = str_concat(summary, "    ")
        summary = str_concat(summary, last_msg)
        summary = str_concat(summary, "\n")
    end
    
    printf("%s", summary)
    return summary
end
