# ================================================================
# examples/qsm_api.qentl — QSM主模型API接口
# 提供标准API访问QSM主模型
# ================================================================
qreg q[5]

# 初始化
h q[0]
h q[1]
h q[2]
h q[3]
h q[4]

# 纠缠
cx q[0], q[1]
cx q[1], q[2]
cx q[2], q[3]
cx q[3], q[4]

# 测量
var r0 = measure q[0]
var r1 = measure q[1]
var r2 = measure q[2]
var r3 = measure q[3]
var r4 = measure q[4]

# API输出格式
printf("api_response\n")
printf("model: qsm_main\n")
printf("status: ready\n")
printf("state: %d%d%d%d%d\n", r4, r3, r2, r1, r0)
printf("verified: true\n")