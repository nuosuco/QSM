# ================================================================
# examples/qteleport_remote.qentl — 远程量子隐形传态
# 展示跨节点量子信息传输
# ================================================================
qreg q[3]
# 发送端准备纠缠对
h q[0]
cx q[0], q[1]
# 发送端进行贝尔测量
cx q[1], q[2]
h q[1]
# 测量
var m0 = measure q[0]
var m1 = measure q[1]
var m2 = measure q[2]
printf("远程隐形传态: %d %d %d\n", m0, m1, m2)
# 验证纠缠特性
if (m0 == m1 or m1 == m2):
    printf("远程隐形传态验证: 通过\n")
else:
    printf("远程隐形传态验证: 失败\n")
end