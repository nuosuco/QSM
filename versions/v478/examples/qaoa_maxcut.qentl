# ================================================================
# 量子近似优化算法(QAOA) — 最大割问题(Max-Cut)
# 变分量子算法求解组合优化
# ================================================================

printf("=== QAOA: 最大割问题 ===\n\n")
printf("问题: 4节点图, 分割节点使跨割边数最大\n")
printf("图: 三角形(节点0-1,1-2,2-0) + 3-0\n\n")

# QAOA核心: 制备叠加态, 应用问题哈密顿量+混合器
# MaxCut: H_C = sum Z_i Z_j, 最大化跨割边
# 2比特示例: 边(0,1), 边(1,2)

# 演示QAOA电路: 用变分参数p=1
# 应用相位分离(ZZ) + 混合器(XX)

printf("QAOA电路 (p=1, 2比特):\n")
printf("  1. 初始化: H⊗H 叠加态\n")
printf("  2. 问题哈密顿量: ZZ(边权重)\n")
printf("  3. 混合器: XX(横向场)\n\n")

# 实现QAOA一层
var q = qreg_create(2)

# 1. 初始化叠加
h q[0]
h q[1]

# 2. 相位分离层: 应用CZ (等效ZZ)
# 边(0,1): 用CZ模拟ZZ
cz q[0], q[1]

# 3. 混合器层: 应用X旋转
# 用H+CZ+H模拟XX
h q[0]
h q[1]
cz q[0], q[1]
h q[0]
h q[1]

# 测量
var m0 = measure(q, 0)
var m1 = measure(q, 1)
printf("QAOA输出: q0=%d, q1=%d\n", m0, m1)

# 计算MaxCut值
var cut = 0
if (m0 != m1): cut = cut + 1 end
printf("跨割边数: %d\n", cut)

printf("\n最优解: 分割{0,2}|{1,3} 或 {0,1}|{2,3}\n")
printf("跨割边=2 (最大)\n\n")

# 多次运行统计
printf("--- 20次运行统计 ---\n")
var best = 0
var i = 0
while (i < 20):
    var q2 = qreg_create(2)
    h q2[0]
    h q2[1]
    cz q2[0], q2[1]
    h q2[0]
    h q2[1]
    cz q2[0], q2[1]
    h q2[0]
    h q2[1]
    var a = measure(q2, 0)
    var b = measure(q2, 1)
    var c = 0
    if (a != b): c = 1 end
    if (c > best): best = c end
    qreg_free(q2)
    i = i + 1
end

printf("20次运行最大跨割: %d\n", best)
printf("QAOA演示: 完成\n")

printf("\n=== QAOA最大割演示完成 ===\n")