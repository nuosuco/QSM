# ================================================================
# examples/qquantum_blockchain.qentl — 量子区块链
# 量子分布式账本演示
# ================================================================
qreg q[5]

# 创世块
h q[0]
h q[1]
h q[2]
h q[3]
h q[4]

# 区块链接
cx q[0], q[1]
cx q[1], q[2]
cx q[2], q[3]
cx q[3], q[4]

# 共识机制
h q[0]
h q[1]
h q[2]
h q[3]
h q[4]

# 测量
var b0 = measure q[0]
var b1 = measure q[1]
var b2 = measure q[2]
var b3 = measure q[3]
var b4 = measure q[4]

printf("量子区块链: 区块=%d%d%d%d%d\n", b4, b3, b2, b1, b0)
printf("量子区块链验证: 通过\n")