# ================================================================
# examples/ghz.qentl — GHZ态演示
# GHZ态: (|000> + |111>) / sqrt(2)
# 展示量子纠缠的非经典关联
# ================================================================
qreg q[3]
# 创建GHZ态
h q[0]
cx q[0], q[1]
cx q[0], q[2]
# 测量
var m0 = measure q[0]
var m1 = measure q[1]
var m2 = measure q[2]
printf("GHZ态测量: %d %d %d\n", m0, m1, m2)
# GHZ态特性: 所有测量结果相同（要么全是0，要么全是1）
if (m0 == m1 and m1 == m2):
    printf("GHZ纠缠验证: 通过 (三个量子位完全关联)\n")
else:
    printf("GHZ纠缠验证: 失败\n")
end
