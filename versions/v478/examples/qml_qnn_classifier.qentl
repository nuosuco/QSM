# ================================================================
# examples/qml_qnn_classifier.qentl — 量子神经网络分类器
# ================================================================

qreg q[4]

# 输入层
h q[0]
h q[1]

# 隐藏层
h q[2]
h q[3]

# 连接
cx q[0], q[2]
cx q[1], q[3]

# 测量
var i0 = measure q[0]
var i1 = measure q[1]
var o0 = measure q[2]
var o1 = measure q[3]

printf("QNN分类: input=%d%d output=%d%d\n", i0, i1, o0, o1)

# 验证
var input_valid = (i0 >= 0 and i0 <= 1 and i1 >= 0 and i1 <= 1)
var output_valid = (o0 >= 0 and o0 <= 1 and o1 >= 0 and o1 <= 1)

if (input_valid and output_valid):
    printf("量子神经网络分类器验证: 通过\n")
else:
    printf("量子神经网络分类器验证: 失败\n")
end
