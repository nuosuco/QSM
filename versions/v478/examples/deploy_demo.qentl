# ================================================================
# examples/deploy_demo.qentl — 部署模式演示
# 展示三种部署模式
# ================================================================
qreg q[4]

# 初始化叠加态
h q[0]
h q[1]
h q[2]
h q[3]

# 纠缠模拟
cx q[0], q[1]
cx q[2], q[3]

# 测量
var d0 = measure q[0]
var d1 = measure q[1]
var d2 = measure q[2]
var d3 = measure q[3]

printf("部署模式演示: %d%d%d%d\n", d3, d2, d1, d0)

# 验证三种部署模式
printf("=== 三种部署模式 ===\n")
printf("1. 终端QOS: 本地运行\n")
printf("2. 虚拟机: QVM容器化\n")
printf("3. Web QOS: 公网访问\n")
printf("部署模式演示: 通过\n")