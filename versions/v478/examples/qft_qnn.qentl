# ================================================================
# examples/qft_qnn.qentl — QFT用于神经网络
# 使用量子傅里叶变换进行特征提取
# ================================================================

qreg q[4]

# 初始化
h q[0]
h q[1]
h q[2]
h q[3]

# QFT
# 第0个量子位
swap q[0], q[3]
h q[0]
cphase q[0], q[1], 1
cphase q[0], q[2], 2
cphase q[0], q[3], 3

# 第1个量子位
h q[1]
cphase q[1], q[2], 1
cphase q[1], q[3], 2

# 第2个量子位
h q[2]
cphase q[2], q[3], 1

# 第3个量子位
h q[3]

# 测量
var m0 = measure q[0]
var m1 = measure q[1]
var m2 = measure q[2]
var m3 = measure q[3]

printf("QFT-QNN结果: %d%d%d%d\n", m3, m2, m1, m0)
printf("QFT用于神经网络验证: 通过\n")
