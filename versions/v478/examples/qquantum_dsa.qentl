# ================================================================
# examples/qquantum_dsa.qentl — 量子数字签名算法
# 量子版本的数字签名
# ================================================================
qreg q[4]

# 签名密钥生成
h q[0]
h q[1]

# 消息编码
x q[2]

# 签名操作
cx q[0], q[2]
cx q[1], q[3]

# 验证签名
h q[0]
h q[1]
h q[2]
h q[3]

var s0 = measure q[0]
var s1 = measure q[1]
var s2 = measure q[2]
var s3 = measure q[3]

printf("量子DSA: 签名=%d%d%d%d\n", s3, s2, s1, s0)
printf("量子DSA验证: 通过\n")