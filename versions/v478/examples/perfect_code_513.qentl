# ================================================================
# 3比特比特翻转码 (对齐已验证实现)
# 逻辑态 |0>L=|000>, |1>L=|111>
# 测量后直接多数表决, 不重复测量
# ================================================================

printf("=== 3比特比特翻转码 ===\n\n")
printf("逻辑态: |0>_L = |000>, |1>_L = |111>\n")
printf("可纠正: 任意单比特X错误\n\n")

# 一轮完整实验
def one_round(b, err_pos):
    var r = qreg_create(3)
    
    # 编码
    if (b == 1):
        x r[0]
    end
    cx r[0], r[1]
    cx r[0], r[2]
    
    # 注错
    if (err_pos == 0): x r[0] end
    if (err_pos == 1): x r[1] end
    if (err_pos == 2): x r[2] end
    
    # 综合征测量 (一次测量)
    var m0 = measure(r, 0)
    var m1 = measure(r, 1)
    var m2 = measure(r, 2)
    
    # 多数表决: 3比特中取多数值
    var ones = m0 + m1 + m2
    var recovered = 0
    if (ones >= 2): recovered = 1 end
    
    qreg_free(r)
    if (recovered == b): return 1 end
    return 0
end

# 全量测试: 2逻辑态 × 4错误位置 × 20轮 = 160次
var total = 0
var ok = 0
var b = 0
while (b <= 1):
    var err = 0 - 1
    while (err <= 2):
        var round = 0
        while (round < 20):
            total = total + 1
            if (one_round(b, err) == 1):
                ok = ok + 1
            end
            round = round + 1
        end
        err = err + 1
    end
    b = b + 1
end

printf("测试矩阵: 2逻辑态 x 4错误位置 x 20轮 = %d 次\n", total)
printf("纠错成功: %d/%d\n", ok, total)
if (ok == total):
    printf("3比特码纠错: 通过 ✅ (单比特翻转全部纠正)\n")
else:
    printf("3比特码纠错: 失败 (%d次未纠正)\n", total - ok)
end

printf("\n=== 演示完成 ===\n")