# ================================================================
# examples/qft6.qentl — 6量子位量子傅里叶变换 (规模化测试)
# 验证相位门电路在大规模量子位下的正确性
# QFT ∘ QFT† = I: 准备|x>, QFT, 逆QFT, 必须回到|x>
# 测试态: x = 37 = 100101 (二进制)
# ================================================================

qreg q[6]

# ---- 准备 |37> = |100101>: q0,q3,q5置1 ----
x q[0]
x q[3]
x q[5]

# ---- QFT(6) ----
h q[0]
cphase q[0], q[1], 1
cphase q[0], q[2], 2
cphase q[0], q[3], 3
cphase q[0], q[4], 4
cphase q[0], q[5], 5
h q[1]
cphase q[1], q[2], 1
cphase q[1], q[3], 2
cphase q[1], q[4], 3
cphase q[1], q[5], 4
h q[2]
cphase q[2], q[3], 1
cphase q[2], q[4], 2
cphase q[2], q[5], 3
h q[3]
cphase q[3], q[4], 1
cphase q[3], q[5], 2
h q[4]
cphase q[4], q[5], 1
h q[5]
# 位反转: q0<->q5, q1<->q4, q2<->q3
cx q[0], q[5]
cx q[5], q[0]
cx q[0], q[5]
cx q[1], q[4]
cx q[4], q[1]
cx q[1], q[4]
cx q[2], q[3]
cx q[3], q[2]
cx q[2], q[3]

# ---- 逆QFT(6): 门序反转+共轭 ----
cx q[2], q[3]
cx q[3], q[2]
cx q[2], q[3]
cx q[1], q[4]
cx q[4], q[1]
cx q[1], q[4]
cx q[0], q[5]
cx q[5], q[0]
cx q[0], q[5]
h q[5]
icphase q[4], q[5], 1
h q[4]
icphase q[3], q[5], 2
icphase q[3], q[4], 1
h q[3]
icphase q[2], q[5], 3
icphase q[2], q[4], 2
icphase q[2], q[3], 1
h q[2]
icphase q[1], q[5], 4
icphase q[1], q[4], 3
icphase q[1], q[3], 2
icphase q[1], q[2], 1
h q[1]
icphase q[0], q[5], 5
icphase q[0], q[4], 4
icphase q[0], q[3], 3
icphase q[0], q[2], 2
icphase q[0], q[1], 1
h q[0]

# ---- 测量: 必须得到 100101 ----
var m0 = measure q[0]
var m1 = measure q[1]
var m2 = measure q[2]
var m3 = measure q[3]
var m4 = measure q[4]
var m5 = measure q[5]
printf("QFT6|37> -> QFT^-1 -> %d%d%d%d%d%d\n", m0, m1, m2, m3, m4, m5)
if (m0 == 1 and m1 == 0 and m2 == 0 and m3 == 1 and m4 == 0 and m5 == 1):
    printf("QFT6往返验证: 通过\n")
else:
    printf("QFT6往返验证: 失败\n")
end
