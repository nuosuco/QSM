# ================================================================
# 量子纠错码综合测试 — Syndrome提取演示
# 展示4种编码的 syndrome 测量过程
# ================================================================

printf("=== 量子纠错码 Syndrome 提取演示 ===\n\n")

# =====================================================================
# 测试1: 3比特比特翻转码
# =====================================================================
printf("--- 测试1: 3比特比特翻转码 ---\n")
printf("编码: |ψ>L = α|000> + β|111>\n")
printf("稳定子: Z1Z2, Z2Z3\n\n")

var q1 = qreg_create(3)
var anc1 = qreg_create(2)

apply_h(q1, 0)
apply_cx(q1, 0, 1)
apply_cx(q1, 0, 2)

apply_cx(q1, 0, anc1, 0)
apply_cx(q1, 1, anc1, 0)
var s1 = measure(anc1, 0)
printf("  Z1Z2 syndrome: %d\n", s1)

apply_cx(q1, 1, anc1, 1)
apply_cx(q1, 2, anc1, 1)
var s2 = measure(anc1, 1)
printf("  Z2Z3 syndrome: %d\n", s2)

apply_h(q1, 0)
var result = measure(q1, 0)
printf("  解码结果: %d\n\n", result)

# =====================================================================
# 测试2: 3比特相位翻转码  
# =====================================================================
printf("--- 测试2: 3比特相位翻转码 ---\n")
printf("编码: |0>L = |+++>, |1>L = |--- >\n")
printf("原理: X基测量检测Z错误\n\n")

var q2 = qreg_create(3)
var anc2 = qreg_create(2)

apply_h(q2, 0)
apply_h(q2, 1)
apply_h(q2, 2)

# 测量X基 syndrome
apply_h(q2, 0)
apply_h(q2, 1)
apply_cx(q2, 0, anc2, 0)
apply_cx(q2, 1, anc2, 0)
apply_h(q2, 0)
apply_h(q2, 1)
var s3 = measure(anc2, 0)
printf("  X基 syndrome (q0,q1): %d\n", s3)

apply_h(q2, 1)
apply_h(q2, 2)
apply_cx(q2, 1, anc2, 1)
apply_cx(q2, 2, anc2, 1)
apply_h(q2, 1)
apply_h(q2, 2)
var s4 = measure(anc2, 1)
printf("  X基 syndrome (q1,q2): %d\n", s4)

apply_h(q2, 0)
apply_h(q2, 1)
apply_h(q2, 2)
var result2 = measure(q2, 0)
printf("  解码结果: %d\n\n", result2)

# =====================================================================
# 测试3: 9比特Shor码
# =====================================================================
printf("--- 测试3: 9比特Shor码 ---\n")
printf("编码: |0>L = (|000>+|111>)(|000>+|111>)(|000>+|111>) / 2√2\n\n")

var q3 = qreg_create(9)
var anc3 = qreg_create(2)

apply_h(q3, 0)
apply_h(q3, 3)
apply_h(q3, 6)
apply_cx(q3, 0, 1)
apply_cx(q3, 0, 2)
apply_cx(q3, 3, 4)
apply_cx(q3, 3, 5)
apply_cx(q3, 6, 7)
apply_cx(q3, 6, 8)

apply_cx(q3, 0, anc3, 0)
apply_cx(q3, 1, anc3, 0)
apply_cx(q3, 3, anc3, 1)
apply_cx(q3, 4, anc3, 1)
apply_cx(q3, 6, anc3, 0)
apply_cx(q3, 7, anc3, 0)
var sx1 = measure(anc3, 0)
var sx2 = measure(anc3, 1)
printf("  X型稳定子: Z1Z2=%d, Z4Z5=%d, Z7Z8=%d\n", sx1, sx2, 0)

apply_h(q3, 0)
apply_h(q3, 1)
apply_h(q3, 2)
apply_h(q3, 3)
apply_h(q3, 4)
apply_h(q3, 5)
apply_h(q3, 6)
apply_h(q3, 7)
apply_h(q3, 8)

apply_cx(q3, 0, anc3, 0)
apply_cx(q3, 1, anc3, 0)
apply_cx(q3, 3, anc3, 1)
apply_cx(q3, 4, anc3, 1)
apply_cx(q3, 6, anc3, 0)
apply_cx(q3, 7, anc3, 0)
var sz1 = measure(anc3, 0)
var sz2 = measure(anc3, 1)
printf("  Z型稳定子: X1X2=%d, X4X5=%d, X7X8=%d\n", sz1, sz2, 0)

apply_h(q3, 0)
apply_h(q3, 1)
apply_h(q3, 2)
apply_h(q3, 3)
apply_h(q3, 4)
apply_h(q3, 5)
apply_h(q3, 6)
apply_h(q3, 7)
apply_h(q3, 8)

var result3 = measure(q3, 0)
printf("  解码结果: %d\n\n", result3)

# =====================================================================
# 测试4: 非破坏性验证
# =====================================================================
printf("--- 测试4: 非破坏性验证 ---\n")
printf("验证: Syndrome提取不坍缩数据量子位\n")

var q4 = qreg_create(3)
var anc4 = qreg_create(2)

apply_h(q4, 0)
apply_cx(q4, 0, 1)
apply_cx(q4, 0, 2)

apply_cx(q4, 0, anc4, 0)
apply_cx(q4, 1, anc4, 0)
apply_cx(q4, 1, anc4, 1)
apply_cx(q4, 2, anc4, 1)
var s4_1 = measure(anc4, 0)
var s4_2 = measure(anc4, 1)
printf("  Syndrome: %d %d (应为 0 0)\n", s4_1, s4_2)

var m0 = measure(q4, 0)
var m1 = measure(q4, 1)
var m2 = measure(q4, 2)
printf("  数据位测量: q0=%d, q1=%d, q2=%d\n", m0, m1, m2)
printf("  验证: 纠缠关系保持 (全部相同)\n\n")

printf("=== 量子纠错码测试完成 ===\n")
