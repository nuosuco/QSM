# ================================================================
# 量子状态层析 — 量子态完全表征
# 通过多角度测量重建量子态
# ================================================================

printf("=== 量子状态层析 ===\n\n")
printf("原理: 在不同基矢下测量, 重建量子态\n")
printf("单比特: 在X/Y/Z基下测量\n\n")

# 单比特状态层析
# 态: |+> = (|0>+|1>)/√2
# Z基: 50%|0>, 50%|1>
# X基: 100%|+> (H后测量全0)
# Y基: 50%|+>, 50%|-> (H+S后)

printf("目标态: |+> = (|0>+|1>)/√2\n\n")

# Z基测量
printf("--- Z基测量 ---\n")
var z0 = 0
var z1 = 0
var i = 0
while (i < 20):
    var q = qreg_create(1)
    h q[0]
    var m = measure(q, 0)
    if (m == 0): z0 = z0 + 1 end
    if (m == 1): z1 = z1 + 1 end
    qreg_free(q)
    i = i + 1
end
printf("  |0>: %d/20, |1>: %d/20\n", z0, z1)

# X基测量
printf("\n--- X基测量 ---\n")
var x0 = 0
var x1 = 0
i = 0
while (i < 20):
    var q = qreg_create(1)
    h q[0]
    h q[0]  # H后测量: X基
    var m = measure(q, 0)
    if (m == 0): x0 = x0 + 1 end
    if (m == 1): x1 = x1 + 1 end
    qreg_free(q)
    i = i + 1
end
printf("  |+>: %d/20, |->: %d/20\n", x0, x1)

# 重建密度矩阵
printf("\n--- 状态重建 ---\n")
printf("Z基: <Z> = %d\n", (z0 - z1) * 100 / 20)
printf("X基: <X> = %d\n", (x0 - x1) * 100 / 20)
printf("理论|+>: <Z>=0, <X>=1\n")

printf("\n=== 状态层析完成 ===\n")