# ================================================================
# QDFS深度建设 — 量子文件系统扩展功能
# 添加搜索、统计、版本控制等功能
# ================================================================
# 内联 QDFS 库（同 lib/qdfs.qentl）
var g_root = ""
var g_meta = ""

def meta_field(line, idx):
    var result = ""
    var field = 0
    var i = 0
    var n = str_len(line)
    while (i < n):
        var ch = str_char_at(line, i)
        if (str_eq(ch, "|")):
            field = field + 1
            if (field == idx):
                return result
            end
            result = ""
        else:
            result = str_concat(result, ch)
        end
        i = i + 1
    end
    return result
end

def meta_find(name):
    var s = str_concat("\n", g_meta)
    var key = str_concat(str_concat("\n", name), "|")
    var idx = str_index_of(s, key)
    if (idx < 0):
        return ""
    end
    var line_start = idx + str_len(key)
    var line_end = str_index_of(s, "\n", line_start)
    if (line_end < 0):
        line_end = str_len(s)
    end
    return str_substring(s, line_start, line_end - line_start)
end

def meta_remove(name):
    var line = meta_find(name)
    if (str_len(line) == 0):
        return
    end
    g_meta = str_replace(g_meta, str_concat("\n", line), "")
    file_write_bytes(str_concat(g_root, "/meta"), g_meta)
end

def meta_set(name, state, partner, collapsed, owner):
    meta_remove(name)
    var l1 = str_concat(name, "|")
    var l2 = str_concat(l1, state)
    var l3 = str_concat(l2, "|")
    var l4 = str_concat(l3, partner)
    var l5 = str_concat(l4, "|")
    var l6 = str_concat(l5, collapsed)
    var l7 = str_concat(l6, "|")
    var l8 = str_concat(l7, owner)
    g_meta = str_concat(g_meta, str_concat("\n", l8))
    file_write_bytes(str_concat(g_root, "/meta"), g_meta)
end

def meta_set_collapse(name, idx):
    var line = meta_find(name)
    if (str_len(line) == 0):
        return
    end
    var state = meta_field(line, 1)
    var partner = meta_field(line, 2)
    var owner = meta_field(line, 4)
    meta_set(name, state, partner, str_from_char(48 + idx), owner)
end

def qdfs_init(root):
    g_root = root
    mkdir(root)
    file_write_bytes(str_concat(root, "/meta"), "")
end

def qdfs_write(name, content):
    var path = str_concat(str_concat(str_concat(g_root, "/"), name), ".data")
    file_write_bytes(path, content)
    meta_set(name, "0", "", "0", "")
end

def qdfs_superpose(name, c0, c1):
    var bd = str_concat(str_concat(str_concat(g_root, "/branches/"), name), "/")
    mkdir(str_concat(str_concat(g_root, "/branches/"), name))
    file_write_bytes(str_concat(bd, "b0"), c0)
    file_write_bytes(str_concat(bd, "b1"), c1)
    meta_set(name, "1", "", "-1", name)
end

def qdfs_entangle(a, b, c0, c1):
    var bd = str_concat(str_concat(str_concat(g_root, "/branches/"), a), "/")
    mkdir(str_concat(str_concat(g_root, "/branches/"), a))
    file_write_bytes(str_concat(bd, "b0"), c0)
    file_write_bytes(str_concat(bd, "b1"), c1)
    meta_set(a, "2", b, "-1", a)
    meta_set(b, "2", a, "-1", a)
end

def qdfs_read(name):
    var line = meta_find(name)
    if (str_len(line) == 0):
        return ""
    end
    var state = meta_field(line, 1)
    if (str_eq(state, "0")):
        return file_read(str_concat(str_concat(str_concat(g_root, "/"), name), ".data"))
    end
    var collapsed = str_to_int(meta_field(line, 3))
    if (collapsed < 0):
        collapsed = rand_int(2)
        meta_set_collapse(name, collapsed)
        var partner = meta_field(line, 2)
        if (str_len(partner) > 0):
            meta_set_collapse(partner, collapsed)
        end
    end
    var owner = meta_field(line, 4)
    var bd = str_concat(str_concat(str_concat(g_root, "/branches/"), owner), "/")
    if (collapsed == 0):
        return file_read(str_concat(bd, "b0"))
    end
    return file_read(str_concat(bd, "b1"))
end

def qdfs_info(name):
    var line = meta_find(name)
    if (str_len(line) == 0):
        return str_concat(name, ": 不存在")
    end
    var state = meta_field(line, 1)
    var collapsed = meta_field(line, 3)
    if (str_eq(state, "0")):
        return str_concat(name, ": 经典态")
    end
    if (str_eq(state, "1")):
        if (str_eq(collapsed, "-1")):
            return str_concat(name, ": 叠加态(未观测)")
        end
        return str_concat(str_concat(name, ": 叠加态 已坍缩->"), str_concat(collapsed, "分支"))
    end
    var partner = meta_field(line, 2)
    if (str_eq(collapsed, "-1")):
        return str_concat(str_concat(str_concat(name, ": 纠缠<->"), partner), "(未观测)")
    end
    return str_concat(str_concat(str_concat(str_concat(name, ": 纠缠<->"), partner), " 已坍缩->"), collapsed)
end

def qdfs_ls():
    var out = ""
    var s = g_meta
    while (str_len(s) > 0):
        var j = str_index_of(s, "\n")
        if (j < 0):
            break
        end
        var line = str_substring(s, 1, j - 1)
        var name = meta_field(line, 0)
        var info = qdfs_info(name)
        out = str_concat(out, str_concat(info, "\n"))
        s = str_substring(s, j + 1, str_len(s) - j - 1)
    end
    return out
end

def qdfs_delete(name):
    var line = meta_find(name)
    if (str_len(line) == 0):
        return 0
    end
    file_delete(str_concat(str_concat(str_concat(g_root, "/"), name), ".data"))
    var bd = str_concat(str_concat(str_concat(g_root, "/branches/"), name), "/")
    file_delete(str_concat(bd, "b0"))
    file_delete(str_concat(bd, "b1"))
    meta_remove(name)
    return 1
end

# 新增功能: 搜索文件内容
def qdfs_search(keyword):
    var results = ""
    var count = 0
    var s = g_meta
    while (str_len(s) > 0):
        var j = str_index_of(s, "\n")
        if (j < 0):
            break
        end
        var line = str_substring(s, 1, j - 1)
        var name = meta_field(line, 0)
        var content = qdfs_read(name)
        var idx = str_index_of(content, keyword)
        if (idx >= 0):
            results = str_concat(results, str_concat(name, "\n"))
            count = count + 1
        end
        s = str_substring(s, j + 1, str_len(s) - j - 1)
    end
    var result = str_concat("找到 ", str_concat(int_to_str(count), str_concat(" 个文件包含 \"", str_concat(keyword, "\""))))
    if (count > 0):
        result = str_concat(result, str_concat("\n文件列表:\n", results))
    end
    return result
end

# 新增功能: 统计文件信息
def qdfs_stats():
    var class_count = 0
    var super_count = 0
    var ent_count = 0
    var s = g_meta
    while (str_len(s) > 0):
        var j = str_index_of(s, "\n")
        if (j < 0):
            break
        end
        var line = str_substring(s, 1, j - 1)
        var state = meta_field(line, 1)
        if (str_eq(state, "0")):
            class_count = class_count + 1
        else:
            if (str_eq(state, "1")):
                super_count = super_count + 1
            else:
                ent_count = ent_count + 1
            end
        end
        s = str_substring(s, j + 1, str_len(s) - j - 1)
    end
    return str_concat("总文件数: ", str_concat(int_to_str(class_count + super_count + ent_count), str_concat("\n  经典文件: ", str_concat(int_to_str(class_count), str_concat("\n  叠加态文件: ", str_concat(int_to_str(super_count), str_concat("\n  纠缠文件: ", int_to_str(ent_count))))))))
end

# 演示程序
printf("=== QDFS扩展功能演示 ===\n\n")

# 初始化
var root = "/tmp/qdfs_ext"
qdfs_init(root)

# 创建文件
printf("--- 创建文件 ---\n")
qdfs_write("量子计算", "量子计算是未来")
qdfs_write("经典计算", "经典计算是基础")
qdfs_write("混合计算", "量子经典混合")
qdfs_superpose("量子叠加", "分支A内容", "分支B内容")
qdfs_entangle("纠缠A", "纠缠B", "量子分支", "经典分支")

# 列出所有文件
printf("\n--- 文件列表 ---\n")
printf("%s\n", qdfs_ls())

# 搜索功能
printf("\n--- 搜索功能 ---\n")
printf("%s\n", qdfs_search("量子"))
printf("%s\n", qdfs_search("经典"))

# 统计功能
printf("\n--- 文件统计 ---\n")
printf("%s\n", qdfs_stats())

# 纠缠同步验证
printf("\n--- 纠缠同步验证 ---\n")
var read_a = qdfs_read("纠缠A")
printf("读取纠缠A: %s\n", read_a)
var read_b = qdfs_read("纠缠B")
printf("读取纠缠B: %s\n", read_b)
if (read_a == read_b):
    printf("纠缠同步验证: 通过\n")
else:
    printf("纠缠同步验证: 失败\n")
end

printf("\n=== QDFS扩展功能演示完成 ===\n")
