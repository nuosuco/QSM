# ================================================================
# 量子加法器增强 — 半加器+全加器
# sum = a XOR b (半加), sum = a XOR b XOR cin (全加)
# ================================================================

printf("=== 量子加法器增强 ===\n\n")

# 半加器: sum = a XOR b, carry = a AND b
printf("--- 半加器 ---\n")
printf("输入: 2比特, 输出: 和+进位\n\n")

var ha_ok = 0
var ha_total = 0
var a = 0
while (a <= 1):
    var b = 0
    while (b <= 1):
        var q = qreg_create(4)
        if (a == 1): x q[0] end
        if (b == 1): x q[1] end
        # sum = a XOR b: 两个CX到q[2]
        cx q[0], q[2]
        cx q[1], q[2]
        # carry = a AND b: Toffoli到q[3]
        ccx q[0], q[1], q[3]
        var sum = measure(q, 2)
        var carry = measure(q, 3)
        var expected_sum = 0
        if (a != b): expected_sum = 1 end
        var expected_carry = 0
        if (a == 1 and b == 1): expected_carry = 1 end
        ha_total = ha_total + 1
        var ok_str = "❌"
        if (sum == expected_sum and carry == expected_carry):
            ha_ok = ha_ok + 1
            ok_str = "✅"
        end
        printf("  %d+%d: sum=%d carry=%d %s\n", a, b, sum, carry, ok_str)
        qreg_free(q)
        b = b + 1
    end
    a = a + 1
end

printf("半加器: %d/%d 正确\n", ha_ok, ha_total)

# 全加器: sum = a XOR b XOR cin
# carry = majority(a,b,cin) = (a&b)|(b&cin)|(a&cin)
printf("\n--- 全加器 ---\n")
printf("输入: 3比特(a,b,cin), 输出: 和+进位\n\n")

var fa_ok = 0
var fa_total = 0
var p = 0
while (p <= 1):
    var q = 0
    while (q <= 1):
        var r = 0
        while (r <= 1):
            var qf = qreg_create(6)
            if (p == 1): x qf[0] end
            if (q == 1): x qf[1] end
            if (r == 1): x qf[2] end
            
            # sum: 三个CX到q[3] => q[3] = a XOR b XOR cin
            cx qf[0], qf[3]
            cx qf[1], qf[3]
            cx qf[2], qf[3]
            
            # carry_out = majority(a,b,cin) = a&b ^ b&cin ^ a&cin
            ccx qf[0], qf[1], qf[4]   # q4 = a&b
            ccx qf[1], qf[2], qf[4]   # q4 ^= b&cin
            ccx qf[0], qf[2], qf[4]   # q4 ^= a&cin
            # 简化: 只测sum和主要carry
            var s = measure(qf, 3)
            var c = measure(qf, 4)
            var expected_s = 0
            var bit_sum = p + q + r
            if (bit_sum == 1 or bit_sum == 3): expected_s = 1 end
            var expected_c = 0
            if (bit_sum >= 2): expected_c = 1 end
            
            var ok_str = "❌"
            fa_total = fa_total + 1
            if (s == expected_s and c == expected_c):
                fa_ok = fa_ok + 1
                ok_str = "✅"
            end
            printf("  %d+%d+%d: sum=%d carry=%d (期望%d,%d) %s\n", p, q, r, s, c, expected_s, expected_c, ok_str)
            qreg_free(qf)
            r = r + 1
        end
        q = q + 1
    end
    p = p + 1
end

printf("全加器: %d/%d 正确\n", fa_ok, fa_total)

printf("\n=== 量子加法器完成 ===\n")