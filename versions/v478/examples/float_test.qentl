# ================================================================
# float_test.qentl — 浮点(定点)字面量测试
# 定点数方案: scale=1000, 3.14 -> 3140
# ================================================================
var a = 3.14
var b = 2.5
var c = a + b
printf("3.14 + 2.5 = %d (定点内部值, 应为5640)\n", c)
var d = 1.0
printf("1.0 = %d (应为1000)\n", d)
var e = 0.5
printf("0.5 = %d (应为500)\n", e)
printf("浮点字面量测试: 通过\n")