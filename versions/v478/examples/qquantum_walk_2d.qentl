# ================================================================
# examples/qquantum_walk_2d.qentl — 二维量子行走
# 2D格子上的连续时间量子行走
# ================================================================
qreg q[4]

# 位置编码 (2x2格子)
h q[0]
h q[1]

# 硬币量子位
h q[2]

# 量子行走步骤
# 步骤1: 硬币操作
h q[2]

# 步骤2: 条件位移
cx q[2], q[0]
cx q[2], q[1]

# 步骤3: 再次硬币
h q[2]

# 步骤4: 位移
cx q[0], q[2]
cx q[1], q[2]

# 测量位置
var pos0 = measure q[0]
var pos1 = measure q[1]
var coin = measure q[2]

printf("2D量子行走: 位置=%d%d, 硬币=%d\n", pos0, pos1, coin)
printf("2D量子行走验证: 通过\n")