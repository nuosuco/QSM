# ================================================================
# 量子Grover+Simon组合 — 黑盒函数分析
# Simon算法: 寻找黑盒函数的隐藏周期
# ================================================================

printf("=== Simon算法 (隐藏周期) ===\n\n")
printf("寻找f(x)=f(x⊕s)的周期s\n")
printf("经典: 需要O(2^(n/2))次查询\n")
printf("量子: 只需O(n)次查询\n\n")

# Simon算法: 2比特输入
# f(x) = f(x⊕s), 隐藏周期s
# 本例: s=2 (10)

printf("隐藏周期s = 2 (10)\n\n")

# Simon电路: 2个寄存器
# |0>|0> → H|x>⊗|0> → Uf → H|x> → 测量
# 结果满足: y·s = 0 (mod 2)

var y0_valid = 0
var y1_valid = 0
var total = 0
var r = 0
while (r < 20):
    total = total + 1
    var q = qreg_create(4)
    
    # 第一寄存器叠加
    h q[0]
    h q[1]
    
    # Oracle: f(x)=f(x⊕s), s=2
    # 用CX构造: f相同
    # 简化: 让第一寄存器通过CNOT到第二寄存器
    cx q[0], q[2]
    cx q[1], q[3]
    
    # 干涉
    h q[0]
    h q[1]
    
    # 测量第一寄存器
    var m0 = measure(q, 0)
    var m1 = measure(q, 1)
    var y = m0 + m1 * 2
    
    # 验证: y·s = y0*1 + y1*0 = y0 = 0
    # s=2(10): s0=0, s1=1
    # y·s = y0*s0 + y1*s1 = y1
    # 有效y: y1 = 0
    if (m1 == 0):
        y0_valid = y0_valid + 1
    end
    qreg_free(q)
    r = r + 1
end

printf("测量结果分析:\n")
printf("满足y·s=0的测量: %d/20\n", y0_valid)
printf("有效测量比例: %d%%\n", y0_valid * 100 / total)

if (y0_valid == total):
    printf("Simon算法: 通过 ✅ (隐藏周期检测)\n")
else:
    printf("Simon算法: 部分有效\n")
end

printf("\n=== Simon算法完成 ===\n")