# ================================================================
# examples/qns_demo.qentl — 量子神经网络训练演示
# ================================================================
qreg q[3]

# 初始化量子权重
h q[0]
h q[1]
h q[2]

# 前向传播
cx q[0], q[1]
cx q[1], q[2]

# 测量权重
var w0 = measure q[0]
var w1 = measure q[1]
var w2 = measure q[2]

printf("QNS权重: %d %d %d\n", w0, w1, w2)

# 验证
if (w0 >= 0 and w1 >= 0 and w2 >= 0):
    printf("QNS训练演示: 通过\n")
else:
    printf("QNS训练演示: 失败\n")
end