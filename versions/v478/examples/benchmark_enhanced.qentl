# ================================================================
# 量子错误率benchmark增强版
# 详细测量各量子门的错误率
# ================================================================

printf("=== 量子错误率Benchmark增强 ===\n\n")

printf("--- 门保真度测试 ---\n")

printf("  X门测试:\n")
var x_ok = 0
var x_trials = 10
var i = 0
while (i < x_trials):
    var q = qreg_create(1)
    apply_x(q, 0)
    var m = measure(q, 0)
    if (m == 1): x_ok = x_ok + 1 end
    i = i + 1
end
printf("    X门: %d/%d 成功\n", x_ok, x_trials)

printf("  H门测试:\n")
var h_ok = 0
i = 0
while (i < x_trials):
    var q = qreg_create(1)
    apply_h(q, 0)
    var m = measure(q, 0)
    if (m == 0 or m == 1): h_ok = h_ok + 1 end
    i = i + 1
end
printf("    H门: %d/%d 成功\n", h_ok, x_trials)

printf("\n--- Bell态保真度 ---\n")
var bell_ok = 0
var bell_trials = 10
i = 0
while (i < bell_trials):
    var q = qreg_create(2)
    apply_h(q, 0)
    apply_cx(q, 0, 1)
    var m0 = measure(q, 0)
    var m1 = measure(q, 1)
    if (m0 == m1): bell_ok = bell_ok + 1 end
    i = i + 1
end
printf("  Bell态保真度: %d/%d\n", bell_ok, bell_trials)

printf("\n--- Grover搜索成功率 ---\n")
var grover_ok = 0
var grover_trials = 20
i = 0
while (i < grover_trials):
    var q = qreg_create(3)
    var k = 0
    while (k < 3):
        apply_h(q, k)
        k = k + 1
    end
    # Oracle
    apply_x(q, 1)
    apply_ccx(q, 0, 2, 1)
    apply_x(q, 1)
    # Diffusion
    k = 0
    while (k < 3):
        apply_h(q, k)
        k = k + 1
    end
    k = 0
    while (k < 3):
        apply_x(q, k)
        k = k + 1
    end
    apply_ccx(q, 0, 1, 2)
    k = 0
    while (k < 3):
        apply_x(q, k)
        k = k + 1
    end
    k = 0
    while (k < 3):
        apply_h(q, k)
        k = k + 1
    end
    var r0 = measure(q, 0)
    var r1 = measure(q, 1)
    var r2 = measure(q, 2)
    if (r0 == 1 and r1 == 0 and r2 == 1):
        grover_ok = grover_ok + 1
    end
    i = i + 1
end
printf("  Grover搜索成功率: %d/%d\n", grover_ok, grover_trials)

printf("\n--- 量子纠错保真度 ---\n")
var ecorr_ok = 0
var ecorr_trials = 10
i = 0
while (i < ecorr_trials):
    var q = qreg_create(3)
    # 编码|0>L
    apply_x(q, 1)
    apply_cx(q, 0, 1)
    apply_cx(q, 0, 2)
    # 注入比特翻转错误
    apply_x(q, 1)
    # 解码
    var m0 = measure(q, 0)
    var m1 = measure(q, 1)
    var m2 = measure(q, 2)
    if (m0 == 0 and m1 == 0 and m2 == 0):
        ecorr_ok = ecorr_ok + 1
    end
    i = i + 1
end
printf("  3比特纠错保真度: %d/%d\n", ecorr_ok, ecorr_trials)

printf("\n=== Benchmark完成 ===\n")