# ================================================================
# lib/fixed.qentl — QEntL定点数运算库 (scale=1000, 3位小数)
# 浮点能力边界②的解决方案: 定点数方案
#
# 设计原理:
#   QVM只有整数运算(long long)。定点数把 3.14 表示为 3140
#   编译器词法器已支持 3.14 字面量 → 自动转为 3140
#   本库提供定点数的乘除/格式化(因为乘除需要缩放)
#
# 核心约定:
#   scale = 1000 (3位小数)
#   fx_add(a,b) = a + b        (加法直接加)
#   fx_sub(a,b) = a - b        (减法直接减)
#   fx_mul(a,b) = a*b/1000     (乘法需除scale)
#   fx_div(a,b) = a*1000/b     (除法需乘scale)
#   fx_int(n)   = n * 1000     (整数转定点)
#   fx_trunc(a) = a / 1000     (取整数部分)
#   fx_to_str(a) = "3.140"     (定点转可读字符串)
# ================================================================

var FIXED_SCALE = 1000

def fx_add(a, b):
    return a + b
end

def fx_sub(a, b):
    return a - b
end

def fx_mul(a, b):
    return a * b / FIXED_SCALE
end

def fx_div(a, b):
    if (b == 0):
        printf("fixed: 除零错误\n")
        return 0
    end
    return a * FIXED_SCALE / b
end

def fx_int(n):
    return n * FIXED_SCALE
end

def fx_trunc(a):
    return a / FIXED_SCALE
end

def fx_from_parts(ip, frac3):
    return ip * FIXED_SCALE + frac3
end

# 牛顿法平方根(定点): sqrt(a) 满足 y*y = a*SCALE
# 迭代 y = (y + a*SCALE/y) / 2, 收敛到定点结果
def fx_sqrt(a):
    if (a <= 0):
        return 0
    end
    var target = a * FIXED_SCALE
    var y = target / 2
    if (a < FIXED_SCALE):
        y = FIXED_SCALE
    end
    var i = 0
    while (i < 30):
        var yn = (y + target / y) / 2
        if (yn == y):
            break
        end
        y = yn
        i = i + 1
    end
    return y
end

# ================================================================
# 三角函数 (泰勒级数, 定点)
#   sin(x) = x - x^3/3! + x^5/5! - ...
#   策略: 先规约到 [0, 2π), 再折叠到 [-π/2, π/2] 加速收敛
#   精度: ±0.002 (scale=1000下的±2)
# ================================================================

var FX_PI = 3142
var FX_PI_HALF = 1571

# x 规约到 [0, 2π)
def fx_mod_2pi(x):
    var two_pi = FX_PI + FX_PI
    while (x < 0):
        x = x + two_pi
    end
    while (x >= two_pi):
        x = x - two_pi
    end
    return x
end

# 泰勒级数核心: t ∈ [-π/2, π/2]
# 递推: term_k = -term_{k-1} * t^2 / ((2k)(2k+1))
def fx_sin_taylor(t):
    var t2 = fx_mul(t, t)
    var term = t
    var sum = t
    var k = 1
    while (k <= 12):
        term = 0 - fx_mul(term, t2) / ((2 * k) * (2 * k + 1))
        if (term == 0):
            break
        end
        sum = sum + term
        k = k + 1
    end
    return sum
end

# sin(x) 任意定点输入
def fx_sin(x):
    x = fx_mod_2pi(x)
    if (x <= FX_PI_HALF):
        return fx_sin_taylor(x)
    end
    if (x <= FX_PI + FX_PI_HALF):
        return fx_sin_taylor(FX_PI - x)
    end
    return 0 - fx_sin_taylor(FX_PI + FX_PI - x)
end

# cos(x) = sin(x + π/2)
def fx_cos(x):
    return fx_sin(x + FX_PI_HALF)
end

# 定点转可读字符串: 3140 -> "3.140"
def fx_to_str(a):
    var neg = 0
    if (a < 0):
        neg = 1
        a = 0 - a
    end
    var ip = a / FIXED_SCALE
    var frac = a % FIXED_SCALE
    var fs = int_to_str(frac)
    # 补齐到3位
    while (str_len(fs) < 3):
        fs = str_concat("0", fs)
    end
    var s = str_concat(int_to_str(ip), str_concat(".", fs))
    if (neg == 1):
        s = str_concat("-", s)
    end
    return s
end