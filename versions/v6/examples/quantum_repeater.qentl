# ================================================================
# 量子中继器协议演示
# 基于纠缠交换的长距离量子通信
# ================================================================

printf("=== 量子中继器协议 ===\n\n")

printf("--- 原理 ---\n")
printf("量子中继器解决长距离量子通信的损耗问题\n")
printf("通过分段纠缠分发+纠缠交换实现\n\n")

printf("--- 协议步骤 ---\n")
printf("1. Alice-Charlie建立纠缠对\n")
printf("2. Bob-Charlie建立纠缠对\n")
printf("3. Charlie做Bell测量, 交换纠缠\n")
printf("4. Alice-Bob获得共享纠缠\n")
printf("5. Alice-Bob用纠缠进行量子通信\n\n")

printf("--- 演示: 3节点中继 ---\n")
var q = qreg_create(6)
# Alice-Charlie纠缠: q[0]-q[2]
# Bob-Charlie纠缠: q[1]-q[3]
# 两个中继节点: q[4], q[5]
printf("网络拓扑:\n")
printf("  Alice(q[0])=---=Charlie(q[2],q[3])=---=Bob(q[1])\n")
printf("    |\n")
printf("  Relay(q[4],q[5])\n\n")

# 制备第一段纠缠
printf("步骤1: Alice-Charlie纠缠\n")
apply_h(q, 0)
apply_cx(q, 0, 2)
printf("  Alice(q[0])-Charlie(q[2]): 纠缠态\n")

# 制备第二段纠缠
printf("步骤2: Bob-Charlie纠缠\n")
apply_h(q, 1)
apply_cx(q, 1, 3)
printf("  Bob(q[1])-Charlie(q[3]): 纠缠态\n")

# Charlie做Bell测量
printf("步骤3: Charlie Bell测量\n")
apply_cx(q, 3, 2)
apply_h(q, 3)
var c0 = measure(q, 3)
var c1 = measure(q, 2)
printf("  Charlie测量: (%d,%d)\n", c0, c1)

# 信号处理: 通过中继器转发
printf("步骤4: 中继器处理\n")
apply_cx(q, 4, 5)
apply_h(q, 4)
var r0 = measure(q, 4)
var r1 = measure(q, 5)
printf("  中继器测量: (%d,%d)\n", r0, r1)

# Alice-Bob测量验证
printf("步骤5: Alice-Bob验证\n")
var a = measure(q, 0)
var b = measure(q, 1)
printf("  Alice: %d, Bob: %d\n", a, b)
if (a == b):
    printf("  ✓ 中继成功: Alice-Bob纠缠建立\n")
else:
    printf("  ℹ 中继结果: Alice=%d, Bob=%d\n", a, b)
end

printf("\n--- 应用场景 ---\n")
printf("  1. 城际量子通信 (>100km)\n")
printf("  2. 量子互联网骨干网\n")
printf("  3. 卫星-地面量子通信\n\n")

printf("=== 量子中继器协议完成 ===\n")