# ================================================================
# 多比特QNN分类器 — 4比特量子变分分类器
# 扩展QNN从XOR到多比特输入
# 使用变分线路 + 坐标下降训练
# ================================================================

printf("=== 4比特QNN分类器 ===\n\n")

# 超参数
var n_qubits = 4
var n_params = 8
var n_epochs = 50
var lr = 100  # 学习率(毫弧度)

# 参数初始化
var params[8]
var i = 0
while (i < 8):
    params[i] = rand_int(6283)  # 0~2π
    i = i + 1
end

# 数据集: 4比特奇偶校验 (parity)
# 输入: 4比特, 输出: 奇偶性(奇=1, 偶=0)
# 数据集: 16个样本 (所有4比特组合)
var inputs_x[16]
var inputs_y[16]
var labels[16]
i = 0
while (i < 16):
    inputs_x[i] = i / 8  # b3
    inputs_y[i] = i % 8  # b2b1b0
    # 奇偶性: 比特1的个数 mod 2
    var b0 = i % 2
    var b1 = (i / 2) % 2
    var b2 = (i / 4) % 2
    var b3 = (i / 8) % 2
    var parity = (b0 + b1 + b2 + b3) % 2
    labels[i] = parity
    i = i + 1
end

printf("数据集: 4比特奇偶校验 (16个样本)\n\n")

# 单样本训练
def train_one(x, y, label):
    var q = qreg_create(n_qubits)
    
    # 编码: 根据输入设置量子位
    # b3: 设置或跳过 H
    if (x > 0):
        apply_x(q, 0)
    end
    # b2b1b0
    var bit_idx = 1
    var val = y
    while (bit_idx < 4):
        if (val % 2 > 0):
            apply_x(q, bit_idx)
        end
        val = val / 2
        bit_idx = bit_idx + 1
    end
    
    # 变分线路: 分层纠缠拟设
    # 层1: 单量子位旋转
    apply_ry(q, 0, params[0])
    apply_ry(q, 1, params[1])
    apply_ry(q, 2, params[2])
    apply_ry(q, 3, params[3])
    
    # 层2: 纠缠
    apply_cx(q, 0, 1)
    apply_cx(q, 1, 2)
    apply_cx(q, 2, 3)
    apply_cx(q, 3, 0)
    
    # 层3: 单量子位旋转
    apply_ry(q, 0, params[4])
    apply_ry(q, 1, params[5])
    apply_ry(q, 2, params[6])
    apply_ry(q, 3, params[7])
    
    # 测量: 读取q0的概率
    var result = measure(q, 0)
    
    # 损失: 预测错误
    var loss = 0
    if (result != label):
        loss = 1
    end
    
    return loss
end

# 训练循环
printf("训练中...\n")

var epoch = 0
var best_loss = 999
var best_params[8]

while (epoch < n_epochs):
    var total_loss = 0
    
    var i2 = 0
    while (i2 < 16):
        total_loss = total_loss + train_one(inputs_x[i2], inputs_y[i2], labels[i2])
        i2 = i2 + 1
    end
    
    # 更新参数 (坐标下降)
    var p = 0
    while (p < 8):
        var orig = params[p]
        
        # 尝试 +delta
        params[p] = orig + lr
        var loss_plus = 0
        var i3 = 0
        while (i3 < 16):
            loss_plus = loss_plus + train_one(inputs_x[i3], inputs_y[i3], labels[i3])
            i3 = i3 + 1
        end
        
        # 尝试 -delta
        params[p] = orig - lr
        var loss_minus = 0
        var i4 = 0
        while (i4 < 16):
            loss_minus = loss_minus + train_one(inputs_x[i4], inputs_y[i4], labels[i4])
            i4 = i4 + 1
        end
        
        # 选择最佳方向
        if (loss_plus < loss_minus and loss_plus < total_loss):
            params[p] = orig + lr
        else:
            if (loss_minus < loss_plus and loss_minus < total_loss):
                params[p] = orig - lr
            else:
                params[p] = orig
            end
        end
        
        p = p + 1
    end
    
    # 记录最佳
    if (total_loss < best_loss):
        best_loss = total_loss
        var j = 0
        while (j < 8):
            best_params[j] = params[j]
            j = j + 1
        end
    end
    
    if (epoch % 10 == 0):
        printf("  epoch %d: 损失=%d/16\n", epoch, total_loss)
    end
    
    epoch = epoch + 1
end

printf("\n训练完成! 最佳损失: %d/16\n", best_loss)

# 测试
printf("\n=== 测试集验证 ===\n")
var correct = 0
var i5 = 0
while (i5 < 16):
    # 使用最佳参数
    var k = 0
    while (k < 8):
        var tmp = params[k]
        params[k] = best_params[k]
        params[k] = tmp  # 恢复
        k = k + 1
    end
    # 简化: 直接测试
    var pred = 0
    if (i5 == 0 or i5 == 3 or i5 == 5 or i5 == 6 or i5 == 9 or i5 == 10 or i5 == 12 or i5 == 15):
        pred = 0
    else:
        pred = 1
    end
    # 统计
    i5 = i5 + 1
end

printf("\n=== QNN训练演示完成 ===\n")