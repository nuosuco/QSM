# ================================================================
# examples/qsuperdense.qentl — 量子密集编码
# 传输2比特经典信息只用1量子比特
# ================================================================
qreg q[2]
# 创建纠缠对
h q[0]
cx q[0], q[1]
# 编码：发送端施加门操作
x q[0]
# 解码
cx q[0], q[1]
h q[0]
# 测量
var m0 = measure q[0]
var m1 = measure q[1]
printf("量子密集编码: %d %d\n", m0, m1)
# 验证：应该得到|10>或|11>
if (m0 == 1):
    printf("量子密集编码验证: 通过\n")
else:
    printf("量子密集编码验证: 失败\n")
end