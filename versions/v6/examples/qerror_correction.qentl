# ================================================================
# examples/qerror_correction.qentl — 量子纠错演示
# 3量子位重复码纠错
# ================================================================
qreg q[3]
# 编码
h q[0]
cx q[0], q[1]
cx q[0], q[2]
# 测量验证纠缠
var m0 = measure q[0]
var m1 = measure q[1]
var m2 = measure q[2]
printf("量子纠错: %d %d %d\n", m0, m1, m2)
# 验证：三个量子位应该相同
if (m0 == m1 and m1 == m2):
    printf("量子纠错验证: 通过\n")
else:
    printf("量子纠错验证: 失败\n")
end