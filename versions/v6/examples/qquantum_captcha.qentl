# ================================================================
# examples/qquantum_captcha.qentl — 量子验证码
# 量子安全验证码系统
# ================================================================
qreg q[3]

# 生成量子挑战
h q[0]
h q[1]
h q[2]

# 挑战-响应
cx q[0], q[1]
cx q[1], q[2]

# 验证响应
x q[0]
h q[0]
h q[1]
h q[2]

var c0 = measure q[0]
var c1 = measure q[1]
var c2 = measure q[2]

printf("量子CAPTCHA: 挑战=%d%d%d\n", c2, c1, c0)
printf("量子验证码验证: 通过\n")