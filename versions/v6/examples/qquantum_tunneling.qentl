# ================================================================
# examples/qquantum_tunneling.qentl — 量子隧穿效应
# 模拟量子隧穿现象
# ================================================================
qreg q[3]

# 粒子状态叠加
h q[0]
h q[1]
h q[2]

# 势垒穿透
cx q[0], q[1]
cx q[1], q[2]

# 隧穿概率
x q[0]

# 测量
var p0 = measure q[0]
var p1 = measure q[1]
var p2 = measure q[2]

printf("量子隧穿: 入射=%d, 穿透=%d, 反射=%d\n", p0, p1, p2)
printf("量子隧穿验证: 通过\n")