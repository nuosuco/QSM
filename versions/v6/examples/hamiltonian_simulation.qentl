# ================================================================
# 哈密顿量模拟 — 量子系统时间演化
# 模拟 H = X0 + X1 (2比特横场模型)
# 时间演化算子 e^(-iHt)
# ================================================================

printf("=== 哈密顿量模拟 ===\n\n")

printf("--- 系统: H = X0 + X1 ---\n")
printf("2比特横场伊辛模型\n")
printf("X门: 翻转 |0>↔|1>\n\n")

# 初始态 |00>
printf("--- 时间演化: t=1 ---\n")
var q = qreg_create(2)
# H = X0 + X1, 演化算子 e^(-iHt) ≈ 分层应用
# 层1: X0加相位
apply_h(q, 0)
apply_h(q, 1)
# 层2: 应用相位(通过CZ模拟)
apply_cz(q, 0, 1)
# 层3: 转回计算基
apply_h(q, 0)
apply_h(q, 1)
# 测量
var m0 = measure(q, 0)
var m1 = measure(q, 1)
printf("  演化后: |%d%d>\n", m1, m0)

# 多时间步验证
printf("\n--- 多时间步演化 ---\n")
var t = 0
while (t < 5):
    var qt = qreg_create(2)
    # X基下的相位编码
    apply_h(qt, 0)
    apply_h(qt, 1)
    var step = 0
    while (step < t + 1):
        apply_cz(qt, 0, 1)
        step = step + 1
    end
    apply_h(qt, 0)
    apply_h(qt, 1)
    var mt0 = measure(qt, 0)
    var mt1 = measure(qt, 1)
    printf("  t=%d: |%d%d>\n", t + 1, mt1, mt0)
    t = t + 1
end

printf("\n=== 哈密顿量模拟完成 ===\n")
printf("H=X0+X1时间演化: 展示量子系统动力学\n")
printf("扩展: 可推广到任意哈密顿量模拟\n")