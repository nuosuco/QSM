# ================================================================
# 量子错误模型 — 错误率模拟
# 模拟不同错误率下的纠错能力
# ================================================================

printf("=== 量子错误模型 ===\n\n")
printf("模拟错误率对纠错的影响\n\n")

# 模拟不同错误率
# 物理错误率p: 每个门出错的概率
# 逻辑错误率: 纠错后剩余错误率

printf("--- 错误率扫描 (3比特翻转码) ---\n\n")

# 在3比特码中注入随机错误
# 模拟不同错误率下的纠错能力

var err_rates = 0
var err0_ok = 0
var err0_total = 0
var err1_ok = 0
var err1_total = 0
var err2_ok = 0
var err2_total = 0

# 错误率0: 无错误
var b = 0
while (b <= 1):
    var r = 0
    while (r < 20):
        err0_total = err0_total + 1
        var q = qreg_create(3)
        if (b == 1): x q[0] end
        cx q[0], q[1]
        cx q[0], q[2]
        var m0 = measure(q, 0)
        var m1 = measure(q, 1)
        var m2 = measure(q, 2)
        var ones = m0 + m1 + m2
        var rec = 0
        if (ones >= 2): rec = 1 end
        if (rec == b): err0_ok = err0_ok + 1 end
        qreg_free(q)
        r = r + 1
    end
    b = b + 1
end
printf("错误率0%%:   %d/40 (%d%%)\n", err0_ok, err0_ok * 100 / 40)

# 错误率1: 单比特错误 (1/3 ≈ 33% 物理错误率)
b = 0
while (b <= 1):
    var r = 0
    while (r < 20):
        err1_total = err1_total + 1
        var q = qreg_create(3)
        if (b == 1): x q[0] end
        cx q[0], q[1]
        cx q[0], q[2]
        # 33%错误率: 随机翻转一个比特
        var err_bit = b  # 用b决定错误模式
        if (err_bit == 0): x q[0] end
        if (err_bit == 1): x q[1] end
        var m0 = measure(q, 0)
        var m1 = measure(q, 1)
        var m2 = measure(q, 2)
        var ones = m0 + m1 + m2
        var rec = 0
        if (ones >= 2): rec = 1 end
        if (rec == b): err1_ok = err1_ok + 1 end
        qreg_free(q)
        r = r + 1
    end
    b = b + 1
end
printf("错误率33%%:  %d/40 (%d%%)\n", err1_ok, err1_ok * 100 / 40)

# 错误率2: 双比特错误 (2/3 ≈ 66% 物理错误率)
b = 0
while (b <= 1):
    var r = 0
    while (r < 20):
        err2_total = err2_total + 1
        var q = qreg_create(3)
        if (b == 1): x q[0] end
        cx q[0], q[1]
        cx q[0], q[2]
        # 66%错误率: 翻转两个比特
        x q[0]
        x q[1]
        var m0 = measure(q, 0)
        var m1 = measure(q, 1)
        var m2 = measure(q, 2)
        var ones = m0 + m1 + m2
        var rec = 0
        if (ones >= 2): rec = 1 end
        if (rec == b): err2_ok = err2_ok + 1 end
        qreg_free(q)
        r = r + 1
    end
    b = b + 1
end
printf("错误率66%%:  %d/40 (%d%%)\n", err2_ok, err2_ok * 100 / 40)

printf("\n--- 结论 ---\n")
printf("单比特错误(33%%): 可纠正 (3比特码距离3)\n")
printf("双比特错误(66%%): 不可纠正 (超过纠错能力)\n")

printf("\n=== 量子错误模型完成 ===\n")