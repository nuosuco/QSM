# ================================================================
# QNN训练算法改进: 网格搜索 + 随机重启
# 解决变分线路坐标下降对OR/AND不收敛的问题
# 用确定性网格搜索替代随机梯度, 保证收敛
# ================================================================

printf("=== QNN训练改进: 网格搜索 ===\n\n")

# 目标: 学习OR函数 (2比特)
# f(x0,x1) = x0 OR x1
# 量子线路: RY(theta0)q0, RY(theta1)q1, CX(q1->q0), 测量q0
# 用网格搜索找到使损失最小的(theta0, theta1)

# 损失函数: 对4个输入(00,01,10,11)测量q0, 与目标对比
# q0测量值>0.5视为1, 否则0

# 网格搜索: theta在[0, 3141]毫弧度(0~pi)范围, 步长1000

printf("--- 网格搜索训练 ---\n")
var best_loss = 100
var best_t0 = 0
var best_t1 = 0
var t0 = 0
while (t0 <= 3141):
    var t1 = 0
    while (t1 <= 3141):
        # 计算4个输入下的输出
        var loss = 0
        var input0 = 0
        while (input0 <= 1):
            var input1 = 0
            while (input1 <= 1):
                # 2比特量子线路
                var q = qreg_create(2)
                if (input0 > 0): apply_x(q, 0) end
                if (input1 > 0): apply_x(q, 1) end
                apply_ry(q, 0, t0)
                apply_ry(q, 1, t1)
                apply_cx(q, 1, 0)
                var m = measure(q, 0)
                # 期望: OR
                var expected = 0
                if (input0 > 0 or input1 > 0): expected = 1 end
                if (m != expected): loss = loss + 1 end
                input1 = input1 + 1
            end
            input0 = input0 + 1
        end
        if (loss < best_loss):
            best_loss = loss
            best_t0 = t0
            best_t1 = t1
            printf("  新最优: theta0=%d, theta1=%d, loss=%d\n", best_t0, best_t1, best_loss)
        end
        t1 = t1 + 1000
    end
    t0 = t0 + 1000
end

printf("\n--- 训练结果 ---\n")
printf("  最优theta: (%d, %d)\n", best_t0, best_t1)
printf("  最优损失: %d/4\n", best_loss)

if (best_loss == 0):
    printf("  ✓ OR函数学习成功! 找到精确参数\n")
else:
    printf("  ✗ 未找到零损失参数, OR函数的变分线路表达受限\n")
    printf("  最小损失: %d/4\n", best_loss)
end

printf("\n=== QNN训练改进演示完成 ===\n")