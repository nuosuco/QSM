# ================================================================
# Surface码 2x2 二维晶格实现
# 4个数据比特 + 稳定子测量
# ================================================================

printf("=== Surface码 2x2 二维晶格 ===\n\n")

printf("--- 晶格布局 ---\n")
printf("  q0 ── Z ── q1\n")
printf("   |         |\n")
printf("   X         X\n")
printf("   |         |\n")
printf("  q2 ── Z ── q3\n")
printf("  稳定子: Z0Z1, Z2Z3, X0X2, X1X3\n\n")

# 基态验证: 所有稳定子=+1
printf("--- 基态验证 |0000> ---\n")
var q = qreg_create(4)
printf("  基态: |0000> (所有稳定子=+1)\n")

# 稳定子测量 (在同一个qreg内)
# Z0Z1: 用CZ实现
printf("\n--- 稳定子 Z0Z1 ---\n")
var q_z = qreg_create(4)
apply_cz(q_z, 0, 1)
var m0 = measure(q_z, 0)
var m1 = measure(q_z, 1)
printf("  Z0Z1: q0=%d, q1=%d (期望 0,0)\n", m0, m1)

# 注入Z错误到q0
printf("\n--- 注入Z错误到q0 ---\n")
var q_e = qreg_create(4)
apply_z(q_e, 0)  # Z错误
apply_cz(q_e, 0, 1)
var e0 = measure(q_e, 0)
var e1 = measure(q_e, 1)
printf("  Z0Z1: q0=%d, q1=%d (应检测到Z错误)\n", e0, e1)
if (e0 != 0 or e1 != 1):
    printf("  ✓ Z错误被检测到\n")
else:
    printf("  ✗ 未检测到Z错误\n")
end

# X错误检测
printf("\n--- X错误检测 (X0X2) ---\n")
var q_x = qreg_create(4)
apply_x(q_x, 1)  # 在q1注入X错误
# 测量X0X2: 先H变换到X基
apply_h(q_x, 0)
apply_h(q_x, 2)
apply_cx(q_x, 0, 2)
var x0 = measure(q_x, 0)
var x2 = measure(q_x, 2)
printf("  X0X2: q0=%d, q2=%d\n", x0, x2)
printf("  预期: q1的X错误应翻转X0X2稳定子\n")

# 完整错误纠正
printf("\n--- 完整纠错循环 ---\n")
var q_c = qreg_create(4)
apply_x(q_c, 2)  # 注入X错误到q2
printf("  注入X错误到q2\n")

# 检测: 测量Z稳定子
apply_cz(q_c, 0, 1)
var z01 = 0
if (measure(q_c, 0) != measure(q_c, 1)): z01 = 1 end
# 重新编码
q_c = qreg_create(4)
apply_x(q_c, 2)
apply_cz(q_c, 2, 3)
var z23 = 0
if (measure(q_c, 2) != measure(q_c, 3)): z23 = 1 end

printf("  Z稳定子: Z0Z1=%d, Z2Z3=%d\n", z01, z23)

# 检测: 测量X稳定子
q_c = qreg_create(4)
apply_x(q_c, 2)
apply_h(q_c, 0)
apply_h(q_c, 2)
apply_cx(q_c, 0, 2)
var x02 = 0
if (measure(q_c, 0) != measure(q_c, 2)): x02 = 1 end

q_c = qreg_create(4)
apply_x(q_c, 2)
apply_h(q_c, 1)
apply_h(q_c, 3)
apply_cx(q_c, 1, 3)
var x13 = 0
if (measure(q_c, 1) != measure(q_c, 3)): x13 = 1 end

printf("  X稳定子: X0X2=%d, X1X3=%d\n", x02, x13)

# 纠错
printf("\n  纠正: ")
if (x02 != 0 and z01 != 0):
    printf("在q0应用X门\n")
else:
    printf("无错误或边界错误\n")
end

printf("\n=== Surface码 2x2 演示完成 ===\n")
printf("拓扑量子纠错原理: 稳定子测量→错误诊断→本地纠正\n")