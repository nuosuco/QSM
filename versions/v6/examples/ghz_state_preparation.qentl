# ================================================================
# 量子GHZ态制备 — 多体纠缠
# N比特GHZ态: 量子纠缠的最高形式
# ================================================================

printf("=== 量子GHZ态制备 ===\n\n")
printf("GHZ态: (|000...>+|111...>)/√2\n")
printf("多体纠缠: 三体以上量子纠缠\n\n")

# 3比特GHZ态
printf("--- 3比特GHZ态 ---\n")
var ghz3_ok = 0
var i = 0
while (i < 20):
    var q = qreg_create(3)
    h q[0]
    cx q[0], q[1]
    cx q[0], q[2]
    var m0 = measure(q, 0)
    var m1 = measure(q, 1)
    var m2 = measure(q, 2)
    # GHZ: 全0或全1
    if (m0 == m1 and m1 == m2):
        ghz3_ok = ghz3_ok + 1
    end
    qreg_free(q)
    i = i + 1
end
printf("  全同: %d/20\n", ghz3_ok)

# 4比特GHZ态
printf("\n--- 4比特GHZ态 ---\n")
var ghz4_ok = 0
i = 0
while (i < 20):
    var q = qreg_create(4)
    h q[0]
    cx q[0], q[1]
    cx q[0], q[2]
    cx q[0], q[3]
    var m0 = measure(q, 0)
    var m1 = measure(q, 1)
    var m2 = measure(q, 2)
    var m3 = measure(q, 3)
    if (m0 == m1 and m1 == m2 and m2 == m3):
        ghz4_ok = ghz4_ok + 1
    end
    qreg_free(q)
    i = i + 1
end
printf("  全同: %d/20\n", ghz4_ok)

# 5比特GHZ态
printf("\n--- 5比特GHZ态 ---\n")
var ghz5_ok = 0
i = 0
while (i < 20):
    var q = qreg_create(5)
    h q[0]
    cx q[0], q[1]
    cx q[0], q[2]
    cx q[0], q[3]
    cx q[0], q[4]
    var m0 = measure(q, 0)
    var m1 = measure(q, 1)
    var m2 = measure(q, 2)
    var m3 = measure(q, 3)
    var m4 = measure(q, 4)
    if (m0 == m1 and m1 == m2 and m2 == m3 and m3 == m4):
        ghz5_ok = ghz5_ok + 1
    end
    qreg_free(q)
    i = i + 1
end
printf("  全同: %d/20\n", ghz5_ok)

printf("\nGHZ态: 3比特%d/20, 4比特%d/20, 5比特%d/20\n", ghz3_ok, ghz4_ok, ghz5_ok)
if (ghz3_ok == 20 and ghz4_ok == 20 and ghz5_ok == 20):
    printf("GHZ制备: 通过 ✅ (多体纠缠作证)\n")
end

printf("\n=== GHZ态制备完成 ===\n")