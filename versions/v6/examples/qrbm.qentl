# ================================================================
# examples/qrbm.qentl — 量子玻尔兹曼机
# 量子版本的受限玻尔兹曼机
# ================================================================

qreg q[4]

# 可见层
h q[0]
h q[1]

# 隐藏层
h q[2]
h q[3]

# 连接
cx q[0], q[2]
cx q[1], q[3]

# 测量
var v0 = measure q[0]
var v1 = measure q[1]
var h0 = measure q[2]
var h1 = measure q[3]

printf("量子RBM: v=%d%d h=%d%d\n", v0, v1, h0, h1)

if (v0 >= 0 and v1 >= 0 and h0 >= 0 and h1 >= 0):
    printf("量子RBM验证: 通过\n")
else:
    printf("量子RBM验证: 失败\n")
end
