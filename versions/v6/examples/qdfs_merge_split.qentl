# ================================================================
# QDFS动态合并/分离验证 — 每个应用独立拥有QDFS+QNS
# 验证: 合并两个命名空间 / 分离命名空间 / 实例创建
# ================================================================

printf("=== QDFS动态合并/分离验证 ===\n")
printf("QDFS叫动态文件系统 = 文件夹自由合并与分离\n\n")

# 1. 创建两个应用的QDFS实例
printf("--- 1. 创建两个应用的QDFS实例 ---\n")
var qdfs_base = "/tmp/qdfs_merge_test"
qdfs_init(qdfs_base)
printf("  基础QDFS初始化: %s\n", qdfs_base)

# 应用1: 写入自己的数据
qdfs_ns_write("system", "app1_config", "应用1配置")
qdfs_ns_write("models", "app1_weights", "权重数据")
qdfs_ns_write("users", "app1_data", "用户数据")
printf("  应用1: 写入3个文件\n")

# 应用2: 写入自己的数据
qdfs_ns_write("system", "app2_config", "应用2配置")
qdfs_ns_write("models", "app2_weights", "权重数据")
qdfs_ns_write("users", "app2_data", "用户数据")
printf("  应用2: 写入3个文件\n")

# 2. 验证命名空间隔离
printf("\n--- 2. 验证隔离 ---\n")
printf("  system命名空间:\n  %s\n", qdfs_ns_ls("system"))
printf("  models命名空间:\n  %s", qdfs_ns_ls("models"))
printf("  users命名空间:\n  %s", qdfs_ns_ls("users"))

# 3. 合并两个命名空间（应用1和应用2协作）
printf("\n--- 3. 合并: models + users → 合并为一个 ---\n")
var merge_out = qdfs_ns_merge("models", "users")
printf("  %s\n", merge_out)
printf("  models命名空间(合并后):\n  %s", qdfs_ns_ls("models"))

# 4. 分离: 从models中分离出以"app1"开头的文件到新的"app1data"命名空间
printf("\n--- 4. 分离: models → 分离出app1data ---\n")
var split_out = qdfs_ns_split("models", "app1data", "app1")
printf("  %s\n", split_out)
printf("  models命名空间(分离后):\n  %s", qdfs_ns_ls("models"))
printf("  app1data命名空间:\n  %s", qdfs_ns_ls("app1data"))

# 5. 验证合并/分离后数据读取（在创建新实例前）
printf("\n--- 5. 验证合并/分离后数据读取 ---\n")
printf("  system:app1_config = %s\n", qdfs_ns_read("system", "app1_config"))
printf("  system:app2_config = %s\n", qdfs_ns_read("system", "app2_config"))
printf("  app1data:app1_data = %s\n", qdfs_ns_read("app1data", "app1_data"))
printf("  models:app2_data = %s\n", qdfs_ns_read("models", "app2_data"))

# 6. 创建新应用实例
printf("\n--- 6. 创建新应用QDFS实例 ---\n")
var app3_root = qdfs_instance_create("/tmp/qdfs_apps", "app3")
printf("  应用3 QDFS实例: %s\n", app3_root)
qdfs_ns_write("system", "app3_conf", "应用3配置")
printf("  应用3: 写入成功\n")
printf("  应用3读取: %s\n", qdfs_ns_read("system", "app3_conf"))

printf("\n=== QDFS动态合并/分离验证完成 ===\n")
printf("QDFS: 文件夹合并✅ 分离✅ 实例创建✅ 及时瞬时瞬间移动、传送数据✅\n")