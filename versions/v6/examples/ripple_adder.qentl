# ================================================================
# 量子Ripple加法器 — 多比特量子算术
# 4比特加法器: 量子算术核心单元
# ================================================================

printf("=== 量子Ripple加法器 ===\n\n")
printf("多比特加法: 级联全加器\n")
printf("4比特: 输入A+B, 输出和\n\n")

# Ripple加法器: 逐位进位
# 用全加器逻辑: sum=a^b^carry, carry=majority

printf("测试: A+B\n\n")

# 测试2比特加法 (0-3范围)
var add_ok = 0
var add_total = 0
var a = 0
while (a < 4):
    var b = 0
    while (b < 4):
        add_total = add_total + 1
        var q = qreg_create(6)
        
        # 编码A (2比特): q[0]低位, q[1]高位
        if (a % 2 == 1): x q[0] end
        if (a / 2 == 1): x q[1] end
        # 编码B (2比特): q[2]低位, q[3]高位
        if (b % 2 == 1): x q[2] end
        if (b / 2 == 1): x q[3] end
        
        # 加法: 用CX计算sum
        # 低位和: q[4] = a0 ^ b0
        cx q[0], q[4]
        cx q[2], q[4]
        # 高位和: q[5] = a1 ^ b1
        cx q[1], q[5]
        cx q[3], q[5]
        
        # 测量和
        var s0 = measure(q, 4)
        var s1 = measure(q, 5)
        var sum = s0 + s1 * 2
        
        var expected = a + b
        # 若超过3, 取mod 4 (进位丢失演示)
        if (expected >= 4):
            expected = expected - 4
        end
        
        if (sum == expected):
            add_ok = add_ok + 1
        end
        qreg_free(q)
        b = b + 1
    end
    a = a + 1
end

printf("2比特加法: %d/%d 正确\n", add_ok, add_total)
if (add_ok == add_total):
    printf("量子加法器: 通过 ✅ (多比特算术)\n")
end

printf("\n=== Ripple加法器完成 ===\n")