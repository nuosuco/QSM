# ================================================================
# 3比特相位翻转码演示
# 演示Z错误的检测和纠正
# ================================================================

printf("=== 3比特相位翻转码演示 ===\n\n")

# 测试1: 无错误
printf("--- 测试1: 无错误 ---\n")
var q1 = qreg_create(3)
apply_h(q1, 0)
apply_h(q1, 1)
apply_h(q1, 2)

# X基测量验证
apply_h(q1, 0)
apply_h(q1, 1)
apply_h(q1, 2)
var m0 = measure(q1, 0)
var m1 = measure(q1, 1)
var m2 = measure(q1, 2)
printf("  X基测量: q0=%d, q1=%d, q2=%d\n", m0, m1, m2)
if (m0 == m1 and m1 == m2):
    printf("  ✓ 编码正确\n\n")
else:
    printf("  ✗ 编码失败\n\n")
end

# 测试2: Z错误注入
printf("--- 测试2: Z错误注入 (q1) ---\n")
var q2 = qreg_create(3)
apply_h(q2, 0)
apply_h(q2, 1)
apply_h(q2, 2)
apply_z(q2, 1)  # 注入Z错误

# X基测量
apply_h(q2, 0)
apply_h(q2, 1)
apply_h(q2, 2)
var m0b = measure(q2, 0)
var m1b = measure(q2, 1)
var m2b = measure(q2, 2)
printf("  X基测量: q0=%d, q1=%d, q2=%d\n", m0b, m1b, m2b)
if (m0b != m1b or m1b != m2b):
    printf("  ✓ Z错误检测成功 (测量结果不一致)\n\n")
else:
    printf("  ✗ Z错误检测失败\n\n")
end

# 测试3: 9比特Shor码编码
printf("--- 测试3: 9比特Shor码编码 ---\n")
var q3 = qreg_create(9)
apply_h(q3, 0)
apply_h(q3, 3)
apply_h(q3, 6)
apply_cx(q3, 0, 1)
apply_cx(q3, 0, 2)
apply_cx(q3, 3, 4)
apply_cx(q3, 3, 5)
apply_cx(q3, 6, 7)
apply_cx(q3, 6, 8)

# 验证编码
var m0c = measure(q3, 0)
var m1c = measure(q3, 1)
var m2c = measure(q3, 2)
printf("  第一组测量: q0=%d, q1=%d, q2=%d\n", m0c, m1c, m2c)
if (m0c == m1c and m1c == m2c):
    printf("  ✓ 第一组编码正确\n")
end

var m3c = measure(q3, 3)
var m4c = measure(q3, 4)
var m5c = measure(q3, 5)
printf("  第二组测量: q3=%d, q4=%d, q5=%d\n", m3c, m4c, m5c)
if (m3c == m4c and m4c == m5c):
    printf("  ✓ 第二组编码正确\n")
end

var m6c = measure(q3, 6)
var m7c = measure(q3, 7)
var m8c = measure(q3, 8)
printf("  第三组测量: q6=%d, q7=%d, q8=%d\n", m6c, m7c, m8c)
if (m6c == m7c and m7c == m8c):
    printf("  ✓ 第三组编码正确\n\n")
else:
    printf("  ✗ 第三组编码失败\n\n")
end

printf("=== 演示完成 ===\n")
