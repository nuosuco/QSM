# ================================================================
# Surface码演示 - 二维拓扑量子纠错
# 最简surface码: 5量子位环面码
# 展示量子纠错的未来方向
# ================================================================

printf("=== 表面码演示 (简化版) ===\n")
printf("原理: 量子比特排列在二维晶格上\n")
printf("稳定子: 顶点算子(奇偶校验) + 面元算子(磁通)\n\n")

# 简化演示: 用4量子位环展示表面码思想
printf("--- 测试1: 4量子位环面码 ---\n")
var q1 = qreg_create(4)
var anc1 = qreg_create(2)

# 编码: GHZ态
apply_h(q1, 0)
apply_cx(q1, 0, 1)
apply_cx(q1, 0, 2)
apply_cx(q1, 0, 3)

# 顶点稳定子测量 (检测X错误)
# A1 = Z1 Z2
apply_cx(q1, 0, anc1, 0)
apply_cx(q1, 1, anc1, 0)
var a1 = measure(anc1, 0)

# A2 = Z2 Z3
apply_cx(q1, 1, anc1, 1)
apply_cx(q1, 2, anc1, 1)
var a2 = measure(anc1, 1)

printf("  顶点稳定子: A1=%d, A2=%d\n", a1, a2)

# 面元稳定子测量 (检测Z错误)
# B1 = X1 X2 X3 X4
apply_h(q1, 0)
apply_h(q1, 1)
apply_h(q1, 2)
apply_h(q1, 3)
apply_cx(q1, 0, anc1, 0)
apply_cx(q1, 1, anc1, 0)
apply_cx(q1, 2, anc1, 0)
apply_cx(q1, 3, anc1, 0)
apply_h(q1, 0)
apply_h(q1, 1)
apply_h(q1, 2)
apply_h(q1, 3)
var b1 = measure(anc1, 0)

printf("  面元稳定子: B1=%d\n", b1)

if (a1 == 0 and a2 == 0 and b1 == 0):
    printf("  ✓ 无错误\n\n")
else:
    printf("  检测到错误\n\n")
end

printf("--- 测试2: 表面码纠错演示 ---\n")
var q2 = qreg_create(4)
var anc2 = qreg_create(2)

# 编码
apply_h(q2, 0)
apply_cx(q2, 0, 1)
apply_cx(q2, 0, 2)
apply_cx(q2, 0, 3)

# 注入X错误到 q1
apply_x(q2, 0)
printf("  注入X错误到 q0\n")

# 测量稳定子
apply_cx(q2, 0, anc2, 0)
apply_cx(q2, 1, anc2, 0)
var sa1 = measure(anc2, 0)

apply_cx(q2, 1, anc2, 1)
apply_cx(q2, 2, anc2, 1)
var sa2 = measure(anc2, 1)

printf("  顶点稳定子: A1=%d, A2=%d\n", sa1, sa2)

# 解码: 根据syndrome定位错误
# A1=1, A2=0 -> q0 或 q1 错误
if (sa1 == 1 and sa2 == 0):
    printf("  定位: q0 或 q1 X错误\n")
    apply_x(q2, 0)
    printf("  纠正: 应用 X 到 q0\n")
end

printf("  ✓ 表面码纠错演示完成\n\n")

printf("--- 测试3: 逻辑量子位编码 ---\n")
printf("表面码优势: 纠错阈值高 (~1%), 可扩展性强\n")
printf("逻辑量子位: 由大量物理量子位编码\n")
printf("容错阈值: 物理错误率 < 1% 时可实现任意精度计算\n\n")

printf("=== 表面码演示完成 ===\n")
printf("下一步: 实现完整的surface_code解码器\n")
