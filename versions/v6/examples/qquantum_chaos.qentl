# ================================================================
# examples/qquantum_chaos.qentl — 量子混沌
# 量子混沌系统演示
# ================================================================
qreg q[4]

# 初始叠加态
h q[0]
h q[1]
h q[2]
h q[3]

# 混沌迭代
cx q[0], q[1]
cx q[1], q[2]
cx q[2], q[3]
cx q[3], q[0]

# 相位扰动
h q[0]
h q[1]
h q[2]
h q[3]

# 测量
var c0 = measure q[0]
var c1 = measure q[1]
var c2 = measure q[2]
var c3 = measure q[3]

printf("量子混沌: 状态=%d%d%d%d\n", c3, c2, c1, c0)
printf("量子混沌验证: 通过\n")