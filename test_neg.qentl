def main():
    var v1 = str_to_int("-600")
    var v2 = str_to_int("-300")
    var v3 = str_to_int("600")
    printf("str_to_int('-600')=%d\n", v1)
    printf("str_to_int('-300')=%d\n", v2)
    printf("str_to_int('600')=%d\n", v3)
    printf("str_char_at('-600',0)=%d\n", ord(str_char_at("-600", 0)))
    printf("str_char_at('-600',1)=%d\n", ord(str_char_at("-600", 1)))
end
main()
