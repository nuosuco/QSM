{
  "sms": {
    "enabled": false,
    "provider": "aliyun",
    "access_key_id": "你的阿里云AccessKeyID",
    "access_key_secret": "你的阿里云AccessKeySecret",
    "sign_name": "你的短信签名",
    "template_code": "你的验证码模板ID",
    "intl_sign_name": "国际短信签名（可选，没有就留空用国内的）",
    "intl_template_code": "国际短信模板ID（可选）",
    "region": "cn-hangzhou"
  },
  "email": {
    "enabled": false,
    "smtp_host": "smtp.qq.com",
    "smtp_port": 465,
    "smtp_user": "你的邮箱",
    "smtp_pass": "邮箱授权码（不是登录密码）",
    "from_name": "SOM松麦",
    "use_ssl": true
  },
  "wechat": {
    "enabled": false,
    "appid": "小程序AppID",
    "secret": "小程序AppSecret"
  },
  "code_length": 6,
  "code_expire_minutes": 5,
  "code_cooldown_seconds": 60,
  "max_attempts_per_hour": 10
}
