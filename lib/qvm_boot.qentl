# ================================================================
# qvm_boot.qentl — QEntL 自举启动器（纯QEntL，无bash依赖）
# ================================================================
#
# 设计：用QEntL写的启动器，作为系统核心入口
#
# 双保险启动：
#   第一层: QVM+QCL自举链（主力）
#   第二层: 回退到C种子模式（冗余）
#
# 使用方式：
#   bin/q_bootstrap run lib/qvm_boot.qbc
#
# 注意：此版本通过 .qvm_boot_arg 文件获取参数
#       由 qvm_boot.sh 写入程序路径
#
# ================================================================

# 配置路径
var g_qvm_path = "run/qvm.qbc"
var g_qcl_path = "run/qcl.qbc"
var g_qns_path = "components/qns/qns.qentl"
var g_input_path = "input.qentl"
var g_output_path = "output.qbc"
var g_target_path = "target.qbc"
var g_root = "/root/QSM"
var g_arg_file = ".qvm_boot_arg"

# ================================================================
# 辅助函数：去除字符串末尾的换行符
# ================================================================
def trim_newline(s):
    var len = str_len(s)
    if (len > 0):
        var last_char = str_substring(s, len - 1, 1)
        if (str_eq(last_char, "\n")):
            return str_substring(s, 0, len - 1)
        end
    end
    return s
end

# ================================================================
# 辅助函数：检查文件是否存在
# ================================================================
def check_file_exists(path):
    var check_cmd = "test -f " + g_root + "/" + path + " && echo 1 || echo 0"
    var result = trim_newline(exec(check_cmd))
    if (str_eq(result, "1")):
        return 1
    end
    return 0
end

# ================================================================
# 辅助函数：运行shell命令
# ================================================================
def run_cmd(cmd):
    exec(cmd)
    return 1
end

# ================================================================
# 辅助函数：获取文件扩展名
# ================================================================
def get_file_extension(path):
    var len = str_len(path)
    var ext_len = 0
    var i = len - 1
    while (i >= 0):
        var c = str_substring(path, i, 1)
        if (str_eq(c, ".")):
            ext_len = len - i
            break
        end
        i = i - 1
    end
    if (ext_len > 0):
        return str_substring(path, len - ext_len, ext_len)
    end
    return ""
end

# ================================================================
# 辅助函数：自举编译（用QCL编译QEntL源码）
# ================================================================
def boot_compile(program_path):
    printf("[BOOT] 自举编译: %s\n", program_path)
    
    # 清理旧文件
    run_cmd("rm -f " + g_root + "/output.qbc " + g_root + "/target.qbc " + g_root + "/input.qentl " + g_root + "/" + g_arg_file)
    
    # 设置QCL为虚拟机目标
    run_cmd("cp " + g_root + "/run/qcl.qbc " + g_root + "/target.qbc")
    
    # 复制用户程序为输入
    run_cmd("cat " + program_path + " > " + g_root + "/input.qentl")
    
    # 运行QVM，QVM加载QCL，QCL编译用户程序→output.qbc
    run_cmd("cd " + g_root + " && bin/q_bootstrap run run/qvm.qbc")
    
    # 检查编译结果
    if (check_file_exists("output.qbc") == 0):
        printf("[BOOT] 错误: QCL编译失败\n")
        return 0
    end
    
    var output_size = trim_newline(exec("stat -c%s " + g_root + "/output.qbc"))
    printf("[BOOT] 编译成功: %s 字节\n", output_size)
    return 1
end

# ================================================================
# 辅助函数：运行程序
# ================================================================
def boot_run_program(program_path):
    var ext = get_file_extension(program_path)
    var is_qentl = 0
    if (str_eq(ext, ".qentl")):
        is_qentl = 1
    end
    
    if (is_qentl == 1):
        if (boot_compile(program_path) == 0):
            return 0
        end
        run_cmd("cp " + g_root + "/output.qbc " + g_root + "/target.qbc")
    else:
        run_cmd("cp " + program_path + " " + g_root + "/target.qbc")
    end
    
    run_cmd("rm -f " + g_root + "/input.qentl")
    printf("[BOOT] 运行: %s\n", program_path)
    run_cmd("cd " + g_root + " && bin/q_bootstrap run run/qvm.qbc")
    return 1
end

# ================================================================
# 主入口
# ================================================================
printf("[BOOT] QEntL自举启动器 v1\n")
printf("[BOOT] 工作目录: %s\n", g_root)

# 检查环境
if (check_file_exists("bin/q_bootstrap") == 0):
    printf("[BOOT] 错误: 找不到 bin/q_bootstrap\n")
    run_cmd("exit 1")
end
if (check_file_exists(g_qvm_path) == 0):
    printf("[BOOT] 错误: 找不到 %s\n", g_qvm_path)
    run_cmd("exit 1")
end
if (check_file_exists(g_qcl_path) == 0):
    printf("[BOOT] 错误: 找不到 %s\n", g_qcl_path)
    run_cmd("exit 1")
end
printf("[BOOT] 环境检查通过\n")

# 检查是否有通过文件传递的参数
var arg_file_exists = check_file_exists(g_arg_file)
var program_path = ""
if (arg_file_exists == 1):
    program_path = trim_newline(exec("cat " + g_root + "/" + g_arg_file))
    run_cmd("rm -f " + g_root + "/" + g_arg_file)
    printf("[BOOT] 从文件读取参数: %s\n", program_path)
    boot_run_program(program_path)
else:
    # 无参数：QVM自举模式
    printf("[BOOT] QVM自举启动 (双重保险模式)\n")
    printf("[BOOT] 第一层: QVM+QCL自举链 (主力)\n")
    printf("[BOOT] 第二层: C种子启动器 (冗余备份)\n")
    printf("[BOOT] =====================================\n")
    run_cmd("rm -f " + g_root + "/output.qbc " + g_root + "/input.qentl")
    run_cmd("cp " + g_root + "/run/qvm.qbc " + g_root + "/target.qbc")
    run_cmd("cd " + g_root + " && bin/q_bootstrap run run/qvm.qbc")
end

printf("[BOOT] 启动完成\n")
