# ================================================================
# qvm_boot.qentl — QEntL 自举启动器（常驻运行时版）
# C种子只点火启动QVM一次，之后QVM常驻处理所有任务
# ================================================================

var g_root = "/root/QSM"

# ================================================================
# 辅助函数：去除字符串末尾的换行符
# ================================================================
def trim_newline(s):
    var len = str_len(s)
    if (len > 0):
        var last_char = str_substring(s, len - 1, 1)
        if (last_char == "\n"):
            return str_substring(s, 0, len - 1)
        end
    end
    return s
end

# ================================================================
# 主入口
# ================================================================
printf("[BOOT] QEntL自举启动器 v2（常驻运行时）\n")
printf("[BOOT] 工作目录: %s\n", g_root)

# 检查环境
var qvm_check = exec("test -f /root/QSM/run/qvm.qbc && echo OK || echo FAIL")
qvm_check = trim_newline(qvm_check)
if (qvm_check == "FAIL"):
    printf("[BOOT] 错误: 找不到 QVM (run/qvm.qbc)\n")
    exec("exit 1")
end

var qcl_check = exec("test -f /root/QSM/run/qcl.qbc && echo OK || echo FAIL")
qcl_check = trim_newline(qcl_check)
if (qcl_check == "FAIL"):
    printf("[BOOT] 错误: 找不到 QCL (run/qcl.qbc)\n")
    exec("exit 1")
end

printf("[BOOT] 环境检查通过\n")

# 检查是否有源码要编译
var has_input = exec("test -f /root/QSM/input.qentl && echo YES || echo NO")
has_input = trim_newline(has_input)

# 清理旧文件
exec("rm -f /root/QSM/.qvm_next /root/QSM/output.qbc /root/QSM/target.qbc")

if (has_input == "YES"):
    # 有源码要编译：写入完整任务链（两行）
    printf("[BOOT] 发现 input.qentl，写入完整任务链\n")
    printf("[BOOT] 任务1: run/qcl.qbc（编译input.qentl→output.qbc）\n")
    printf("[BOOT] 任务2: output.qbc（运行编译结果）\n")
    exec("echo 'run/qcl.qbc' > /root/QSM/.qvm_next")
    exec("echo 'output.qbc' >> /root/QSM/.qvm_next")
else:
    # 无源码：写入单任务链，启动QCL
    printf("[BOOT] 启动QVM常驻运行时（无输入）\n")
    printf("[BOOT] =====================================\n")
    exec("echo 'run/qcl.qbc' > /root/QSM/.qvm_next")
end

# 设置当前要运行的程序为QCL
exec("cp /root/QSM/run/qcl.qbc /root/QSM/target.qbc")

printf("[BOOT] 启动完成，QVM进入常驻模式\n")
printf("[BOOT] QVM将自动逐行处理.qvm_next中的任务链\n")