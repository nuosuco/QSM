# ===== 总字数 =====
var yi_total = 300

# ===== 翻译函数 =====
def yi_data_size():
    return yi_total
end

def yi_to_zh(char):
    var i = 0
    while (i < yi_data_size()):
        if (str_eq(yi_chars[i], char)):
            return yi_zh[i]
        end
        i = i + 1
    end
    return "未知"
end

def yi_to_en(char):
    var i = 0
    while (i < yi_data_size()):
        if (str_eq(yi_chars[i], char)):
            return yi_en[i]
        end
        i = i + 1
    end
    return "unknown"
end

# ===== 测试 =====
def test_yi_data():
    printf("彝文数据: %d字 (目标4120→扩展中)\n", yi_data_size())
    printf("--- 彝文三语映射 ---\n")
    var i = 0
    while (i < 5):
        printf("  %s = %s (%s)\n", yi_chars[i], yi_zh[i], yi_en[i])
        i = i + 1
    end
    printf("  ...\n")
    i = 195
    while (i < yi_data_size()):
        printf("  %s = %s (%s)\n", yi_chars[i], yi_zh[i], yi_en[i])
        i = i + 1
    end
    printf("彝文数据验证: 通过 ✅\n")
end

test_yi_data()