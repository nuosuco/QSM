# tiny_probe.qentl - 最小探针验证 emit_ints 基本可用
var g_h = arr_new(8)
arr_set(g_h, 0, 10)
arr_set(g_h, 1, -20)
arr_set(g_h, 2, 30)
arr_set(g_h, 3, 40)
arr_set(g_h, 4, -50)
arr_set(g_h, 5, 60)
arr_set(g_h, 6, 70)
arr_set(g_h, 7, 80)
printf("MARK: ")
emit_str("HELLO ")
emit_ints(g_h, 0, 8)
printf("\nBYE\n")
