# QSCL真训练: 固定编码器+1参数偏置b, 4态不同起点, 梯度下降
# 数据: qdfs/ns/data/yi_train_4120.data (4120条, 码点 标签)
# 编码: 6位十进制数字加权求和(权重固定)

var g_data = ""
var g_nrows = 0
var g_b = 0
var g_w0 = 0
var g_w1 = 0
var g_w2 = 0
var g_w3 = 0
var g_w4 = 0
var g_w5 = 0

# 加载数据
def load_data():
    g_data = file_read("qdfs/ns/data/yi_train_4120.data")
    if (str_len(g_data) == 0):
        printf("数据加载失败\n")
        return 0
    end
    # 每行9字节(6码点+空格+标签+换行), 但最后一行可能无换行
    g_nrows = 0
    var pos = 0
    var dl = str_len(g_data)
    while (pos < dl):
        var nl = str_index_of(str_substring(g_data, pos, 60000), "\n")
        if (nl < 0): 
            g_nrows = g_nrows + 1
            pos = dl
        else:
            g_nrows = g_nrows + 1
            pos = pos + nl + 1
        end
    end
    return g_nrows - 1
end

# 行号→码点(从数据取)
def row_code(row):
    var rs = 0
    var i = 0
    while (i < row):
        var nl = str_index_of(str_substring(g_data, rs, 60000), "\n")
        if (nl < 0):
            return 0
        end
        rs = rs + nl + 1
        i = i + 1
    end
    return str_to_int(str_substring(g_data, rs, 6))
end

# 编码: 6位十进制数字加权求和
def encode(code):
    var tmp = code
    var d5 = tmp % 10; tmp = tmp / 10
    var d4 = tmp % 10; tmp = tmp / 10
    var d3 = tmp % 10; tmp = tmp / 10
    var d2 = tmp % 10; tmp = tmp / 10
    var d1 = tmp % 10; tmp = tmp / 10
    var d0 = tmp % 10
    var c = g_w0 * d0
    c = c + g_w1 * d1
    c = c + g_w2 * d2
    c = c + g_w3 * d3
    c = c + g_w4 * d4
    c = c + g_w5 * d5
    return c
end

# 预测: encode(code) - b
def predict(code):
    return encode(code) - g_b
end

# 主训练
def train():
    var n = load_data()
    printf("数据: %d 行\n", n)
    if (n == 0): return 0 end

    # 固定编码器权重(位置加权)
    g_w0 = 10000 * 10
    g_w1 = 10000; g_w2 = 1000; g_w3 = 100; g_w4 = 10; g_w5 = 1

    var lr = 1; var scale = 1; var epochs = 5

    # 4态训练
    var state = 0
    while (state < 4):
        g_b = state * 100
        var ep = 1
        while (ep <= epochs):
            var row = 0; var cnt = 0; var err_sum = 0
            while (row < n):
                var rem4 = row - (row / 4) * 4
                if (rem4 == state):
                    var code = row_code(row)
                    # 目标: 标签行最后数字
                    var rs = 0
                    var i = 0
                    while (i < row):
                        var nl = str_index_of(str_substring(g_data, rs, 60000), "\n")
                        rs = rs + nl + 1
                        i = i + 1
                    end
                    var label_str = str_substring(g_data, rs + 7, 4)
                    var target = str_to_int(label_str)
                    var pred = predict(code)
                    var delta = target - pred
                    g_b = g_b - lr * delta / scale
                    cnt = cnt + 1
                end
                row = row + 1
            end
            ep = ep + 1
        end
        var wpath = str_concat("qdfs/ns/models/yi_state_", int_to_str(state))
        wpath = str_concat(wpath, ".w")
        file_write_bytes(wpath, int_to_str(g_b))
        printf("态%d: b=%d\n", state, g_b)
        state = state + 1
    end
    return 1
end

train()