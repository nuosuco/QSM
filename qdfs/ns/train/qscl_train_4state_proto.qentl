# QSCL叠加态训练 v16 - 固定E只训练W (感知机, 一对一任务)
# 4态不同起步: E/W随机初始化种子不同; 训练只更新W, E固定
# 任务: code(0-15) -> label=code (一对一), 高维线性可分, 感知机保证收敛
var D = 8
var K = 16
var N = 16
var EPOCHS = 60
var LR = 20

def prand(c, s):
    var v = c * 137 + s * 7919
    v = v % 97
    return v + 3
end

var E1[128]
var E2[128]
var E3[128]
var E4[128]
var W1[128]
var W2[128]
var W3[128]
var W4[128]

def init_weights(seed, E, W):
    var i = 0
    while (i < N * D):
        E[i] = prand(i, seed) % 93 + 3
        i = i + 1
    end
    i = 0
    while (i < K):
        var j = 0
        while (j < D):
            W[i * D + j] = prand(i * 17 + j, seed * 3) % 19 + 1
            j = j + 1
        end
        i = i + 1
    end
end

def train_state(seed, E, W):
    var x[16]
    var logits[32]
    var gradW[128]
    var epoch = 0
    while (epoch < EPOCHS):
        var correct = 0
        var code = 0
        while (code < N):
            var label = code % K
            x = embedding(code, D, E)
            logits = mat_mul(x, W, D, K)
            var pred = argmax(logits, K)
            if (pred == label):
                correct = correct + 1
            else:
                # 感知机: W[label] += x, W[pred] -= x
                # mat_mul读W[j*m+i]=W[输入维][类], 所以更新也用同布局: W[d*K+cls]
                var i = 0
                while (i < K * D):
                    gradW[i] = 0
                    i = i + 1
                end
                var d = 0
                while (d < D):
                    gradW[d * K + label] = x[d]
                    gradW[d * K + pred] = 0 - x[d]
                    d = d + 1
                end
                backprop(W, gradW, K * D, LR)
            end
            code = code + 1
        end
        printf("  epoch%d acc=%d/%d (%d%%)  seed=%d  W[0]=%d\n", epoch, correct, N, correct * 100 / N, seed, W[0])
        epoch = epoch + 1
    end
end

printf("=== 4态不同起步独立训练 (E固定,只训W) ===\n")
init_weights(1, E1, W1)
train_state(1, E1, W1)
init_weights(2, E2, W2)
train_state(2, E2, W2)
init_weights(3, E3, W3)
train_state(3, E3, W3)
init_weights(4, E4, W4)
train_state(4, E4, W4)

printf("=== 观测坍缩合并(投票: 4态各自预测, 多数决) ===\n")
var x2[16]
var logits2[32]
var correct = 0
var code = 0
while (code < N):
    var label = code % K
    var votes[16]
    var i = 0
    while (i < K):
        votes[i] = 0
        i = i + 1
    end
    # 4态各自预测
    x2 = embedding(code, D, E1)
    logits2 = mat_mul(x2, W1, D, K)
    var p1 = argmax(logits2, K)
    votes[p1] = votes[p1] + 1
    x2 = embedding(code, D, E2)
    logits2 = mat_mul(x2, W2, D, K)
    var p2 = argmax(logits2, K)
    votes[p2] = votes[p2] + 1
    x2 = embedding(code, D, E3)
    logits2 = mat_mul(x2, W3, D, K)
    var p3 = argmax(logits2, K)
    votes[p3] = votes[p3] + 1
    x2 = embedding(code, D, E4)
    logits2 = mat_mul(x2, W4, D, K)
    var p4 = argmax(logits2, K)
    votes[p4] = votes[p4] + 1
    # 多数决
    var best = 0
    var bv = 0
    i = 0
    while (i < K):
        if (votes[i] > bv):
            bv = votes[i]
            best = i
        end
        i = i + 1
    end
    if (best == label): correct = correct + 1 end
    code = code + 1
end
printf("=== 坍缩(投票)后准确率: %d/%d (%d%%) ===\n", correct, N, correct * 100 / N)
printf("态1[0]=%d 态2[0]=%d 态3[0]=%d 态4[0]=%d\n", E1[0], E2[0], E3[0], E4[0])
printf("态1[10]=%d 态2[10]=%d 态3[10]=%d 态4[10]=%d\n", E1[10], E2[10], E3[10], E4[10])