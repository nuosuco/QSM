# 诊断9: 精确复现冒烟的3池布局，逐步骤查权重是否被改
def main():
    printf("=== diag9: 3-pool exact v9 layout ===\n")
    var wsz = 515
    wsz = wsz * 1024
    g_xh = arr_new(1024)
    g_nxh = arr_new(1024)
    g_wh = arr_new(wsz)
    printf("[0] xh=%d nxh=%d wh=%d wsz=%d\n", g_xh, g_nxh, g_wh, wsz)

    # 模拟 parse_sample: 填 xh[0..3]=1, nxh[0..3]=-1
    arr_set(g_xh, 0, 1)
    arr_set(g_xh, 1, 1)
    arr_set(g_xh, 2, 1)
    arr_set(g_xh, 3, 1)
    arr_set(g_nxh, 0, 0 - 1)
    printf("[1] xh[0]=%d nxh[0]=%d\n", arr_get(g_xh, 0), arr_get(g_nxh, 0))

    # boost_class(label=0, lr=500): axpy_arr_at(g_wh, 0, g_xh, 1024, 500)
    axpy_arr_at(g_wh, 0, g_xh, 1024, 500)
    printf("[2] boost后 wh[0]=%d(期望0.50->0整除, 或1) wh[1]=%d wh[2]=%d wh[3]=%d\n",
        arr_get(g_wh, 0), arr_get(g_wh, 1), arr_get(g_wh, 2), arr_get(g_wh, 3))

    # 用 lr=1000 应精确收敛到 x
    g_wh2 = arr_new(wsz)
    axpy_arr_at(g_wh2, 0, g_xh, 4, 1000)
    printf("[3] wh2 lr=1000: wh2[0]=%d wh2[1]=%d wh2[2]=%d wh2[3]=%d (期望全1)\n",
        arr_get(g_wh2, 0), arr_get(g_wh2, 1), arr_get(g_wh2, 2), arr_get(g_wh2, 3))

    # 类3 起点 off=3072 是否可写（检查1 修复验证）
    arr_set(g_wh2, 3072, 123)
    printf("[4] wh2[3072]=%d xh[0]=%d (若xh[0]=123则池重叠)\n",
        arr_get(g_wh2, 3072), arr_get(g_xh, 0))
    return 0
end

main()
