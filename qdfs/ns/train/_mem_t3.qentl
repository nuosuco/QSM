# 内存泄漏隔离测试 v3: dot_arr_at offset 递增 (模拟 arecog 的 cc*1024)
var wsz = 527360
var wh = arr_new(wsz)
var xh = arr_new(1024)
var j = 0
while (j < 1024):
    arr_set(xh, j, 1)
    j = j + 1
end
var rb = 0
while (rb < 42):
    var rf = "qdfs/ns/models/merged_row_b"
    rf = str_concat(rf, int_to_str(rb))
    rf = str_concat(rf, ".w")
    var nw = load_ints_from_file(rf, wh, wsz)
    rb = rb + 1
end
# 模拟 arecog: 42批 × 129类 × dot(offset=cc*1024)
var total = 0
var rb2 = 0
while (rb2 < 42):
    var cc = 0
    while (cc < 129):
        var sc = dot_arr_at(wh, cc * 1024, xh, 1024)
        total = total + sc
        cc = cc + 1
    end
    rb2 = rb2 + 1
end
printf("完成 total=%d\n", total)
