# leak_probe.qentl - 零泄漏探针(emit_ints 新通道)
# 527360 值池, 值 = idx%7 - 3 (含负数), 一次 emit_ints 全喷出
var g_size = 515
g_size = g_size * 1024        # 计算式: 527360 (禁字面量>65535)
var g_h = arr_new(g_size)
var g_i = 0
while (g_i < g_size):
    arr_set(g_h, g_i, g_i % 7 - 3)
    g_i = g_i + 1
end
printf("FILL done size=%d h=%d\n", g_size, g_h)
emit_ints(g_h, 0, g_size)
printf("\nDONE emit_ints count=%d\n", g_size)
