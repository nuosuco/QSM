# 诊断7: axpy_arr_at 用全局池句柄（小池）是否真的不生效
def main():
    printf("=== diag7: global-handle axpy small-pool check ===\n")
    g_wh = arr_new(8)
    g_xh = arr_new(4)
    arr_set(g_wh, 0, 5)
    arr_set(g_wh, 1, 6)
    arr_set(g_xh, 0, 1)
    arr_set(g_xh, 1, 2)
    var w0a = arr_get(g_wh, 0)
    var w1a = arr_get(g_wh, 1)
    var x0 = arr_get(g_xh, 0)
    var x1 = arr_get(g_xh, 1)
    printf("[1] init wh0=%d wh1=%d xh0=%d xh1=%d\n", w0a, w1a, x0, x1)
    axpy_arr_at(g_wh, 0, g_xh, 2, 1000)
    var w0b = arr_get(g_wh, 0)
    var w1b = arr_get(g_wh, 1)
    printf("[2] axpy lr=1000 wh0=%d wh1=%d\n", w0b, w1b)
    g_wh2 = arr_new(8)
    g_xh2 = arr_new(4)
    arr_set(g_wh2, 0, 0)
    arr_set(g_xh2, 0, 3)
    axpy_arr_at(g_wh2, 0, g_xh2, 1, 500)
    printf("[3] axpy lr=500 x=3 w=%d\n", arr_get(g_wh2, 0))
    g_wh3 = arr_new(8)
    g_xh3 = arr_new(4)
    arr_set(g_wh3, 0, 5)
    arr_set(g_xh3, 0, 3)
    axpy_arr_at(g_wh3, 0, g_xh3, 1, 0 - 500)
    printf("[4] axpy neglr=-500 W=5 x=3 w=%d\n", arr_get(g_wh3, 0))
    return 0
end

main()
