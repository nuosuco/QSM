# QSCL字形训练 — 正确数据版
# 4个样本, 每类16个独立像素, 用不同模式区分
# 样本0: 像素0-15为1, 其余为0
# 样本1: 像素16-31为1, 其余为0
# 样本2: 像素32-47为1, 其余为0
# 样本3: 像素48-63为1, 其余为0

var g_W[64]   # 4类 × 16像素
var g_P[64]   # 4样本 × 16像素
var g_L[4]    # 4 logits

def main():
    printf("[开始]\n")
    
    # 清空
    var i = 0
    while (i < 64):
        g_P[i] = 0
        i = i + 1
    end
    
    # 样本0: 像素0-15
    i = 0
    while (i < 16):
        g_P[i] = 1
        i = i + 1
    end
    
    # 样本1: 像素16-31
    i = 16
    while (i < 32):
        g_P[i] = 1
        i = i + 1
    end
    
    # 样本2: 像素32-47
    i = 32
    while (i < 48):
        g_P[i] = 1
        i = i + 1
    end
    
    # 样本3: 像素48-63
    i = 48
    while (i < 64):
        g_P[i] = 1
        i = i + 1
    end
    
    printf("[数据] 4个样本×16像素\n")
    
    # 打印像素
    var s = 0
    while (s < 4):
        printf("样本%d:", s)
        i = 0
        while (i < 64):
            printf("%d", g_P[s * 16 + i])
            i = i + 1
        end
        printf("\n")
        s = s + 1
    end
    
    # 设置权重: 类j只响应样本j的像素
    i = 0
    while (i < 64):
        g_W[i] = 0
        i = i + 1
    end
    # 类0: 权重0-15=100
    i = 0
    while (i < 16):
        g_W[0 * 16 + i] = 100
        i = i + 1
    end
    # 类1: 权重16-31=100
    i = 16
    while (i < 32):
        g_W[1 * 16 + (i - 16)] = 100
        i = i + 1
    end
    # 类2: 权重32-47=100
    i = 32
    while (i < 48):
        g_W[2 * 16 + (i - 32)] = 100
        i = i + 1
    end
    # 类3: 权重48-63=100
    i = 48
    while (i < 64):
        g_W[3 * 16 + (i - 48)] = 100
        i = i + 1
    end
    
    printf("[权重] 已设置\n")
    
    # 测试前向
    s = 0
    while (s < 4):
        var j = 0
        while (j < 4):
            var sum = 0
            i = 0
            while (i < 16):
                sum = sum + g_W[j * 16 + i] * g_P[s * 16 + i]
                i = i + 1
            end
            g_L[j] = sum
            j = j + 1
        end
        
        var max_idx = 0
        var max_val = g_L[0]
        var k = 1
        while (k < 4):
            if (g_L[k] > max_val):
                max_val = g_L[k]
                max_idx = k
            end
            k = k + 1
        end
        
        var ok = 0
        if (max_idx == s):
            ok = 1
        end
        printf("样本%d: logits=[%d,%d,%d,%d] 预测=%d 正确=%d\n", s, g_L[0], g_L[1], g_L[2], g_L[3], max_idx, ok)
        s = s + 1
    end
    printf("[完成]\n")
end

main()