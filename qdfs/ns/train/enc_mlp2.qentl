# 标点段 17窄段 MLP (固定池, 全手写, 不用mat_mul/predict_all)
# 9位输入 → 12隐藏 → 17段, 权重全预分配, 仅arr_set写回
var g_w1 = 0
var g_b1 = 0
var g_w2 = 0
var g_b2 = 0
var g_x = 0
var g_h = 0
var g_o = 0
var g_i = 0
var g_j = 0
var g_k = 0
var g_lr = 10

def main():
    printf("=== 标点段 17窄段 MLP (固定池手写) ===\n")
    g_w1 = arr_new(108)
    g_b1 = arr_new(12)
    g_w2 = arr_new(204)
    g_b2 = arr_new(17)
    g_x = arr_new(9)
    g_h = arr_new(12)
    g_o = arr_new(17)
    # 初始化
    g_i = 0
    while (g_i < 108):
        arr_set(g_w1, g_i, (g_i * 7) % 9 - 4)
        g_i = g_i + 1
    end
    g_i = 0
    while (g_i < 204):
        arr_set(g_w2, g_i, (g_i * 5) % 9 - 4)
        g_i = g_i + 1
    end
    var ep = 0
    while (ep < 120):
        var tc = 0
        var tw = 0
        var lcl = 0
        while (lcl < 316):
            var tseg = 0
            if (lcl >= 95): tseg = 1 end
            if (lcl >= 102): tseg = 2 end
            if (lcl >= 112): tseg = 3 end
            if (lcl >= 116): tseg = 4 end
            if (lcl >= 117): tseg = 5 end
            if (lcl >= 118): tseg = 6 end
            if (lcl >= 120): tseg = 7 end
            if (lcl >= 121): tseg = 8 end
            if (lcl >= 122): tseg = 9 end
            if (lcl >= 123): tseg = 10 end
            if (lcl >= 212): tseg = 11 end
            if (lcl >= 217): tseg = 12 end
            if (lcl >= 219): tseg = 13 end
            if (lcl >= 220): tseg = 14 end
            if (lcl >= 221): tseg = 15 end
            if (lcl >= 222): tseg = 16 end
            # 输入 9位
            g_i = 0
            while (g_i < 9):
                var pv = 1
                g_j = 0
                while (g_j < g_i):
                    pv = pv * 2
                    g_j = g_j + 1
                end
                arr_set(g_x, g_i, lcl / pv % 2)
                g_i = g_i + 1
            end
            # 前向 h = relu(w1*x+b1)
            g_i = 0
            while (g_i < 12):
                var acc = arr_get(g_b1, g_i)
                g_j = 0
                while (g_j < 9):
                    acc = acc + arr_get(g_w1, g_j * 12 + g_i) * arr_get(g_x, g_j)
                    g_j = g_j + 1
                end
                if (acc < 0): acc = 0 end
                if (acc > 400): acc = 400 end
                arr_set(g_h, g_i, acc)
                g_i = g_i + 1
            end
            # 前向 o = w2*h+b2
            g_i = 0
            while (g_i < 17):
                var acc2 = arr_get(g_b2, g_i)
                g_j = 0
                while (g_j < 12):
                    acc2 = acc2 + arr_get(g_w2, g_j * 17 + g_i) * arr_get(g_h, g_j)
                    g_j = g_j + 1
                end
                arr_set(g_o, g_i, acc2)
                g_i = g_i + 1
            end
            # argmax 预测
            var best = 0
            var bv = 0 - 30000
            g_i = 0
            while (g_i < 17):
                if (arr_get(g_o, g_i) > bv):
                    bv = arr_get(g_o, g_i)
                    best = g_i
                end
                g_i = g_i + 1
            end
            if (best == tseg):
                tc = tc + 1
            else:
                tw = tw + 1
            end
            # 梯度: 预测输出 - onehot (用argmax近似, 简化)
            # w2更新
            g_j = 0
            while (g_j < 12):
                var hv = arr_get(g_h, g_j)
                g_i = 0
                while (g_i < 17):
                    var gv = 0
                    if (g_i == tseg): gv = 1 end
                    if (g_i == best): gv = gv - 1 end
                    var upd = g_lr * gv * hv / 100
                    arr_set(g_w2, g_j * 17 + g_i, arr_get(g_w2, g_j * 17 + g_i) + upd)
                    g_i = g_i + 1
                end
                g_j = g_j + 1
            end
            # b2更新
            g_i = 0
            while (g_i < 17):
                var gv2 = 0
                if (g_i == tseg): gv2 = 1 end
                if (g_i == best): gv2 = gv2 - 1 end
                arr_set(g_b2, g_i, arr_get(g_b2, g_i) + g_lr * gv2 / 100)
                g_i = g_i + 1
            end
            # w1更新
            g_j = 0
            while (g_j < 9):
                var xv = arr_get(g_x, g_j)
                g_i = 0
                while (g_i < 12):
                    var hk = arr_get(g_h, g_i)
                    var hd = 0
                    if (hk > 0): hd = 1 end
                    var sumi = 0
                    g_k = 0
                    while (g_k < 17):
                        var gvk = 0
                        if (g_k == tseg): gvk = 1 end
                        if (g_k == best): gvk = gvk - 1 end
                        sumi = sumi + arr_get(g_w2, g_i * 17 + g_k) * gvk
                        g_k = g_k + 1
                    end
                    var upd3 = g_lr * sumi * hd * xv / 1000
                    arr_set(g_w1, g_j * 12 + g_i, arr_get(g_w1, g_j * 12 + g_i) + upd3)
                    g_i = g_i + 1
                end
                g_j = g_j + 1
            end
            lcl = lcl + 1
        end
        var cr = tc * 100 / (tc + tw)
        printf("ep%d: 17段MLP(316类) 对%d 错%d = %d%%\n", ep, tc, tw, cr)
        if (tw == 0):
            break
        end
        ep = ep + 1
    end
    printf("=== 保存 MLP 权重 ===\n")
    emit_ints(g_w1, 0, 108)
    printf("\n")
    emit_ints(g_b1, 0, 12)
    printf("\n")
    emit_ints(g_w2, 0, 204)
    printf("\n")
    emit_ints(g_b2, 0, 17)
    printf("\n=== 完成 ===\n")
end
main()
