# ================================================================
# QSCL 4120字 4态叠加训练器 v1
# 核心创新：一个训练器 → 一个权重文件 qscl4120.w
# 4态不同起点(seed 1/101/202/303) → 训练到同一文件的不同区段
# 服务器加载一个文件 → 按批次路由 → 4态投票
# 循环升级：每次运行从旧权重继承 + 增量训练
#
# 架构：
#   权重文件 qscl4120.w:
#     header: 8 515 (批次数 每批类数)
#     batch0_state0: 32960 ints (515×64)
#     batch0_state1: 32960 ints
#     batch0_state2: 32960 ints
#     batch0_state3: 32960 ints
#     batch1_state0: 32960 ints
#     ...
#     batch7_state3: 32960 ints
#     总计 8×4×32960 = 1054720 权重
# ================================================================

var g_LR = 1000
var g_EP = 20
var g_BATCHES = 8
var g_NB = 515
var g_NX = 64
var g_NS = 4

# 权重(一态515类×64像素=32960)
var g_W[32960]
var g_P[32960]
var g_L[515]

var g_data = ""
var g_path = ""
var g_i = 0
var g_j = 0
var g_k = 0
var g_n = 0
var g_ep = 0
var g_s = 0
var g_base = 0
var g_sum = 0
var g_max_idx = 0
var g_max_val = 0
var g_correct = 0
var g_updates = 0
var g_pred = 0
var g_label = 0
var g_rnd = 0
var g_seed = 0
var g_batch = 0
var g_state = 0
var g_w_str = ""
var g_nl = 0
var g_line = ""
var g_c1 = 0
var g_rest = ""
var g_c2 = 0
var g_pix_str = ""
var g_ps = 0
var g_pe = 0
var g_pv = ""
var g_state_seeds[4]
var g_epoch_mode = 0
var g_skip = 0
var g_total_correct = 0
var g_total_n = 0

# ================================================================
# 主函数 - 全部内联(规避QVM多函数调用链栈下溢bug)
# ================================================================
def main():
    printf("=== QSCL 4120字 4态叠加训练器 v1 ===\n")
    printf("  权重文件: qdfs/ns/models/qscl4120.w\n")
    printf("  批次: 8 × 515字 = 4120字\n")
    printf("  每批4态: seed 1/101/202/303\n")

    # 解析4态种子
    g_state_seeds[0] = 1
    g_state_seeds[1] = 101
    g_state_seeds[2] = 202
    g_state_seeds[3] = 303
    printf("  4态种子: %d/%d/%d/%d\n", g_state_seeds[0], g_state_seeds[1], g_state_seeds[2], g_state_seeds[3])

    # 检查是否存在旧权重(循环升级模式)
    g_path = "qdfs/ns/models/qscl4120.w"
    var old_w = file_read(g_path)
    if (str_len(old_w) > 0):
        printf("[循环升级] 发现旧权重(%d字节)，从头训练覆盖\n", str_len(old_w))
        g_epoch_mode = 1
    else:
        printf("[全新训练]\n")
    end

    # 清空权重文件
    exec("truncate -s 0 " + g_path)

    # 写入header
    exec("printf -- '8 515 64 4\n' > " + g_path)

    # 8批次 × 4态
    g_batch = 0
    while (g_batch < g_BATCHES):
        printf("\n[批次%d/%d] 字%d-%d\n", g_batch, g_BATCHES, g_batch * 515, g_batch * 515 + 514)

        # === 加载批次数据 ===
        g_data = file_read("qdfs/ns/data/yi_glyph_4120_8x8.data")
        g_skip = g_batch * 515
        g_n = 0
        g_base = 0
        g_i = 0
        while (g_i < g_skip):
            g_nl = str_index_of(str_substring(g_data, g_base, 60000), "\n")
            if (g_nl < 0):
                g_base = str_len(g_data)
            else:
                g_base = g_base + g_nl + 1
            end
            g_i = g_i + 1
        end
        g_n = 0
        while (g_n < 515):
            g_nl = str_index_of(str_substring(g_data, g_base, 60000), "\n")
            g_line = ""
            if (g_nl < 0):
                g_line = str_substring(g_data, g_base, str_len(g_data) - g_base)
                g_base = str_len(g_data)
            else:
                g_line = str_substring(g_data, g_base, g_nl)
                g_base = g_base + g_nl + 1
            end
            g_c1 = str_index_of(g_line, ":")
            if (g_c1 >= 0):
                g_rest = str_substring(g_line, g_c1 + 1, 60000)
                g_c2 = str_index_of(g_rest, ":")
                if (g_c2 >= 0):
                    g_pix_str = str_substring(g_rest, 0, g_c2)
                    g_j = 0
                    g_ps = 0
                    while (g_j < 64):
                        g_pe = str_index_of(str_substring(g_pix_str, g_ps, 60000), ",")
                        g_pv = ""
                        if (g_pe < 0):
                            g_pv = str_substring(g_pix_str, g_ps, 60000)
                            g_ps = 60000
                        else:
                            g_pv = str_substring(g_pix_str, g_ps, g_pe)
                            g_ps = g_ps + g_pe + 1
                        end
                        g_P[g_n * 64 + g_j] = str_to_int(g_pv)
                        g_j = g_j + 1
                    end
                end
            end
            g_n = g_n + 1
        end
        printf("  数据加载: %d样本×64像素\n", g_n)

        # === 4态训练 ===
        g_state = 0
        while (g_state < g_NS):
            g_seed = g_state_seeds[g_state]
            printf("  [态%d seed=%d] 初始化\n", g_state, g_seed)

            # 随机初始化权重
            g_rnd = g_seed
            g_i = 0
            while (g_i < 32960):
                g_rnd = g_rnd * 1103 + 12345
                g_W[g_i] = g_rnd % 10
                g_i = g_i + 1
            end

            # 训练循环
            g_ep = 0
            while (g_ep < g_EP):
                g_updates = 0
                g_s = 0
                while (g_s < g_n):
                    # 前向传播
                    g_base = g_s * 64
                    g_j = 0
                    while (g_j < 515):
                        g_sum = 0
                        g_i = 0
                        while (g_i < 64):
                            g_sum = g_sum + g_W[g_j * 64 + g_i] * g_P[g_base + g_i]
                            g_i = g_i + 1
                        end
                        g_L[g_j] = g_sum
                        g_j = g_j + 1
                    end
                    # argmax
                    g_max_idx = 0
                    g_max_val = g_L[0]
                    g_i = 1
                    while (g_i < 515):
                        if (g_L[g_i] > g_max_val):
                            g_max_val = g_L[g_i]
                            g_max_idx = g_i
                        end
                        g_i = g_i + 1
                    end
                    g_pred = g_max_idx
                    g_label = g_s
                    if (g_pred != g_label):
                        g_base = g_s * 64
                        g_i = 0
                        while (g_i < 64):
                            if (g_P[g_base + g_i] > 0):
                                g_W[g_label * 64 + g_i] = g_W[g_label * 64 + g_i] + g_LR
                                g_W[g_pred * 64 + g_i] = g_W[g_pred * 64 + g_i] - g_LR
                            end
                            g_i = g_i + 1
                        end
                        g_updates = g_updates + 1
                    end
                    g_s = g_s + 1
                end

                # 验证
                g_correct = 0
                g_s = 0
                while (g_s < g_n):
                    g_base = g_s * 64
                    g_j = 0
                    while (g_j < 515):
                        g_sum = 0
                        g_i = 0
                        while (g_i < 64):
                            g_sum = g_sum + g_W[g_j * 64 + g_i] * g_P[g_base + g_i]
                            g_i = g_i + 1
                        end
                        g_L[g_j] = g_sum
                        g_j = g_j + 1
                    end
                    g_max_idx = 0
                    g_max_val = g_L[0]
                    g_i = 1
                    while (g_i < 515):
                        if (g_L[g_i] > g_max_val):
                            g_max_val = g_L[g_i]
                            g_max_idx = g_i
                        end
                        g_i = g_i + 1
                    end
                    if (g_max_idx == g_s):
                        g_correct = g_correct + 1
                    end
                    g_s = g_s + 1
                end

                if (g_ep % 5 == 0 or g_ep == g_EP - 1):
                    printf("    态%d ep%d: %d/%d (%d%%) upd=%d\n", g_seed, g_ep, g_correct, g_n, g_correct * 100 / g_n, g_updates)
                end
                g_ep = g_ep + 1
            end

            # 保存到权重文件(追加)
            g_w_str = ""
            g_i = 0
            while (g_i < 32960):
                g_j = 0
                while (g_j < 50 and g_i < 32960):
                    g_w_str = str_concat(g_w_str, int_to_str(g_W[g_i]))
                    g_w_str = str_concat(g_w_str, "\n")
                    g_i = g_i + 1
                    g_j = g_j + 1
                end
                exec("printf -- '" + g_w_str + "' >> " + g_path)
                g_w_str = ""
            end
            printf("  [保存] 批次%d 态%d → %s\n", g_batch, g_state, g_path)
            g_state = g_state + 1
        end
        g_batch = g_batch + 1
    end

    printf("\n=== 4120字 4态叠加训练完成 ===\n")
    printf("  权重文件: %s\n", g_path)
end

main()