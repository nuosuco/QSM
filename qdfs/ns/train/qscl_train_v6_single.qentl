# QSCL训练v6: 16字原型4态训练 → file_append合并单文件权重
# 训练: 感知机(16类, D=8), 4态不同起步
# 输出: qdfs/ns/models/qscl_model.w (单文件,8段)

var D = 8
var K = 16
var N = 16
var EPOCHS = 60
var LR = 20

# 4态权重(并行数组,每态K*D=128)
var E0[128]
var W0[128]
var E1[128]
var W1[128]
var E2[128]
var W2[128]
var E3[128]
var W3[128]

# 临时
var x[8]
var logits[16]
var gradW[128]

def prand(c, s):
    var v = c * 137 + s * 7919
    v = v % 97
    return v + 3
end

# 初始化单态(不同seed=不同起步)
def init_state(seed):
    var i = 0
    while (i < K * D):
        E0[i] = prand(i, seed) % 19 + 1
        W0[i] = prand(i * 17, seed * 13 + 7) % 19 + 1
        i = i + 1
    end
end

# 训练单态: 一对一映射 code->label=code
def train_state(epochs):
    var e = 0
    while (e < epochs):
        var idx = 0
        while (idx < N):
            embedding_to(idx, D, E0, x)
            mat_mul_to(x, W0, D, K, logits)
            var pred = argmax(logits, K)
            if (pred != idx):
                # 感知机: W[label] += x, W[pred] -= x
                var d = 0
                while (d < D):
                    W0[idx * D + d] = W0[idx * D + d] + x[d] * LR / 100
                    W0[pred * D + d] = W0[pred * D + d] - x[d] * LR / 100
                    d = d + 1
                end
            end
            idx = idx + 1
        end
        e = e + 1
    end
end

# 验证态准确率
def verify_state():
    var correct = 0
    var idx = 0
    while (idx < N):
        embedding_to(idx, D, E0, x)
        mat_mul_to(x, W0, D, K, logits)
        var pred = argmax(logits, K)
        if (pred == idx): correct = correct + 1 end
        idx = idx + 1
    end
    return correct
end

# 序列化数组到字符串(prefix=文件名段落)
def arr_to_str(prefix, arr, n):
    var content = ""
    var i = 0
    while (i < n):
        var line = str_concat(prefix, int_to_str(i))
        line = str_concat(line, ":")
        line = str_concat(line, int_to_str(arr[i]))
        line = str_concat(line, "\n")
        content = str_concat(content, line)
        i = i + 1
    end
    return content
end

# 复制权重(训练用E0/W0, 存到对应态数组)
def copy_to(dst, src, n):
    var i = 0
    while (i < n):
        dst[i] = src[i]
        i = i + 1
    end
end

printf("=== QSCL训练v6: 单文件权重输出 ===\n")

# 训练态0
init_state(1)
train_state(EPOCHS)
var ok0 = verify_state()
printf("态0: %d/16 (%d%%) seed=1\n", ok0, ok0 * 100 / N)
copy_to(E0, E0, K * D)  # E0已是
# E0存到E0数组, W0存到W0(直接用)

# 态1: 重新初始化E0/W0训练, 存E1/W1
init_state(2)
train_state(EPOCHS)
var ok1 = verify_state()
printf("态1: %d/16 (%d%%) seed=2\n", ok1, ok1 * 100 / N)
copy_to(E1, E0, K * D)
copy_to(W1, W0, K * D)

# 态2
init_state(3)
train_state(EPOCHS)
var ok2 = verify_state()
printf("态2: %d/16 (%d%%) seed=3\n", ok2, ok2 * 100 / N)
copy_to(E2, E0, K * D)
copy_to(W2, W0, K * D)

# 态3
init_state(4)
train_state(EPOCHS)
var ok3 = verify_state()
printf("态3: %d/16 (%d%%) seed=4\n", ok3, ok3 * 100 / N)
copy_to(E3, E0, K * D)
copy_to(W3, W0, K * D)

printf("\n=== 单态准确率: %d%% %d%% %d%% %d%% ===\n", ok0 * 100 / N, ok1 * 100 / N, ok2 * 100 / N, ok3 * 100 / N)

# 重新加载E态0(init_state被覆盖) - 从copy恢复
# 注意: E0被态1/2/3覆盖, 需要重新初始化态0的E
init_state(1)
copy_to(E0, E0, K * D)  # E0=seed1

# 合并输出单文件
var model_path = "/root/QSM/QLife/v0.0.3/qdfs/ns/models/qscl_model.w"
# 清理旧文件(不存在则直接写)
var first = arr_to_str("E0:", E0, K * D)
var w0str = arr_to_str("W0:", W0, K * D)
var e1str = arr_to_str("E1:", E1, K * D)
var w1str = arr_to_str("W1:", W1, K * D)
var e2str = arr_to_str("E2:", E2, K * D)
var w2str = arr_to_str("W2:", W2, K * D)
var e3str = arr_to_str("E3:", E3, K * D)
var w3str = arr_to_str("W3:", W3, K * D)

file_write_bytes(model_path, first)
file_append(model_path, w0str)
file_append(model_path, e1str)
file_append(model_path, w1str)
file_append(model_path, e2str)
file_append(model_path, w2str)
file_append(model_path, e3str)
file_append(model_path, w3str)
printf("单文件权重已保存: %s\n", model_path)