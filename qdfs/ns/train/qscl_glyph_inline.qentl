# QSCL字形训练 — 单函数展开版(规避所有函数调用bug)
# QVM已知问题: 多函数调用链会崩溃，即使全用全局变量
# 解决方案: 把所有逻辑写在main()一个函数里

var g_LR = 1000
var g_EP = 20
var g_data = ""
var g_N = 16

var g_P[1024]
var g_W[1024]
var g_L[16]

var g_i = 0
var g_j = 0
var g_base = 0
var g_sum = 0
var g_updates = 0
var g_correct = 0
var g_pred = 0
var g_n = 0
var g_ep = 0
var g_s = 0
var g_label = 0
var g_nl = 0
var g_line = ""
var g_c1 = 0
var g_rest = ""
var g_c2 = 0
var g_pix_str = ""
var g_ps = 0
var g_pe = 0
var g_pv = ""
var g_max_idx = 0
var g_max_val = 0

def main():
    printf("[开始]\n")
    
    # === 数据加载 ===
    g_data = file_read("qdfs/ns/data/yi_glyph_16_real.data")
    g_n = 0
    g_base = 0
    while (g_n < 16):
        g_nl = str_index_of(str_substring(g_data, g_base, 60000), "\n")
        g_line = ""
        if (g_nl < 0):
            g_line = str_substring(g_data, g_base, str_len(g_data) - g_base)
            g_base = str_len(g_data)
        else:
            g_line = str_substring(g_data, g_base, g_nl)
            g_base = g_base + g_nl + 1
        end
        g_c1 = str_index_of(g_line, ":")
        if (g_c1 >= 0):
            g_rest = str_substring(g_line, g_c1 + 1, 60000)
            g_c2 = str_index_of(g_rest, ":")
            if (g_c2 >= 0):
                g_pix_str = str_substring(g_rest, 0, g_c2)
                g_j = 0
                g_ps = 0
                while (g_j < 64):
                    g_pe = str_index_of(str_substring(g_pix_str, g_ps, 60000), ",")
                    g_pv = ""
                    if (g_pe < 0):
                        g_pv = str_substring(g_pix_str, g_ps, 60000)
                        g_ps = 60000
                    else:
                        g_pv = str_substring(g_pix_str, g_ps, g_pe)
                        g_ps = g_ps + g_pe + 1
                    end
                    g_P[g_n * 64 + g_j] = str_to_int(g_pv)
                    g_j = g_j + 1
                end
            end
        end
        g_n = g_n + 1
    end
    printf("[数据] %d个样本×64像素\n", g_n)
    
    # 初始化权重为0
    g_i = 0
    while (g_i < 1024):
        g_W[g_i] = 0
        g_i = g_i + 1
    end
    printf("[权重] 清零\n")
    
    # === 训练循环 ===
    g_ep = 0
    while (g_ep < g_EP):
        g_updates = 0
        g_s = 0
        while (g_s < g_n):
            # 前向传播
            g_base = g_s * 64
            g_j = 0
            while (g_j < 16):
                g_sum = 0
                g_i = 0
                while (g_i < 64):
                    g_sum = g_sum + g_W[g_j * 64 + g_i] * g_P[g_base + g_i]
                    g_i = g_i + 1
                end
                g_L[g_j] = g_sum
                g_j = g_j + 1
            end
            
            # argmax
            g_max_idx = 0
            g_max_val = g_L[0]
            g_i = 1
            while (g_i < 16):
                if (g_L[g_i] > g_max_val):
                    g_max_val = g_L[g_i]
                    g_max_idx = g_i
                end
                g_i = g_i + 1
            end
            g_pred = g_max_idx
            g_label = g_s
            
            if (g_pred == g_label):
                # 正确，跳过
            else:
                # 梯度更新
                g_base = g_s * 64
                g_i = 0
                while (g_i < 64):
                    if (g_P[g_base + g_i] > 0):
                        g_W[g_label * 64 + g_i] = g_W[g_label * 64 + g_i] + g_LR
                        g_W[g_pred * 64 + g_i] = g_W[g_pred * 64 + g_i] - g_LR
                    end
                    g_i = g_i + 1
                end
                g_updates = g_updates + 1
            end
            g_s = g_s + 1
        end
        
        # 验证
        g_correct = 0
        g_s = 0
        while (g_s < g_n):
            g_base = g_s * 64
            g_j = 0
            while (g_j < 16):
                g_sum = 0
                g_i = 0
                while (g_i < 64):
                    g_sum = g_sum + g_W[g_j * 64 + g_i] * g_P[g_base + g_i]
                    g_i = g_i + 1
                end
                g_L[g_j] = g_sum
                g_j = g_j + 1
            end
            g_max_idx = 0
            g_max_val = g_L[0]
            g_i = 1
            while (g_i < 16):
                if (g_L[g_i] > g_max_val):
                    g_max_val = g_L[g_i]
                    g_max_idx = g_i
                end
                g_i = g_i + 1
            end
            if (g_max_idx == g_s):
                g_correct = g_correct + 1
            end
            g_s = g_s + 1
        end
        
        if (g_ep % 5 == 0 or g_ep == g_EP - 1):
            printf("epoch%d: %d/%d (%d%%) updates=%d\n", g_ep, g_correct, g_n, g_correct * 100 / g_n, g_updates)
        end
        g_ep = g_ep + 1
    end
    
    # 最终验证
    g_correct = 0
    g_s = 0
    while (g_s < g_n):
        g_base = g_s * 64
        g_j = 0
        while (g_j < 16):
            g_sum = 0
            g_i = 0
            while (g_i < 64):
                g_sum = g_sum + g_W[g_j * 64 + g_i] * g_P[g_base + g_i]
                g_i = g_i + 1
            end
            g_L[g_j] = g_sum
            g_j = g_j + 1
        end
        g_max_idx = 0
        g_max_val = g_L[0]
        g_i = 1
        while (g_i < 16):
            if (g_L[g_i] > g_max_val):
                g_max_val = g_L[g_i]
                g_max_idx = g_i
            end
            g_i = g_i + 1
        end
        if (g_max_idx == g_s):
            g_correct = g_correct + 1
        end
        g_s = g_s + 1
    end
    printf("最终: %d/%d (%d%%)\n", g_correct, g_n, g_correct * 100 / g_n)
end

main()