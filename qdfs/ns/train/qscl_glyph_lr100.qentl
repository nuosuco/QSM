# QSCL字形训练 — 低学习率版(解决震荡问题)
# 改进: lr=100, epoch=50, 让模型稳定收敛

var g_LR = 100
var g_EP = 50
var g_SEED = 1
var g_data = ""
var g_N = 20
var g_source = "qdfs/ns/data/yi_glyph_20_v3.data"

var g_P[1280]
var g_W[1280]
var g_L[20]

var g_i = 0
var g_j = 0
var g_base = 0
var g_sum = 0
var g_updates = 0
var g_correct = 0
var g_pred = 0
var g_n = 0
var g_ep = 0
var g_s = 0
var g_label = 0
var g_nl = 0
var g_line = ""
var g_c1 = 0
var g_rest = ""
var g_c2 = 0
var g_pix_str = ""
var g_ps = 0
var g_pe = 0
var g_pv = ""
var g_max_idx = 0
var g_max_val = 0
var g_rnd = 0
var g_w_str = ""
var g_prev_correct = 0
var g_no_improve = 0

def main():
    printf("[开始] 低学习率训练 N=%d lr=%d\n", g_N, g_LR)
    
    # === 数据加载 ===
    g_data = file_read(g_source)
    g_n = 0
    g_base = 0
    while (g_n < g_N):
        g_nl = str_index_of(str_substring(g_data, g_base, 60000), "\n")
        g_line = ""
        if (g_nl < 0):
            g_line = str_substring(g_data, g_base, str_len(g_data) - g_base)
            g_base = str_len(g_data)
        else:
            g_line = str_substring(g_data, g_base, g_nl)
            g_base = g_base + g_nl + 1
        end
        g_c1 = str_index_of(g_line, ":")
        if (g_c1 >= 0):
            g_rest = str_substring(g_line, g_c1 + 1, 60000)
            g_c2 = str_index_of(g_rest, ":")
            if (g_c2 >= 0):
                g_pix_str = str_substring(g_rest, 0, g_c2)
                g_j = 0
                g_ps = 0
                while (g_j < 64):
                    g_pe = str_index_of(str_substring(g_pix_str, g_ps, 60000), ",")
                    g_pv = ""
                    if (g_pe < 0):
                        g_pv = str_substring(g_pix_str, g_ps, 60000)
                        g_ps = 60000
                    else:
                        g_pv = str_substring(g_pix_str, g_ps, g_pe)
                        g_ps = g_ps + g_pe + 1
                    end
                    g_P[g_n * 64 + g_j] = str_to_int(g_pv)
                    g_j = g_j + 1
                end
            end
        end
        g_n = g_n + 1
    end
    printf("[数据] %d个样本×64像素\n", g_n)
    
    # === 随机初始化权重 ===
    g_rnd = g_SEED
    g_i = 0
    while (g_i < g_N * 64):
        g_rnd = g_rnd * 1103 + 12345
        g_W[g_i] = g_rnd % 10
        g_i = g_i + 1
    end
    printf("[初始化] 种子=%d\n", g_SEED)
    
    # === 训练循环 ===
    g_ep = 0
    g_prev_correct = 0
    g_no_improve = 0
    while (g_ep < g_EP):
        g_updates = 0
        g_s = 0
        while (g_s < g_n):
            # 前向传播
            g_base = g_s * 64
            g_j = 0
            while (g_j < g_N):
                g_sum = 0
                g_i = 0
                while (g_i < 64):
                    g_sum = g_sum + g_W[g_j * 64 + g_i] * g_P[g_base + g_i]
                    g_i = g_i + 1
                end
                g_L[g_j] = g_sum
                g_j = g_j + 1
            end
            
            # argmax
            g_max_idx = 0
            g_max_val = g_L[0]
            g_i = 1
            while (g_i < g_N):
                if (g_L[g_i] > g_max_val):
                    g_max_val = g_L[g_i]
                    g_max_idx = g_i
                end
                g_i = g_i + 1
            end
            g_pred = g_max_idx
            g_label = g_s
            
            if (g_pred != g_label):
                g_base = g_s * 64
                g_i = 0
                while (g_i < 64):
                    if (g_P[g_base + g_i] > 0):
                        g_W[g_label * 64 + g_i] = g_W[g_label * 64 + g_i] + g_LR
                        g_W[g_pred * 64 + g_i] = g_W[g_pred * 64 + g_i] - g_LR
                    end
                    g_i = g_i + 1
                end
                g_updates = g_updates + 1
            end
            g_s = g_s + 1
        end
        
        # 验证
        g_correct = 0
        g_s = 0
        while (g_s < g_n):
            g_base = g_s * 64
            g_j = 0
            while (g_j < g_N):
                g_sum = 0
                g_i = 0
                while (g_i < 64):
                    g_sum = g_sum + g_W[g_j * 64 + g_i] * g_P[g_base + g_i]
                    g_i = g_i + 1
                end
                g_L[g_j] = g_sum
                g_j = g_j + 1
            end
            g_max_idx = 0
            g_max_val = g_L[0]
            g_i = 1
            while (g_i < g_N):
                if (g_L[g_i] > g_max_val):
                    g_max_val = g_L[g_i]
                    g_max_idx = g_i
                end
                g_i = g_i + 1
            end
            if (g_max_idx == g_s):
                g_correct = g_correct + 1
            end
            g_s = g_s + 1
        end
        
        printf("态%d ep%d: %d/%d (%d%%) updates=%d\n", g_SEED, g_ep, g_correct, g_n, g_correct * 100 / g_n, g_updates)
        
        # 早停
        if (g_correct >= 20):
            printf("[完美收敛]\n")
            break
        end
        if (g_correct == g_prev_correct):
            g_no_improve = g_no_improve + 1
            if (g_no_improve >= 10):
                printf("[早停] 连续%d轮无改进\n", g_no_improve)
                break
            end
        else:
            g_no_improve = 0
        end
        g_prev_correct = g_correct
        g_ep = g_ep + 1
    end
    
    # 保存
    g_w_str = ""
    g_i = 0
    while (g_i < g_N * 64):
        g_w_str = str_concat(g_w_str, int_to_str(g_W[g_i]))
        g_w_str = str_concat(g_w_str, "\n")
        g_i = g_i + 1
    end
    file_write_bytes("qdfs/ns/models/glyph_state_" + int_to_str(g_SEED) + "_lr100.w", g_w_str)
    printf("[保存] glyph_state_%d_lr100.w\n", g_SEED)
end

main()