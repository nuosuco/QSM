# QSCL 32x32 v10-VAR - 变体数据训练 (每类6变体, 批内行数可变)
# 基于 v10, 改 load_batch_data 读批次专属变体文件, g_ns 从控制文件读
# 类槽位固定129 (predict/save pcls=ncls=129), 样本数 g_ns 可变 (<=2064)

# ---- 池句柄 ----
var g_wh = 0
var g_xh = 0
var g_nxh = 0
var g_xsrc_h = 0
var g_all_pix_h = 0
var g_all_pix_sz = 0

# ---- 输入数据 (一次性缓存) ----
var g_x[1024]
var g_batch_data = ""
var g_batch_data_len = 0
var g_batch_line_off[2064]
var g_batch_label[2064]
var g_batch_start_pos = 0
var g_batch_pix_offs_h = 0

# ---- 训练状态 ----
var g_batch = 0
var g_s = 0
var g_state = 0
var g_seed = 0
var g_base = 0
var g_lr = 15
var g_ep = 0
var g_epoch = 30             # 由 build_run_var.sh 设定
var g_smoke_limit = 0
var g_ns = 0
var g_sidx = 0
var g_label = 0
var g_pred = 0
var g_score = 0
var g_max_val = 0
var g_max_idx = 0
var g_correct = 0
var g_updates = 0
var g_rnd = 0
var g_ns_file = "qdfs/ns/train/variant_ns_A.txt"

# ---- 循环变量 ----
var g_i = 0
var g_c = 0

# ---- transform 临时 ----
var g_t1_i = 0
var g_t1_row = 0
var g_t1_col = 0
var g_t1_tmp = 0
var g_t2_i = 0
var g_t3_row = 0
var g_t3_col = 0
var g_t3_tmp = 0

# ---- hex2dec (同 v10) ----
def hex2dec(hex):
    var v = 0
    var ch = ""
    while (str_len(hex) > 0):
        ch = str_substring(hex, 0, 1)
        v = v * 16
        if (ch == "0"): v = v + 0 end
        if (ch == "1"): v = v + 1 end
        if (ch == "2"): v = v + 2 end
        if (ch == "3"): v = v + 3 end
        if (ch == "4"): v = v + 4 end
        if (ch == "5"): v = v + 5 end
        if (ch == "6"): v = v + 6 end
        if (ch == "7"): v = v + 7 end
        if (ch == "8"): v = v + 8 end
        if (ch == "9"): v = v + 9 end
        if (ch == "a"): v = v + 10 end
        if (ch == "A"): v = v + 10 end
        if (ch == "b"): v = v + 11 end
        if (ch == "B"): v = v + 11 end
        if (ch == "c"): v = v + 12 end
        if (ch == "C"): v = v + 12 end
        if (ch == "d"): v = v + 13 end
        if (ch == "D"): v = v + 13 end
        if (ch == "e"): v = v + 14 end
        if (ch == "E"): v = v + 14 end
        if (ch == "f"): v = v + 15 end
        if (ch == "F"): v = v + 15 end
        hex = str_substring(hex, 1, 60000)
    end
    return v
end

# ---- 变体批次数据加载: 读批次专属文件, g_ns 从控制文件 ----
def load_batch_data():
    # 构造批次数据文件路径
    var dpath = "qdfs/ns/data/variant_b"
    dpath = str_concat(dpath, int_to_str(g_batch))
    dpath = str_concat(dpath, ".comma.data")
    var full = file_read(dpath)
    var full_len = str_len(full)
    g_batch_start_pos = 0
    # g_ns 从控制文件读 (侧别隔离: 由 g_ns_file 指定 A/B 侧文件)
    var nstxt = file_read(g_ns_file)
    var nsnl = str_index_of(nstxt, "\n")
    if (nsnl >= 0): nstxt = str_substring(nstxt, 0, nsnl) end
    g_ns = str_to_int(nstxt)
    if (g_ns < 0): g_ns = 0 end
    var slice_len = full_len
    var slice = str_substring(full, 0, slice_len)
    g_batch_data = slice
    g_batch_data_len = full_len
    var rpos = 0
    var rln = 0
    var rnl = 0
    g_batch_line_off[0] = 0
    while (rln < g_ns):
        rnl = str_index_of(str_substring(slice, rpos, 4000), "\n")
        if (rnl < 0):
            g_batch_line_off[g_ns] = full_len
            rpos = full_len
            rln = g_ns
        else:
            g_batch_line_off[rln + 1] = rpos + rnl + 1
            rpos = rpos + rnl + 1
            rln = rln + 1
        end
    end
    var li = 0
    var lline = ""
    var cpos = 0
    var lbl = 0
    while (li < g_ns):
        lline = str_substring(slice, g_batch_line_off[li], 60)
        cpos = str_index_of(lline, ":")
        lbl = hex2dec(str_substring(lline, 0, cpos))
        g_batch_label[li] = lbl
        li = li + 1
    end
    g_batch_pix_offs_h = arr_new(g_ns)
    var ii = 0
    var lstart = 0
    var cpos2 = 0
    while (ii < g_ns):
        lstart = g_batch_line_off[ii]
        cpos2 = str_index_of(str_substring(slice, lstart, 60), ":")
        arr_set(g_batch_pix_offs_h, ii, lstart + cpos2 + 1)
        ii = ii + 1
    end
    g_all_pix_sz = g_ns
    g_all_pix_sz = g_all_pix_sz * 1024
    g_all_pix_h = arr_new(g_all_pix_sz)
    var loaded = flat_load_all_batch(slice, g_batch_pix_offs_h, g_all_pix_h, g_ns, 1024, 100)
    printf("batch%d(var): 文件=%s 切片=%d 预解析=%d g_ns=%d 标签[0]=%d 标签[%d]=%d\n",
        g_batch, dpath, g_batch_data_len, loaded, g_ns,
        g_batch_label[0], g_ns - 1, g_batch_label[g_ns - 1])
end

# ---- 解析单个样本 (同 v10) ----
def parse_sample(sidx):
    g_label = g_batch_label[sidx]
    var base_off = sidx * 1024
    copy_pool_to_pool(g_xsrc_h, g_all_pix_h, base_off, 1024)
    fill_xn_from_pool(g_xh, g_nxh, g_xsrc_h, 0, 1024)
end

def transform_sample():
    g_rnd = transform_pool(g_xsrc_h, g_state, g_rnd)
    fill_xn_from_pool(g_xh, g_nxh, g_xsrc_h, 0, 1024)
end

def predict():
    # pcls 必须=本批类数(129), 标签空间是全局类号, 但权重行内偏移 c*1024
    # 变体标签是十进制全局类号(lbl), 不是批内局部类号
    var pcls = 129
    g_pred = predict_all(g_wh, pcls, g_xh, 1024)
end

def boost_class(c_off, lr):
    axpy_arr_at(g_wh, c_off, g_xh, 1024, lr)
    clamp_row(c_off)
end

def suppress_class(c_off, lr):
    var neg_lr = 0 - lr
    axpy_arr_at(g_wh, c_off, g_xh, 1024, neg_lr)
    clamp_row(c_off)
end

def clamp_row(c_off):
    clamp_arr_at(g_wh, c_off, 1024, 30000)
end

def train_one():
    transform_sample()
    predict()
    # g_label 是全局类号(0-5315), 本批局部类号 = g_label - g_base
    var lcl = g_label - g_base
    if (g_pred == lcl):
        g_correct = g_correct + 1
        if (g_state == 3):
            boost_class(lcl * 1024, g_lr)
        end
    else:
        g_updates = g_updates + 1
        # 增强suppress: 每态都强压错类, 拉大类间差异
        boost_class(lcl * 1024, g_lr)
        suppress_class(g_pred * 1024, g_lr * 3)
    end
end

def train_state():
    printf("  态%d seed=%d lr=%d 池 g_wh=%d g_xh=%d g_nxh=%d g_all_pix_h=%d g_ns=%d\n",
        g_state, g_seed, g_lr, g_wh, g_xh, g_nxh, g_all_pix_h, g_ns)
    g_ep = 0
    while (g_ep < g_epoch):
        g_correct = 0
        g_updates = 0
        g_sidx = 0
        while (g_sidx < g_ns):
            if (g_sidx % 4 == g_state):
                if (g_smoke_limit == 0 or g_sidx < g_smoke_limit * 4 + 3):
                    parse_sample(g_sidx)
                    train_one()
                end
            end
            g_sidx = g_sidx + 1
        end
        printf("  态%d ep%d: 正确%d/%d 更新%d\n",
            g_state, g_ep, g_correct, g_ns, g_updates)
        g_ep = g_ep + 1
    end
end

def save_weights():
    printf("=== 日志截断 ===\n")
    printf("=== QSCL 32x32 v10-VAR 权重流 (emit_ints) ===\n")
    var ncls = 129
    printf("META batch=%d state=%d seed=%d lr=%d nclass=%d pix=1024 nelem=%d\n",
        g_batch, g_state, g_seed, g_lr, ncls, ncls * 1024)
    var cstr = ""
    g_c = 0
    while (g_c < ncls):
        cstr = str_concat("C", int_to_str(g_c))
        cstr = str_concat(cstr, ": ")
        emit_str(cstr)
        emit_ints(g_wh, g_c * 1024, 1024)
        printf("\n")
        g_c = g_c + 1
    end
    printf("=== 权重流结束 (%d类 x 1024值) ===\n", ncls)
end

def read_control_files():
    # 侧别隔离: 由 build_run_var.sh 写 current_side.txt (内容 "A" 或 "B"), qentl 按侧读对应控制文件
    var sdetxt = file_read("qdfs/ns/train/current_side.txt")
    var isA = (str_substring(sdetxt, 0, 1) == "A")
    var batchf = "qdfs/ns/train/current_batch_A.txt"
    var statef = "qdfs/ns/train/current_state_A.txt"
    var smokef = "qdfs/ns/train/smoke_limit_A.txt"
    var nsf = "qdfs/ns/train/variant_ns_A.txt"
    if (!isA):
        batchf = "qdfs/ns/train/current_batch_B.txt"
        statef = "qdfs/ns/train/current_state_B.txt"
        smokef = "qdfs/ns/train/smoke_limit_B.txt"
        nsf = "qdfs/ns/train/variant_ns_B.txt"
    end
    g_ns_file = nsf
    var btxt = file_read(batchf)
    var bnl = 0
    if (str_len(btxt) > 0):
        bnl = str_index_of(btxt, "\n")
        if (bnl >= 0): btxt = str_substring(btxt, 0, bnl) end
        g_batch = str_to_int(btxt)
    end
    var stxt = file_read(statef)
    var snl = 0
    if (str_len(stxt) > 0):
        snl = str_index_of(stxt, "\n")
        if (snl >= 0): stxt = str_substring(stxt, 0, snl) end
        g_s = str_to_int(stxt)
    end
end

def main():
    printf("=== QSCL 32x32 v10-VAR 变体数据训练 ===\n")
    var g_wsz = 129
    g_wsz = g_wsz * 1024
    g_xh = arr_new(1024)
    g_nxh = arr_new(1024)
    g_xsrc_h = arr_new(1024)
    g_wh = arr_new(g_wsz)
    printf("池句柄: g_wh=%d g_xh=%d g_nxh=%d g_xsrc=%d (g_wsz=%d)\n",
        g_wh, g_xh, g_nxh, g_xsrc_h, g_wsz)

    read_control_files()
    # smoke_limit 按侧别读 (g_ns_file 是 ns 文件, 同侧 smoke 文件路径相同规律)
    var smf = "qdfs/ns/train/smoke_limit_A.txt"
    var sdetxt = file_read("qdfs/ns/train/current_side.txt")
    if (str_substring(sdetxt, 0, 1) == "B"):
        smf = "qdfs/ns/train/smoke_limit_B.txt"
    end
    var sm = file_read(smf)
    var smnl = 0
    if (str_len(sm) > 0):
        smnl = str_index_of(sm, "\n")
        if (smnl >= 0): sm = str_substring(sm, 0, smnl) end
        g_smoke_limit = str_to_int(sm)
        printf("冒烟模式: 只跑前%d样本\n", g_smoke_limit)
    end
    g_base = g_batch * 129
    printf("本次 batch%d 态%d base=%d\n", g_batch, g_s, g_base)

    if (g_s < 4):
        printf("--- batch%d (类%d-%d) 态%d [变体] ---\n", g_batch, g_base, g_base + 128, g_s)
        load_batch_data()
        g_state = g_s
        g_seed = 1 + g_s * 100
        g_lr = 15
        train_state()
        save_weights()
        printf("=== batch%d 态%d 变体训练完成 ===\n", g_batch, g_s)
    end
end

main()
