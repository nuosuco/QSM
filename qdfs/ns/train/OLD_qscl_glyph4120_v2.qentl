# ================================================================
# QSCL 4120字 4态叠加训练器 v2 — 多层MLP + 各态不同起步
# 
# v1改进点：
#   1. 4态不同学习率: LR=500/1000/2000/3000 (起步维度1)
#   2. 4态不同epoch数: 20/30/40/50 (起步维度2)
#   3. 单隐层MLP(64像素→32隐→515类)，每态独立隐层权重
#   4. 隐层加ReLU整数模拟(>0保持，<=0归零)
#   5. 训练到同一个qscl4120.w，循环覆盖
#
# 权重文件布局（vs v1变化）：
#   header: 8 515 64 4
#   每批每态:
#     W1[32×64]=2048 (输入→隐层)
#     W2[515×32]=16480 (隐层→输出)
#     每态总计 18528 权重
#   8批×4态×18528 = 592896 权重
#
# 前向: h[i] = relu(Σ(W1[i*64+j]*x[j])) for i=0..31
#        y[c] = Σ(W2[c*32+i]*h[i]) for c=0..514
# ================================================================

var g_EP = 30
var g_BATCHES = 8
var g_NB = 515
var g_NX = 64
var g_HN = 32
var g_NS = 4

var g_W1[2048]     # 32×64 输入→隐层
var g_W2[16480]    # 515×32 隐层→输出
var g_P[32960]     # 515×64 像素
var g_H[32]        # 隐层激活
var g_L[515]       # logits

var g_data = ""
var g_path = ""
var g_i = 0 g_j = 0 g_k = 0 g_n = 0 g_ep = 0 g_s = 0
var g_base = 0 g_sum = 0 g_max_idx = 0 g_max_val = 0
var g_correct = 0 g_updates = 0 g_pred = 0 g_label = 0
var g_rnd = 0 g_seed = 0 g_state = 0 g_w_str = ""
var g_nl = 0 g_line = "" g_c1 = 0 g_rest = "" g_c2 = 0
var g_pix_str = "" g_ps = 0 g_pe = 0 g_pv = ""
var g_skip = 0 g_h = 0 g_lr = 0

def main():
    printf("=== QSCL 4120字 4态叠加训练器 v2(多层MLP) ===\n")
    printf("  架构: 64像素→32隐层(ReLU)→515类\n")
    printf("  4态起步: seed 1/101/202/303, LR 500/1000/2000/3000\n")
    printf("  权重文件: qdfs/ns/models/qscl4120.w\n")

    g_path = "qdfs/ns/models/qscl4120.w"
    exec("truncate -s 0 " + g_path)
    exec("printf -- '8 515 64 32 4\n' > " + g_path)

    g_batch = 0
    while (g_batch < g_BATCHES):
        printf("\n[批次%d/8] 字%d-%d\n", g_batch, g_batch * 515, g_batch * 515 + 514)

        # 加载数据
        g_data = file_read("qdfs/ns/data/yi_glyph_4120.data")
        g_skip = g_batch * 515
        g_n = 0
        g_base = 0
        g_i = 0
        while (g_i < g_skip):
            g_nl = str_index_of(str_substring(g_data, g_base, 60000), "\n")
            if (g_nl < 0): g_base = str_len(g_data)
            else: g_base = g_base + g_nl + 1
            end
            g_i = g_i + 1
        end
        g_n = 0
        while (g_n < 515):
            g_nl = str_index_of(str_substring(g_data, g_base, 60000), "\n")
            g_line = ""
            if (g_nl < 0):
                g_line = str_substring(g_data, g_base, str_len(g_data) - g_base)
                g_base = str_len(g_data)
            else:
                g_line = str_substring(g_data, g_base, g_nl)
                g_base = g_base + g_nl + 1
            end
            g_c1 = str_index_of(g_line, ":")
            if (g_c1 >= 0):
                g_rest = str_substring(g_line, g_c1 + 1, 60000)
                g_c2 = str_index_of(g_rest, ":")
                if (g_c2 >= 0):
                    g_pix_str = str_substring(g_rest, 0, g_c2)
                    g_j = 0
                    g_ps = 0
                    while (g_j < 64):
                        g_pe = str_index_of(str_substring(g_pix_str, g_ps, 60000), ",")
                        g_pv = ""
                        if (g_pe < 0):
                            g_pv = str_substring(g_pix_str, g_ps, 60000)
                            g_ps = 60000
                        else:
                            g_pv = str_substring(g_pix_str, g_ps, g_pe)
                            g_ps = g_ps + g_pe + 1
                        end
                        g_P[g_n * 64 + g_j] = str_to_int(g_pv)
                        g_j = g_j + 1
                    end
                end
            end
            g_n = g_n + 1
        end
        printf("  数据: %d样本\n", g_n)

        # 4态
        g_state = 0
        while (g_state < 4):
            g_seed = 1 + g_state * 100
            g_lr = 500 + g_state * 500
            g_ep_max = 20 + g_state * 10
            printf("  [态%d seed=%d LR=%d EP=%d]\n", g_state, g_seed, g_lr, g_ep_max)

            # 初始化W1(32×64=2048)
            g_rnd = g_seed
            g_i = 0
            while (g_i < 2048):
                g_rnd = g_rnd * 1103 + 12345
                g_W1[g_i] = g_rnd % 10
                g_i = g_i + 1
            end
            # 初始化W2(515×32=16480)
            g_i = 0
            while (g_i < 16480):
                g_rnd = g_rnd * 1103 + 12345
                g_W2[g_i] = g_rnd % 10
                g_i = g_i + 1
            end

            # 训练
            g_ep = 0
            while (g_ep < g_ep_max):
                g_updates = 0
                g_s = 0
                while (g_s < g_n):
                    g_base = g_s * 64

                    # 隐层 h[i] = relu(Σ W1[i*64+j]*P[s*64+j])
                    g_h = 0
                    while (g_h < 32):
                        g_sum = 0
                        g_j = 0
                        while (g_j < 64):
                            g_sum = g_sum + g_W1[g_h * 64 + g_j] * g_P[g_base + g_j]
                            g_j = g_j + 1
                        end
                        if (g_sum > 0): g_H[g_h] = g_sum
                        else: g_H[g_h] = 0
                        end
                        g_h = g_h + 1
                    end

                    # 输出层 y[c] = Σ W2[c*32+i]*H[i]
                    g_j = 0
                    while (g_j < 515):
                        g_sum = 0
                        g_i = 0
                        while (g_i < 32):
                            g_sum = g_sum + g_W2[g_j * 32 + g_i] * g_H[g_i]
                            g_i = g_i + 1
                        end
                        g_L[g_j] = g_sum
                        g_j = g_j + 1
                    end

                    # argmax
                    g_max_idx = 0
                    g_max_val = g_L[0]
                    g_i = 1
                    while (g_i < 515):
                        if (g_L[g_i] > g_max_val):
                            g_max_val = g_L[g_i]
                            g_max_idx = g_i
                        end
                        g_i = g_i + 1
                    end
                    g_pred = g_max_idx
                    g_label = g_s
                    if (g_pred != g_label):
                        # 更新W2: 正确类隐层+LR, 错误类隐层-LR
                        g_i = 0
                        while (g_i < 32):
                            if (g_H[g_i] > 0):
                                g_W2[g_label * 32 + g_i] = g_W2[g_label * 32 + g_i] + g_lr
                                g_W2[g_pred * 32 + g_i] = g_W2[g_pred * 32 + g_i] - g_lr
                            end
                            g_i = g_i + 1
                        end
                        g_updates = g_updates + 1
                    end
                    g_s = g_s + 1
                end

                # 验证
                g_correct = 0
                g_s = 0
                while (g_s < g_n):
                    g_base = g_s * 64
                    g_h = 0
                    while (g_h < 32):
                        g_sum = 0
                        g_j = 0
                        while (g_j < 64):
                            g_sum = g_sum + g_W1[g_h * 64 + g_j] * g_P[g_base + g_j]
                            g_j = g_j + 1
                        end
                        if (g_sum > 0): g_H[g_h] = g_sum
                        else: g_H[g_h] = 0
                        end
                        g_h = g_h + 1
                    end
                    g_j = 0
                    while (g_j < 515):
                        g_sum = 0
                        g_i = 0
                        while (g_i < 32):
                            g_sum = g_sum + g_W2[g_j * 32 + g_i] * g_H[g_i]
                            g_i = g_i + 1
                        end
                        g_L[g_j] = g_sum
                        g_j = g_j + 1
                    end
                    g_max_idx = 0
                    g_max_val = g_L[0]
                    g_i = 1
                    while (g_i < 515):
                        if (g_L[g_i] > g_max_val):
                            g_max_val = g_L[g_i]
                            g_max_idx = g_i
                        end
                        g_i = g_i + 1
                    end
                    if (g_max_idx == g_s): g_correct = g_correct + 1 end
                    g_s = g_s + 1
                end
                if (g_ep % 5 == 0 or g_ep == g_ep_max - 1):
                    printf("    态%d ep%d: %d/%d (%d%%)\n", g_seed, g_ep, g_correct, g_n, g_correct * 100 / g_n)
                end
                g_ep = g_ep + 1
            end

            # 保存: W1(2048) + W2(16480) = 18528
            g_w_str = ""
            g_i = 0
            while (g_i < 2048):
                g_j = 0
                while (g_j < 50 and g_i < 2048):
                    g_w_str = str_concat(g_w_str, int_to_str(g_W1[g_i]))
                    g_w_str = str_concat(g_w_str, "\n")
                    g_i = g_i + 1
                    g_j = g_j + 1
                end
                exec("printf -- '" + g_w_str + "' >> " + g_path)
                g_w_str = ""
            end
            g_i = 0
            while (g_i < 16480):
                g_j = 0
                while (g_j < 50 and g_i < 16480):
                    g_w_str = str_concat(g_w_str, int_to_str(g_W2[g_i]))
                    g_w_str = str_concat(g_w_str, "\n")
                    g_i = g_i + 1
                    g_j = g_j + 1
                end
                exec("printf -- '" + g_w_str + "' >> " + g_path)
                g_w_str = ""
            end
            printf("  [保存] 批次%d 态%d (18528权重)\n", g_batch, g_state)
            g_state = g_state + 1
        end
        g_batch = g_batch + 1
    end
    printf("\n=== v2 4120字训练完成 ===\n")
end

main()