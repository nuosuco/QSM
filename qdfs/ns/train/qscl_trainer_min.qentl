# QSCL最小验证版 - 只训100样本5轮，验证能跑通
var g_WSIZE_BIG = 70 * 1024
var g_W[70 * 1024]
var g_x[1024]
var g_data = ""
var g_data_len = 0
var g_line = ""
var g_rem = ""
var g_pix_str = ""
var g_pv = ""
var g_i = 0
var g_c = 0
var g_s = 0
var g_ep = 0
var g_row_start = 0
var g_row_end = 0
var g_nl = 0
var g_c1 = 0
var g_ps = 0
var g_pe = 0
var g_max_val = 0
var g_max_idx = 0
var g_score = 0
var g_diff = 0
var g_correct = 0
var g_updates = 0
var g_pred = 0
var g_label = 0
var g_rnd = 0
var g_idx = 0
var g_idx2 = 0
var g_state = 0
var g_lr = 0
var g_seed = 0
var g_path = ""

def load_line(lineno):
    g_row_start = 0
    g_i = 0
    while (g_i < lineno):
        g_rem = str_substring(g_data, g_row_start, g_data_len - g_row_start)
        g_nl = str_index_of(g_rem, "\n")
        if (g_nl < 0):
            g_row_start = g_data_len
        else:
            g_row_start = g_row_start + g_nl + 1
        end
        g_i = g_i + 1
    end
    g_rem = str_substring(g_data, g_row_start, g_data_len - g_row_start)
    g_nl = str_index_of(g_rem, "\n")
    if (g_nl >= 0):
        g_row_end = g_row_start + g_nl
    else:
        g_row_end = g_data_len
    end
    g_line = str_substring(g_data, g_row_start, g_row_end - g_row_start)
    g_c1 = str_index_of(g_line, ":")
    g_pix_str = str_substring(g_line, g_c1 + 1, 60000)
    g_ps = 0
    g_i = 0
    while (g_i < 1024):
        g_rem = str_substring(g_pix_str, g_ps, 60000)
        g_pe = str_index_of(g_rem, ",")
        if (g_pe < 0):
            g_pv = g_rem
            g_ps = 60000
        else:
            g_pv = str_substring(g_rem, 0, g_pe)
            g_ps = g_ps + g_pe + 1
        end
        g_x[g_i] = str_to_int(g_pv)
        g_i = g_i + 1
    end
end

def argmax():
    g_max_val = -30000
    g_max_idx = 0
    g_c = 0
    while (g_c < 70):
        g_score = 0
        g_idx = g_c * 1024
        g_i = 0
        while (g_i < 1024):
            g_score = g_score + g_W[g_idx + g_i] * g_x[g_i]
            g_i = g_i + 1
        end
        if (g_c == 0):
            g_max_val = g_score
            g_max_idx = 0
        else:
            if (g_score > g_max_val):
                g_max_val = g_score
                g_max_idx = g_c
            end
        end
        g_c = g_c + 1
    end
    g_pred = g_max_idx
end

def train():
    argmax()
    g_idx = g_label * 1024
    g_i = 0
    while (g_i < 1024):
        g_diff = g_x[g_i] - g_W[g_idx + g_i]
        g_W[g_idx + g_i] = g_W[g_idx + g_i] + g_diff * g_lr / 1000
        g_i = g_i + 1
    end
    if (g_pred != g_label):
        g_idx2 = g_pred * 1024
        g_i = 0
        while (g_i < 1024):
            g_W[g_idx2 + g_i] = g_W[g_idx2 + g_i] + g_diff * g_lr / 1000
            g_i = g_i + 1
        end
        g_updates = g_updates + 1
    end
end

def main():
    printf("QSCL最小验证版\n")
    g_state = str_to_int(exec("echo ${TRAIN_STATE:-0}"))
    g_seed = 1 + g_state * 7
    g_lr = 500
    g_path = "qdfs/ns/data/yi_glyph_4226_32x32.data"
    printf("态%d seed=%d\n", g_state, g_seed)
    
    g_rnd = g_seed
    g_i = 0
    while (g_i < 70 * 1024):
        g_rnd = g_rnd * 1103 + 12345
        g_W[g_i] = g_rnd % 3
        g_i = g_i + 1
    end
    printf("权重初始化ok\n")
    
    g_data = file_read(g_path)
    g_data_len = str_len(g_data)
    printf("数据%d字节\n", g_data_len)
    
    g_ep = 0
    while (g_ep < 3):
        g_updates = 0
        g_s = 0
        while (g_s < 100):
            g_label = g_s
            load_line(g_s)
            train()
            g_s = g_s + 1
        end
        g_correct = 0
        g_s = 0
        while (g_s < 100):
            load_line(g_s)
            argmax()
            if (g_pred == g_s):
                g_correct = g_correct + 1
            end
            g_s = g_s + 1
        end
        printf("态%d ep%d: %d/100 更新%d\n", g_state, g_ep, g_correct, g_updates)
        g_ep = g_ep + 1
    end
    
    var wsize = 70 * 1024
    var out = "qdfs/ns/models/qscl_32x32_min_s" + int_to_str(g_state) + ".w"
    var wstr = ""
    g_i = 0
    while (g_i < wsize):
        wstr = str_concat(wstr, int_to_str(g_W[g_i]))
        if (g_i < wsize - 1):
            wstr = str_concat(wstr, ",")
        end
        g_i = g_i + 1
    end
    file_write_bytes(out, wstr)
    printf("保存%s\n", out)
end

main()
