# QSCL字形训练 — 32样本4态投票坍缩

var g_data = ""
var g_N = 32

var g_P[2048]
var g_W[2048]
var g_L[32]
var g_preds[128]  # 4态 × 32样本

var g_i = 0
var g_j = 0
var g_base = 0
var g_sum = 0
var g_n = 0
var g_s = 0
var g_nl = 0
var g_line = ""
var g_c1 = 0
var g_rest = ""
var g_c2 = 0
var g_pix_str = ""
var g_ps = 0
var g_pe = 0
var g_pv = ""
var g_max_idx = 0
var g_max_val = 0
var g_pred = 0
var g_seed = 0
var g_w_str = ""
var g_correct = 0
var g_t = 0
var g_best_vote = 0
var g_best_count = 0
var g_vote_count = 0
var g_vote_total = 0
var g_v = 0
var g_votes[32]   # 每个类别的得票数

def main():
    printf("[开始] 32样本4态投票坍缩\n")
    
    # === 加载数据 ===
    g_data = file_read("qdfs/ns/data/yi_glyph_32_v4.data")
    g_n = 0
    g_base = 0
    while (g_n < g_N):
        g_nl = str_index_of(str_substring(g_data, g_base, 60000), "\n")
        g_line = ""
        if (g_nl < 0):
            g_line = str_substring(g_data, g_base, str_len(g_data) - g_base)
            g_base = str_len(g_data)
        else:
            g_line = str_substring(g_data, g_base, g_nl)
            g_base = g_base + g_nl + 1
        end
        g_c1 = str_index_of(g_line, ":")
        if (g_c1 >= 0):
            g_rest = str_substring(g_line, g_c1 + 1, 60000)
            g_c2 = str_index_of(g_rest, ":")
            if (g_c2 >= 0):
                g_pix_str = str_substring(g_rest, 0, g_c2)
                g_j = 0
                g_ps = 0
                while (g_j < 64):
                    g_pe = str_index_of(str_substring(g_pix_str, g_ps, 60000), ",")
                    g_pv = ""
                    if (g_pe < 0):
                        g_pv = str_substring(g_pix_str, g_ps, 60000)
                        g_ps = 60000
                    else:
                        g_pv = str_substring(g_pix_str, g_ps, g_pe)
                        g_ps = g_ps + g_pe + 1
                    end
                    g_P[g_n * 64 + g_j] = str_to_int(g_pv)
                    g_j = g_j + 1
                end
            end
        end
        g_n = g_n + 1
    end
    printf("[数据] %d个样本×64像素\n", g_n)
    
    # === 加载4个态并预测 ===
    g_s = 0
    while (g_s < 4):
        if (g_s == 0): g_seed = 1
        else:
            if (g_s == 1): g_seed = 101
            else:
                if (g_s == 2): g_seed = 202
                else:
                    if (g_s == 3): g_seed = 303
                    end
                end
            end
        end
        
        g_w_str = file_read("qdfs/ns/models/glyph_state_" + int_to_str(g_seed) + "_n32.v4.w")
        g_i = 0
        g_ps = 0
        while (g_i < g_N * 64):
            g_pe = str_index_of(str_substring(g_w_str, g_ps, 60000), "\n")
            g_pv = ""
            if (g_pe < 0):
                g_pv = str_substring(g_w_str, g_ps, 60000)
                g_ps = 60000
            else:
                g_pv = str_substring(g_w_str, g_ps, g_pe)
                g_ps = g_ps + g_pe + 1
            end
            g_W[g_i] = str_to_int(g_pv)
            g_i = g_i + 1
        end
        
        g_correct = 0
        g_t = 0
        while (g_t < g_n):
            g_base = g_t * 64
            g_j = 0
            while (g_j < g_N):
                g_sum = 0
                g_i = 0
                while (g_i < 64):
                    g_sum = g_sum + g_W[g_j * 64 + g_i] * g_P[g_base + g_i]
                    g_i = g_i + 1
                end
                g_L[g_j] = g_sum
                g_j = g_j + 1
            end
            
            g_max_idx = 0
            g_max_val = g_L[0]
            g_i = 1
            while (g_i < g_N):
                if (g_L[g_i] > g_max_val):
                    g_max_val = g_L[g_i]
                    g_max_idx = g_i
                end
                g_i = g_i + 1
            end
            g_pred = g_max_idx
            
            g_preds[g_s * g_N + g_t] = g_pred
            
            if (g_pred == g_t):
                g_correct = g_correct + 1
            end
            g_t = g_t + 1
        end
        printf("[态%d] %d/%d 正确 (%d%%)\n", g_seed, g_correct, g_n, g_correct * 100 / g_n)
        g_s = g_s + 1
    end
    
    # === 投票坍缩 ===
    printf("\n[投票坍缩]\n")
    g_correct = 0
    g_t = 0
    while (g_t < g_n):
        # 初始化投票计数
        g_i = 0
        while (g_i < 32):
            g_votes[g_i] = 0
            g_i = g_i + 1
        end
        
        # 统计每个态的预测
        g_s = 0
        while (g_s < 4):
            g_pred = g_preds[g_s * g_N + g_t]
            g_votes[g_pred] = g_votes[g_pred] + 1
            g_s = g_s + 1
        end
        
        # 找得票最多的类别
        g_best_vote = 0
        g_best_count = g_votes[0]
        g_i = 1
        while (g_i < g_N):
            if (g_votes[g_i] > g_best_count):
                g_best_count = g_votes[g_i]
                g_best_vote = g_i
            end
            g_i = g_i + 1
        end
        
        # 判断是否正确
        if (g_best_vote == g_t):
            g_correct = g_correct + 1
        end
        
        printf("样本%d: 投票=%d 真实=%d %s\n", g_t, g_best_vote, g_t, if (g_best_vote == g_t, "✓", "✗"))
        g_t = g_t + 1
    end
    
    printf("\n[最终] 投票坍缩: %d/%d 正确 (%d%%)\n", g_correct, g_n, g_correct * 100 / g_n)
end

main()