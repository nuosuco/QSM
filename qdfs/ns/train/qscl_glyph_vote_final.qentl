# QSCL字形训练 — 4态投票坍缩(最终版)
# 全部用全局变量, 无局部变量, 无分号(除了printf)

var g_data = ""
var g_N = 16

var g_P[1024]
var g_W[1024]
var g_L[16]

var g_preds[64]

var g_i = 0
var g_j = 0
var g_base = 0
var g_sum = 0
var g_n = 0
var g_s = 0
var g_nl = 0
var g_line = ""
var g_c1 = 0
var g_rest = ""
var g_c2 = 0
var g_pix_str = ""
var g_ps = 0
var g_pe = 0
var g_pv = ""
var g_max_idx = 0
var g_max_val = 0
var g_pred = 0
var g_seed = 0
var g_w_str = ""
var g_correct = 0
var g_t = 0
var g_best_vote = 0
var g_best_count = 0
var g_v0 = 0
var g_v1 = 0
var g_v2 = 0
var g_v3 = 0
var g_v4 = 0
var g_v5 = 0
var g_v6 = 0
var g_v7 = 0
var g_v8 = 0
var g_v9 = 0
var g_v10 = 0
var g_v11 = 0
var g_v12 = 0
var g_v13 = 0
var g_v14 = 0
var g_v15 = 0

def main():
    printf("[开始] 4态投票坍缩\n")
    
    # === 加载数据 ===
    g_data = file_read("qdfs/ns/data/yi_glyph_16_real.data")
    g_n = 0
    g_base = 0
    while (g_n < 16):
        g_nl = str_index_of(str_substring(g_data, g_base, 60000), "\n")
        g_line = ""
        if (g_nl < 0):
            g_line = str_substring(g_data, g_base, str_len(g_data) - g_base)
            g_base = str_len(g_data)
        else:
            g_line = str_substring(g_data, g_base, g_nl)
            g_base = g_base + g_nl + 1
        end
        g_c1 = str_index_of(g_line, ":")
        if (g_c1 >= 0):
            g_rest = str_substring(g_line, g_c1 + 1, 60000)
            g_c2 = str_index_of(g_rest, ":")
            if (g_c2 >= 0):
                g_pix_str = str_substring(g_rest, 0, g_c2)
                g_j = 0
                g_ps = 0
                while (g_j < 64):
                    g_pe = str_index_of(str_substring(g_pix_str, g_ps, 60000), ",")
                    g_pv = ""
                    if (g_pe < 0):
                        g_pv = str_substring(g_pix_str, g_ps, 60000)
                        g_ps = 60000
                    else:
                        g_pv = str_substring(g_pix_str, g_ps, g_pe)
                        g_ps = g_ps + g_pe + 1
                    end
                    g_P[g_n * 64 + g_j] = str_to_int(g_pv)
                    g_j = g_j + 1
                end
            end
        end
        g_n = g_n + 1
    end
    printf("[数据] %d个样本×64像素\n", g_n)
    
    # === 加载4个态并预测 ===
    g_s = 0
    while (g_s < 4):
        if (g_s == 0): g_seed = 1
        else:
            if (g_s == 1): g_seed = 101
            else:
                if (g_s == 2): g_seed = 202
                else:
                    if (g_s == 3): g_seed = 303
                    end
                end
            end
        end
        
        g_w_str = file_read("qdfs/ns/models/glyph_state_" + int_to_str(g_seed) + ".w")
        g_i = 0
        g_ps = 0
        while (g_i < 1024):
            g_pe = str_index_of(str_substring(g_w_str, g_ps, 60000), "\n")
            g_pv = ""
            if (g_pe < 0):
                g_pv = str_substring(g_w_str, g_ps, 60000)
                g_ps = 60000
            else:
                g_pv = str_substring(g_w_str, g_ps, g_pe)
                g_ps = g_ps + g_pe + 1
            end
            g_W[g_i] = str_to_int(g_pv)
            g_i = g_i + 1
        end
        
        g_correct = 0
        g_t = 0
        while (g_t < g_n):
            g_base = g_t * 64
            g_j = 0
            while (g_j < 16):
                g_sum = 0
                g_i = 0
                while (g_i < 64):
                    g_sum = g_sum + g_W[g_j * 64 + g_i] * g_P[g_base + g_i]
                    g_i = g_i + 1
                end
                g_L[g_j] = g_sum
                g_j = g_j + 1
            end
            
            g_max_idx = 0
            g_max_val = g_L[0]
            g_i = 1
            while (g_i < 16):
                if (g_L[g_i] > g_max_val):
                    g_max_val = g_L[g_i]
                    g_max_idx = g_i
                end
                g_i = g_i + 1
            end
            g_pred = g_max_idx
            
            g_preds[g_s * 16 + g_t] = g_pred
            
            if (g_pred == g_t):
                g_correct = g_correct + 1
            end
            g_t = g_t + 1
        end
        printf("[态%d] %d/%d 正确 (%d%%)\n", g_seed, g_correct, g_n, g_correct * 100 / g_n)
        g_s = g_s + 1
    end
    
    # === 投票坍缩 ===
    printf("\n[投票坍缩]\n")
    g_correct = 0
    g_t = 0
    while (g_t < g_n):
        g_v0 = 0
        g_v1 = 0
        g_v2 = 0
        g_v3 = 0
        g_v4 = 0
        g_v5 = 0
        g_v6 = 0
        g_v7 = 0
        g_v8 = 0
        g_v9 = 0
        g_v10 = 0
        g_v11 = 0
        g_v12 = 0
        g_v13 = 0
        g_v14 = 0
        g_v15 = 0
        
        g_s = 0
        while (g_s < 4):
            g_pred = g_preds[g_s * 16 + g_t]
            if (g_pred == 0): g_v0 = g_v0 + 1
            else:
                if (g_pred == 1): g_v1 = g_v1 + 1
                else:
                    if (g_pred == 2): g_v2 = g_v2 + 1
                    else:
                        if (g_pred == 3): g_v3 = g_v3 + 1
                        else:
                            if (g_pred == 4): g_v4 = g_v4 + 1
                            else:
                                if (g_pred == 5): g_v5 = g_v5 + 1
                                else:
                                    if (g_pred == 6): g_v6 = g_v6 + 1
                                    else:
                                        if (g_pred == 7): g_v7 = g_v7 + 1
                                        else:
                                            if (g_pred == 8): g_v8 = g_v8 + 1
                                            else:
                                                if (g_pred == 9): g_v9 = g_v9 + 1
                                                else:
                                                    if (g_pred == 10): g_v10 = g_v10 + 1
                                                    else:
                                                        if (g_pred == 11): g_v11 = g_v11 + 1
                                                        else:
                                                            if (g_pred == 12): g_v12 = g_v12 + 1
                                                            else:
                                                                if (g_pred == 13): g_v13 = g_v13 + 1
                                                                else:
                                                                    if (g_pred == 14): g_v14 = g_v14 + 1
                                                                    else:
                                                                        if (g_pred == 15): g_v15 = g_v15 + 1
                                                                        end
                                                                    end
                                                                end
                                                            end
                                                        end
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
            g_s = g_s + 1
        end
        
        g_best_vote = 0
        g_best_count = g_v0
                if (g_v1 > g_best_count):
            g_best_vote = 1
            g_best_count = g_v1
        end
                if (g_v2 > g_best_count):
            g_best_vote = 2
            g_best_count = g_v2
        end
                if (g_v3 > g_best_count):
            g_best_vote = 3
            g_best_count = g_v3
        end
                if (g_v4 > g_best_count):
            g_best_vote = 4
            g_best_count = g_v4
        end
                if (g_v5 > g_best_count):
            g_best_vote = 5
            g_best_count = g_v5
        end
                if (g_v6 > g_best_count):
            g_best_vote = 6
            g_best_count = g_v6
        end
                if (g_v7 > g_best_count):
            g_best_vote = 7
            g_best_count = g_v7
        end
                if (g_v8 > g_best_count):
            g_best_vote = 8
            g_best_count = g_v8
        end
                if (g_v9 > g_best_count):
            g_best_vote = 9
            g_best_count = g_v9
        end
                if (g_v10 > g_best_count):
            g_best_vote = 10
            g_best_count = g_v10
        end
                if (g_v11 > g_best_count):
            g_best_vote = 11
            g_best_count = g_v11
        end
                if (g_v12 > g_best_count):
            g_best_vote = 12
            g_best_count = g_v12
        end
                if (g_v13 > g_best_count):
            g_best_vote = 13
            g_best_count = g_v13
        end
                if (g_v14 > g_best_count):
            g_best_vote = 14
            g_best_count = g_v14
        end
                if (g_v15 > g_best_count):
            g_best_vote = 15
            g_best_count = g_v15
        end
        
        if (g_best_vote == g_t):
            g_correct = g_correct + 1
        end
        
        printf("样本%d: 投票=%d 真实=%d\n", g_t, g_best_vote, g_t)
        g_t = g_t + 1
    end
    
    printf("\n[最终] 投票坍缩: %d/%d 正确 (%d%%)\n", g_correct, g_n, g_correct * 100 / g_n)
end

main()