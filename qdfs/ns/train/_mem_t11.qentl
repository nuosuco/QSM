# 内存泄漏隔离测试 v11: 函数返回长字符串是否累积
def build_smp(d):
    var out = "SMP#"
    out = str_concat(out, int_to_str(d))
    out = str_concat(out, ": class=")
    out = str_concat(out, int_to_str(d))
    out = str_concat(out, " batch=")
    out = str_concat(out, int_to_str(7))
    out = str_concat(out, "\ncodepoint=")
    out = str_concat(out, int_to_str(994040))
    out = str_concat(out, "\n")
    var gf2 = str_concat(str_concat("qdfs/ns/models/wviz/c", int_to_str(d)), ".grid")
    var gtxt2 = file_read(gf2)
    out = str_concat(out, gtxt2)
    return out
end

var req = 0
while (req < 2):
    var resp = build_smp(1000)
    printf("请求%d 响应len=%d\n", req, str_len(resp))
    req = req + 1
end
printf("结束\n")
