# leak_probe_old.qentl - 反向对照: 旧逐值 printf(bi_printf)路径, 1万值
var g_size = 515
g_size = g_size * 1024
var g_h = arr_new(g_size)
var g_i = 0
while (g_i < g_size):
    arr_set(g_h, g_i, g_i % 7 - 3)
    g_i = g_i + 1
end
printf("FILL done\n")
var g_j = 0
while (g_j < 10000):
    printf("%d,", arr_get(g_h, g_j))
    g_j = g_j + 1
end
printf("\nDONE old-path printf count=10000\n")
