# 10字快速验证版 - 验证4态叠加训练架构
var g_LR = 1000
var g_EP = 20
var g_NB = 10
var g_NX = 64
var g_NS = 4
var g_W[640]
var g_P[640]
var g_L[10]
var g_data = ""
var g_path = "qdfs/ns/models/qscl4120_test.w"
var g_i = 0 g_j = 0 g_n = 0 g_ep = 0 g_s = 0 g_base = 0 g_sum = 0
var g_max_idx = 0 g_max_val = 0 g_correct = 0 g_updates = 0 g_pred = 0 g_label = 0
var g_rnd = 0 g_seed = 0 g_state = 0 g_w_str = "" g_nl = 0 g_line = ""
var g_c1 = 0 g_rest = "" g_c2 = 0 g_pix_str = "" g_ps = 0 g_pe = 0 g_pv = ""

def main():
    printf("=== QSCL 10字 4态验证 ===\n")
    g_path = "qdfs/ns/models/qscl4120_test.w"
    exec("truncate -s 0 " + g_path)
    g_data = file_read("qdfs/ns/data/yi_glyph_4120_8x8.data")
    g_n = 0
    g_base = 0
    while (g_n < 10):
        g_nl = str_index_of(str_substring(g_data, g_base, 60000), "\n")
        g_line = str_substring(g_data, g_base, g_nl)
        g_base = g_base + g_nl + 1
        g_c1 = str_index_of(g_line, ":")
        g_rest = str_substring(g_line, g_c1 + 1, 60000)
        g_c2 = str_index_of(g_rest, ":")
        g_pix_str = str_substring(g_rest, 0, g_c2)
        g_j = 0
        g_ps = 0
        while (g_j < 64):
            g_pe = str_index_of(str_substring(g_pix_str, g_ps, 60000), ",")
            g_pv = str_substring(g_pix_str, g_ps, g_pe)
            g_ps = g_ps + g_pe + 1
            g_P[g_n * 64 + g_j] = str_to_int(g_pv)
            g_j = g_j + 1
        end
        g_n = g_n + 1
    end
    printf("数据: %d样本\n", g_n)
    g_state = 0
    while (g_state < 4):
        g_seed = 1 + g_state * 100
        g_rnd = g_seed
        g_i = 0
        while (g_i < 640):
            g_rnd = g_rnd * 1103 + 12345
            g_W[g_i] = g_rnd % 10
            g_i = g_i + 1
        end
        g_ep = 0
        while (g_ep < g_EP):
            g_updates = 0
            g_s = 0
            while (g_s < g_n):
                g_base = g_s * 64
                g_j = 0
                while (g_j < 10):
                    g_sum = 0
                    g_i = 0
                    while (g_i < 64):
                        g_sum = g_sum + g_W[g_j * 64 + g_i] * g_P[g_base + g_i]
                        g_i = g_i + 1
                    end
                    g_L[g_j] = g_sum
                    g_j = g_j + 1
                end
                g_max_idx = 0
                g_max_val = g_L[0]
                g_i = 1
                while (g_i < 10):
                    if (g_L[g_i] > g_max_val):
                        g_max_val = g_L[g_i]
                        g_max_idx = g_i
                    end
                    g_i = g_i + 1
                end
                g_pred = g_max_idx
                g_label = g_s
                if (g_pred != g_label):
                    g_base = g_s * 64
                    g_i = 0
                    while (g_i < 64):
                        if (g_P[g_base + g_i] > 0):
                            g_W[g_label * 64 + g_i] = g_W[g_label * 64 + g_i] + g_LR
                            g_W[g_pred * 64 + g_i] = g_W[g_pred * 64 + g_i] - g_LR
                        end
                        g_i = g_i + 1
                    end
                    g_updates = g_updates + 1
                end
                g_s = g_s + 1
            end
            g_correct = 0
            g_s = 0
            while (g_s < g_n):
                g_base = g_s * 64
                g_j = 0
                while (g_j < 10):
                    g_sum = 0
                    g_i = 0
                    while (g_i < 64):
                        g_sum = g_sum + g_W[g_j * 64 + g_i] * g_P[g_base + g_i]
                        g_i = g_i + 1
                    end
                    g_L[g_j] = g_sum
                    g_j = g_j + 1
                end
                g_max_idx = 0
                g_max_val = g_L[0]
                g_i = 1
                while (g_i < 10):
                    if (g_L[g_i] > g_max_val):
                        g_max_val = g_L[g_i]
                        g_max_idx = g_i
                    end
                    g_i = g_i + 1
                end
                if (g_max_idx == g_s):
                    g_correct = g_correct + 1
                end
                g_s = g_s + 1
            end
            if (g_ep % 5 == 0 or g_ep == g_EP - 1):
                printf("  seed=%d ep%d: %d/%d (%d%%)\n", g_seed, g_ep, g_correct, g_n, g_correct * 100 / g_n)
            end
            g_ep = g_ep + 1
        end
        printf("  态%d seed=%d 完成 保存640权重\n", g_state, g_seed)
        g_w_str = ""
        g_i = 0
        while (g_i < 640):
            g_w_str = str_concat(g_w_str, int_to_str(g_W[g_i]))
            g_w_str = str_concat(g_w_str, "\n")
            g_i = g_i + 1
        end
        exec("printf -- '" + g_w_str + "' >> " + g_path)
        g_state = g_state + 1
    end
    printf("完成 权重文件: %s\n", g_path)
end

main()