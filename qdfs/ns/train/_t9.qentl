def main():
    printf("QVM 乘法截断测试:\n")
    var a = 983025
    var b = a * 2
    printf("  983025*2=%d (2^30=1073741824, 65535*2=131070)\n", b)
    var c = 10000
    var d = c * 499
    printf("  10000*499=%d (4990000, 超16位=65535?)\n", d)
    var e = 10000 + 4999
    printf("  10000+4999=%d (14999, 16位内)\n", e)
    var f = 993040
    printf("  993040字面量=%d (16位截断成? 期望10000)\n", f)
    var g = 15
    g = g * 65535
    g = g + 15
    printf("  15*65535+15=%d (983040, 变量算术绕65536)\n", g)
end
main()
