# QVM v3 — 极简 QBC1 虚拟机 (QEntL编写)
# 适配QCL语法限制，解决池溢出
# 输入: target.qbc

# ---- 配置 (最小化变量) ----
var g_target = "target.qbc"
var g_raw = ""
var g_code_len = 0
var g_pool_off = 0
var g_pool_len = 0
var g_main_start = 0

# ---- 预解码字节码 (最小化) ----
var g_code[32768]
var g_pool[16384]

# ---- 值栈: 1024深 ----
var st_type[1024]
var st_int[1024]
var st_str[1024]
var sp = 0

# ---- 函数表: 64个 ----
var fn_body[64]
var fn_params[64]
var fn_count = 0
var fr_retpc[64]
var fp = 0

# ---- 局部变量: 256个 ----
var loc_type[256]
var loc_int[256]
var loc_str[256]
var loc_base = 0

# ---- 全局变量: 64个 ----
var gl_type[64]
var gl_int[64]
var gl_str[64]

# ---- pop结果 ----
var p1_t = 0
var p1_i = 0
var p1_s = ""
var p2_t = 0
var p2_i = 0
var p2_s = ""

# ================================================================
# 工具函数
# ================================================================
def byte_at(p):
    return g_code[p]
end

def u16_at(p):
    return g_code[p] + g_code[p + 1] * 256
end

def push_int(v):
    if (sp < 1024):
        st_type[sp] = 0
        st_int[sp] = v
        st_str[sp] = ""
        sp = sp + 1
    end
end

def push_str(s):
    if (sp < 1024):
        st_type[sp] = 1
        st_int[sp] = 0
        st_str[sp] = s
        sp = sp + 1
    end
end

def do_pop1():
    if (sp > 0):
        sp = sp - 1
        p1_t = st_type[sp]
        p1_i = st_int[sp]
        p1_s = st_str[sp]
    end
end

def do_pop2():
    if (sp >= 2):
        do_pop1()
        var t2 = p1_t
        var i2 = p1_i
        var s2 = p1_s
        sp = sp - 1
        p1_t = st_type[sp]
        p1_i = st_int[sp]
        p1_s = st_str[sp]
        p2_t = t2
        p2_i = i2
        p2_s = s2
    end
end

def pool_str(idx):
    if (idx < 0 or idx >= 16384):
        return ""
    end
    var result = ""
    var pi = idx
    while (pi < 16384):
        var ch = g_pool[pi]
        if (ch == 0):
            pi = 16384
        else:
            result = str_concat(result, str_from_char(ch))
            pi = pi + 1
        end
    end
    return result
end

# ================================================================
# 加载QBC
# ================================================================
def load_qbc():
    g_raw = file_read(g_target)
    if (str_len(g_raw) < 8):
        return 0
    end
    # 验证QBC1头
    var h = str_substring(g_raw, 0, 4)
    if (str_eq(h, "QBC1") == 0):
        return 0
    end
    # 读取code_len
    g_code_len = ord(str_char_at(g_raw, 4)) + ord(str_char_at(g_raw, 5)) * 256
    g_pool_off = 6 + g_code_len
    g_pool_len = ord(str_char_at(g_raw, g_pool_off)) + ord(str_char_at(g_raw, g_pool_off + 1)) * 256
    # 解码code段 (QBC1: [4B]QBC1 [2B]code_len [code] [2B]pool_len [pool])
    var i = 0
    var code_start = 6
    while (i < g_code_len and i < 32768):
        g_code[i] = ord(str_char_at(g_raw, code_start + i))
        i = i + 1
    end
    # 解码pool段
    var pool_start = g_pool_off + 2
    var j = 0
    while (j < g_pool_len and j < 16384):
        g_pool[j] = ord(str_char_at(g_raw, pool_start + j))
        j = j + 1
    end
    # 读取主入口: code[0]=JMP(16), code[1:3]=main_start
    g_main_start = g_code[1] + g_code[2] * 256
    # 扫描函数区 (从pc=3到g_main_start)
    # 格式: FUNC_DEF(30) u16(fpid) nargs [body...] FUNC_END(31)
    var pc = 3
    fn_count = 0
    while (pc < g_main_start and fn_count < 64):
        if (g_code[pc] == 30):
            var fpid = g_code[pc + 1] + g_code[pc + 2] * 256
            fn_body[fn_count] = fpid
            fn_params[fn_count] = g_code[pc + 3]
            fn_count = fn_count + 1
            pc = pc + 1
        else:
            pc = pc + 1
        end
    end
    return 1
end

# ================================================================
# 运行程序
# ================================================================
def run_program():
    var pc = g_main_start
    var running = 1
    while (running == 1 and pc < g_code_len):
        var op = byte_at(pc)
        var npc = pc + 1
        if (op == 1):
            push_int(u16_at(npc))
            npc = npc + 2
        end
        if (op == 2):
            push_str(pool_str(u16_at(npc)))
            npc = npc + 2
        end
        if (op == 3):
            var idx = u16_at(npc)
            if (idx >= 32768):
                var gi = idx - 32768
                st_type[sp] = gl_type[gi]
                st_int[sp] = gl_int[gi]
                st_str[sp] = gl_str[gi]
            else:
                st_type[sp] = loc_type[idx]
                st_int[sp] = loc_int[idx]
                st_str[sp] = loc_str[idx]
            end
            sp = sp + 1
            npc = npc + 2
        end
        if (op == 4):
            var idx = u16_at(npc)
            do_pop1()
            if (idx >= 32768):
                var gi = idx - 32768
                gl_type[gi] = p1_t
                gl_int[gi] = p1_i
                gl_str[gi] = p1_s
            else:
                loc_type[idx] = p1_t
                loc_int[idx] = p1_i
                loc_str[idx] = p1_s
            end
            npc = npc + 2
        end
        if (op == 5):
            do_pop2()
            push_int(p2_i + p1_i)
        end
        if (op == 6):
            do_pop2()
            push_int(p2_i - p1_i)
        end
        if (op == 7):
            do_pop2()
            push_int(p2_i * p1_i)
        end
        if (op == 8):
            do_pop2()
            if (p1_i != 0):
                push_int(p2_i / p1_i)
            else:
                push_int(0)
            end
        end
        if (op == 9):
            do_pop2()
            if (p1_i != 0):
                push_int(p2_i % p1_i)
            else:
                push_int(0)
            end
        end
        if (op == 10):
            do_pop2()
            if (p2_i == p1_i):
                push_int(1)
            else:
                push_int(0)
            end
        end
        if (op == 11):
            do_pop2()
            if (p2_i != p1_i):
                push_int(1)
            else:
                push_int(0)
            end
        end
        if (op == 12):
            do_pop2()
            if (p2_i < p1_i):
                push_int(1)
            else:
                push_int(0)
            end
        end
        if (op == 13):
            do_pop2()
            if (p2_i > p1_i):
                push_int(1)
            else:
                push_int(0)
            end
        end
        if (op == 14):
            do_pop2()
            if (p2_i <= p1_i):
                push_int(1)
            else:
                push_int(0)
            end
        end
        if (op == 15):
            do_pop2()
            if (p2_i >= p1_i):
                push_int(1)
            else:
                push_int(0)
            end
        end
        if (op == 16):
            npc = u16_at(npc)
        end
        if (op == 17):
            do_pop1()
            if (p1_i == 0):
                npc = u16_at(npc)
            else:
                npc = npc + 2
            end
        end
        if (op == 18):
            var fpid = u16_at(npc)
            var nargs = byte_at(npc + 2)
            # 查找函数
            var fi = 0
            var found = 0
            while (fi < fn_count and found == 0):
                if (fn_body[fi] == fpid):
                    found = 1
                else:
                    fi = fi + 1
                end
            end
            if (found == 1):
                fr_retpc[fp] = npc + 3
                fp = fp + 1
                # 扫描找到函数体
                var scan_pc = 3
                var func_idx = 0
                while (scan_pc < g_main_start and func_idx <= fi):
                    if (g_code[scan_pc] == 30):
                        if (func_idx == fi):
                            # 跳过 FUNC_DEF u16(fpid) nargs
                            npc = scan_pc + 4 + fn_params[fi] * 2
                        end
                        func_idx = func_idx + 1
                    end
                    scan_pc = scan_pc + 1
                end
            end
        end
        if (op == 19):
            if (fp > 0):
                fp = fp - 1
                npc = fr_retpc[fp]
            end
        end
        if (op == 20):
            running = 0
        end
        if (op == 21):
            var bi_idx = u16_at(npc)
            var bname = pool_str(bi_idx)
            var bargs = byte_at(npc + 2)
            npc = npc + 3
            if (str_eq(bname, "printf")):
                bi_printf(bargs)
            end
            if (str_eq(bname, "str_len")):
                bi_str_len(bargs)
            end
            if (str_eq(bname, "str_char_at")):
                bi_str_char_at(bargs)
            end
            if (str_eq(bname, "str_substring")):
                bi_str_substring(bargs)
            end
            if (str_eq(bname, "str_concat")):
                bi_str_concat(bargs)
            end
            if (str_eq(bname, "str_eq")):
                bi_str_eq(bargs)
            end
            if (str_eq(bname, "str_to_int")):
                bi_str_to_int(bargs)
            end
            if (str_eq(bname, "int_to_str")):
                bi_int_to_str(bargs)
            end
            if (str_eq(bname, "rand_int")):
                bi_rand_int(bargs)
            end
            if (str_eq(bname, "sys")):
                bi_sys(bargs)
            end
            if (str_eq(bname, "file_read")):
                bi_file_read(bargs)
            end
            if (str_eq(bname, "file_write")):
                bi_file_write(bargs)
            end
            if (str_eq(bname, "ord")):
                bi_ord(bargs)
            end
            if (str_eq(bname, "chr")):
                bi_chr(bargs)
            end
        end
        if (op == 25):
            if (sp > 0):
                sp = sp - 1
            end
        end
        if (op == 26):
            do_pop1()
            push_int(0 - p1_i)
        end
        if (op == 27):
            do_pop1()
            if (p1_i == 0):
                push_int(1)
            else:
                push_int(0)
            end
        end
        pc = npc
    end
end

# ================================================================
# 内置函数
# ================================================================
def bi_printf(nargs):
    var base = sp - nargs
    var fmt = st_str[base]
    var out = ""
    var k = 0
    var fl = str_len(fmt)
    while (k < fl):
        var ch = str_char_at(fmt, k)
        if (str_eq(ch, "%") and k + 1 < fl):
            var nx = str_char_at(fmt, k + 1)
            if (str_eq(nx, "d")):
                out = str_concat(out, int_to_str(st_int[base + 1]))
                k = k + 2
            else:
                if (str_eq(nx, "s")):
                    if (st_type[base + 1] == 1):
                        out = str_concat(out, st_str[base + 1])
                    else:
                        out = str_concat(out, int_to_str(st_int[base + 1]))
                    end
                    k = k + 2
                else:
                    out = str_concat(out, ch)
                    k = k + 1
                end
            end
        else:
            if (str_eq(ch, "\n")):
                out = str_concat(out, "\n")
                k = k + 1
            else:
                out = str_concat(out, ch)
                k = k + 1
            end
        end
    end
    printf("%s", out)
    sp = base
    push_int(0)
end

def bi_str_len(nargs):
    do_pop1()
    push_int(str_len(p1_s))
end

def bi_str_char_at(nargs):
    do_pop2()
    var s = p2_s
    var i = p1_i
    if (i < 0 or i >= str_len(s)):
        push_str("")
    else:
        push_str(str_char_at(s, i))
    end
end

def bi_str_substring(nargs):
    do_pop2()
    var s = p2_s
    var start = p1_i
    var len = 0
    if (start < 0):
        start = 0
    end
    if (start >= str_len(s)):
        len = 0
    else:
        len = str_len(s) - start
    end
    push_str(str_substring(s, start, len))
end

def bi_str_concat(nargs):
    do_pop2()
    push_str(str_concat(p2_s, p1_s))
end

def bi_str_eq(nargs):
    do_pop2()
    if (str_eq(p2_s, p1_s)):
        push_int(1)
    else:
        push_int(0)
    end
end

def bi_str_to_int(nargs):
    do_pop1()
    push_int(str_to_int(p1_s))
end

def bi_int_to_str(nargs):
    do_pop1()
    push_str(int_to_str(p1_i))
end

def bi_rand_int(nargs):
    do_pop1()
    push_int(p1_i % 100)
end

def bi_sys(nargs):
    push_int(0)
end

def bi_file_read(nargs):
    do_pop1()
    var fname = p1_s
    push_str(file_read(fname))
end

def bi_file_write(nargs):
    do_pop2()
    push_int(0)
end

def bi_ord(nargs):
    do_pop1()
    if (str_len(p1_s) > 0):
        push_int(ord(str_char_at(p1_s, 0)))
    else:
        push_int(0)
    end
end

def bi_chr(nargs):
    do_pop1()
    push_str(str_from_char(p1_i))
end

# ================================================================
# 主入口
# ================================================================
printf("QVM v3: QEntL编写的QBC1虚拟机 (极简版)\n")
if (load_qbc() == 1):
    printf("[QVM-Q] 加载 %s code=%d pool=%d funcs=%d\n", g_target, g_code_len, g_pool_len, fn_count)
    run_program()
    printf("\n[QVM-Q] 执行完成\n")
else:
    printf("[QVM-Q] 加载失败 (raw_len=%d code_len=%d)\n", str_len(g_raw), g_code_len)
end