# 数组元素池访问（双段）
# ================================================================
def ae_t_get(pos):
    var p = pos
    if (p < 65535): return ae_type0[p] end
    p = p - 65535
    if (p < 65535): return ae_type1[p] end
    p = p - 65535
    if (p < 65535): return ae_type2[p] end
    p = p - 65535
    if (p < 65535): return ae_type3[p] end
    p = p - 65535
    if (p < 65535): return ae_type4[p] end
    p = p - 65535
    if (p < 65535): return ae_type5[p] end
    p = p - 65535
    if (p < 65535): return ae_type6[p] end
    p = p - 65535
    if (p < 65535): return ae_type7[p] end
    p = p - 65535
    if (p < 65535): return ae_type8[p] end
    p = p - 65535
    if (p < 65535): return ae_type9[p] end
    p = p - 65535
    if (p < 65535): return ae_type10[p] end
    p = p - 65535
    if (p < 65535): return ae_type11[p] end
    p = p - 65535
    if (p < 65535): return ae_type12[p] end
    p = p - 65535
    if (p < 65535): return ae_type13[p] end
    p = p - 65535
    if (p < 65535): return ae_type14[p] end
    p = p - 65535
    if (p < 65535): return ae_type15[p] end
    p = p - 65535
    if (p < 65535): return ae_type16[p] end
    return ae_type17[p - 65535]
end

def ae_t_set(pos, v):
    var p = pos
    # B组: 段9-17 (pos >= 65535*9)
    if (p >= 65535*9):
        p = p - 65535*9
        if (p < 65535): ae_type9[p] = v
        else:
            p = p - 65535
            if (p < 65535): ae_type10[p] = v
            else:
                p = p - 65535
                if (p < 65535): ae_type11[p] = v
                else:
                    p = p - 65535
                    if (p < 65535): ae_type12[p] = v
                    else:
                        p = p - 65535
                        if (p < 65535): ae_type13[p] = v
                        else:
                            p = p - 65535
                            if (p < 65535): ae_type14[p] = v
                            else:
                                p = p - 65535
                                if (p < 65535): ae_type15[p] = v
                                else:
                                    p = p - 65535
                                    if (p < 65535): ae_type16[p] = v
                                    else: ae_type17[p - 65535] = v end
                                end
                            end
                        end
                    end
                end
            end
        end
        return
    end
    # A组: 段0-8
    if (p < 65535): ae_type0[p] = v
    else:
        p = p - 65535
        if (p < 65535): ae_type1[p] = v
        else:
            p = p - 65535
            if (p < 65535): ae_type2[p] = v
            else:
                p = p - 65535
                if (p < 65535): ae_type3[p] = v
                else:
                    p = p - 65535
                    if (p < 65535): ae_type4[p] = v
                    else:
                        p = p - 65535
                        if (p < 65535): ae_type5[p] = v
                        else:
                            p = p - 65535
                            if (p < 65535): ae_type6[p] = v
                            else:
                                p = p - 65535
                                if (p < 65535): ae_type7[p] = v
                                else: ae_type8[p - 65535] = v end
                            end
                        end
                    end
                end
            end
        end
    end
end

