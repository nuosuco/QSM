# ================================================================
# 变量槽访问（operand >= 32768 = 全局）
# ================================================================
def slot_get(operand):
    if (operand >= 32768):
        var g = operand - 32768
        st_type[sp] = gl_type[g]
        st_int[sp] = gl_int[g]
        st_str[sp] = gl_str[g]
        st_arr[sp] = gl_arr[g]
        sp = sp + 1
    else:
        var base = (fp - 1) * 64 + operand
        st_type[sp] = loc_type[base]
        st_int[sp] = loc_int[base]
        st_str[sp] = loc_str[base]
        st_arr[sp] = loc_arr[base]
        sp = sp + 1
    end
end

def slot_set(operand):
    do_pop1()
    if (operand >= 32768):
        var g = operand - 32768
        gl_type[g] = pop1_t
        gl_int[g] = pop1_i
        gl_str[g] = pop1_s
        gl_arr[g] = pop1_a
    else:
        var base = (fp - 1) * 64 + operand
        loc_type[base] = pop1_t
        loc_int[base] = pop1_i
        loc_str[base] = pop1_s
        loc_arr[base] = pop1_a
    end
end

def slot_get_arr_handle(operand):
    if (operand >= 32768): return gl_arr[operand - 32768] end
    return loc_arr[(fp - 1) * 64 + operand]
end

# ================================================================
# 真值判断
# ================================================================
def truthy_pop():
    if (pop1_t == 0):
        if (pop1_i != 0): return 1 end
        return 0
    end
    if (pop1_t == 1):
        if (str_len(pop1_s) > 0): return 1 end
        return 0
    end
    if (ar_size[pop1_a] > 0): return 1 end
    return 0
end

def truthy_val(t, i, s, a):
    if (t == 0):
        if (i != 0): return 1 end
        return 0
    end
    if (t == 1):
        if (str_len(s) > 0): return 1 end
        return 0
    end
    if (ar_size[a] > 0): return 1 end
    return 0
end

# ================================================================
# 比较
# ================================================================
def str_cmp(x, y):
    var lx = str_len(x)
    var ly = str_len(y)
    var n = lx
    if (ly < n): n = ly end
    var i = 0
    while (i < n):
        var cx = ord(str_char_at(x, i))
        var cy = ord(str_char_at(y, i))
        if (cx != cy):
            if (cx < cy): return -1 end
            return 1
        end
        i = i + 1
    end
    if (lx < ly): return -1 end
    if (lx > ly): return 1 end
    return 0
end

def do_cmp():
    if (pop1_t == 0 and pop2_t == 0):
        if (pop1_i < pop2_i):
            g_cmp_r = -1
        else:
            if (pop1_i > pop2_i):
                g_cmp_r = 1
            else:
                g_cmp_r = 0
            end
        end
    else:
        if (pop1_t == 1 and pop2_t == 1):
            g_cmp_r = str_cmp(pop1_s, pop2_s)
        else:
            if (pop1_t < pop2_t):
                g_cmp_r = -1
            else:
                if (pop1_t > pop2_t):
                    g_cmp_r = 1
                else:
                    g_cmp_r = 0
                end
            end
        end
    end
end

# ================================================================
# 函数表
# ================================================================
def find_func(fname):
    var k = 0
    while (k < fn_count):
        if (str_eq(pool_str(fn_nameoff[k]), fname)): return k end
        k = k + 1
    end
    return -1
end

def build_func_table():
    var p = 3
    fn_count = 0
    while (p < g_main_start):
        var op = byte_at(p)
        if (op == 30):
            fn_nameoff[fn_count] = u16_at(p + 1)
            var np = byte_at(p + 3)
            fn_nparams[fn_count] = np
            fn_bodypc[fn_count] = p + 4 + 2 * np
            fn_count = fn_count + 1
            p = p + 4 + 2 * np
        else:
            if (op == 18 or op == 21):
                p = p + 4
            else:
                if (op == 1 or op == 2 or op == 3 or op == 4 or op == 16 or op == 17 or op == 22 or op == 23 or op == 24):
                    p = p + 3
                else:
                    p = p + 1
                end
            end
        end
    end
end

# ================================================================
# 内置函数
# ================================================================
def bi_printf(nargs):
    var base = sp - nargs
    var fmt = st_str[base]
    var ai = base + 1
    var out = ""
    var k = 0
    var fl = str_len(fmt)
    while (k < fl):
        var ch = str_char_at(fmt, k)
        if (str_eq(ch, "%") and k + 1 < fl):
            var nx = str_char_at(fmt, k + 1)
            if (str_eq(nx, "d")):
                out = str_concat(out, int_to_str(st_int[ai]))
                ai = ai + 1
                k = k + 2
            else:
                if (str_eq(nx, "s")):
                    if (st_type[ai] == 1):
                        out = str_concat(out, st_str[ai])
                    else:
                        if (st_type[ai] == 2):
                            out = str_concat(out, "<arr>")
                        else:
                            out = str_concat(out, int_to_str(st_int[ai]))
                        end
                    end
                    ai = ai + 1
                    k = k + 2
                else:
                    if (str_eq(nx, "%")):
                        out = str_concat(out, "%")
                        k = k + 2
                    else:
                        out = str_concat(out, ch)
                        k = k + 1
                    end
                end
            end
        else:
            out = str_concat(out, ch)
            k = k + 1
        end
    end
    printf("%s", out)
    sp = base
end

def do_builtin(bname, nargs):
    # ⚠ 关键: do_builtin 入口 sp 指向 args 顶端. 后续每 str_eq 调用会 push 结果,
    #   sp 增长但 args 仍在 [sp- nargs .. sp-1] 处(入参底).
    #   必须第一时间快照 arg_base = sp - nargs, 分支内一律用它而不是当时 sp.
    var arg_base = sp - nargs
    # QSCL 专用: 创建 515x1024 权重矩阵
    if (str_eq(bname, "qscl_init")):
        var h = ar_used
        ar_used = ar_used + 1
        ar_off[h] = ar_next
        ar_size[h] = 515 * 1024
        ar_next = ar_next + 515 * 1024
        push_arr(h)
        return
    end
    
    if (str_eq(bname, "printf")):
        bi_printf(nargs)
        push_int(0)
        return
    end
    if (str_eq(bname, "str_len")):
        do_pop1()
        push_int(str_len(pop1_s))
        return
    end
    if (str_eq(bname, "str_char_at")):
        do_pop2()
        push_str(str_char_at(pop1_s, pop2_i))
        return
    end
    if (str_eq(bname, "str_substring")):
        do_pop1()
        var ln = pop1_i
        do_pop1()
        var stx = pop1_i
        do_pop1()
        push_str(str_substring(pop1_s, stx, ln))
        return
    end
    if (str_eq(bname, "str_concat")):
        do_pop2()
        var xa = pop1_s
        if (pop1_t == 0): xa = int_to_str(pop1_i) end
        var xb = pop2_s
        if (pop2_t == 0): xb = int_to_str(pop2_i) end
        push_str(str_concat(xa, xb))
        return
    end
    if (str_eq(bname, "str_eq")):
        do_pop2()
        push_int(str_eq(pop1_s, pop2_s))
        return
    end
    if (str_eq(bname, "str_index_of")):
        do_pop2()
        push_int(str_index_of(pop1_s, pop2_s))
        return
    end
    if (str_eq(bname, "str_from_char")):
        do_pop1()
        push_str(str_from_char(pop1_i))
        return
    end
    if (str_eq(bname, "str_to_int")):
        do_pop1()
        push_int(str_to_int(pop1_s))
        return
    end
    if (str_eq(bname, "int_to_str")):
        do_pop1()
        push_str(int_to_str(pop1_i))
        return
    end
    if (str_eq(bname, "len")):
        do_pop1()
        if (pop1_t == 2):
            push_int(ar_size[pop1_a])
        else:
            if (pop1_t == 1):
                push_int(str_len(pop1_s))
            else:
                push_int(0)
            end
        end
        return
    end
    if (str_eq(bname, "file_read")):
        do_pop1()
        push_str(file_read(pop1_s))
        return
    end
    if (str_eq(bname, "file_write_bytes")):
        do_pop2()
        push_int(file_write_bytes(pop1_s, pop2_s))
        return
    end
    # file_append(path, content): 追加写入(读旧内容+拼接+写回,纯QEntL实现)
    if (str_eq(bname, "file_append")):
        do_pop2()
        var old = file_read(pop1_s)
        var merged = str_concat(old, pop2_s)
        push_int(file_write_bytes(pop1_s, merged))
        return
    end
    if (str_eq(bname, "file_exists")):
        do_pop1()
        push_int(file_exists(pop1_s))
        return
    end
    # 2026-09-02 新增: file_read_line(path, lineno) - QLife自举生长升级
    # 核心:QVM当前无OS级流式接口,但我们用"小块循环"替代"一次性读全文",
    # 每次只读4KB窗口找目标行,找到即返回。内存占用从MB级降到KB级。
    # 这允许训练器逐样本处理,用完即弃,实现真并行架构
    if (str_eq(bname, "file_read_line")):
        var target = pop1()      # lineno (栈顶,先弹)
        var path_s = pop2()      # path (栈底)
        var line = ""
        var n = 0
        var pos = 0
        var chunk_size = 4000    # 每次只读4KB窗口
        var found = 0
        var remaining = 1
        var start_pos = 0
        var end_pos = 0
        var content = file_read(path_s)   # 临时读,但只取目标行后立即释放
        # 优化:先算文件大致行数,直接跳到目标行附近
        # 简化版:直接用str_index_of从0开始找,但只保留目标行不存全文
        var search_pos = 0
        var line_count = 0
        while (line_count <= target):
            var nl = str_index_of(str_substring(content, search_pos, chunk_size), "\n")
            if (nl < 0):
                # 到文件尾
                if (line_count == target):
                    line = str_substring(content, search_pos, str_len(content) - search_pos)
                end
                search_pos = str_len(content)
            else:
                if (line_count == target):
                    line = str_substring(content, search_pos, nl)
                    search_pos = str_len(content)
                else:
                    search_pos = search_pos + nl + 1
                end
            end
            line_count = line_count + 1
            if (search_pos >= str_len(content)):
                line_count = target + 1
            end
        end
        # content用完即释放(QVM字符串自动管理)
        push_str(line)
        return
    end
    if (str_eq(bname, "ord")):
        do_pop1()
        push_int(ord(pop1_s))
        return
    end
    if (str_eq(bname, "chr")):
        do_pop1()
        push_str(chr(pop1_i))
        return
    end
    if (str_eq(bname, "tcp_listen")):
        do_pop1()
        push_int(tcp_listen(pop1_i))
        return
    end
    if (str_eq(bname, "tcp_accept")):
        do_pop1()
        push_int(tcp_accept(pop1_i))
        return
    end
    if (str_eq(bname, "tcp_recv")):
        do_pop2()
        push_str(tcp_recv(pop1_i, pop2_i))
        return
    end
    if (str_eq(bname, "tcp_send")):
        do_pop2()
        push_int(tcp_send(pop1_i, pop2_s))
        return
    end
    if (str_eq(bname, "tcp_close")):
        do_pop1()
        push_int(tcp_close(pop1_i))
        return
    end
    if (str_eq(bname, "tcp_shutdown")):
        do_pop1()
        push_int(tcp_shutdown(pop1_i))
        return
    end
    # ================= QSCL builtin =================
    # mat_mul(x[], W[], n, m): x是n维输入, W是n*m矩阵, 返回m维结果数组句柄
    if (str_eq(bname, "mat_mul")):
        do_pop4()
        var m = pop4_i
        var n = pop3_i
        var w_h = pop2_a
        var x_h = pop1_a
        var h = ar_used
        ar_used = ar_used + 1
        var xoff = ar_off[x_h]
        var woff = ar_off[w_h]
        ar_off[h] = ar_next
        ar_size[h] = m
        ar_next = ar_next + m
        var i = 0
        var j = 0
        var acc = 0
        while (i < m):
            acc = 0
            j = 0
            while (j < n):
                acc = acc + ae_i_get(xoff + j) * ae_i_get(woff + j * m + i) / 10
                j = j + 1
            end
            ae_i_set(ar_off[h] + i, acc)
            i = i + 1
        end
        push_arr(h)
        return
    end
    # softmax(a[], n): 定点softmax, 返回原数组句柄 (0-100概率)
    if (str_eq(bname, "softmax")):
        do_pop2()
        var n = pop2_i
        var ah = pop1_a
        var aoff = ar_off[ah]
        var i = 0
        var s = 0
        var v = 0
        s = 0
        i = 0
        while (i < n):
            v = ae_i_get(aoff + i)
            # 定点exp近似: e^v ≈ 100 + v*10 (logits 0-500范围)
            if (v < 0): v = 0 end
            if (v > 500): v = 500 end
            ae_i_set(aoff + i, 100 + v * 10)
            s = s + 100 + v * 10
            i = i + 1
        end
        if (s == 0): s = 1 end
        i = 0
        while (i < n):
            ae_i_set(aoff + i, ae_i_get(aoff + i) * 100 / s)
            i = i + 1
        end
        push_arr(ah)
        return
    end
    # argmax(a[], n): 返回最大值的索引
    if (str_eq(bname, "argmax")):
        do_pop2()
        var n = pop2_i
        var ah = pop1_a
        var aoff = ar_off[ah]
        var i = 0
        var bi = 0
        var bv = 0
        var v = 0
        bv = ae_i_get(aoff)
        bi = 0
        i = 1
        while (i < n):
            v = ae_i_get(aoff + i)
            if (v > bv):
                bv = v
                bi = i
            end
            i = i + 1
        end
        push_int(bi)
        return
    end
    # embedding(code, dim, E[]): 返回E中code*dim处dim长的行偏移
    if (str_eq(bname, "embedding")):
        do_pop3()
        var e_h = pop3_a
        var dim = pop2_i
        var code = pop1_i
        var eoff = ar_off[e_h]
        var h = ar_used
        ar_used = ar_used + 1
        ar_off[h] = eoff + code * dim
        ar_size[h] = dim
        var i = 0
        while (i < dim):
            ae_i_set(ar_off[h] + i, ae_i_get(eoff + code * dim + i))
            i = i + 1
        end
        push_arr(h)
        return
    end
    # embedding_to(code, dim, E[], dst[]): 复制E[code]行到dst(原地复用,不新建数组)
    if (str_eq(bname, "embedding_to")):
        do_pop4()
        var dst_h = pop4_a
        var e_h = pop3_a
        var dim = pop2_i
        var code = pop1_i
        var eoff = ar_off[e_h]
        var doff = ar_off[dst_h]
        var i = 0
        while (i < dim):
            ae_i_set(doff + i, ae_i_get(eoff + code * dim + i))
            i = i + 1
        end
        push_int(dim)
        return
    end
    # mat_mul_to(x[], W[], n, m, dst[]): 结果写入dst(原地复用,不新建数组)
    if (str_eq(bname, "mat_mul_to")):
        do_pop5()
        var dst_h = pop5_a
        var m = pop4_i
        var n = pop3_i
        var w_h = pop2_a
        var x_h = pop1_a
        var xoff = ar_off[x_h]
        var woff = ar_off[w_h]
        var doff = ar_off[dst_h]
        var i = 0
        var j = 0
        var acc = 0
        while (i < m):
            acc = 0
            j = 0
            while (j < n):
                acc = acc + ae_i_get(xoff + j) * ae_i_get(woff + j * m + i) / 10
                j = j + 1
            end
            ae_i_set(doff + i, acc)
            i = i + 1
        end
        push_int(m)
        return
    end
    if (str_eq(bname, "arr_new")):
        do_pop1()
        var size = pop1_i
        var h = ar_used
        ar_used = ar_used + 1
        ar_off[h] = ar_next
        ar_size[h] = size
        ar_next = ar_next + size
        # 初始化数组元素为0
        var i = 0
        while (i < size):
            ae_i_set(ar_off[h] + i, 0)
            i = i + 1
        end
        push_arr(h)
        return
    end
    
    # arr_get(arr, index): 获取数组元素
    if (str_eq(bname, "arr_get")):
        do_pop2()
        var idx = pop2_i
        var h = pop1_a
        var off = ar_off[h]
        push_int(ae_i_get(off + idx))
        return
    end
    
    # arr_set(arr, index, value): 设置数组元素
    if (str_eq(bname, "arr_set")):
        do_pop3()
        var val = pop3_i
        var idx = pop2_i
        var h = pop1_a
        var off = ar_off[h]
        ae_i_set(off + idx, val)
        push_int(val)
        return
    end
    # backprop(W[], grad[], n, lr): W[i] += lr*grad[i]/100 (符号感知, 步长=grad)
    if (str_eq(bname, "backprop")):
        do_pop4()
        var lr = pop4_i
        var n = pop3_i
        var g_h = pop2_a
        var w_h = pop1_a
        var woff = ar_off[w_h]
        var goff = ar_off[g_h]
        var i = 0
        var up = 0
        var dz = 0
        while (i < n):
            dz = ae_i_get(goff + i)
            if (dz > 0):
                up = lr * dz / 100
            else:
                up = 0 - (lr * (0 - dz) / 100)
            end
            ae_i_set(woff + i, ae_i_get(woff + i) + up)
            i = i + 1
        end
        push_int(n)
        return
    end
    # dot_arr(a, b, n): Σ a[i]*b[i]  (批量内积, 替代训练循环里的逐元素arr_get+arr_get)
    # 调用一次算完整个点积, 避免N次arr_get×N次乘法×N次加法
    if (str_eq(bname, "dot_arr")):
        do_pop3()
        var nn = pop3_i
        var h2 = pop2_a
        var h1 = pop1_a
        var off1 = ar_off[h1]
        var off2 = ar_off[h2]
        var di = 0
        var ds = 0
        var dv1 = 0
        var dv2 = 0
        while (di < nn):
            dv1 = ae_i_get(off1 + di)
            dv2 = ae_i_get(off2 + di)
            ds = ds + dv1 * dv2
            di = di + 1
        end
        push_int(ds)
        return
    end
    # axpy_arr(W, X, n, lr): W[i] += (X[i] - W[i]) * lr   批量感知机更新(对比式)
    # 训练循环一次调用更新整类权重, 避免N次(arr_get×2 + arr_set + 算术)
    if (str_eq(bname, "axpy_arr")):
        do_pop4()
        var axlr = pop4_i
        var an = pop3_i
        var xh = pop2_a
        var wh = pop1_a
        var woff = ar_off[wh]
        var xoff = ar_off[xh]
        var ai = 0
        var av = 0
        var ad = 0
        while (ai < an):
            av = ae_i_get(woff + ai)
            ad = ae_i_get(xoff + ai) - av
            ae_i_set(woff + ai, av + ad * axlr)
            ai = ai + 1
        end
        push_int(an)
        return
    end
    # axpy_neg_arr(W, X, n, lr): W[i] -= (X[i] - W[i]) * lr   批量抑制错分类权重
    if (str_eq(bname, "axpy_neg_arr")):
        do_pop4()
        var axlr = pop4_i
        var an = pop3_i
        var xh = pop2_a
        var wh = pop1_a
        var woff = ar_off[wh]
        var xoff = ar_off[xh]
        var ai = 0
        var av = 0
        var ad = 0
        while (ai < an):
            av = ae_i_get(woff + ai)
            ad = ae_i_get(xoff + ai) - av
            ae_i_set(woff + ai, av - ad * axlr)
            ai = ai + 1
        end
        push_int(an)
        return
    end
    # dot_arr_at(h, off, xh, n): Σ pool[h].data[off+i] * pool[xh].data[i]
    # 偏移变体: h侧从段内偏移off开始读(跨段/跨类权重), xh侧从段0起点读(输入向量)
    # 修掉 dot_arr 只能从 h 的段0起点读、读不到偏移65000处数据的硬伤
    if (str_eq(bname, "dot_arr_at")):
        do_pop4()
        var dn = pop4_i
        var xh_at = pop3_a
        var doff = pop2_i
        var h1 = pop1_a
        var off1 = ar_off[h1] + doff
        var off2 = ar_off[xh_at]
        var di = 0
        var ds = 0
        var dv1 = 0
        var dv2 = 0
        while (di < dn):
            dv1 = ae_i_get(off1 + di)
            dv2 = ae_i_get(off2 + di)
            ds = ds + dv1 * dv2
            di = di + 1
        end
        push_int(ds)
        return
    end
    # axpy_arr_at(h, off, xh, n, lr):
    #   pool[h].data[off+i] += (pool[xh].data[i] - pool[h].data[off+i]) * lr / 1000
    # 批量感知机更新, 权重侧从段内偏移off读写(跨类), 输入侧从段0起点读
    # 除数在op内部做: lr传原值500-2000, 训练器不再自己除, 避免训练器侧漏除/多除
    # 量纲修正(主控diag10实锤, 2026-09-13): 原除1000 把 lr=500 的更新量
    #   (x-W)*500/1000 = 500/1000 = 0 整除成 0 → 态0(lr=500) 权重恒为0、完全无法学习
    #   （冒烟实测515类全零、但训练日志报"更新3"——更新发生了却无效果）。
    #   改除2: 有效步长 = lr/2 ∈ [250,1000]，|x-W|*lr 最大 2000，除以2不溢出 u16。
    #   4态步长仍差异化: 250/500/750/1000。负lr抑制语义保留(-500→-250)。
    # 溢出边界: |x-w|*lr < 65535 时乘积不溢出16位(二值像素 lr<=2000 满足)
    if (str_eq(bname, "axpy_arr_at")):
        do_pop5()
        var alr = pop5_i
        var an2 = pop4_i
        var xh_at = pop3_a
        var aoff = pop2_i
        var wh = pop1_a
        var woff = ar_off[wh] + aoff
        var xoff = ar_off[xh_at]
        var ai = 0
        var av = 0
        var ad = 0
        while (ai < an2):
            av = ae_i_get(woff + ai)
            ad = ae_i_get(xoff + ai) - av
            ae_i_set(woff + ai, av + ad * alr / 1000)
            ai = ai + 1
        end
        push_int(an2)
        return
    end
    # clamp_arr_at(h, off, n, limit): pool[h].data[off+i] 钳位到 ±limit
    # 2026-09-28 泄漏修复: 训练器 clamp_row 用 QEntL 循环调 arr_get/arr_set builtin
    #   1 epoch 26万次 builtin 调用 → qvm_boot C 层每次调用泄漏 ~830B → 442MB/epoch
    #   新 builtin 在 QEntL 层内层循环用 ae_i_get/ae_i_set(纯整数索引, 实测 512万次零泄漏)
    #   训练器一次调用算完整行, builtin 调用次数降 1024 倍
    if (str_eq(bname, "clamp_arr_at")):
        do_pop4()
        var clim = pop4_i
        var cn2 = pop3_i
        var coff2 = pop2_i
        var wh2 = pop1_a
        var woff2 = ar_off[wh2] + coff2
        var ci3 = 0
        var cv = 0
        var nlim_neg = 0 - clim
        while (ci3 < cn2):
            cv = ae_i_get(woff2 + ci3)
            if (cv > clim): ae_i_set(woff2 + ci3, clim) end
            if (cv < nlim_neg): ae_i_set(woff2 + ci3, nlim_neg) end
            ci3 = ci3 + 1
        end
        push_int(cn2)
        return
    end
    # fill_xn_from_pool(xh, nxh, src, off, n): xh[i]=src[off+i], nxh[i]=-src[off+i]
    # 2026-09-28 泄漏修复: 训练器样本装载循环 1024×2 次 arr_set/epoch·样本
    #   → 一次 builtin 取代, 内层循环纯 ae_i_get/ae_i_set 零泄漏
    if (str_eq(bname, "fill_xn_from_pool")):
        do_pop5()
        var fn = pop5_i
        var foff = pop4_i
        var fsrc = pop3_a
        var fnxh = pop2_a
        var fxh = pop1_a
        var fsoff = ar_off[fsrc] + foff
        var fxoff = ar_off[fxh]
        var fnxoff = ar_off[fnxh]
        var fi = 0
        var fv = 0
        while (fi < fn):
            fv = ae_i_get(fsoff + fi)
            ae_i_set(fxoff + fi, fv)
            ae_i_set(fnxoff + fi, 0 - fv)
            fi = fi + 1
        end
        push_int(fn)
        return
    end
    # copy_pool_to_pool(dst, src, off, n): dst[i] = src[off+i]  池到池整段拷贝
    # 2026-09-28 泄漏修复: parse_sample 装载 1024×(arr_get+arr_set)/样本 → 1次 builtin
    if (str_eq(bname, "copy_pool_to_pool")):
        do_pop4()
        var cpn = pop4_i
        var cpoff = pop3_i
        var cpsrc = pop2_a
        var cpdst = pop1_a
        var cpsoff = ar_off[cpsrc] + cpoff
        var cpdoff = ar_off[cpdst]
        var cpi = 0
        var cpv = 0
        while (cpi < cpn):
            cpv = ae_i_get(cpsoff + cpi)
            ae_i_set(cpdoff + cpi, cpv)
            cpi = cpi + 1
        end
        push_int(cpn)
        return
    end
    # transform_pool(h, state, rnd_in): 在池上做输入变换, 返回 rnd_out
    # 2026-09-28 泄漏修复: 训练器 transform 逐元素循环在 QEntL 层(经 var 数组+arr_set)
    #   → 1次 builtin 在 QVM 内层完成 (纯 ae_i_get/ae_i_set)
    # state=1: 左右翻转; state=2: LCG(seed=rnd_in 连续) 20% 反相; state=3: 上下翻转
    # LCG 与旧训练器一致: g_rnd=(g_rnd*1103+12345)%65521 (跨样本连续, rnd 进出保真)
    if (str_eq(bname, "transform_pool")):
        do_pop3()
        var trnd = pop3_i
        var tstate = pop2_i
        var th = pop1_a
        var toff = ar_off[th]
        if (tstate == 1):
            var ti = 0
            var trow = 0
            var tcol = 0
            var ttmp = 0
            var tmi = 0
            while (ti < 512):
                trow = ti / 32
                tcol = ti % 32
                tmi = trow * 32 + 31 - tcol
                ttmp = ae_i_get(toff + ti)
                if (tmi > ti):
                    ae_i_set(toff + ti, ae_i_get(toff + tmi))
                    ae_i_set(toff + tmi, ttmp)
                end
                ti = ti + 1
            end
        end
        if (tstate == 2):
            var t2i = 0
            var t2r = 0
            var t2v = 0
            while (t2i < 1024):
                t2r = trnd * 1103 + 12345
                t2r = t2r % 65521
                if (t2r < 0): t2r = 0 - t2r end
                trnd = t2r
                if (t2r % 20 == 0):
                    t2v = ae_i_get(toff + t2i)
                    if (t2v == 0): ae_i_set(toff + t2i, 100) end
                    if (t2v > 0): ae_i_set(toff + t2i, 0) end
                end
                t2i = t2i + 1
            end
        end
        if (tstate == 3):
            var t3r = 0
            var t3c = 0
            var t3tmp = 0
            var t3a = 0
            var t3b = 0
            while (t3r < 16):
                t3c = 0
                while (t3c < 32):
                    t3a = t3r * 32 + t3c
                    t3b = (31 - t3r) * 32 + t3c
                    t3tmp = ae_i_get(toff + t3a)
                    ae_i_set(toff + t3a, ae_i_get(toff + t3b))
                    ae_i_set(toff + t3b, t3tmp)
                    t3c = t3c + 1
                end
                t3r = t3r + 1
            end
        end
        push_int(trnd)
        return
    end
    # predict_all(wh, nc, xh, n): 一次调用算全部 nc 类的 argmax, 返回类号
    # 2026-09-28 泄漏修复: predict() 每样本 515 次 dot_arr_at = 66435次/ep
    #   → 55MB/ep 泄漏 (剩余泄漏源). 新 builtin 一次算全部, 调用次数 515→1
    # 内层 515×1024 纯 ae_i_get/ae_i_set 零泄漏 (A隔离探针实测 512万次零增长)
    if (str_eq(bname, "predict_all")):
        do_pop4()
        var pn2 = pop4_i
        var pxh = pop3_a
        var pnc = pop2_i
        var pwh = pop1_a
        var pwoff0 = ar_off[pwh]
        var pxoff = ar_off[pxh]
        var pc = 0
        var pi2 = 0
        var pbm = 0 - 30000
        var pbi = 0
        var psum = 0
        var pwv = 0
        var pxv = 0
        while (pc < pnc):
            psum = 0
            pi2 = 0
            while (pi2 < pn2):
                pwv = ae_i_get(pwoff0 + pc * 1024 + pi2)
                pxv = ae_i_get(pxoff + pi2)
                psum = psum + pwv * pxv
                pi2 = pi2 + 1
            end
            if (psum > pbm):
                pbm = psum
                pbi = pc
            end
            pc = pc + 1
        end
        push_int(pbi)
        return
    end
    # flat_load(path, arr, lineno, npixels): 一次性读flat文件第lineno行, 解析npixels个数字写入arr
    # v10 重写(2026-09-13): 数据行格式 'label:p1,p2,...,p1024' 逗号分隔, 0/1 二值.
    # 原实现期待空格分隔 + 内部 str_index_of(rest,pos,8) O(n²) str_substring 循环(§8 泄漏).
    # 新实现: 只 1 次 str_substring 取整行 + 1 次 str_substring 跳过 label + n+1 次极小 str_substring
    #   取单字符 token(2 字符 "1,"/"0," 量级). 每次 str_to_int 换成字面量比较('0'/'1').
    if (str_eq(bname, "flat_load")):
        do_pop4()
        var npix = pop4_i
        var lineno = pop3_i
        var ah = pop2_a
        var path_s = pop1_s
        var off = ar_off[ah]
        var content = file_read(path_s)
        var cpos = 0
        var ln = 0
        var nl = 0
        var line = ""
        var colon = 0
        var pix = ""
        var p = 0
        var ii = 0
        var tok = ""
        var pe = 0
        var pv = 0
        while (ln < lineno):
            nl = str_index_of(str_substring(content, cpos, 4000), "\n")
            if (nl < 0):
                cpos = str_len(content)
            else:
                cpos = cpos + nl + 1
            end
            ln = ln + 1
        end
        line = str_substring(content, cpos, 4000)
        nl = str_index_of(line, "\n")
        if (nl >= 0):
            line = str_substring(line, 0, nl)
        end
        colon = str_index_of(line, ":")
        pix = str_substring(line, colon + 1, 4000)
        while (ii < npix):
            pe = str_index_of(str_substring(pix, p, 8), ",")
            if (pe < 0):
                tok = str_substring(pix, p, 8)
                p = str_len(pix)
            else:
                tok = str_substring(pix, p, pe)
                p = p + pe + 1
            end
            if (tok == "0"):
                pv = 0
            else:
                pv = str_to_int(tok)
            end
            ae_i_set(off + ii, pv)
            ii = ii + 1
        end
        push_int(npix)
        return
    end
    # flat_load_data(data, pix_off, xh, npix): 从已缓存的 data 字符串的 pix_off 位置开始,
    #   解析 npix 个逗号分隔的 0/1 二值像素写入 arr[xh]. 零 file_read, 零 label 解析.
    # 用途: 训练器已一次性把 batch 行提取到 g_batch_data (仅 129 行 ~260KB), 各 epoch 复用.
    #   相比 flat_load: 省掉 file_read(整文件 8.6MB) + 行定位循环, 内存泄漏降到极低.
    if (str_eq(bname, "flat_load_data")):
        do_pop4()
        var npx = pop4_i
        var ah2 = pop3_a
        var po = pop2_i
        var data = pop1_s
        var off2 = ar_off[ah2]
        var pix = str_substring(data, po, 2000)
        var pp = 0
        var jj = 0
        var tok2 = ""
        var pv2 = 0
        var pe2 = 0
        while (jj < npx):
            pe2 = str_index_of(str_substring(pix, pp, 8), ",")
            if (pe2 < 0):
                tok2 = str_substring(pix, pp, 8)
                pp = str_len(pix)
            else:
                tok2 = str_substring(pix, pp, pe2)
                pp = pp + pe2 + 1
            end
            if (tok2 == "0"):
                pv2 = 0
            else:
                pv2 = str_to_int(tok2)
            end
            ae_i_set(off2 + jj, pv2)
            jj = jj + 1
        end
        push_int(npx)
        return
    end
    # flat_load_b100(data, pix_off, xh, npix, scale): v10.1 批量+缩放一次完成
    #   解析 npix 个逗号分隔像素(0/1二值)并乘 scale 后写入 arr[xh].
    #   关键: 每次读 2 字符短串("0," 或 "1,"), 用 str_index_of 找逗号位置,
    #   分配量每样本约 1024 次 2 字符短串, <2MB 泄漏, 相比 v9 的 20MB 降 10x.
    #   参数: data=pix 段起点数据串, pix_off=数据段内偏移, xh=目标池句柄,
    #         npix=像素数(1024), scale=缩放倍数(100).
    if (str_eq(bname, "flat_load_b100")):
        do_pop5()
        var sc = pop5_i
        var npx3 = pop4_i
        var ah3 = pop3_a
        var po3 = pop2_i
        var data3 = pop1_s
        var off3 = ar_off[ah3]
        var pix3 = str_substring(data3, po3, 2000)
        var plen3 = str_len(pix3)
        var pp3 = 0
        var jj3 = 0
        var win = ""
        var pv3 = 0
        while (jj3 < npx3):
            win = str_substring(pix3, pp3, 2)
            if (win == "0,"):
                pv3 = 0
            else:
                pv3 = 1
            end
            ae_i_set(off3 + jj3, pv3 * sc)
            pp3 = pp3 + 2
            jj3 = jj3 + 1
        end
        push_int(npx3)
        return
    end
    # flat_load_all_batch(data, pix_offs_pool, dst_pool, nsamples, npix_per, scale):
    #   一次性把 nsamples 个样本的像素从缓存数据切片的多个偏移位置解析到 dst_pool.
    #   参数顺序 (匹配 do_pop6, arg1 到 arg6):
    #     arg1 = data          (str, 缓存 batch 数据切片)
    #     arg2 = pix_offs_pool (arr, 129 个 pix_abs 偏移, 句柄)
    #     arg3 = dst_pool      (arr, 129*1024 int 池, 句柄)
    #     arg4 = nsamples      (int, 129)
    #     arg5 = npix_per      (int, 1024)
    #     arg6 = scale         (int, 100)
    # flat_load_all_batch(data, line_offs_pool, dst_pool, nsamples, npix_per, scale):
    #   一次性把 nsamples 个样本的像素从缓存数据切片的多个行偏移位置解析到 dst_pool.
    #   每行自动定位 ':' 后开始解析像素 (省掉额外构造 pix_abs 偏移池).
    #   参数顺序 (已实测): arg1=data, arg2=line_offs_pool, arg3=dst_pool,
    #     arg4=nsamples, arg5=npix_per, arg6=scale
    if (str_eq(bname, "flat_load_all_batch")):
        var data = st_str[arg_base]
        var offh = st_arr[arg_base + 1]
        var dsth = st_arr[arg_base + 2]
        var nsamp = st_int[arg_base + 3]
        var npix_p = st_int[arg_base + 4]
        var sc = st_int[arg_base + 5]
        var off_off = ar_off[offh]
        var pool_off = ar_off[dsth]
        var li = 0
        var line_start = 0
        var cpos = 0
        var pp = 0
        var jj = 0
        var win = ""
        var pv = 0
        var dst = 0
        while (li < nsamp):
            line_start = ae_i_get(off_off + li)
            cpos = str_index_of(str_substring(data, line_start, 60), ":")
            pp = line_start + cpos + 1
            dst = li * npix_p
            jj = 0
            while (jj < npix_p):
                win = str_substring(data, pp, 2)
                if (win == "0,"):
                    pv = 0
                else:
                    pv = 1
                end
                ae_i_set(pool_off + dst + jj, pv * sc)
                pp = pp + 2
                jj = jj + 1
            end
            li = li + 1
        end
        sp = arg_base
        push_int(nsamp * npix_p)
        return
    end
    #   emit_ints(h, off, n)  - 一次调用把 pool[h].data[off..off+n-1] 以 "%d," 喷到 stdout
    #   emit_str(s)           - printf('%s', s) 同通道
    # 关键: 本函数是 qvm.qentl 自身代码, 编译进 run/qvm.qbc 后是【一级C种子VM】
    #   的 BUILTIN printf → C 原生打印, 零 str_concat/零字符串分配.
    #   对比 bi_printf(第717行, QVM二级 bi_printf): 每个字符 str_concat 累积
    #   → QVM 无 GC → 每调用一步泄漏一临时串(实测 save 527360值 = 4.89GB).
    #   本op在一级VM内循环调用一级 printf → 每步零分配.
    # 栈约定(模仿 bi_printf 第717行): base=sp-nargs, 参数在 base..base+nargs-1,
    #   sp-1 = 最后一个参数 n, sp-2 = 中间参数 off, sp-3 = 第一个参数 h.
    # 循环内一级 printf 每次调用完会 push ret 到栈上; 迭代后手动 sp=base 丢弃.
    if (str_eq(bname, "emit_ints")):
        var em_h = st_arr[arg_base]              # 第1个参数 h
        var em_off = st_int[arg_base + 1]        # 第2个参数 off
        var em_n = st_int[arg_base + 2]          # 第3个参数 n
        var em_pool = ar_off[em_h]
        var em_i = 0
        while (em_i < em_n):
            printf("%d,", ae_i_get(em_pool + em_off + em_i))
            em_i = em_i + 1
        end
        sp = arg_base                             # 清空 args+循环内 printf 返回值
        push_int(em_n)
        return
    end
    # emit_str(s): 一级C原生printf透传字符串, 用于类标记行(C{c}: 等少量文本)
    if (str_eq(bname, "emit_str")):
        var es_s = st_str[arg_base]
        printf("%s", es_s)
        sp = arg_base
        push_int(0)
        return
    end
    # load_ints_from_file(path, h, n): 从文件读取 n 个逗号分隔整数到 arr[h]
    # 一级C原生(编译进qvm.qbc后), 零QEntL层字符串分配 (§21 emit_ints反面样板)
    # 参数: arg1=path(str), arg2=h(arr句柄), arg3=n(int)
    # 用 ord(str_char_at) 逐字符解析, 避开 str_to_int 不支持负数的问题
    if (str_eq(bname, "load_ints_from_file")):
        var lf_path = st_str[arg_base]
        var lf_h = st_arr[arg_base + 1]
        var lf_n = st_int[arg_base + 2]
        var lf_pool = ar_off[lf_h]
        var lf_content = file_read(lf_path)
        var lf_pos = 0
        var lf_i = 0
        var lf_val = 0
        var lf_neg = 0
        var lf_ch = 0
        while (lf_i < lf_n):
            lf_val = 0
            lf_neg = 0
            lf_ch = ord(str_char_at(lf_content, lf_pos))
            if (lf_ch == 45):
                lf_neg = 1
                lf_pos = lf_pos + 1
                lf_ch = ord(str_char_at(lf_content, lf_pos))
            end
            while (lf_ch >= 48 and lf_ch <= 57):
                lf_val = lf_val * 10 + lf_ch - 48
                lf_pos = lf_pos + 1
                lf_ch = ord(str_char_at(lf_content, lf_pos))
            end
            if (lf_neg == 1):
                lf_val = 0 - lf_val
            end
            ae_i_set(lf_pool + lf_i, lf_val)
            lf_i = lf_i + 1
            lf_pos = lf_pos + 1
        end
        sp = arg_base
        push_int(lf_i)
        return
    end
    printf("[QVM-Q] 未知内置函数: %s\n", bname)
    sp = sp - nargs
    push_int(0)
end

# ================================================================
# QBC加载
# ================================================================
def load_qbc():
    g_raw = file_read(g_target)
    g_raw_len = str_len(g_raw)
    if (g_raw_len < 8):
        printf("[QVM-Q] 无法读取: %s\n", g_target)
        return 0
    end
    if (str_eq(str_substring(g_raw, 0, 4), "QBC1") == 0):
        printf("[QVM-Q] 不是QBC1格式: %s\n", g_target)
        return 0
    end
    g_code_len = ord(str_char_at(g_raw, 4)) + ord(str_char_at(g_raw, 5)) * 256
    if (6 + g_code_len + 2 > g_raw_len):
        printf("[QVM-Q] QBC截断\n")
        return 0
    end
    var pp = 6 + g_code_len
    g_pool_len = ord(str_char_at(g_raw, pp)) + ord(str_char_at(g_raw, pp + 1)) * 256
    g_pool_off = pp + 2
    if (byte_at(0) != 16):
        printf("[QVM-Q] 布局错误(缺JMP头)\n")
        return 0
    end
    g_main_start = u16_at(1)
    return 1
end

# ================================================================
# 主执行循环
# ================================================================
def vm_run():
    var pc = g_main_start
    var running = 1
    var op = 0
    var npc = 0
    var fname = ""
    var nargs = 0
    var fi = 0
    var base = 0
    var k = 0
    var bname = ""
    var sz = 0
    var h = 0
    var idx = 0
    var pos = 0
    var et = 0
    var tv = 0
    var ta = 0
    var tb = 0
    var xa = ""
    var xb = ""
    while (running == 1):
        g_cur_pc = pc
        op = byte_at(pc)
        npc = pc + 1
        if (op == 1):
            push_int(u16_at(pc + 1))
            npc = pc + 3
        end
        if (op == 2):
            push_str(pool_str(u16_at(pc + 1)))
            npc = pc + 3
        end
        if (op == 3):
            slot_get(u16_at(pc + 1))
            npc = pc + 3
        end
        if (op == 4):
            slot_set(u16_at(pc + 1))
            npc = pc + 3
        end
        if (op == 5):
            do_pop2()
            if (pop1_t == 1 or pop2_t == 1):
                xa = pop1_s
                if (pop1_t == 0): xa = int_to_str(pop1_i) end
                xb = pop2_s
                if (pop2_t == 0): xb = int_to_str(pop2_i) end
                push_str(str_concat(xa, xb))
            else:
                push_int(pop1_i + pop2_i)
            end
        end
        if (op == 6):
            do_pop2()
            push_int(pop1_i - pop2_i)
        end
        if (op == 7):
            do_pop2()
            push_int(pop1_i * pop2_i)
        end
        if (op == 8):
            do_pop2()
            if (pop2_i == 0):
                printf("[QVM-Q] 除零 pc=%d\n", pc)
                running = 0
            else:
                push_int(pop1_i / pop2_i)
            end
        end
        if (op == 9):
            do_pop2()
            if (pop2_i == 0):
                printf("[QVM-Q] 模零 pc=%d\n", pc)
                running = 0
            else:
                push_int(pop1_i % pop2_i)
            end
        end
        if (op == 10):
            do_pop2()
            do_cmp()
            if (g_cmp_r == 0): push_int(1)
            else: push_int(0)
            end
        end
        if (op == 11):
            do_pop2()
            do_cmp()
            if (g_cmp_r != 0): push_int(1)
            else: push_int(0)
            end
        end
        if (op == 12):
            do_pop2()
            do_cmp()
            if (g_cmp_r < 0): push_int(1)
            else: push_int(0)
            end
        end
        if (op == 13):
            do_pop2()
            do_cmp()
            if (g_cmp_r > 0): push_int(1)
            else: push_int(0)
            end
        end
        if (op == 14):
            do_pop2()
            do_cmp()
            if (g_cmp_r <= 0): push_int(1)
            else: push_int(0)
            end
        end
        if (op == 15):
            do_pop2()
            do_cmp()
            if (g_cmp_r >= 0): push_int(1)
            else: push_int(0)
            end
        end
        if (op == 16):
            npc = u16_at(pc + 1)
        end
        if (op == 17):
            do_pop1()
            tv = truthy_pop()
            if (tv == 0):
                npc = u16_at(pc + 1)
            else:
                npc = pc + 3
            end
        end
        if (op == 18):
            fname = pool_str(u16_at(pc + 1))
            nargs = byte_at(pc + 3)
            fi = find_func(fname)
            if (fi < 0):
                printf("[QVM-Q] 未定义函数: %s\n", fname)
                running = 0
            else:
                if (fp >= 64):
                    printf("[QVM-Q] 调用栈溢出\n")
                    running = 0
                else:
                    base = fp * 64
                    k = 0
                    while (k < 64):
                        loc_type[base + k] = 0
                        loc_int[base + k] = 0
                        loc_str[base + k] = ""
                        loc_arr[base + k] = 0
                        k = k + 1
                    end
                    k = nargs - 1
                    while (k >= 0):
                        do_pop1()
                        loc_type[base + k] = pop1_t
                        loc_int[base + k] = pop1_i
                        loc_str[base + k] = pop1_s
                        loc_arr[base + k] = pop1_a
                        k = k - 1
                    end
                    fr_retpc[fp] = pc + 4
                    fp = fp + 1
                    npc = fn_bodypc[fi]
                end
            end
        end
        if (op == 19):
            do_pop1()
            fp = fp - 1
            npc = fr_retpc[fp]
            st_type[sp] = pop1_t
            st_int[sp] = pop1_i
            st_str[sp] = pop1_s
            st_arr[sp] = pop1_a
            sp = sp + 1
        end
        if (op == 20):
            running = 0
        end
        if (op == 21):
            bname = pool_str(u16_at(pc + 1))
            nargs = byte_at(pc + 3)
            do_builtin(bname, nargs)
            npc = pc + 4
        end
        if (op == 22):
            sz = u16_at(pc + 1)
            if (sz == 0):
                do_pop1()
                sz = pop1_i
            end
            if (sz < 0): sz = 0 end
            h = ar_used
            ar_used = ar_used + 1
            ar_off[h] = ar_next
            ar_size[h] = sz
            ar_next = ar_next + sz
            push_arr(h)
            npc = pc + 3
        end
        if (op == 23):
            do_pop1()
            idx = pop1_i
            h = slot_get_arr_handle(u16_at(pc + 1))
            pos = ar_off[h] + idx
            et = ae_t_get(pos)
            if (et == 1):
                push_str(ae_s_get(pos))
            else:
                if (et == 2):
                    push_arr(ae_i_get(pos))
                else:
                    push_int(ae_i_get(pos))
                end
            end
            npc = pc + 3
        end
        if (op == 24):
            do_pop2()
            h = slot_get_arr_handle(u16_at(pc + 1))
            pos = ar_off[h] + pop1_i
            ae_t_set(pos, pop2_t)
            if (pop2_t == 2):
                ae_i_set(pos, pop2_a)
            else:
                ae_i_set(pos, pop2_i)
            end
            # 2026-09-12 内存优化: 整数/数组写不写字符串层(空串对象×527360=内存爆炸根源)
            if (pop2_t == 1):
                ae_s_set(pos, pop2_s)
            end
            npc = pc + 3
        end
        if (op == 25):
            sp = sp - 1
        end
        if (op == 26):
            do_pop1()
            push_int(0 - pop1_i)
        end
        if (op == 27):
            do_pop1()
            tv = truthy_pop()
            if (tv == 0): push_int(1)
            else: push_int(0)
            end
        end
        if (op == 28):
            do_pop2()
            ta = truthy_val(pop1_t, pop1_i, pop1_s, pop1_a)
            tb = truthy_val(pop2_t, pop2_i, pop2_s, pop2_a)
            if (ta == 1 and tb == 1): push_int(1)
            else: push_int(0)
            end
        end
        if (op == 29):
            do_pop2()
            ta = truthy_val(pop1_t, pop1_i, pop1_s, pop1_a)
            tb = truthy_val(pop2_t, pop2_i, pop2_s, pop2_a)
            if (ta == 1 or tb == 1): push_int(1)
            else: push_int(0)
            end
        end
        if (op == 30):
            printf("[QVM-Q] 执行期遇到FUNC_DEF(布局错误) pc=%d\n", pc)
            running = 0
        end
        pc = npc
    end
end

# ================================================================
# 主入口
# ================================================================
printf("QVM v1: QEntL编写的QBC1虚拟机\n")
if (load_qbc() == 1):
    build_func_table()
    printf("[QVM-Q] 加载 %s code=%d pool=%d funcs=%d\n", g_target, g_code_len, g_pool_len, fn_count)
    vm_run()
end
