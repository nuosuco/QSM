# ================================================================
# QVM v1 — QBC1 虚拟机（QEntL编写，阶段3）
# 输入: target.qbc   输出: 程序的printf透传
# 目标: 完全取代C启动器的VM，构建纯QEntL运行环境
#
# QBC1格式: [4B]"QBC1" [2B]code_len [code] [2B]pool_len [pool]
# 布局: [JMP main | funcs | main | HALT]
# 值模型: 并行数组 (type: 0=int 1=str 2=arr句柄)
# ================================================================

# ---- 目标文件 ----
var g_target = "target.qbc"

# ---- QBC加载状态 ----
var g_raw = ""
var g_raw_len = 0
var g_code_len = 0
var g_pool_off = 0
var g_pool_len = 0
var g_main_start = 0

# ---- 值栈: 4096深 ----
var st_type[4096]
var st_int[4096]
var st_str[4096]
var st_arr[4096]
var sp = 0

# ---- 调用帧: 64帧 × 64局部 ----
var fr_retpc[64]
var fp = 0
var loc_type[4096]
var loc_int[4096]
var loc_str[4096]
var loc_arr[4096]

# ---- 全局槽: 512 ----
var gl_type[512]
var gl_int[512]
var gl_str[512]
var gl_arr[512]

# ---- 数组池: 碰撞分配器, 9段存储(升级版, 支持515×1024=527360) ----
var ar_off[16384]
var ar_size[16384]
var ar_used = 0
var ar_next = 0
var ae_type0[65535]
var ae_type1[65535]
var ae_type2[65535]
var ae_type3[65535]
var ae_type4[65535]
var ae_type5[65535]
var ae_type6[65535]
var ae_type7[65535]
var ae_type8[65535]
var ae_int0[65535]
var ae_int1[65535]
var ae_int2[65535]
var ae_int3[65535]
var ae_int4[65535]
var ae_int5[65535]
var ae_int6[65535]
var ae_int7[65535]
var ae_int8[65535]
var ae_str0[65535]
var ae_str1[65535]
var ae_str2[65535]
var ae_str3[65535]
var ae_str4[65535]
var ae_str5[65535]
var ae_str6[65535]
var ae_str7[65535]
var ae_str8[65535]

# ---- 函数表 ----
var fn_nameoff[128]
var fn_nparams[128]
var fn_bodypc[128]
var fn_count = 0

# ---- pop结果寄存器 ----
var pop1_t = 0
var pop1_i = 0
var pop1_s = ""
var pop1_a = 0
var pop2_t = 0
var pop2_i = 0
var pop2_s = ""
var pop2_a = 0
var pop3_t = 0
var pop3_i = 0
var pop3_s = ""
var pop3_a = 0
var pop4_t = 0
var pop4_i = 0
var pop4_s = ""
var pop4_a = 0
var pop5_t = 0
var pop5_i = 0
var pop5_s = ""
var pop5_a = 0
var g_cmp_r = 0

# ================================================================
# 字节码访问
# ================================================================
def byte_at(p):
    return ord(str_char_at(g_raw, 6 + p))
end

def u16_at(p):
    return byte_at(p) + byte_at(p + 1) * 256
end

def pool_str(off):
    if (off < 0): return "" end
    if (off >= g_pool_len): return "" end
    var e = off
    while (e < g_pool_len):
        if (ord(str_char_at(g_raw, g_pool_off + e)) == 0): break end
        e = e + 1
    end
    return str_substring(g_raw, g_pool_off + off, e - off)
end

# ================================================================
# 值栈操作
# ================================================================
def push_int(v):
    st_type[sp] = 0
    st_int[sp] = v
    sp = sp + 1
end

def push_str(s):
    st_type[sp] = 1
    st_str[sp] = s
    sp = sp + 1
end

def push_arr(h):
    st_type[sp] = 2
    st_arr[sp] = h
    sp = sp + 1
end

def do_pop1():
    sp = sp - 1
    pop1_t = st_type[sp]
    pop1_i = st_int[sp]
    pop1_s = st_str[sp]
    pop1_a = st_arr[sp]
end

def do_pop2():
    do_pop1()
    pop2_t = pop1_t
    pop2_i = pop1_i
    pop2_s = pop1_s
    pop2_a = pop1_a
    do_pop1()
end

def do_pop3():
    do_pop1()
    pop3_t = pop1_t
    pop3_i = pop1_i
    pop3_s = pop1_s
    pop3_a = pop1_a
    do_pop2()
end

def do_pop4():
    do_pop1()
    pop4_t = pop1_t
    pop4_i = pop1_i
    pop4_s = pop1_s
    pop4_a = pop1_a
    do_pop3()
end

def do_pop5():
    do_pop1()
    pop5_t = pop1_t
    pop5_i = pop1_i
    pop5_s = pop1_s
    pop5_a = pop1_a
    do_pop4()
end

# ================================================================
# 数组元素池访问（双段）
# ================================================================
def ae_t_get(pos):
    var p = pos
    if (p < 65535): return ae_type0[p] end
    p = p - 65535
    if (p < 65535): return ae_type1[p] end
    p = p - 65535
    if (p < 65535): return ae_type2[p] end
    p = p - 65535
    if (p < 65535): return ae_type3[p] end
    p = p - 65535
    if (p < 65535): return ae_type4[p] end
    p = p - 65535
    if (p < 65535): return ae_type5[p] end
    p = p - 65535
    if (p < 65535): return ae_type6[p] end
    p = p - 65535
    if (p < 65535): return ae_type7[p] end
    return ae_type8[p - 65535]
end

def ae_t_set(pos, v):
    var p = pos
    if (p < 65535): ae_type0[p] = v
    else:
        p = p - 65535
        if (p < 65535): ae_type1[p] = v
        else:
            p = p - 65535
            if (p < 65535): ae_type2[p] = v
            else:
                p = p - 65535
                if (p < 65535): ae_type3[p] = v
                else:
                    p = p - 65535
                    if (p < 65535): ae_type4[p] = v
                    else:
                        p = p - 65535
                        if (p < 65535): ae_type5[p] = v
                        else:
                            p = p - 65535
                            if (p < 65535): ae_type6[p] = v
                            else:
                                p = p - 65535
                                if (p < 65535): ae_type7[p] = v
                                else: ae_type8[p - 65535] = v end
                            end
                        end
                    end
                end
            end
        end
    end
end

def ae_i_get(pos):
    var p = pos
    if (p < 65535): return ae_int0[p] end
    p = p - 65535
    if (p < 65535): return ae_int1[p] end
    p = p - 65535
    if (p < 65535): return ae_int2[p] end
    p = p - 65535
    if (p < 65535): return ae_int3[p] end
    p = p - 65535
    if (p < 65535): return ae_int4[p] end
    p = p - 65535
    if (p < 65535): return ae_int5[p] end
    p = p - 65535
    if (p < 65535): return ae_int6[p] end
    p = p - 65535
    if (p < 65535): return ae_int7[p] end
    return ae_int8[p - 65535]
end

