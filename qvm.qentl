var pop6_s = ""
var pop6_a = 0
var g_cmp_r = 0
var g_cur_pc = 0

# ================================================================
# 字节码访问
# ================================================================
def byte_at(p):
    return ord(str_char_at(g_raw, 6 + p))
end

def u16_at(p):
    return byte_at(p) + byte_at(p + 1) * 256
end

def pool_str(off):
    if (off < 0): return "" end
    if (off >= g_pool_len): return "" end
    var e = off
    while (e < g_pool_len):
        if (ord(str_char_at(g_raw, g_pool_off + e)) == 0): break end
        e = e + 1
    end
    return str_substring(g_raw, g_pool_off + off, e - off)
end

# ================================================================
# 值栈操作
# ================================================================
def push_int(v):
    st_type[sp] = 0
    st_int[sp] = v
    sp = sp + 1
end

def push_str(s):
    st_type[sp] = 1
    st_str[sp] = s
    sp = sp + 1
end

def push_arr(h):
    st_type[sp] = 2
    st_arr[sp] = h
    sp = sp + 1
end

def do_pop1():
    sp = sp - 1
    if (sp < 0):
        printf("[QVM-DBG] 栈下溢! sp=%d pc=%d\n", sp, g_cur_pc)
        sp = 0
    end
    pop1_t = st_type[sp]
    pop1_i = st_int[sp]
    pop1_s = st_str[sp]
    pop1_a = st_arr[sp]
end

def do_pop2():
    do_pop1()
    pop2_t = pop1_t
    pop2_i = pop1_i
    pop2_s = pop1_s
    pop2_a = pop1_a
    do_pop1()
end

def do_pop3():
    do_pop1()
    pop3_t = pop1_t
    pop3_i = pop1_i
    pop3_s = pop1_s
    pop3_a = pop1_a
    do_pop2()
end

def do_pop4():
    do_pop1()
    pop4_t = pop1_t
    pop4_i = pop1_i
    pop4_s = pop1_s
    pop4_a = pop1_a
    do_pop3()
end

def do_pop5():
    do_pop1()
    pop5_t = pop1_t
    pop5_i = pop1_i
    pop5_s = pop1_s
    pop5_a = pop1_a
    do_pop4()
end

def do_pop6():
    do_pop1()
    pop6_t = pop1_t
    pop6_i = pop1_i
    pop6_s = pop1_s
    pop6_a = pop1_a
    do_pop5()
end
