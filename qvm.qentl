# QVM v2 — 精簡版 (解決池溢出)
# 減少變量以適應65535字節限制

# ---- 配置 ----
var g_target = "target.qbc"
var g_raw = ""
var g_code_len = 0
var g_pool_off = 0
var g_pool_len = 0
var g_main_start = 0

# ---- 預解碼 (壓縮存儲) ----
# 使用兩個大數組存儲解碼後的字节码
var g_code[65535]
var g_pool[32768]

# ---- 值棧: 2048深 ----
var st_type[2048]
var st_int[2048]
var st_str[2048]
var sp = 0

# ---- 局部變量: 128個 ----
var loc_type[128]
var loc_int[128]
var loc_str[128]
var fp = 0

# ---- 全局變量: 64個 ----
var gl_type[64]
var gl_int[64]
var gl_str[64]

# ---- 函數表: 32個函數 ----
var fn_body[32]
var fn_params[32]
var fn_count = 0

# ---- 彈棧結果 ----
var p1_t = 0
var p1_i = 0
var p1_s = ""
var p2_t = 0
var p2_i = 0
var p2_s = ""

# ================================================================
# 工具函數
# ================================================================

def byte_at(p):
    return g_code[p]
end

def u16_at(p):
    return g_code[p] + g_code[p + 1] * 256
end

def push_int(v):
    st_type[sp] = 0
    st_int[sp] = v
    sp = sp + 1
end

def push_str(s):
    st_type[sp] = 1
    st_str[sp] = s
    sp = sp + 1
end

def do_pop1():
    sp = sp - 1
    p1_t = st_type[sp]
    p1_i = st_int[sp]
    p1_s = st_str[sp]
end

def do_pop2():
    do_pop1()
    var t2 = p1_t
    var i2 = p1_i
    var s2 = p1_s
    p1_t = st_type[sp - 1]
    p1_i = st_int[sp - 1]
    p1_s = st_str[sp - 1]
    p2_t = t2
    p2_i = i2
    p2_s = s2
end

def truthy_val(t, i, s, a):
    if (t == 0): return (i != 0)
    return (str_len(s) > 0)
end

def truthy_pop():
    return truthy_val(p1_t, p1_i, p1_s, 0)
end

# ================================================================
# 加載QBC
# ================================================================

def load_qbc():
    g_raw = file_read(g_target)
    if (str_len(g_raw) < 8):
        printf("[QVM] 無法讀取: %s\n", g_target)
        return 0
    end
    if (str_substring(g_raw, 0, 4) != "QBC1"):
        printf("[QVM] 不是QBC1格式\n")
        return 0
    end
    g_code_len = u16_at(4)
    g_pool_off = 6 + g_code_len
    g_pool_len = u16_at(6 + g_code_len)
    
    # 解碼code
    var i = 0
    while (i < g_code_len):
        g_code[i] = ord(str_char_at(g_raw, 6 + i))
        i = i + 1
    end
    
    # 解碼pool
    var pi = 0
    var pi2 = 0
    i = g_pool_off
    while (i < 6 + g_code_len + g_pool_len and pi < 32768):
        var ch = ord(str_char_at(g_raw, i))
        if (ch == 0):
            pi = pi + 1
            pi2 = 0
        else:
            g_pool[pi * 128 + pi2] = ch
            pi2 = pi2 + 1
        end
        i = i + 1
    end
    g_pool[pi * 128] = 0  # 終止符
    
    # 解碼函數表
    fn_count = 0
    var fi = 0
    while (fi < 32):
        var name_off = u16_at(6 + g_code_len + g_pool_len + 2 + fi * 4)
        var nparams = byte_at(6 + g_code_len + g_pool_len + 3 + fi * 4)
        var body = u16_at(6 + g_code_len + g_pool_len + 4 + fi * 4)
        if (name_off == 0):
            break
        end
        fn_body[fi] = body
        fn_params[fi] = nparams
        fn_count = fi + 1
        fi = fi + 1
    end
    
    # 找main入口
    fi = 0
    while (fi < fn_count):
        var nm = pool_str(fn_body[fi] - 2)
        if (nm == "main"):
            g_main_start = fn_body[fi] + 3
            return 1
        end
        fi = fi + 1
    end
    
    printf("[QVM] 找不到main函數\n")
    return 0
end

def pool_str(idx):
    if (idx < 0 or idx >= 32768):
        return ""
    end
    var result = ""
    var i = idx * 128
    while (i < idx * 128 + 128 and g_pool[i] != 0):
        result = str_concat(result, str_from_char(g_pool[i]))
        i = i + 1
    end
    return result
end

# ================================================================
# Builtin函數
# ================================================================

def bi_printf(nargs):
    var fmt = p1_s
    var i = 0
    var idx = 0
    while (idx < str_len(fmt)):
        if (str_char_at(fmt, idx) == '%' and idx + 1 < str_len(fmt)):
            var fc = str_char_at(fmt, idx + 1)
            if (fc == 'd' and i < nargs):
                do_pop1()
                var v = p1_i
                printf("%d", v)
                i = i + 1
            end
            if (fc == 's' and i < nargs):
                do_pop1()
                printf("%s", p1_s)
                i = i + 1
            end
            idx = idx + 2
        else:
            printf("%s", str_char_at(fmt, idx))
            idx = idx + 1
        end
    end
    while (i < nargs):
        do_pop1()
        i = i + 1
    end
    push_int(0)
end

def bi_str_len(nargs):
    do_pop1()
    push_int(str_len(p1_s))
end

def bi_str_char_at(nargs):
    do_pop2()
    var s = p2_s
    var i = p1_i
    if (i < 0 or i >= str_len(s)):
        push_str("")
    else:
        push_str(str_char_at(s, i))
    end
end

def bi_str_substring(nargs):
    do_pop3()
    var s = p3_s
    var start = p2_i
    var len = p1_i
    if (start < 0): start = 0
    if (start >= str_len(s)): len = 0
    if (start + len > str_len(s)): len = str_len(s) - start
    push_str(str_substring(s, start, len))
end

def bi_str_concat(nargs):
    do_pop2()
    push_str(str_concat(p2_s, p1_s))
end

def bi_str_eq(nargs):
    do_pop2()
    if (p2_s == p1_s): push_int(1)
    else: push_int(0)
    end
end

def bi_str_to_int(nargs):
    do_pop1()
    push_int(str_to_int(p1_s))
end

def bi_int_to_str(nargs):
    do_pop1()
    push_str(int_to_str(p1_i))
end

def bi_qreg_create(nargs):
    push_int(0)
end

def bi_qreg_free(nargs):
    do_pop1()
end

def bi_apply_h(nargs):
    do_pop2()
    push_int(0)
end

def bi_apply_cx(nargs):
    do_pop3()
    push_int(0)
end

def bi_apply_x(nargs):
    do_pop2()
    push_int(0)
end

def bi_apply_z(nargs):
    do_pop2()
    push_int(0)
end

def bi_apply_swap(nargs):
    do_pop2()
    push_int(0)
end

def bi_measure(nargs):
    do_pop2()
    push_int(0)
end

def bi_rand_int(nargs):
    push_int(42)
end

def bi_sys(nargs):
    push_int(0)
end

def bi_file_read(nargs):
    do_pop1()
    push_str("")
end

def bi_file_write(nargs):
    do_pop2()
    push_int(0)
end

def bi_pool_add_string(nargs):
    do_pop1()
    # 簡單實現：返回0 (實際應加入pool)
    push_int(0)
end

def bi_pool_add_substr(nargs):
    do_pop2()
    push_int(0)
end

def bi_str_from_pool(nargs):
    do_pop1()
    push_str("")
end

def bi_ord(nargs):
    do_pop1()
    if (str_len(p1_s) > 0):
        push_int(ord(str_char_at(p1_s, 0)))
    else:
        push_int(0)
    end
end

def bi_chr(nargs):
    do_pop1()
    push_str(str_from_char(p1_i))
end

def bi_load_func(nargs):
    do_pop1()
    # 返回函數指針 (用索引表示)
    var fi = p1_i
    if (fi >= 0 and fi < fn_count):
        push_int(fn_body[fi])
    else:
        push_int(0)
    end
end

# ================================================================
# 主執行循環
# ================================================================

def run_program():
    var pc = g_main_start
    var running = 1
    while (running and pc < g_code_len):
        var op = byte_at(pc)
        var npc = pc + 1
        
        if (op == 0):  # HALT
            running = 0
        end
        if (op == 1):  # PUSH_INT
            push_int(u16_at(npc))
            npc = npc + 2
        end
        if (op == 2):  # PUSH_STR
            push_str(pool_str(u16_at(npc)))
            npc = npc + 2
        end
        if (op == 3):  # PUSH_LOCAL
            var idx = u16_at(npc)
            st_type[sp] = loc_type[idx]
            st_int[sp] = loc_int[idx]
            st_str[sp] = loc_str[idx]
            sp = sp + 1
            npc = npc + 2
        end
        if (op == 4):  # STORE_LOCAL
            var idx = u16_at(npc)
            do_pop1()
            loc_type[idx] = p1_t
            loc_int[idx] = p1_i
            loc_str[idx] = p1_s
            npc = npc + 2
        end
        if (op == 5):  # POP
            if (sp > 0): sp = sp - 1
        end
        if (op == 6):  # JMP
            npc = u16_at(npc)
        end
        if (op == 7):  # JMP_FALSE
            do_pop1()
            if (truthy_pop() == 0):
                npc = u16_at(npc)
            else:
                npc = npc + 2
            end
        end
        if (op == 8):  # CALL
            var fi = u16_at(npc)
            var nargs = fn_params[fi]
            fr_retpc[fp] = npc + 2
            fp = fp + 1
            npc = fn_body[fi]
            # 注意: 參數已經在棧上
        end
        if (op == 9):  # RET
            fp = fp - 1
            npc = fr_retpc[fp]
        end
        if (op == 10):  # LOAD_GLOBAL
            var idx = u16_at(npc)
            st_type[sp] = gl_type[idx]
            st_int[sp] = gl_int[idx]
            st_str[sp] = gl_str[idx]
            sp = sp + 1
            npc = npc + 2
        end
        if (op == 11):  # STORE_GLOBAL
            var idx = u16_at(npc)
            do_pop1()
            gl_type[idx] = p1_t
            gl_int[idx] = p1_i
            gl_str[idx] = p1_s
            npc = npc + 2
        end
        if (op == 12):  # ADD
            do_pop2()
            push_int(p2_i + p1_i)
        end
        if (op == 13):  # SUB
            do_pop2()
            push_int(p2_i - p1_i)
        end
        if (op == 14):  # MUL
            do_pop2()
            push_int(p2_i * p1_i)
        end
        if (op == 15):  # DIV
            do_pop2()
            if (p1_i != 0):
                push_int(p2_i / p1_i)
            else:
                push_int(0)
            end
        end
        if (op == 16):  # EQ
            do_pop2()
            if (p2_i == p1_i): push_int(1)
            else: push_int(0)
            end
        end
        if (op == 17):  # LT
            do_pop2()
            if (p2_i < p1_i): push_int(1)
            else: push_int(0)
            end
        end
        if (op == 18):  # GT
            do_pop2()
            if (p2_i > p1_i): push_int(1)
            else: push_int(0)
            end
        end
        if (op == 19):  # AND
            do_pop2()
            if (p2_i != 0 and p1_i != 0): push_int(1)
            else: push_int(0)
            end
        end
        if (op == 20):  # OR
            do_pop2()
            if (p2_i != 0 or p1_i != 0): push_int(1)
            else: push_int(0)
            end
        end
        if (op == 21):  # NOT
            do_pop1()
            if (p1_i == 0): push_int(1)
            else: push_int(0)
            end
        end
        if (op == 22):  # NEG
            do_pop1()
            push_int(0 - p1_i)
        end
        if (op == 23):  # LOAD_FUNC
            var fi = u16_at(npc)
            push_int(fn_body[fi])
            npc = npc + 2
        end
        if (op == 24):  # CALL_FUNC_PTR
            var nargs = p1_i
            do_pop1()
            var fn_ptr = p1_i
            # 查找函數索引
            var found = 0
            var i = 0
            while (i < fn_count and found == 0):
                if (fn_body[i] == fn_ptr):
                    fr_retpc[fp] = npc + 2
                    fp = fp + 1
                    npc = fn_ptr + 3  # 跳過名稱
                    found = 1
                end
                i = i + 1
            end
            if (found == 0):
                printf("[QVM] 找不到函數 %d\n", fn_ptr)
                running = 0
            end
        end
        if (op == 25):  # BUILTIN
            var bi_idx = u16_at(npc)
            var bname = pool_str(bi_idx)
            var bargs = byte_at(npc + 2)
            npc = npc + 3
            if (bname == "printf"): bi_printf(bargs)
            if (bname == "str_len"): bi_str_len(bargs)
            if (bname == "str_char_at"): bi_str_char_at(bargs)
            if (bname == "str_substring"): bi_str_substring(bargs)
            if (bname == "str_concat"): bi_str_concat(bargs)
            if (bname == "str_eq"): bi_str_eq(bargs)
            if (bname == "str_to_int"): bi_str_to_int(bargs)
            if (bname == "int_to_str"): bi_int_to_str(bargs)
            if (bname == "qreg_create"): bi_qreg_create(bargs)
            if (bname == "qreg_free"): bi_qreg_free(bargs)
            if (bname == "apply_h"): bi_apply_h(bargs)
            if (bname == "apply_cx"): bi_apply_cx(bargs)
            if (bname == "apply_x"): bi_apply_x(bargs)
            if (bname == "apply_z"): bi_apply_z(bargs)
            if (bname == "apply_swap"): bi_apply_swap(bargs)
            if (bname == "measure"): bi_measure(bargs)
            if (bname == "rand_int"): bi_rand_int(bargs)
            if (bname == "sys"): bi_sys(bargs)
            if (bname == "file_read"): bi_file_read(bargs)
            if (bname == "file_write"): bi_file_write(bargs)
            if (bname == "pool_add_string"): bi_pool_add_string(bargs)
            if (bname == "pool_add_substr"): bi_pool_add_substr(bargs)
            if (bname == "str_from_pool"): bi_str_from_pool(bargs)
            if (bname == "ord"): bi_ord(bargs)
            if (bname == "chr"): bi_chr(bargs)
            if (bname == "load_func"): bi_load_func(bargs)
            # 未知builtin跳過
            end
        end
        if (op == 28):  # DUP
            if (sp > 0):
                st_type[sp] = st_type[sp - 1]
                st_int[sp] = st_int[sp - 1]
                st_str[sp] = st_str[sp - 1]
                sp = sp + 1
            end
        end
        if (op == 29):  # SWAP
            if (sp >= 2):
                var t = st_type[sp - 1]
                var i = st_int[sp - 1]
                var s = st_str[sp - 1]
                st_type[sp - 1] = st_type[sp - 2]
                st_int[sp - 1] = st_int[sp - 2]
                st_str[sp - 1] = st_str[sp - 2]
                st_type[sp - 2] = t
                st_int[sp - 2] = i
                st_str[sp - 2] = s
            end
        end
        pc = npc
    end
end

# ================================================================
# 主入口
# ================================================================

printf("QVM v2: QEntL編寫的QBC1虛擬機 (精簡版)\n")
if (load_qbc() == 1):
    printf("[QVM-Q] 加載 %s code=%d pool=%d funcs=%d\n", g_target, g_code_len, g_pool_len, fn_count)
    run_program()
    printf("\n[QVM-Q] 執行完成\n")
else:
    printf("[QVM-Q] 加載失敗\n")
end
