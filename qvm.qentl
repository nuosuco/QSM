                            p = p - 65535
                            if (p < 65535): ae_str6[p] = v
                            else:
                                p = p - 65535
                                if (p < 65535): ae_str7[p] = v
                                else: ae_str8[p - 65535] = v end
                            end
                        end
                    end
                end
            end
        end
    end
end

# ================================================================
# 变量槽访问（operand >= 32768 = 全局）
# ================================================================
def slot_get(operand):
    if (operand >= 32768):
        var g = operand - 32768
        st_type[sp] = gl_type[g]
        st_int[sp] = gl_int[g]
        st_str[sp] = gl_str[g]
        st_arr[sp] = gl_arr[g]
        sp = sp + 1
    else:
        var base = (fp - 1) * 64 + operand
        st_type[sp] = loc_type[base]
        st_int[sp] = loc_int[base]
        st_str[sp] = loc_str[base]
        st_arr[sp] = loc_arr[base]
        sp = sp + 1
    end
end

def slot_set(operand):
    do_pop1()
    if (operand >= 32768):
        var g = operand - 32768
        gl_type[g] = pop1_t
        gl_int[g] = pop1_i
        gl_str[g] = pop1_s
        gl_arr[g] = pop1_a
    else:
        var base = (fp - 1) * 64 + operand
        loc_type[base] = pop1_t
        loc_int[base] = pop1_i
        loc_str[base] = pop1_s
        loc_arr[base] = pop1_a
    end
end

def slot_get_arr_handle(operand):
    if (operand >= 32768): return gl_arr[operand - 32768] end
    return loc_arr[(fp - 1) * 64 + operand]
end

# ================================================================
# 真值判断
# ================================================================
def truthy_pop():
    if (pop1_t == 0):
        if (pop1_i != 0): return 1 end
        return 0
    end
    if (pop1_t == 1):
        if (str_len(pop1_s) > 0): return 1 end
        return 0
    end
    if (ar_size[pop1_a] > 0): return 1 end
    return 0
end

def truthy_val(t, i, s, a):
    if (t == 0):
        if (i != 0): return 1 end
        return 0
    end
    if (t == 1):
        if (str_len(s) > 0): return 1 end
        return 0
    end
    if (ar_size[a] > 0): return 1 end
    return 0
end

# ================================================================
# 比较
# ================================================================
def str_cmp(x, y):
    var lx = str_len(x)
    var ly = str_len(y)
    var n = lx
    if (ly < n): n = ly end
    var i = 0
    while (i < n):
        var cx = ord(str_char_at(x, i))
        var cy = ord(str_char_at(y, i))
        if (cx != cy):
            if (cx < cy): return -1 end
            return 1
        end
        i = i + 1
    end
    if (lx < ly): return -1 end
    if (lx > ly): return 1 end
    return 0
end

def do_cmp():
    if (pop1_t == 0 and pop2_t == 0):
        if (pop1_i < pop2_i):
            g_cmp_r = -1
        else:
            if (pop1_i > pop2_i):
                g_cmp_r = 1
            else:
                g_cmp_r = 0
            end
        end
    else:
        if (pop1_t == 1 and pop2_t == 1):
            g_cmp_r = str_cmp(pop1_s, pop2_s)
        else:
            if (pop1_t < pop2_t):
                g_cmp_r = -1
            else:
                if (pop1_t > pop2_t):
                    g_cmp_r = 1
                else:
                    g_cmp_r = 0
                end
            end
        end
    end
end

# ================================================================
# 函数表
# ================================================================
def find_func(fname):
    var k = 0
    while (k < fn_count):
        if (str_eq(pool_str(fn_nameoff[k]), fname)): return k end
        k = k + 1
    end
    return -1
end

def build_func_table():
    var p = 3
    fn_count = 0
    while (p < g_main_start):
        var op = byte_at(p)
        if (op == 30):
            fn_nameoff[fn_count] = u16_at(p + 1)
            var np = byte_at(p + 3)
            fn_nparams[fn_count] = np
            fn_bodypc[fn_count] = p + 4 + 2 * np
            fn_count = fn_count + 1
            p = p + 4 + 2 * np
        else:
            if (op == 18 or op == 21):
                p = p + 4
            else:
                if (op == 1 or op == 2 or op == 3 or op == 4 or op == 16 or op == 17 or op == 22 or op == 23 or op == 24):
                    p = p + 3
                else:
                    p = p + 1
                end
            end
        end
    end
end

# ================================================================
# 内置函数
# ================================================================
def bi_printf(nargs):
    var base = sp - nargs
    var fmt = st_str[base]
    var ai = base + 1
    var out = ""
    var k = 0
    var fl = str_len(fmt)
    while (k < fl):
        var ch = str_char_at(fmt, k)
        if (str_eq(ch, "%") and k + 1 < fl):
            var nx = str_char_at(fmt, k + 1)
            if (str_eq(nx, "d")):
                out = str_concat(out, int_to_str(st_int[ai]))
                ai = ai + 1
                k = k + 2
            else:
                if (str_eq(nx, "s")):
                    if (st_type[ai] == 1):
                        out = str_concat(out, st_str[ai])
                    else:
                        if (st_type[ai] == 2):
                            out = str_concat(out, "<arr>")
                        else:
                            out = str_concat(out, int_to_str(st_int[ai]))
                        end
                    end
                    ai = ai + 1
                    k = k + 2
                else:
                    if (str_eq(nx, "%")):
                        out = str_concat(out, "%")
                        k = k + 2
                    else:
                        out = str_concat(out, ch)
                        k = k + 1
                    end
                end
            end
        else:
            out = str_concat(out, ch)
            k = k + 1
        end
    end
    printf("%s", out)
    sp = base
end

def do_builtin(bname, nargs):
    if (str_eq(bname, "printf")):
        bi_printf(nargs)
        push_int(0)
        return
    end
    if (str_eq(bname, "str_len")):
        do_pop1()
        push_int(str_len(pop1_s))
        return
    end
    if (str_eq(bname, "str_char_at")):
        do_pop2()
        push_str(str_char_at(pop1_s, pop2_i))
        return
    end
    if (str_eq(bname, "str_substring")):
        do_pop1()
        var ln = pop1_i
        do_pop1()
        var stx = pop1_i
        do_pop1()
        push_str(str_substring(pop1_s, stx, ln))
        return
    end
    if (str_eq(bname, "str_concat")):
        do_pop2()
        var xa = pop1_s
        if (pop1_t == 0): xa = int_to_str(pop1_i) end
        var xb = pop2_s
        if (pop2_t == 0): xb = int_to_str(pop2_i) end
        push_str(str_concat(xa, xb))
        return
    end
    if (str_eq(bname, "str_eq")):
        do_pop2()
        push_int(str_eq(pop1_s, pop2_s))
        return
    end
    if (str_eq(bname, "str_index_of")):
        do_pop2()
        push_int(str_index_of(pop1_s, pop2_s))
        return
    end
    if (str_eq(bname, "str_from_char")):
        do_pop1()
        push_str(str_from_char(pop1_i))
        return
    end
    if (str_eq(bname, "str_to_int")):
        do_pop1()
        push_int(str_to_int(pop1_s))
        return
    end
    if (str_eq(bname, "int_to_str")):
        do_pop1()
        push_str(int_to_str(pop1_i))
        return
    end
    if (str_eq(bname, "len")):
        do_pop1()
        if (pop1_t == 2):
            push_int(ar_size[pop1_a])
        else:
            if (pop1_t == 1):
                push_int(str_len(pop1_s))
            else:
                push_int(0)
            end
        end
        return
    end
    if (str_eq(bname, "file_read")):
        do_pop1()
        push_str(file_read(pop1_s))
        return
    end
    if (str_eq(bname, "file_write_bytes")):
        do_pop2()
        push_int(file_write_bytes(pop1_s, pop2_s))
        return
    end
    # file_append(path, content): 追加写入(读旧内容+拼接+写回,纯QEntL实现)
    if (str_eq(bname, "file_append")):
        do_pop2()
        var old = file_read(pop1_s)
        var merged = str_concat(old, pop2_s)
        push_int(file_write_bytes(pop1_s, merged))
        return
    end
    if (str_eq(bname, "file_exists")):
        do_pop1()
        push_int(file_exists(pop1_s))
        return
    end
    if (str_eq(bname, "ord")):
        do_pop1()
        push_int(ord(pop1_s))
        return
    end
    if (str_eq(bname, "chr")):
        do_pop1()
        push_str(chr(pop1_i))
        return
    end
    if (str_eq(bname, "tcp_listen")):
        do_pop1()
        push_int(tcp_listen(pop1_i))
        return
    end
    if (str_eq(bname, "tcp_accept")):
        do_pop1()
        push_int(tcp_accept(pop1_i))
        return
    end
    if (str_eq(bname, "tcp_recv")):
        do_pop2()
        push_str(tcp_recv(pop1_i, pop2_i))
        return
    end
    if (str_eq(bname, "tcp_send")):
        do_pop2()
        push_int(tcp_send(pop1_i, pop2_s))
        return
    end
    if (str_eq(bname, "tcp_close")):
        do_pop1()
        push_int(tcp_close(pop1_i))
        return
    end
    if (str_eq(bname, "tcp_shutdown")):
        do_pop1()
        push_int(tcp_shutdown(pop1_i))
        return
    end
    # ================= QSCL builtin =================
    # mat_mul(x[], W[], n, m): x是n维输入, W是n*m矩阵, 返回m维结果数组句柄
    if (str_eq(bname, "mat_mul")):
        do_pop4()
        var m = pop4_i
        var n = pop3_i
        var w_h = pop2_a
        var x_h = pop1_a
        var h = ar_used
        ar_used = ar_used + 1
        var xoff = ar_off[x_h]
        var woff = ar_off[w_h]
        ar_off[h] = ar_next
        ar_size[h] = m
        ar_next = ar_next + m
        var i = 0
        var j = 0
        var acc = 0
        while (i < m):
            acc = 0
            j = 0
            while (j < n):
                acc = acc + ae_i_get(xoff + j) * ae_i_get(woff + j * m + i) / 10
                j = j + 1
            end
            ae_i_set(ar_off[h] + i, acc)
            i = i + 1
        end
        push_arr(h)
        return
    end
    # softmax(a[], n): 定点softmax, 返回原数组句柄 (0-100概率)
    if (str_eq(bname, "softmax")):
        do_pop2()
        var n = pop2_i
        var ah = pop1_a
        var aoff = ar_off[ah]
        var i = 0
        var s = 0
        var v = 0
        s = 0
        i = 0
        while (i < n):
            v = ae_i_get(aoff + i)
            # 定点exp近似: e^v ≈ 100 + v*10 (logits 0-500范围)
            if (v < 0): v = 0 end
            if (v > 500): v = 500 end
            ae_i_set(aoff + i, 100 + v * 10)
            s = s + 100 + v * 10
            i = i + 1
        end
        if (s == 0): s = 1 end
        i = 0
        while (i < n):
            ae_i_set(aoff + i, ae_i_get(aoff + i) * 100 / s)
            i = i + 1
        end
        push_arr(ah)
        return
    end
    # argmax(a[], n): 返回最大值的索引
    if (str_eq(bname, "argmax")):
        do_pop2()
        var n = pop2_i
        var ah = pop1_a
        var aoff = ar_off[ah]
        var i = 0
        var bi = 0
        var bv = 0
        var v = 0
        bv = ae_i_get(aoff)
        bi = 0
        i = 1
        while (i < n):
            v = ae_i_get(aoff + i)
            if (v > bv):
                bv = v
                bi = i
            end
            i = i + 1
        end
        push_int(bi)
        return
    end
    # embedding(code, dim, E[]): 返回E中code*dim处dim长的行偏移
    if (str_eq(bname, "embedding")):
        do_pop3()
        var e_h = pop3_a
        var dim = pop2_i
        var code = pop1_i
        var eoff = ar_off[e_h]
        var h = ar_used
        ar_used = ar_used + 1
        ar_off[h] = eoff + code * dim
        ar_size[h] = dim
        var i = 0
        while (i < dim):
            ae_i_set(ar_off[h] + i, ae_i_get(eoff + code * dim + i))
            i = i + 1
        end
        push_arr(h)
        return
    end
    # embedding_to(code, dim, E[], dst[]): 复制E[code]行到dst(原地复用,不新建数组)
    if (str_eq(bname, "embedding_to")):
        do_pop4()
        var dst_h = pop4_a
        var e_h = pop3_a
        var dim = pop2_i
        var code = pop1_i
        var eoff = ar_off[e_h]
        var doff = ar_off[dst_h]
        var i = 0
        while (i < dim):
            ae_i_set(doff + i, ae_i_get(eoff + code * dim + i))
            i = i + 1
        end
        push_int(dim)
        return
    end
    # mat_mul_to(x[], W[], n, m, dst[]): 结果写入dst(原地复用,不新建数组)
    if (str_eq(bname, "mat_mul_to")):
        do_pop5()
        var dst_h = pop5_a
        var m = pop4_i
        var n = pop3_i
        var w_h = pop2_a
        var x_h = pop1_a
        var xoff = ar_off[x_h]
        var woff = ar_off[w_h]
        var doff = ar_off[dst_h]
        var i = 0
        var j = 0
        var acc = 0
        while (i < m):
            acc = 0
            j = 0
            while (j < n):
                acc = acc + ae_i_get(xoff + j) * ae_i_get(woff + j * m + i) / 10
                j = j + 1
            end
            ae_i_set(doff + i, acc)
            i = i + 1
        end
        push_int(m)
        return
    end
    # backprop(W[], grad[], n, lr): W[i] += lr*grad[i]/100 (符号感知, 步长=grad)
    if (str_eq(bname, "backprop")):
        do_pop4()
        var lr = pop4_i
        var n = pop3_i
        var g_h = pop2_a
        var w_h = pop1_a
        var woff = ar_off[w_h]
        var goff = ar_off[g_h]
        var i = 0
        var up = 0
        var dz = 0
        while (i < n):
            dz = ae_i_get(goff + i)
            if (dz > 0):
                up = lr * dz / 100
            else:
                up = 0 - (lr * (0 - dz) / 100)
            end
            ae_i_set(woff + i, ae_i_get(woff + i) + up)
            i = i + 1
        end
        push_int(n)
        return
    end
    printf("[QVM-Q] 未知内置函数: %s\n", bname)
    sp = sp - nargs
    push_int(0)
end

# ================================================================
# QBC加载
# ================================================================
def load_qbc():
    g_raw = file_read(g_target)
    g_raw_len = str_len(g_raw)
    if (g_raw_len < 8):
        printf("[QVM-Q] 无法读取: %s\n", g_target)
        return 0
    end
    if (str_eq(str_substring(g_raw, 0, 4), "QBC1") == 0):
        printf("[QVM-Q] 不是QBC1格式: %s\n", g_target)
        return 0
    end
    g_code_len = ord(str_char_at(g_raw, 4)) + ord(str_char_at(g_raw, 5)) * 256
    if (6 + g_code_len + 2 > g_raw_len):
        printf("[QVM-Q] QBC截断\n")
        return 0
    end
    var pp = 6 + g_code_len
    g_pool_len = ord(str_char_at(g_raw, pp)) + ord(str_char_at(g_raw, pp + 1)) * 256
    g_pool_off = pp + 2
    if (byte_at(0) != 16):
        printf("[QVM-Q] 布局错误(缺JMP头)\n")
        return 0
    end
    g_main_start = u16_at(1)
    return 1
end

# ================================================================
# 主执行循环
# ================================================================
def vm_run():
    var pc = g_main_start
    var running = 1
    var op = 0
    var npc = 0
    var fname = ""
    var nargs = 0
    var fi = 0
    var base = 0
    var k = 0
    var bname = ""
    var sz = 0
    var h = 0
    var idx = 0
    var pos = 0
    var et = 0
    var tv = 0
    var ta = 0
    var tb = 0
    var xa = ""
    var xb = ""
    while (running == 1):
        op = byte_at(pc)
        npc = pc + 1
        if (op == 1):
            push_int(u16_at(pc + 1))
            npc = pc + 3
        end
        if (op == 2):
            push_str(pool_str(u16_at(pc + 1)))
            npc = pc + 3
        end
        if (op == 3):
            slot_get(u16_at(pc + 1))
            npc = pc + 3
        end
        if (op == 4):
            slot_set(u16_at(pc + 1))
            npc = pc + 3
        end
        if (op == 5):
            do_pop2()
            if (pop1_t == 1 or pop2_t == 1):
                xa = pop1_s
                if (pop1_t == 0): xa = int_to_str(pop1_i) end
                xb = pop2_s
                if (pop2_t == 0): xb = int_to_str(pop2_i) end
                push_str(str_concat(xa, xb))
            else:
                push_int(pop1_i + pop2_i)
            end
        end
        if (op == 6):
            do_pop2()
            push_int(pop1_i - pop2_i)
        end
        if (op == 7):
            do_pop2()
            push_int(pop1_i * pop2_i)
        end
        if (op == 8):
            do_pop2()
            if (pop2_i == 0):
                printf("[QVM-Q] 除零 pc=%d\n", pc)
                running = 0
            else:
                push_int(pop1_i / pop2_i)
            end
        end
        if (op == 9):
            do_pop2()
            if (pop2_i == 0):
                printf("[QVM-Q] 模零 pc=%d\n", pc)
                running = 0
            else:
                push_int(pop1_i % pop2_i)
            end
        end
        if (op == 10):
            do_pop2()
            do_cmp()
            if (g_cmp_r == 0): push_int(1)
            else: push_int(0)
            end
        end
        if (op == 11):
            do_pop2()
            do_cmp()
            if (g_cmp_r != 0): push_int(1)
            else: push_int(0)
            end
        end
        if (op == 12):
            do_pop2()
            do_cmp()
            if (g_cmp_r < 0): push_int(1)
            else: push_int(0)
            end
        end
        if (op == 13):
            do_pop2()
            do_cmp()
            if (g_cmp_r > 0): push_int(1)
            else: push_int(0)
            end
        end
        if (op == 14):
            do_pop2()
            do_cmp()
            if (g_cmp_r <= 0): push_int(1)
            else: push_int(0)
            end
        end
        if (op == 15):
            do_pop2()
            do_cmp()
            if (g_cmp_r >= 0): push_int(1)
            else: push_int(0)
            end
        end
        if (op == 16):
            npc = u16_at(pc + 1)
        end
        if (op == 17):
            do_pop1()
            tv = truthy_pop()
            if (tv == 0):
                npc = u16_at(pc + 1)
            else:
                npc = pc + 3
            end
        end
        if (op == 18):
            fname = pool_str(u16_at(pc + 1))
            nargs = byte_at(pc + 3)
            fi = find_func(fname)
            if (fi < 0):
                printf("[QVM-Q] 未定义函数: %s\n", fname)
                running = 0
            else:
                if (fp >= 64):
                    printf("[QVM-Q] 调用栈溢出\n")
                    running = 0
                else:
                    base = fp * 64
                    k = 0
                    while (k < 64):
                        loc_type[base + k] = 0
                        loc_int[base + k] = 0
                        loc_str[base + k] = ""
                        loc_arr[base + k] = 0
                        k = k + 1
                    end
                    k = nargs - 1
                    while (k >= 0):
                        do_pop1()
                        loc_type[base + k] = pop1_t
                        loc_int[base + k] = pop1_i
                        loc_str[base + k] = pop1_s
                        loc_arr[base + k] = pop1_a
                        k = k - 1
                    end
                    fr_retpc[fp] = pc + 4
                    fp = fp + 1
                    npc = fn_bodypc[fi]
                end
            end
        end
        if (op == 19):
            do_pop1()
            fp = fp - 1
            npc = fr_retpc[fp]
            st_type[sp] = pop1_t
            st_int[sp] = pop1_i
            st_str[sp] = pop1_s
            st_arr[sp] = pop1_a
            sp = sp + 1
        end
        if (op == 20):
            running = 0
        end
        if (op == 21):
            bname = pool_str(u16_at(pc + 1))
            nargs = byte_at(pc + 3)
            do_builtin(bname, nargs)
            npc = pc + 4
        end
        if (op == 22):
            sz = u16_at(pc + 1)
            if (sz == 0):
                do_pop1()
                sz = pop1_i
            end
            if (sz < 0): sz = 0 end
            h = ar_used
            ar_used = ar_used + 1
            ar_off[h] = ar_next
            ar_size[h] = sz
            ar_next = ar_next + sz
            push_arr(h)
            npc = pc + 3
        end
        if (op == 23):
            do_pop1()
            idx = pop1_i
            h = slot_get_arr_handle(u16_at(pc + 1))
            pos = ar_off[h] + idx
            et = ae_t_get(pos)
            if (et == 1):
                push_str(ae_s_get(pos))
            else:
                if (et == 2):
                    push_arr(ae_i_get(pos))
                else:
                    push_int(ae_i_get(pos))
                end
            end
            npc = pc + 3
        end
        if (op == 24):
            do_pop2()
            h = slot_get_arr_handle(u16_at(pc + 1))
            pos = ar_off[h] + pop1_i
            ae_t_set(pos, pop2_t)
            if (pop2_t == 2):
                ae_i_set(pos, pop2_a)
            else:
                ae_i_set(pos, pop2_i)
            end
            ae_s_set(pos, pop2_s)
            npc = pc + 3
        end
        if (op == 25):
            sp = sp - 1
        end
        if (op == 26):
            do_pop1()
            push_int(0 - pop1_i)
        end
        if (op == 27):
            do_pop1()
            tv = truthy_pop()
            if (tv == 0): push_int(1)
            else: push_int(0)
            end
        end
        if (op == 28):
            do_pop2()
            ta = truthy_val(pop1_t, pop1_i, pop1_s, pop1_a)
            tb = truthy_val(pop2_t, pop2_i, pop2_s, pop2_a)
            if (ta == 1 and tb == 1): push_int(1)
            else: push_int(0)
            end
        end
        if (op == 29):
            do_pop2()
            ta = truthy_val(pop1_t, pop1_i, pop1_s, pop1_a)
            tb = truthy_val(pop2_t, pop2_i, pop2_s, pop2_a)
            if (ta == 1 or tb == 1): push_int(1)
            else: push_int(0)
            end
        end
        if (op == 30):
            printf("[QVM-Q] 执行期遇到FUNC_DEF(布局错误) pc=%d\n", pc)
            running = 0
        end
        pc = npc
    end
end

# ================================================================
# 主入口
# ================================================================
printf("QVM v1: QEntL编写的QBC1虚拟机\n")
if (load_qbc() == 1):
    build_func_table()
    printf("[QVM-Q] 加载 %s code=%d pool=%d funcs=%d\n", g_target, g_code_len, g_pool_len, fn_count)
    vm_run()
end
