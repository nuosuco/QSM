    var p = pos
    if (p < 65535): ae_int0[p] = v
    else:
        p = p - 65535
        if (p < 65535): ae_int1[p] = v
        else:
            p = p - 65535
            if (p < 65535): ae_int2[p] = v
            else:
                p = p - 65535
                if (p < 65535): ae_int3[p] = v
                else:
                    p = p - 65535
                    if (p < 65535): ae_int4[p] = v
                    else:
                        p = p - 65535
                        if (p < 65535): ae_int5[p] = v
                        else:
                            p = p - 65535
                            if (p < 65535): ae_int6[p] = v
                            else:
                                p = p - 65535
                                if (p < 65535): ae_int7[p] = v
                                else: ae_int8[p - 65535] = v end
                            end
                        end
                    end
                end
            end
        end
    end
end

def ae_s_get(pos):
    var p = pos
    if (p < 65535): return ae_str0[p] end
    p = p - 65535
    if (p < 65535): return ae_str1[p] end
    p = p - 65535
    if (p < 65535): return ae_str2[p] end
    p = p - 65535
    if (p < 65535): return ae_str3[p] end
    p = p - 65535
    if (p < 65535): return ae_str4[p] end
    p = p - 65535
    if (p < 65535): return ae_str5[p] end
    p = p - 65535
    if (p < 65535): return ae_str6[p] end
    p = p - 65535
    if (p < 65535): return ae_str7[p] end
    return ae_str8[p - 65535]
end

def ae_s_set(pos, v):
    var p = pos
    if (p < 65535): ae_str0[p] = v
    else:
        p = p - 65535
        if (p < 65535): ae_str1[p] = v
        else:
            p = p - 65535
            if (p < 65535): ae_str2[p] = v
            else:
                p = p - 65535
                if (p < 65535): ae_str3[p] = v
                else:
                    p = p - 65535
                    if (p < 65535): ae_str4[p] = v
                    else:
                        p = p - 65535
