# ================================================================
# QVM v1 — QBC1 虚拟机（QEntL编写，阶段3）
# 输入: target.qbc   输出: 程序的printf透传
# 目标: 完全取代C启动器的VM，构建纯QEntL运行环境
#
# QBC1格式: [4B]"QBC1" [2B]code_len [code] [2B]pool_len [pool]
# 布局: [JMP main | funcs | main | HALT]
# 值模型: 并行数组 (type: 0=int 1=str 2=arr句柄)
# ================================================================

# ---- 目标文件 ----
var g_target = "target.qbc"

# ---- QBC加载状态 ----
var g_raw = ""
var g_raw_len = 0
var g_code_len = 0
var g_pool_off = 0
var g_pool_len = 0
var g_main_start = 0

# ---- 值栈: 4096深 ----
var st_type[4096]
var st_int[4096]
var st_str[4096]
var st_arr[4096]
var sp = 0

# ---- 调用帧: 64帧 × 64局部 ----
var fr_retpc[64]
var fp = 0
var loc_type[4096]
var loc_int[4096]
var loc_str[4096]
var loc_arr[4096]

# ---- 全局槽: 512 ----
var gl_type[512]
var gl_int[512]
var gl_str[512]
var gl_arr[512]

# ---- 数组池: 碰撞分配器, 18段存储(升级版, 支持4态×515×1024=2109440) ----
var ar_off[16384]
var ar_size[16384]
var ar_used = 0
var ar_next = 0
var ae_type0[65535]
var ae_type1[65535]
var ae_type2[65535]
