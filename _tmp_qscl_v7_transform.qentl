# QSCL 32×32 真训练器 v7 - 4态不同起点+不同更新策略叠加态并行（坍缩合并）
# 数据: 4226字 8批×515类 + 106部首，32×32=1024像素
# 4态: seed=1+s*100, LR=500/1000/1500/2000
#   态0=标准对比式感知机（增强+抑制）
#   态1=只增强正确类，不抑制错分类
#   态2=对称抑制加权（抑制强度加倍）
#   态3=随机扰动学习（增强时75%像素更新25%跳过）
# 权重: arr_new(515*1024=527360) 跨18段池

var g_W = 0                    # 权重矩阵句柄（arr_new分配）
var g_Wsum = 0                 # 汇总权重句柄（坍缩合并用）
var g_x = 0                    # 当前样本像素（arr_new 1024）
var g_scores = 0               # 各类得分（arr_new 515）
var g_data = ""
var g_data_len = 0
var g_line = ""
var g_rem = ""
var g_pv = ""
var g_c1 = 0
var g_ps = 0
var g_pe = 0
var g_nl = 0
var g_row_start = 0
var g_i = 0
var g_label = 0
var g_pred = 0
var g_score = 0
var g_max_val = 0
var g_max_idx = 0
var g_correct = 0
var g_updates = 0
var g_diff = 0
var g_lr = 500
var g_rnd = 0
var g_ep = 0
var g_epoch = 25               # 每态25轮（skill: A识别batch0 ep24=99%）
var g_batch = 0
var g_state = 0
var g_seed = 0
var g_base = 0                 # 本批起始类号 = batch * 515
var g_nclass = 515             # 每批515类
var g_s = 0                    # 态编号 0-3
var g_wpos = 0                 # 权重写入位置（分块保存）

# 加载本批数据（第batch*515行开始）
def load_batch():
    g_data = file_read("qdfs/ns/data/yi_glyph_4226_32x32.data")
    g_data_len = str_len(g_data)
    g_row_start = 0
    g_i = 0
    var target_line = g_batch * 515
    while (g_i < target_line):
        g_rem = str_substring(g_data, g_row_start, g_data_len - g_row_start)
        g_nl = str_index_of(g_rem, "\n")
        if (g_nl < 0):
            g_row_start = g_data_len
        else:
            g_row_start = g_row_start + g_nl + 1
        end
        g_i = g_i + 1
    end
    printf("batch%d: 起始行%d, 位置%d\n", g_batch, target_line, g_row_start)
end

# 解析第s个样本（从g_row_start开始）
def parse_sample(s):
    var cur_pos = g_row_start
    var cnt = 0
    while (cnt < s):
        g_rem = str_substring(g_data, cur_pos, g_data_len - cur_pos)
        g_nl = str_index_of(g_rem, "\n")
        if (g_nl < 0):
            cur_pos = g_data_len
        else:
            cur_pos = cur_pos + g_nl + 1
        end
        cnt = cnt + 1
    end
    g_rem = str_substring(g_data, cur_pos, g_data_len - cur_pos)
    g_nl = str_index_of(g_rem, "\n")
    if (g_nl < 0):
        g_line = g_rem
    else:
        g_line = str_substring(g_rem, 0, g_nl)
    end
    # 解析label和像素
    g_c1 = str_index_of(g_line, ":")
    g_label = str_to_int(str_substring(g_line, 0, g_c1)) - g_base
    g_pix_str = str_substring(g_line, g_c1 + 1, 60000)
    g_ps = 0
    g_i = 0
    while (g_i < 1024):
        g_rem = str_substring(g_pix_str, g_ps, 60000)
        g_pe = str_index_of(g_rem, ",")
        if (g_pe < 0):
            g_pv = g_rem
            g_ps = 60000
        else:
            g_pv = str_substring(g_rem, 0, g_pe)
            g_ps = g_ps + g_pe + 1
        end
        arr_set(g_x, g_i, str_to_int(g_pv))
        g_i = g_i + 1
    end
end

# 按态做不同输入变换，保证4态看到不同数据视角（在 parse_sample 后、train_one 前调用）
def transform_sample():
    if (g_state == 1):
        # 态1=水平翻转：32×32图每行左右镜像
        var th_i = 0
        var th_row = 0
        var th_col = 0
        var th_tmp = 0
        while (th_i < 1024):
            th_row = th_i / 32
            th_col = th_i % 32
            th_tmp = arr_get(g_x, th_i)
            arr_set(g_x, th_i, arr_get(g_x, th_row * 32 + 31 - th_col))
            arr_set(g_x, th_row * 32 + 31 - th_col, th_tmp)
            th_i = th_i + 1
        end
    end
    if (g_state == 2):
        # 态2=椒盐噪声：约5%像素翻转0↔1（g_rnd=g_rnd*1103+12345）
        var tn_i = 0
        while (tn_i < 1024):
            g_rnd = g_rnd * 1103 + 12345
            if (g_rnd < 0): g_rnd = 0 - g_rnd end
            if (g_rnd % 20 == 0):
                arr_set(g_x, tn_i, 1 - arr_get(g_x, tn_i))
            end
            tn_i = tn_i + 1
        end
    end
    if (g_state == 3):
        # 态3=垂直翻转：32×32图上下32行对调
        var tv_i = 0
        var tv_row = 0
        var tv_col = 0
        var tv_tmp = 0
        while (tv_i < 1024):
            tv_row = tv_i / 32
            tv_col = tv_i % 32
            tv_tmp = arr_get(g_x, tv_i)
            arr_set(g_x, tv_i, arr_get(g_x, (31 - tv_row) * 32 + tv_col))
            arr_set(g_x, (31 - tv_row) * 32 + tv_col, tv_tmp)
            tv_i = tv_i + 1
        end
    end
end

# 手写内积argmax（515类×1024像素，v6已验证正确的对比式感知机）
# 注: 改名predict, 避免与QVM内建argmax(arr,n)撞名被误判为builtin
def predict():
    g_max_val = -30000
    g_max_idx = 0
    g_c = 0
    while (g_c < 515):
        g_score = 0
        var idx = g_c * 1024
        g_i = 0
        while (g_i < 1024):
            g_score = g_score + arr_get(g_W, idx + g_i) * arr_get(g_x, g_i)
            g_i = g_i + 1
        end
        if (g_score > g_max_val):
            g_max_val = g_score
            g_max_idx = g_c
        end
        g_c = g_c + 1
    end
    g_pred = g_max_idx
end

# 不同更新策略训练（4态各不同学习律变体）
def train_one():
    transform_sample()
    predict()
    if (g_pred == g_label):
        g_correct = g_correct + 1
    else:
        g_updates = g_updates + 1
        if (g_state == 0):
            # 态0: 标准对比式感知机（增强正确类+抑制错分类）
            var idx1 = g_label * 1024
            g_i = 0
            while (g_i < 1024):
                g_diff = arr_get(g_x, g_i) - arr_get(g_W, idx1 + g_i)
                arr_set(g_W, idx1 + g_i, arr_get(g_W, idx1 + g_i) + g_diff * g_lr / 1000)
                g_i = g_i + 1
            end
            var idx2 = g_pred * 1024
            g_i = 0
            while (g_i < 1024):
                g_diff = arr_get(g_x, g_i) - arr_get(g_W, idx2 + g_i)
                arr_set(g_W, idx2 + g_i, arr_get(g_W, idx2 + g_i) - g_diff * g_lr / 1000)
                g_i = g_i + 1
            end
        end
        if (g_state == 1):
            # 态1: 只增强正确类，不抑制错分类
            var idx1 = g_label * 1024
            g_i = 0
            while (g_i < 1024):
                g_diff = arr_get(g_x, g_i) - arr_get(g_W, idx1 + g_i)
                arr_set(g_W, idx1 + g_i, arr_get(g_W, idx1 + g_i) + g_diff * g_lr / 1000)
                g_i = g_i + 1
            end
        end
        if (g_state == 2):
            # 态2: 对称抑制加权（抑制强度加倍 W[pred]-=2*(x-W[pred])*lr/1000）
            var idx1 = g_label * 1024
            g_i = 0
            while (g_i < 1024):
                g_diff = arr_get(g_x, g_i) - arr_get(g_W, idx1 + g_i)
                arr_set(g_W, idx1 + g_i, arr_get(g_W, idx1 + g_i) + g_diff * g_lr / 1000)
                g_i = g_i + 1
            end
            var idx2 = g_pred * 1024
            g_i = 0
            while (g_i < 1024):
                g_diff = arr_get(g_x, g_i) - arr_get(g_W, idx2 + g_i)
                arr_set(g_W, idx2 + g_i, arr_get(g_W, idx2 + g_i) - g_diff * g_lr * 2 / 1000)
                g_i = g_i + 1
            end
        end
        if (g_state == 3):
            # 态3: 随机扰动学习（增强时75%像素更新25%跳过）
            var idx1 = g_label * 1024
            g_i = 0
            while (g_i < 1024):
                g_rnd = g_rnd * 1103 + 12345
                if (g_rnd < 0): g_rnd = 0 - g_rnd end
                if (g_rnd % 4 > 0):
                    g_diff = arr_get(g_x, g_i) - arr_get(g_W, idx1 + g_i)
                    arr_set(g_W, idx1 + g_i, arr_get(g_W, idx1 + g_i) + g_diff * g_lr / 1000)
                end
                g_i = g_i + 1
            end
        end
    end
end

# 单态训练（1个batch）
def train_state():
    # 不同起点初始化权重
    g_rnd = g_seed
    g_i = 0
    while (g_i < 515 * 1024):
        g_rnd = g_rnd * 1103 + 12345
        if (g_rnd < 0): g_rnd = 0 - g_rnd end
        arr_set(g_W, g_i, g_rnd % 3)
        g_i = g_i + 1
    end
    printf("  态%d seed=%d lr=%d 权重初始化完成\n", g_state, g_seed, g_lr)
    
    # 逐epoch训练
    g_ep = 0
    while (g_ep < g_epoch):
        g_correct = 0
        g_updates = 0
        var s = 0
        while (s < 515):  # 每批515个样本
            parse_sample(s)
            train_one()
            s = s + 1
        end
        printf("  态%d ep%d: 正确%d/515 更新%d\n", g_state, g_ep, g_correct, g_updates)
        g_ep = g_ep + 1
    end
end

# 坍缩合并：把当前态权重累加进汇总权重
def collapse_merge():
    g_i = 0
    while (g_i < 515 * 1024):
        arr_set(g_Wsum, g_i, arr_get(g_Wsum, g_i) + arr_get(g_W, g_i))
        g_i = g_i + 1
    end
    printf("  态%d 坍缩合并完成\n", g_state)
end

# 分块保存权重（避免字符串拼接OOM）
def save_weights():
    var wname = "qdfs/ns/models/qscl_32x32_b"
    wname = str_concat(wname, int_to_str(g_batch))
    wname = str_concat(wname, ".w")
    # 清空文件
    file_write_bytes(wname, "")
    # 分块写：每次写1024个权重（1类）
    g_wpos = 0
    var chunk = 0
    while (g_wpos < 515 * 1024):
        var wstr = ""
        var j = 0
        while (j < 1024):
            if (g_wpos + j > 0):
                wstr = str_concat(wstr, ",")
            end
            wstr = str_concat(wstr, int_to_str(arr_get(g_Wsum, g_wpos + j)))
            j = j + 1
        end
        file_append(wname, wstr)
        g_wpos = g_wpos + 1024
        chunk = chunk + 1
    end
    printf("  保存: %s (%d块)\n", wname, chunk)
end

def main():
    printf("=== QSCL 32×32 v7 4态叠加态训练（不同更新策略）===\n")
    printf("数据: 4226字 8批×515类 32×32=1024像素\n")
    printf("态0=标准对比式 态1=只增强 态2=抑制加倍 态3=随机扰动\n")
    printf("LR: 态0=500 态1=1000 态2=1500 态3=2000\n")
    
    # 分配权重矩阵（18段池支持527360）
    g_W = arr_new(515 * 1024)
    g_Wsum = arr_new(515 * 1024)
    g_x = arr_new(1024)
    g_scores = arr_new(515)
    printf("权重矩阵分配: W/Wsum各527360元素\n")
    
    # 清零汇总权重
    g_i = 0
    while (g_i < 515 * 1024):
        arr_set(g_Wsum, g_i, 0)
        g_i = g_i + 1
    end
    
    # 逐批训练（8批×515类）
    g_batch = 0
    while (g_batch < 8):
        g_base = g_batch * 515
        printf("--- batch%d (类%d-%d) ---\n", g_batch, g_base, g_base+514)
        load_batch()
        
        # 4态循环
        g_s = 0
        while (g_s < 4):
            g_state = g_s
            g_seed = 1 + g_s * 100
            g_lr = 500 + g_s * 500
            train_state()
            collapse_merge()
            g_s = g_s + 1
        end
        
        # 平均汇总权重（坍缩合并）
        g_i = 0
        while (g_i < 515 * 1024):
            arr_set(g_Wsum, g_i, arr_get(g_Wsum, g_i) / 4)
            g_i = g_i + 1
        end
        
        save_weights()
        g_batch = g_batch + 1
    end
    
    printf("=== 全部8批4态训练完成，坍缩合并保存 ===\n")
end

main()
