/* SOM 松麦 - 全局样式（对应网页版 style.css 通用部分） */
page {
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  background: #f5f7f6;
  color: #2c3e50;
  line-height: 1.6;
}

/* 加载动画（对应 .loading） */
.loading {
  display: inline-block;
  width: 40rpx;
  height: 40rpx;
  border: 6rpx solid #e0e6e3;
  border-top-color: #4a9d6e;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 空状态（对应 .empty-state） */
.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
  color: #7f8c8d;
  font-size: 28rpx;
}

/* 商品卡片（对应 .product-card） */
.product-card {
  background: #fff;
  border: 2rpx solid #e0e6e3;
  border-radius: 24rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.product-image {
  width: 100%;
  height: 340rpx;
  background: #f5f7f6;
}

.product-info {
  padding: 24rpx;
}

.product-title {
  font-size: 28rpx;
  line-height: 1.4;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.product-price {
  color: #e74c3c;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.product-shop {
  font-size: 24rpx;
  color: #7f8c8d;
}

/* 加载更多 */
.loading-more {
  text-align: center;
  padding: 30rpx;
  color: #7f8c8d;
  font-size: 26rpx;
}