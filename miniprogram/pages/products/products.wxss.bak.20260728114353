/* 对应 style.css 中 .products-container 到 .empty-state 部分 */
.products-container {
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

/* 搜索框（对应 .search-box） */
.search-box {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.search-box input {
  flex: 1;
  padding: 20rpx 24rpx;
  border: 2rpx solid #e0e6e3;
  border-radius: 24rpx;
  font-size: 28rpx;
  background: #fff;
}

.search-box button {
  padding: 20rpx 48rpx;
  background: #4a9d6e;
  color: white;
  border: none;
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 1.4;
}

/* 平台筛选（对应 .platform-filter） */
.platform-filter {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.filter-btn {
  flex: 1;
  padding: 16rpx 0;
  border: 2rpx solid #e0e6e3;
  background: #fff;
  border-radius: 40rpx;
  text-align: center;
  font-size: 26rpx;
  color: #7f8c8d;
}

.filter-btn.active {
  background: #4a9d6e;
  color: white;
  border-color: #4a9d6e;
}

/* 排序按钮（对应 .sort-filter） */
.sort-filter {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
  white-space: nowrap;
  padding-bottom: 8rpx;
}

.sort-btn {
  display: inline-block;
  padding: 12rpx 24rpx;
  border: 2rpx solid #e0e6e3;
  background: #fff;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: #7f8c8d;
}

.sort-btn.active {
  background: #4a9d6e;
  color: white;
  border-color: #4a9d6e;
}

/* 分类导航（对应 .category-nav） */
.category-nav {
  display: flex;
  gap: 24rpx;
  margin-bottom: 32rpx;
  padding: 24rpx;
  background: #f5f7f6;
  border-radius: 24rpx;
  white-space: nowrap;
}

.category-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  min-width: 140rpx;
  padding: 20rpx 16rpx;
  background: #fff;
  border: 2rpx solid #e0e6e3;
  border-radius: 24rpx;
}

.category-item.active {
  border-color: #4a9d6e;
  box-shadow: 0 4rpx 16rpx rgba(74,157,110,0.15);
}

.category-icon {
  font-size: 56rpx;
  line-height: 1;
}

.category-name {
  font-size: 24rpx;
  color: #2c3e50;
  text-align: center;
}

.category-loading {
  width: 100%;
  text-align: center;
  padding: 40rpx;
  color: #7f8c8d;
  font-size: 28rpx;
}

/* 商品网格（对应 .products-grid） */
.products-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.products-grid .product-card {
  width: 48.5%;
  margin-bottom: 16rpx;
}

.products-grid .product-image {
  height: 240rpx;
}

.products-grid .product-title {
  font-size: 26rpx;
}

.products-grid .product-price {
  font-size: 32rpx;
}

.products-grid .product-shop {
  font-size: 22rpx;
}