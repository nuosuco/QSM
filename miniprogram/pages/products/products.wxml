<!-- 有机好物 - 审核版：隐藏商品展示，只留搜索框 -->
<!-- 商品功能完整保留，用户主动搜索后才显示结果 -->
<view class="products-container">
  <!-- 搜索框（核心功能，保留） -->
  <view class="search-box">
    <input type="text" value="{{keyword}}" placeholder="搜索有机食材，如：枸杞、红枣、山药..." bindinput="onSearchInput" bindconfirm="doSearch" confirm-type="search" />
    <button bindtap="doSearch">搜索</button>
  </view>

  <!-- 搜索提示（未搜索时显示） -->
  <view class="search-hint" wx:if="{{!hasSearched && !loading}}">
    <view class="hint-icon">🌿</view>
    <view class="hint-title">有机食材搜索</view>
    <view class="hint-desc">输入食材名称，为您查找有机认证好物</view>
    <view class="hint-tags">
      <text class="hint-tag" bindtap="quickSearch" data-kw="枸杞">枸杞</text>
      <text class="hint-tag" bindtap="quickSearch" data-kw="红枣">红枣</text>
      <text class="hint-tag" bindtap="quickSearch" data-kw="山药">山药</text>
      <text class="hint-tag" bindtap="quickSearch" data-kw="薏米">薏米</text>
      <text class="hint-tag" bindtap="quickSearch" data-kw="茯苓">茯苓</text>
      <text class="hint-tag" bindtap="quickSearch" data-kw="百合">百合</text>
    </view>
  </view>

  <!-- 商品网格（搜索后才显示） -->
  <view class="products-grid" wx:if="{{products.length > 0}}">
    <view class="product-card" wx:for="{{products}}" wx:key="index" bindtap="openProductDetail" data-index="{{index}}">
      <image class="product-image" src="{{item.image}}" mode="aspectFill"></image>
      <view class="product-info">
        <view class="product-title">{{item.title}}</view>
        <view class="product-price">¥{{item.price}}</view>
        <view class="product-shop">{{item.shop_name || ''}} · {{item.platform === 'taobao' ? '淘宝' : '京东'}}</view>
      </view>
    </view>
  </view>

  <!-- 搜索无结果 -->
  <view class="empty-state" wx:if="{{hasSearched && !loading && products.length === 0}}">
    <text>未找到相关食材，换个关键词试试</text>
  </view>

  <!-- 加载中 -->
  <view class="loading-more" wx:if="{{loading}}">
    <text class="loading"></text>
    <text>搜索中...</text>
  </view>

  <!-- 加载更多 -->
  <view class="loading-more" wx:if="{{!loading && products.length > 0 && hasMore}}" bindtap="loadMore">
    <text>点击加载更多</text>
  </view>
  <view class="loading-more" wx:if="{{!loading && products.length > 0 && !hasMore}}">
    <text>没有更多了</text>
  </view>
</view>