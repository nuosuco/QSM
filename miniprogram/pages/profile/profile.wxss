/* 对应 style.css 中 .profile-container 到 .empty-hint 部分 */
.profile-container {
  padding: 32rpx;
  max-width: 100%;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

/* 用户卡片（对应 .profile-card） */
.profile-card {
  background: linear-gradient(135deg, #4a8c6f, #6cb488);
  border-radius: 32rpx;
  padding: 48rpx;
  display: flex;
  align-items: center;
  gap: 40rpx;
  color: white;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 30rpx rgba(74, 140, 111, 0.3);
}

.profile-avatar {
  width: 144rpx;
  height: 144rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  font-weight: bold;
  border: 6rpx solid rgba(255,255,255,0.5);
  flex-shrink: 0;
}

.profile-info {
  flex: 1;
}

.profile-name {
  margin: 0 0 16rpx 0;
  font-size: 40rpx;
  color: white;
  font-weight: bold;
}

.profile-tizhi,
.profile-points,
.profile-checkin {
  margin: 8rpx 0;
  font-size: 28rpx;
  opacity: 0.9;
  color: white;
}

/* 区块（对应 .profile-section） */
.profile-section {
  background: white;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.section-title {
  margin: 0 0 24rpx 0;
  font-size: 32rpx;
  color: #2c3e50;
  font-weight: bold;
}

/* 统计数据（对应 .profile-stats） */
.profile-stats {
  display: flex;
  justify-content: space-around;
  text-align: center;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 56rpx;
  font-weight: bold;
  color: #4a9d6e;
}

.stat-label {
  font-size: 24rpx;
  color: #7f8c8d;
  margin-top: 8rpx;
}

/* 体质记录（对应 .profile-history / .history-item） */
.profile-history {
  max-height: 600rpx;
  overflow-y: auto;
}

.history-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
  gap: 24rpx;
  font-size: 26rpx;
}

.history-item:last-child {
  border-bottom: none;
}

.history-date {
  color: #7f8c8d;
  flex-shrink: 0;
  font-size: 24rpx;
}

.history-tizhi {
  color: #4a9d6e;
  font-weight: 500;
  flex-shrink: 0;
}

.history-desc {
  color: #7f8c8d;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
}

.empty-hint {
  color: #7f8c8d;
  text-align: center;
  padding: 40rpx 0;
  font-size: 28rpx;
}