/* 对应 style.css 中 .chat-container 到 .send-btn:disabled 部分 */
page {
  height: 100%;
  overflow: hidden;
}

.chat-container {
  display: flex;
  flex-direction: column;
  height: 100%;
  background: #fff;
}

.chat-messages {
  flex: 1;
  height: 0; /* 强制flex子项收缩，让scroll-view只在内部滚动 */
  width: 100%;
  box-sizing: border-box;
}

.chat-messages-inner {
  padding: 24rpx;
  box-sizing: border-box;
}

.message {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.message.user {
  flex-direction: row-reverse;
}

.message-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4a9d6e, #7bc49f);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
  font-size: 32rpx;
  flex-shrink: 0;
}

.message.user .message-avatar {
  background: #95a5a6;
}

.message-content {
  max-width: 65%;
  min-width: 0;
}

.message-text {
  background: #f5f7f6;
  padding: 24rpx 32rpx;
  border-radius: 24rpx;
  line-height: 1.6;
  font-size: 28rpx;
  white-space: pre-line;
  overflow-wrap: break-word;
  word-break: break-all;
}

.message.user .message-text {
  background: #4a9d6e;
  color: white;
}

.chat-input-area {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid #e0e6e3;
  background: #fff;
}

.chat-input {
  flex: 1;
  padding: 20rpx 24rpx;
  border: 2rpx solid #e0e6e3;
  border-radius: 24rpx;
  font-size: 28rpx;
  min-height: 40rpx;
  max-height: 200rpx;
}

.send-btn {
  padding: 20rpx 48rpx;
  background: #4a9d6e;
  color: white;
  border: none;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.4;
}

.send-btn[disabled] {
  background: #bdc3c7;
}

/* 收藏按钮（对应 .fav-chat-btn） */
.fav-chat-btn {
  display: inline-block;
  margin-top: 16rpx;
  padding: 8rpx 24rpx;
  border: 2rpx solid #e74c3c;
  border-radius: 24rpx;
  background: #fff;
  color: #e74c3c;
  font-size: 24rpx;
}

.fav-chat-btn.favorited {
  background: #e74c3c;
  color: #fff;
}

/* 聊天中推荐商品（对应 .chat-products） */
.chat-products {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 24rpx;
  border: 2rpx solid #e0e6e3;
  box-sizing: border-box;
}

.chat-products-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #4a9d6e;
  margin-bottom: 20rpx;
}

.chat-products-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.chat-products-grid .product-card {
  width: 48.5%;
  margin-bottom: 16rpx;
  border-radius: 20rpx;
}

.chat-products-grid .product-image {
  height: 300rpx;
}