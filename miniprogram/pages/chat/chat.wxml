<!-- 对应 index.html #chat-tab -->
<view class="chat-container">
  <scroll-view class="chat-messages" scroll-y scroll-into-view="{{scrollToId}}" scroll-with-animation="{{false}}">
   <view class="chat-messages-inner">
    <!-- 初始欢迎消息（对应 index.html 中的 assistant message） -->
    <view class="message assistant" wx:if="{{messages.length === 0}}">
      <view class="message-avatar">麦</view>
      <view class="message-content">
        <view class="message-text">你好，我是小麦SOM，你的养生助手。

告诉我你最近的身体状况，比如：
• 失眠、疲劳、上火
• 口干、胃口不好
• 手脚冰凉、湿气重

我会帮你辨证分析，推荐适合的养生方案和有机好物。</view>
      </view>
    </view>

    <!-- 消息列表（对应 appendMessage 动态生成的 DOM） -->
    <block wx:for="{{messages}}" wx:for-index="msgIdx" wx:for-item="msg" wx:key="id">
      <view class="message {{msg.type}}" id="{{msg.id}}">
        <view class="message-avatar">{{msg.type === 'user' ? '你' : '麦'}}</view>
        <view class="message-content">
          <view class="message-text" wx:if="{{msg.type === 'user'}}">
            <text>{{msg.text}}</text>
            <view class="msg-user-images" wx:if="{{msg.images && msg.images.length > 0}}">
              <image wx:for="{{msg.images}}" wx:for-item="imgSrc" wx:key="*this" class="msg-user-image" src="{{imgSrc}}" mode="aspectFill" bindtap="previewMsgImage" data-src="{{imgSrc}}"></image>
            </view>
            <image wx:elif="{{msg.image}}" class="msg-user-image" src="{{msg.image}}" mode="aspectFill" bindtap="previewMsgImage" data-src="{{msg.image}}"></image>
          </view>
          <view class="message-text" wx:else>
            <text wx:if="{{msg.loading}}" class="loading"></text>
            <text wx:else>{{msg.text}}</text>
          </view>

          <!-- 新用户引导按钮 -->
          <view class="guide-actions" wx:if="{{msg.showGuide}}">
            <view class="guide-btn photo" bindtap="goPhotoScan">📷 拍照扫描（舌苔/面色/皮肤/患处）</view>
            <view class="guide-btn test" bindtap="goTizhiTest">📝 3分钟健康测评</view>
          </view>

          <!-- 辨证结果卡片 -->
          <view class="bianzheng-card" wx:if="{{msg.hasBianzheng}}">
            <view class="bianzheng-title">📋 辨证分析</view>
            <view class="bianzheng-row" wx:if="{{msg.zhengxing}}">
              <text class="bianzheng-label">证型：</text>
              <text class="bianzheng-value">{{msg.zhengxing}}</text>
            </view>
            <view class="bianzheng-row" wx:if="{{msg.tizhi}}">
              <text class="bianzheng-label">体质偏向：</text>
              <text class="bianzheng-value">{{msg.tizhi}}</text>
            </view>
          </view>

          <!-- 药食同源推荐 -->
          <view class="recommend-card" wx:if="{{msg.recommendations && msg.recommendations.length > 0}}">
            <view class="recommend-title">💊 推荐药食同源食材</view>
            <view class="recommend-item" wx:for="{{msg.recommendations}}" wx:for-item="rec" wx:key="name">
              <view class="recommend-name">{{rec.name}}</view>
              <view class="recommend-detail">性味：{{rec.xingwei}} ｜ 功效：{{rec.gongxiao}}</view>
              <view class="recommend-detail warn" wx:if="{{rec.jinji}}">⚠️ {{rec.jinji}}</view>
              <view class="recommend-shiliao" wx:if="{{rec.shiliao}}">
                <text class="shiliao-name">🍲 {{rec.shiliao.name}}</text>
                <text class="shiliao-recipe">{{rec.shiliao.recipe}}</text>
              </view>
            </view>
          </view>
          <!-- 操作按钮栏：收藏 + 分享图（对应网页版 msg-action-bar） -->
          <view class="msg-action-bar" wx:if="{{msg.showFav || msg.showRetry}}">
            <view class="fav-chat-btn {{msg.favorited ? 'favorited' : ''}}" wx:if="{{msg.showFav}}" bindtap="toggleChatFav" data-idx="{{msgIdx}}">
              {{msg.favorited ? '♥ 已收藏' : '♡ 收藏'}}
            </view>
            <view class="share-chat-btn" wx:if="{{msg.showFav}}" bindtap="onShareChatImage" data-idx="{{msgIdx}}">🖼️ 分享图</view>
            <view class="retry-btn" wx:if="{{msg.showRetry}}" bindtap="onRetry" data-idx="{{msgIdx}}">🔄 重试</view>
          </view>

        </view>
      </view>

      <!-- 推荐商品卡片（对应 chat-products） -->
      <view class="chat-products" wx:if="{{msg.products && msg.products.length > 0}}">
        <view class="chat-products-title">🛒 为你推荐以下有机好物：</view>
        <view class="chat-products-grid">
          <view class="product-card" wx:for="{{msg.products}}" wx:for-item="product" wx:for-index="prodIdx" wx:key="index" bindtap="openProductDetail" data-msg-idx="{{msgIdx}}" data-prod-idx="{{prodIdx}}">
            <image class="product-image" src="{{product.image}}" mode="aspectFill"></image>
            <view class="product-info">
              <view class="product-title">{{product.title}}</view>
              <view class="product-price">¥{{product.price}}</view>
              <view class="product-shop">{{product.shop_name || ''}} · {{product.platform === 'taobao' ? '淘宝' : '京东'}}</view>
            </view>
          </view>
        </view>
      </view>

      <!-- 三个引导提问（放在商品推荐之后，与网页版一致） -->
      <view class="followup-suggestions" wx:if="{{msg.showFollowup}}">
        <view class="followup-title">你可以继续：</view>
        <view class="followup-chip" wx:for="{{msg.followupChips}}" wx:for-item="chip" wx:key="*this" data-chip="{{chip}}" bindtap="onFollowupChip">{{chip}}</view>
      </view>
    </block>
   </view>
  </scroll-view>

  <!-- 分享图 canvas（隐藏，对应网页版 generateShareImage） -->
  <canvas type="2d" id="chatShareCanvas" class="share-canvas"></canvas>

  <!-- 输入区域（对应 chat-input-area） -->
  <view class="chat-input-area">
    <!-- 图片预览（多张） -->
    <view class="image-preview-list" wx:if="{{pendingImages.length > 0}}">
      <view class="preview-item" wx:for="{{pendingImages}}" wx:key="*this">
        <image class="preview-img" src="{{item}}" mode="aspectFill" bindtap="previewPendingImage" data-src="{{item}}"></image>
        <view class="preview-remove" bindtap="removePendingImage" data-idx="{{index}}">✕</view>
      </view>
      <view class="preview-add" wx:if="{{pendingImages.length < 4}}" bindtap="chooseImage">＋</view>
    </view>
    <view class="chat-input-row">
      <button class="upload-btn" bindtap="chooseImage" disabled="{{sending}}">📷</button>
      <textarea class="chat-input" value="{{inputValue}}" placeholder="描述身体状况，或📷拍舌苔..." auto-height maxlength="500" bindinput="onInput" bindconfirm="sendMessage" confirm-type="send" />
      <button class="send-btn" bindtap="sendMessage" disabled="{{sending}}">发送</button>
    </view>
  </view>
</view>