.test-container { min-height: 100vh; background: #f0f7f0; padding: 0 0 40rpx; }

/* 开始页 */
.start-page { display: flex; flex-direction: column; align-items: center; padding-top: 120rpx; }
.start-icon { font-size: 100rpx; }
.start-title { font-size: 44rpx; font-weight: bold; color: #2c3e50; margin-top: 30rpx; }
.start-desc { font-size: 28rpx; color: #666; text-align: center; margin-top: 20rpx; line-height: 1.8; padding: 0 60rpx; white-space: pre-line; }
.start-btn { margin-top: 60rpx; background: #4a9d6e; color: #fff; font-size: 32rpx; font-weight: bold; border-radius: 50rpx; padding: 24rpx 100rpx; border: none; }
.start-btn::after { border: none; }
.start-tip { margin-top: 30rpx; font-size: 24rpx; color: #999; }

/* 答题页 */
.quiz-page { padding: 40rpx 30rpx; }
.progress-bar { height: 8rpx; background: #ddd; border-radius: 4rpx; overflow: hidden; }
.progress-fill { height: 100%; background: #4a9d6e; border-radius: 4rpx; transition: width 0.3s; }
.progress-text { text-align: right; font-size: 24rpx; color: #999; margin-top: 10rpx; }
.question-card { background: #fff; border-radius: 24rpx; padding: 50rpx 40rpx; margin-top: 30rpx; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06); }
.question-text { font-size: 34rpx; font-weight: bold; color: #2c3e50; line-height: 1.6; }
.options { margin-top: 40rpx; }
.option { padding: 28rpx 30rpx; margin-bottom: 20rpx; background: #f5f7f6; border-radius: 16rpx; font-size: 30rpx; color: #333; border: 2rpx solid transparent; transition: all 0.2s; }
.option.selected { background: #e8f5e9; border-color: #4a9d6e; color: #4a9d6e; font-weight: bold; }

/* 结果页 */
.result-page { padding: 40rpx 30rpx; }
.result-card { background: #fff; border-radius: 24rpx; padding: 50rpx 40rpx; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06); text-align: center; }
.result-badge { font-size: 80rpx; }
.result-title { font-size: 40rpx; font-weight: bold; color: #4a9d6e; margin-top: 20rpx; }
.result-symptoms { margin-top: 20rpx; display: flex; flex-wrap: wrap; justify-content: center; gap: 12rpx; }
.symptom-tag { background: #f0f7f0; color: #4a9d6e; font-size: 24rpx; padding: 8rpx 20rpx; border-radius: 20rpx; }
.result-desc { font-size: 28rpx; color: #666; margin-top: 20rpx; line-height: 1.6; }
.result-advice { text-align: left; background: #f9fdf9; border-radius: 16rpx; padding: 30rpx; margin-top: 30rpx; border: 1rpx solid #e0f0e0; }
.advice-title { font-size: 30rpx; font-weight: bold; color: #4a9d6e; margin-bottom: 16rpx; }
.advice-diet, .advice-avoid, .advice-life { font-size: 26rpx; color: #555; line-height: 1.8; }

/* 分享图 canvas（隐藏但存在） */
.share-canvas { position: fixed; left: -9999rpx; top: 0; width: 375px; height: 520px; }

/* 操作按钮 */
.result-actions { display: flex; gap: 20rpx; margin-top: 40rpx; }
.share-btn { flex: 1; background: #fff; color: #4a9d6e; font-size: 28rpx; font-weight: bold; border: 2rpx solid #4a9d6e; border-radius: 50rpx; padding: 22rpx 0; }
.share-btn::after { border: none; }
.ask-btn { flex: 1; background: #4a9d6e; color: #fff; font-size: 28rpx; font-weight: bold; border-radius: 50rpx; padding: 22rpx 0; border: none; }
.ask-btn::after { border: none; }
.result-tip { text-align: center; font-size: 24rpx; color: #999; margin-top: 24rpx; }
