/* 对应 style.css 中 .detail-overlay 到 @keyframes slideUp 部分 */
.detail-page {
  background: #fff;
  min-height: 100vh;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

/* 轮播（对应 .detail-img-wrap） */
.detail-swiper {
  width: 100%;
  height: 750rpx;
  background: #f8f9fa;
}

.detail-main-img {
  width: 100%;
  height: 100%;
}

.detail-img-counter {
  position: absolute;
  top: 700rpx;
  right: 20rpx;
  background: rgba(0,0,0,0.5);
  color: #fff;
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  z-index: 5;
}

/* 缩略图（对应 .detail-thumbs） */
.detail-thumbs {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  white-space: nowrap;
}

.detail-thumb {
  display: inline-block;
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  overflow: hidden;
  border: 4rpx solid #eee;
}

.detail-thumb.active {
  border-color: #7bc49f;
}

.detail-thumb image {
  width: 100%;
  height: 100%;
}

/* 商品信息（对应 .detail-body） */
.detail-body {
  padding: 32rpx;
}

.detail-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  line-height: 1.5;
}

.detail-price {
  font-size: 56rpx;
  color: #e74c3c;
  font-weight: 700;
  margin-bottom: 24rpx;
}

.detail-price .sym {
  font-size: 36rpx;
}

.detail-shop {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 40rpx;
}

.detail-brand,
.modal-sales {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 12rpx;
}

/* 操作按钮（对应 .detail-actions） */
.detail-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.detail-buy {
  flex: 1;
  padding: 28rpx;
  background: linear-gradient(135deg, #ff6b35, #e85d2c);
  color: #fff;
  border: none;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
}

.detail-fav {
  flex: 0 0 auto;
  padding: 28rpx 40rpx;
  border: 4rpx solid #e74c3c;
  border-radius: 24rpx;
  background: #fff;
  color: #e74c3c;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
}

.detail-fav.favorited {
  background: #e74c3c;
  color: #fff;
}

/* 商品详情区域（对应 .detail-detail-section） */
.detail-detail-section {
  padding: 0 32rpx 32rpx;
}

.detail-detail-title {
  text-align: center;
  font-size: 28rpx;
  color: #aaa;
  padding: 24rpx 0;
  letter-spacing: 4rpx;
}

.detail-detail-gallery {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.detail-detail-img {
  width: 100%;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f8f9fa;
}

.detail-detail-img image {
  width: 100%;
  display: block;
}

.detail-detail-footer {
  text-align: center;
  padding: 40rpx 0;
}

.detail-detail-btn {
  display: inline-block;
  padding: 24rpx 64rpx;
  background: linear-gradient(135deg, #ff6b35, #e85d2c);
  color: #fff;
  border: none;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
}