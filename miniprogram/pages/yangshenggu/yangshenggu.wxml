<!-- 养生谷：健康测评 + 节气养生 + 护眼训练 + 九种体质 + 药食同源 -->
<view class="knowledge-container">
  <!-- 健康测评入口 -->
  <view class="test-banner" bindtap="goTizhiTest">
    <view class="test-banner-left">
      <view class="test-banner-title">🔍 测测你的健康</view>
      <view class="test-banner-desc">体质测评 + 三高/痛风/风湿症状自评</view>
    </view>
    <view class="test-banner-btn">3分钟 →</view>
  </view>

  <!-- 快捷操作栏 -->
  <view class="quick-actions">
    <button class="quick-btn" bindtap="goAskXiaomai">💬 问小麦</button>
    <button class="quick-btn" open-type="share">📤 分享养生谷</button>
    <button class="quick-btn" bindtap="shareYangshengImage">🖼️ 分享海报</button>
  </view>

  <!-- 分享海报 canvas（隐藏） -->
  <canvas type="2d" id="ygShareCanvas" class="yg-share-canvas"></canvas>

  <!-- 节气养生 -->
  <view class="knowledge-section">
    <view class="section-title">🌿 节气养生</view>
    <view class="jieqi-card" wx:if="{{jieqi}}">
      <view class="jieqi-header">
        <text class="jieqi-name">{{jieqi.jieqi}}</text>
        <text class="jieqi-season">{{jieqi.season}}季</text>
        <text class="jieqi-next">下一：{{jieqi.next_jieqi}} {{jieqi.next_date}}</text>
      </view>
      <view class="jieqi-desc">{{jieqi.desc}}</view>
      <view class="jieqi-yangsheng">{{jieqi.yangsheng}}</view>
      <view class="jieqi-foods">
        <text class="jieqi-label">🥬 当季食材：</text>
        <text class="jieqi-food-tag" wx:for="{{jieqi.foods}}" wx:key="*this">{{item}}</text>
      </view>
      <view class="jieqi-tea">🍵 推荐茶饮：{{jieqi.tea}}</view>
      <view class="jieqi-avoid">⚠️ 注意：{{jieqi.avoid}}</view>
    </view>
    <view class="empty-state" wx:if="{{!jieqi && !loading}}"><text>加载失败</text></view>
  </view>

  <!-- 护眼训练 -->
  <view class="knowledge-section">
    <view class="section-title">👁️ 护眼训练</view>
    <view class="eye-list" wx:if="{{eyeExercises.length > 0}}">
      <view class="eye-item" wx:for="{{eyeExercises}}" wx:key="index">
        <view class="eye-name">{{item.name}} <text class="eye-duration">{{item.duration}}</text></view>
        <view class="eye-steps">{{item.steps}}</view>
        <view class="eye-benefit">{{item.benefit}}</view>
      </view>
    </view>
    <view class="eye-tips" wx:if="{{eyeTips}}">💡 {{eyeTips}}</view>
  </view>

  <!-- 九种体质 -->
  <view class="knowledge-section">
    <view class="section-title">九种体质</view>
    <view class="tizhi-grid">
      <view class="tizhi-card" wx:for="{{tizhiList}}" wx:key="index">
        <view class="tizhi-name">{{item.name}}</view>
        <view class="tizhi-desc">{{item.desc}}</view>
        <view class="tizhi-diet" wx:if="{{item.diet}}">调养：{{item.diet}}</view>
      </view>
    </view>
    <view class="empty-state" wx:if="{{tizhiList.length === 0 && !loading}}"><text>暂无数据</text></view>
  </view>

  <!-- 药食同源 -->
  <view class="knowledge-section">
    <view class="section-title">药食同源</view>
    <view class="yaoshi-list">
      <view class="yaoshi-item" wx:for="{{yaoshiList}}" wx:key="index">
        <view class="yaoshi-name">{{item.name}}</view>
        <view class="yaoshi-info">
          <text class="yaoshi-tag">性味：{{item.xingwei}}</text>
          <text class="yaoshi-tag">归经：{{item.guijing}}</text>
        </view>
        <view class="yaoshi-gongxiao">功效：{{item.gongxiao}}</view>
        <view class="yaoshi-jinji" wx:if="{{item.jinji}}">⚠️ {{item.jinji}}</view>
      </view>
    </view>
    <view class="empty-state" wx:if="{{yaoshiList.length === 0 && !loading}}"><text>暂无数据</text></view>
  </view>

  <!-- 加载中 -->
  <view class="loading-more" wx:if="{{loading}}">
    <text class="loading"></text>
    <text>加载中...</text>
  </view>
</view>
