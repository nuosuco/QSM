# ================================================================
# server_v14.qentl — QEntL HTTP服务器
# GET  /api/yi?d=N  — 字形识别(QSCL 4态投票)
# POST /api/yi       — 小趣QSM智能体对话(三语言)
# GET  /api/status   — 健康检查
# ================================================================

var g_port = 9802
var g_alive = 1

def get_d_param(path):
    var dpos = str_index_of(path, "d=")
    if (dpos < 0): return -1 end
    var dst = str_substring(path, dpos + 2, 60000)
    var dq = str_index_of(dst, " ")
    if (dq < 0): dq = str_index_of(dst, "&") end
    if (dq < 0): dq = str_len(dst) end
    var dval = str_substring(dst, 0, dq)
    return str_to_int(dval)
end

# ---- 查询参数?k=N ----
def get_k_param(req):
    var kpos = str_index_of(req, "?k=")
    if (kpos < 0): return 0 end
    var dst = str_substring(req, kpos + 3, 60000)
    var dq = str_index_of(dst, " ")
    if (dq < 0): dq = str_index_of(dst, "&") end
    if (dq < 0): dq = str_index_of(dst, "\r") end
    if (dq < 0): dq = str_len(dst) end
    var dval = str_substring(dst, 0, dq)
    return str_to_int(dval)
end

# ---- 请求体提取 ----
def get_body(req):
    var bd = str_index_of(req, "\r\n\r\n")
    if (bd < 0): return "" end
    return str_substring(req, bd + 4, 60000)
end

# ---- 小趣QSM 智能体对话 ----
def chat_reply(msg):
    # 把请求体写到临时文件(字节完整), 脚本读文件避免多字节编码问题
    file_write_bytes("/tmp/yi_chat_in.txt", msg)
    var cmd = "bash build/yi_api_chat_file.sh"
    return exec(cmd)
end

def handle_request(req):
    var resp = ""
    var sp1 = str_index_of(req, " ")
    var method = str_substring(req, 0, sp1)
    var path = "/"
    var sp2 = str_index_of(req, " ")
    if (sp2 >= 0):
        path = str_substring(req, sp2 + 1, 60000)
    end
    if (str_index_of(path, "/api/yi") >= 0):
        if (str_eq(method, "GET")):
            var d = get_d_param(path)
            if (d < 0):
                resp = "{\"error\":\"Usage: GET /api/yi?d=0..4119\"}"
            else:
                if (d > 4119):
                    resp = "{\"error\":\"d range 0..4119\"}"
                else:
                    var cmd = str_concat("bash build/yi_infer_v4.sh ", int_to_str(d))
                    resp = exec(cmd)
                end
            end
        else:
            var bd = str_index_of(req, "\r\n\r\n")
            var body = ""
            if (bd >= 0):
                body = str_substring(req, bd + 4, 10000)
            end
            var reply = chat_reply(body)
            resp = reply
        end
    else:
        if (str_index_of(path, "/api/status") >= 0):
            resp = "{\"status\":\"ok\",\"model\":\"qscl_unified\",\"votes\":\"4-state\",\"weights\":\"qscl_unified_b{0-7}_s{0-3}.w x32 + 8 merged\",\"dim\":\"515x64\",\"glyphs\":\"4120 yi\",\"engine\":\"gen_unified.sh\",\"chat\":\"xiaoqu-qsm\"}"
        else:
            if (str_index_of(path, "/api/generate") >= 0):
                var k = get_k_param(req)
                if (k < 0): k = 0 end
                if (k > 4119): k = 4119 end
                var cmdg = str_concat("/root/QSM/QLife/build/gen_unified.sh ", int_to_str(k))
                resp = exec(cmdg)
            else:
                if (str_index_of(path, "/api/recognize") >= 0):
                    var body = get_body(req)
                    var blen = str_len(body)
                    if (blen < 64):
                        resp = "{\"error\":\"need 64 pixels\"}"
                    else:
                        var cmdr = str_concat("/root/QSM/QLife/build/qscl_engine.sh argmax ", body)
                        resp = exec(cmdr)
                    end
                else:
                    if (str_index_of(path, "/api/image") >= 0):
                        var body = get_body(req)
                        var blen = str_len(body)
                        if (blen < 10):
                            resp = "{\"error\":\"no image input\"}"
                        else:
                            var cmdi = str_concat("/root/QSM/QLife/build/qscl_engine.sh img ", body)
                            resp = exec(cmdi)
                        end
                    else:
                        if (str_index_of(path, "/api/xiaoqu") >= 0):
                            var body = get_body(req)
                            var reply = chat_reply(body)
                            resp = reply
                        else:
                            resp = "{\"error\":\"unknown endpoint\"}"
                    end
                end
            end
        end
    end
    end
    return resp
end

var sock = tcp_listen(g_port)
printf("[server_v14] listening on port %d\n", g_port)
while (g_alive == 1):
    var cli = tcp_accept(sock)
    if (cli >= 0):
        var req = tcp_recv(cli, 4096)
        var body = handle_request(req)
        var hdr = str_concat("HTTP/1.0 200 OK\r\nContent-Type: application/json\r\nContent-Length: ", str_concat(int_to_str(str_len(body)), "\r\n\r\n"))
        tcp_send(cli, str_concat(hdr, body))
        tcp_close(cli)
    end
end
tcp_shutdown(sock)
tcp_close(sock)