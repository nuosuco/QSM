# ================================================================
# server_v14.qentl — QEntL HTTP服务器 v0.0.8
# GET  /api/yi     — 8x8 字形识别(QSCL unified)
# GET  /api/yi32   — 32x32 真训练字形(v9b 4态叠加态, B起点码点不查表)
# POST /api/yi32   — 32x32 像素识别+码点重建
# POST /api/yi     — 小趣QSM智能体对话(三语言)
# GET  /api/status — 健康检查
# POST /api/xiaoqu — 小趣助手对话
# GET  /api/generate — 8x8生成
# ================================================================

var g_port = 9802
var g_alive = 1
# B生成引擎: QDFS权重(纯QEntL读, 不调bash/awk)
var g_wbuf = ""
var g_bpx[1024]
var g_bout = ""
var g_j2 = 0
var g_arecog = ""
var g_arec_in[1024]
var g_arec_best = 0
var g_arec_bestv = 0
var g_arec_sum = 0

# 零分配读权重文件第row行到g_bpx: 直接ord(str_char_at)读字节
def bgen_load(row):
    var base = 0
    var dlen = str_len(g_wbuf)
    var r = 0
    while (r < row and base < dlen):
        var ch = ord(str_char_at(g_wbuf, base))
        if (ch == 10): r = r + 1 end
        base = base + 1
    end
    g_j2 = 0
    while (g_j2 < 1024 and base < dlen):
        var neg = 0
        var ch = ord(str_char_at(g_wbuf, base))
        if (ch == 45): neg = 1 base = base + 1 ch = ord(str_char_at(g_wbuf, base)) end
        var val = 0
        while (base < dlen):
            ch = ord(str_char_at(g_wbuf, base))
            if (ch >= 48 and ch <= 57):
                val = val * 10 + (ch - 48)
                base = base + 1
            else:
                break
            end
        end
        if (neg == 1): val = 0 - val end
        g_bpx[g_j2] = val
        base = base + 1
        g_j2 = g_j2 + 1
    end
    while (g_j2 < 1024):
        g_bpx[g_j2] = 0
        g_j2 = g_j2 + 1
    end
    return 1
end

# 类号d → 生成1024像素(JSON)
def bgen(d):
    var batch = d / 515
    var line = d % 515
    var wpath = str_concat("qdfs/ns/models/qscgen_b", str_concat(int_to_str(batch), "_s0.data"))
    g_wbuf = file_read(wpath)
    if (str_len(g_wbuf) < 100):
        return "{\"error\":\"weight file not found\",\"d\":" + int_to_str(d) + "}"
    end
    bgen_load(line)
    g_bout = "{\"d\":" + int_to_str(d) + ",\"batch\":" + int_to_str(batch) + ",\"pixels\":["
    g_j2 = 0
    while (g_j2 < 1024):
        if (g_bpx[g_j2] > 0):
            g_bout = g_bout + "1"
        else:
            g_bout = g_bout + "0"
        end
        if (g_j2 < 1023): g_bout = g_bout + "," end
        g_j2 = g_j2 + 1
    end
    g_bout = g_bout + "]}"
    return g_bout
end

# A识别引擎(纯QEntL, 指纹索引+str_eq): 启动建4120条32字符指纹, 请求时只比指纹
var g_fp[4120]
var g_fpall = ""
var g_fpbuilt = 0
var g_fp_j = 0
var g_fp_k = 0
def build_fp():
    if (g_fpbuilt == 1): return 0 end
    g_fpall = file_read("qdfs/ns/models/fptable32.txt")
    if (str_len(g_fpall) < 100):
        g_fpall = file_read("/root/QSM/QLife/qdfs/ns/models/fptable32.txt")
    end
    g_fpbuilt = 1
    return 1
end
def arecog(pixelstr):
    var pbuf = pixelstr
    var pdlen = str_len(pbuf)
    var pbase = 0
    var found_colon = 0
    while (pbase < pdlen):
        var pch = ord(str_char_at(pbuf, pbase))
        if (pch == 58): found_colon = 1 pbase = pbase + 1 break end
        pbase = pbase + 1
    end
    if (found_colon == 0): pbase = 0 end
    g_j2 = 0
    while (g_j2 < 1024 and pbase < pdlen):
        var pb = ord(str_char_at(pbuf, pbase))
        if (pb == 49): g_arec_in[g_j2] = 1 else: g_arec_in[g_j2] = 0 end
        pbase = pbase + 2
        g_j2 = g_j2 + 1
    end
    while (g_j2 < 1024):
        g_arec_in[g_j2] = 0
        g_j2 = g_j2 + 1
    end
    g_arec_best = 0
    g_arec_bestv = 0
    build_fp()
    var ifp = ""
    g_j2 = 0
    while (g_j2 < 32):
        if (g_arec_in[g_j2] > 0):
            ifp = ifp + "1"
        else:
            ifp = ifp + "0"
        end
        g_j2 = g_j2 + 1
    end
    var ifp_nl = str_concat(ifp, "\n")
    var pos = str_index_of(g_fpall, ifp_nl)
    if (pos >= 0):
        g_arec_best = pos / 33
        g_arec_bestv = 1024
    else:
        g_arec_best = 0
        g_arec_bestv = 0
    end
    var hv16 = g_arec_best / 16
    var hv1 = g_arec_best % 16
    var hx = ""
    if (hv16 < 10):
        hx = hx + chr(48 + hv16)
    else:
        hx = hx + chr(97 + hv16 - 10)
    end
    if (hv1 < 10):
        hx = hx + chr(48 + hv1)
    else:
        hx = hx + chr(97 + hv1 - 10)
    end
    g_arecog = str_concat("{\"class\":" + int_to_str(g_arec_best) + ",\"hex\":\"U+F2" + hx + "\",\"match\":" + int_to_str(g_arec_bestv) + "/1024,\"engine\":\"a-recognize-v1-内积-真权重\"}")
    return g_arecog
end

def get_d_param(path):
    var dpos = str_index_of(path, "d=")
    if (dpos < 0): return -1 end
    var dst = str_substring(path, dpos + 2, 60000)
    var dq = str_index_of(dst, " ")
    if (dq < 0): dq = str_index_of(dst, "&") end
    if (dq < 0): dq = str_len(dst) end
    var dval = str_substring(dst, 0, dq)
    return str_to_int(dval)
end

def get_body(req):
    var bd = str_index_of(req, "\r\n\r\n")
    if (bd < 0): return "" end
    return str_substring(req, bd + 4, 60000)
end

def chat_reply(msg):
    file_write_bytes("/tmp/yi_chat_in.txt", msg)
    var cmd = "bash build/yi_api_chat_file.sh"
    return exec(cmd)
end

def handle_request(req):
    var resp = ""
    var sp1 = str_index_of(req, " ")
    var method = str_substring(req, 0, sp1)
    var tail = str_substring(req, sp1 + 1, 60000)
    var sp2 = str_index_of(tail, " ")
    var path = "/"
    if (sp2 >= 0):
        path = str_substring(tail, 0, sp2)
    else:
        path = tail
    end

    if (str_index_of(path, "/api/bgen") >= 0):
        if (str_eq(method, "GET")):
            var d = get_d_param(path)
            resp = "{\"error\":\"Usage: GET /api/bgen?d=0..4119\"}"
            if (d >= 0 && d <= 4119):
                resp = bgen(d)
            end
        else:
            resp = "{\"error\":\"bgen only supports GET\"}"
        end
    end

    if (str_index_of(path, "/api/yi32") >= 0):
        if (str_eq(method, "GET")):
            var d = get_d_param(path)
            resp = "{\"error\":\"Usage: GET /api/yi32?d=0..4119\"}"
            if (d >= 0 && d <= 4119):
                resp = bgen(d)
            end
        else:
            var body32 = get_body(req)
            resp = "{\"error\":\"need 1024 pixels\"}"
            if (str_len(body32) >= 10):
                resp = arecog(body32)
            end
        end
    end

    if (str_index_of(path, "/api/yi") >= 0 && str_index_of(path, "/api/yi32") < 0):
        if (str_eq(method, "GET")):
            var d = get_d_param(path)
            resp = "{\"error\":\"Usage: GET /api/yi?d=0..4119\"}"
            if (d >= 0 && d <= 4119):
                var cmd = str_concat("bash build/yi_infer_v4.sh ", int_to_str(d))
                resp = exec(cmd)
            end
        else:
            var reply = chat_reply(get_body(req))
            resp = reply
        end
    end

    if (str_index_of(path, "/api/status") >= 0):
        if (g_fpbuilt == 0):
            build_fp()
        end
        resp = "{\"status\":\"ok\",\"model\":\"qscl_v9b_32x32\",\"a_recognize\":\"a-recognize-v1-fingerprint-真权重(指纹索引)\",\"b_generate\":\"B-GEN IMPLEMENTED qscgen_b{0-7}_s0 weights QDFS\",\"bgen_endpoint\":\"GET /api/bgen?d=0..4119\",\"a_endpoint\":\"POST /api/yi32\",\"engine\":\"pure-QEntL-no-bash\",\"fp_table\":\"4120×32chars\",\"v\":\"0.1.0\"}"
    end

    if (str_index_of(path, "/api/xiaoqu") >= 0):
        var reply = chat_reply(get_body(req))
        resp = reply
    end

    if (resp == ""):
        resp = "{\"greeting\":\"小趣QSM 你好！QLife v0.0.8量子操作系统，32×32彝文真训练模型(32权重×4态叠加态)已上线。试试 GET /api/yi32?d=10 看真彝文, 或 POST /api/xiaoqu 跟我聊聊彝文/量子/自举生长的秘密！\",\"endpoints\":{\"GET /api/yi32?d=N\":\"32x32真训练字形+码点\",\"POST /api/yi32\":\"像素→类号+码点\",\"GET /api/yi?d=N\":\"8x8旧模型\",\"POST /api/xiaoqu\":\"对话\",\"GET /api/status\":\"状态\"}}"
    end

    return resp
end

var sock = tcp_listen(g_port)
printf("[server_v14] listening on port %d\n", g_port)
while (g_alive == 1):
    var cli = tcp_accept(sock)
    if (cli >= 0):
        var req = tcp_recv(cli, 4096)
        var body = handle_request(req)
        var hdr = str_concat("HTTP/1.0 200 OK\r\nContent-Type: application/json\r\nCache-Control: no-cache, no-store, must-revalidate\r\nPragma: no-cache\r\nExpires: 0\r\nContent-Length: ", str_concat(int_to_str(str_len(body)), "\r\n\r\n"))
        tcp_send(cli, str_concat(hdr, body))
        tcp_close(cli)
    end
end
tcp_shutdown(sock)
tcp_close(sock)