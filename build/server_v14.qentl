# ================================================================
# server_v14.qentl — QEntL HTTP服务器
# GET  /api/yi?d=N  — 字形识别(QSCL 4态投票)
# POST /api/yi       — 小趣QSM智能体对话(三语言)
# GET  /api/status   — 健康检查
# ================================================================

var g_port = 9802
var g_alive = 1

def get_d_param(path):
    var dpos = str_index_of(path, "d=")
    if (dpos < 0): return -1 end
    var dst = str_substring(path, dpos + 2, 60000)
    var dq = str_index_of(dst, " ")
    if (dq < 0): dq = str_index_of(dst, "&") end
    if (dq < 0): dq = str_len(dst) end
    var dval = str_substring(dst, 0, dq)
    return str_to_int(dval)
end

# ---- 小趣QSM 智能体对话(关键词匹配, 三语言) ----
def chat_reply(msg):
    var mlen = str_len(msg)
    if (mlen <= 0):
        return "你好！我是小趣QSM，QEntL量子操作系统的智能助手。"
    end
    if (str_index_of(msg, "识别") >= 0):
        var zpos = str_index_of(msg, "识别")
        var rest = str_substring(msg, zpos + 2, 100)
        var nlen = str_len(rest)
        var d = 0
        var i = 0
        while (i < nlen):
            var cc = ord(str_char_at(rest, i))
            if (cc >= 48 && cc <= 57):
                d = d * 10 + cc - 48
            end
            i = i + 1
        end
        if (d >= 0 && d <= 4119):
            var cmd = str_concat("bash build/yi_infer_v4.sh ", int_to_str(d))
            var r = exec(cmd)
            return str_concat("QSCL权重识别字", str_concat(int_to_str(d), str_concat("结果=", r)))
        end
        return "格式错误。请发识别加d值，如识别1234（d=0..4119）"
    end
    if (str_index_of(msg, "U+") >= 0):
        var upos = str_index_of(msg, "U+")
        var hexs = str_substring(msg, upos + 2, 100)
        var hlen = str_len(hexs)
        var cp = 0
        var j = 0
        while (j < hlen):
            var cc2 = ord(str_char_at(hexs, j))
            var v = 0
            if (cc2 >= 48 && cc2 <= 57): v = cc2 - 48 end
            if (cc2 >= 97 && cc2 <= 102): v = cc2 - 97 + 10 end
            if (cc2 >= 65 && cc2 <= 70): v = cc2 - 65 + 10 end
            cp = cp * 16 + v
            j = j + 1
        end
        var cmd0 = str_concat("bash build/yi_recog_cp_v4.sh ", int_to_str(cp))
        var r0 = exec(cmd0)
        return r0
    end
    var yi = 0
    var yi_cp = 0
    var k = 0
    while (k < mlen):
        var ch = str_char_at(msg, k)
        var cval = ord(ch)
        if (cval > 63000): yi = 1 end
        if (yi == 1): yi_cp = cval end
        k = k + 1
    end
    if (yi == 1):
        var cmd1 = str_concat("bash build/yi_recog_cp_v4.sh ", int_to_str(yi_cp))
        var r = exec(cmd1)
        return r
    end
    if (str_index_of(msg, "hi") >= 0):
        return "Hello! I am XiaoQu QSM, your QEntL quantum OS assistant."
    end
    if (str_index_of(msg, "hello") >= 0):
        return "Hello! I am XiaoQu QSM. Type in Chinese, English, or Yi."
    end
    if (str_index_of(msg, "你好") >= 0):
        return "你好！我是小趣QSM，QEntL量子操作系统的智能助手。可以用中文、英文或彝文交流。"
    end
    if (str_index_of(msg, "你") >= 0):
        return "你好！我在听。可以问QEntL、量子计算、彝文、字形识别，或随便聊聊。"
    end
    if (str_index_of(msg, "QEntL") >= 0):
        return "QEntL是QNS自举生长的量子编程语言和操作系统，构建链：C 到 QCL 到 QVM 到 QDFS 到 QNS 到 4模型。"
    end
    if (str_index_of(msg, "量子") >= 0):
        return "量子叠加态让我能同时处理多种状态，4态投票推理是当前QSCL模型的推理方式。"
    end
    if (str_index_of(msg, "模型") >= 0):
        return "当前QSCL模型：4120彝文字符 × 8批 × 4叠加态 = 32份权重，识别准确率99%。"
    end
    return "我收到了你的消息。我是小趣QSM，可以聊QEntL、量子计算、彝文，或帮你查询字形识别。"
end

def handle_request(req):
    var resp = ""
    var sp1 = str_index_of(req, " ")
    var method = str_substring(req, 0, sp1)
    var path = "/"
    var sp2 = str_index_of(req, " ")
    if (sp2 >= 0):
        path = str_substring(req, sp2 + 1, 60000)
    end
    if (str_index_of(path, "/api/yi") >= 0):
        if (str_eq(method, "GET")):
            var d = get_d_param(path)
            if (d < 0):
                resp = "{\"error\":\"Usage: GET /api/yi?d=0..4119\"}"
            else:
                if (d > 4119):
                    resp = "{\"error\":\"d range 0..4119\"}"
                else:
                    var cmd = str_concat("bash build/yi_infer_v4.sh ", int_to_str(d))
                    resp = exec(cmd)
                end
            end
        else:
            var bd = str_index_of(req, "\r\n\r\n")
            var body = ""
            if (bd >= 0):
                body = str_substring(req, bd + 4, 10000)
            end
            var reply = chat_reply(body)
            resp = str_concat("{\"role\":\"assistant\",\"text\":\"", str_concat(reply, "\"}"))
        end
    else:
        if (str_index_of(path, "/api/status") >= 0):
            resp = "{\"status\":\"ok\",\"model\":\"qscl\",\"votes\":\"4-state\",\"chat\":\"xiaoqu-qsm\"}"
        else:
            resp = "{\"error\":\"unknown endpoint\"}"
        end
    end
    return resp
end

var sock = tcp_listen(g_port)
printf("[server_v14] listening on port %d\n", g_port)
while (g_alive == 1):
    var cli = tcp_accept(sock)
    if (cli >= 0):
        var req = tcp_recv(cli, 4096)
        var body = handle_request(req)
        var hdr = str_concat("HTTP/1.0 200 OK\r\nContent-Type: application/json\r\nContent-Length: ", str_concat(int_to_str(str_len(body)), "\r\n\r\n"))
        tcp_send(cli, str_concat(hdr, body))
        tcp_close(cli)
    end
end
tcp_shutdown(sock)
tcp_close(sock)