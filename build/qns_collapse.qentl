# qns_collapse.qentl — QSCL坍缩: 直接拼接4个shard
def main():
    printf("QSCL观测坍缩: 合并4态权重\n")
    var model = ""
    var sid = 0
    while (sid < 4):
        var path = str_concat("qdfs/ns/models/qns_shard_", str_concat(int_to_str(sid), ".weights"))
        var content = file_read(path)
        model = str_concat(model, content)
        printf("  读入态%d: %d字节\n", sid, str_len(content))
        sid = sid + 1
    end
    file_write_bytes("qdfs/ns/models/yi_model.weights", model)
    printf("坍缩完成: %d字节 -> yi_model.weights\n", str_len(model))
    return 1
end
main()