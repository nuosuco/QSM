#!/bin/bash
# yi_infer.sh — 单字4态投票推理(shell, 不受QEntL字符串限制)
# 用法: ./yi_infer.sh <char_idx>
# 输出: "OK v0 v1 v2 v3 votes=4"
d=$1
b=$((d/515))
r=$((d%515))
ds=$((r*64+1))
de=$((r*64+64))
p=64
c=515
D=()
mapfile -t D < <(sed -n "${ds},${de}p" qdfs/ns/data/yi_flat_b${b}.bin)
vs=""
for s in 0 1 2 3; do
    W=()
    mapfile -t W < qdfs/ns/models/qscl_b${b}_s${s}.w
    mi=0
    mv=0
    for i in $(seq 0 $((c-1))); do
        lg=0
        ib=$((i*p))
        for j in $(seq 0 $((p-1))); do
            lg=$((lg + ${W[$((ib+j))]} * ${D[$j]}))
        done
        if [ $lg -gt $mv ]; then
            mv=$lg
            mi=$i
        fi
    done
    vs="$vs $mi"
done
# 投票
read v0 v1 v2 v3 <<< "$vs"
# 真多数投票: 找出4态出现最多的标签(中华真叠加态坍缩)
max_votes=0; top=$v0
for cand in $v0 $v1 $v2 $v3; do
    cnt=0
    for v in $v0 $v1 $v2 $v3; do [ "$v" = "$cand" ] && cnt=$((cnt+1)); done
    if [ $cnt -gt $max_votes ]; then max_votes=$cnt; top=$cand; fi
done
# 与真实标签r比对
votes=0
[ "$v0" = "$r" ] && votes=$((votes+1))
[ "$v1" = "$r" ] && votes=$((votes+1))
[ "$v2" = "$r" ] && votes=$((votes+1))
[ "$v3" = "$r" ] && votes=$((votes+1))
if [ $max_votes -ge 2 ] && [ "$top" = "$r" ]; then
    ok="OK"
else
    ok="NO"
fi
printf "%s %d %d %s %s %s %s votes=%d top=%d" "$ok" "$d" "$r" "$v0" "$v1" "$v2" "$v3" "$votes" "$top"