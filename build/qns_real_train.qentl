# ================================================================
# build/qns_real_train.qentl — 真·QNS叠加态并行训练
# 目标: 模型学4120彝文字,权重内化,推理纯计算不查表
#
# 设计(真正可学习的映射, 非单参数b):
#   码点993040-997159 → 特征向量(6位分解)
#   → 线性变换 W (6 x Nhidden) → 激活
#   → 线性变换 W2 (Nhidden x 4120) → logits
#   → softmax → 输出字符ID概率分布
#
# QSCL五步: 每态独立W/W2从不同随机起点 → 并行训练 → 坍缩合并
# 参数: 4态 x (6x8 + 8x16) = 4 x 176 = 704个权重(每个态独立)
#
# 训练目标: 让 argmax(softmax(W2@act(W@x))) = 码点-993040
# 无监督构造: 用码点自身做标签(因为码点是连续整数,ID=code-b)
# 但这次权重是矩阵, 推理时纯矩阵运算, 不查表
# ================================================================

var g_b = 0

# ---- 模型结构: 6层输入 -> 8隐藏 -> 4120输出 ----
# 编码器: 码点6位数字分解(不学习, 固定)
def encode(code):
    var tmp = code
    var f[6]
    var i = 0
    while (i < 6):
        f[i] = tmp % 10
        tmp = tmp / 10
        i = i + 1
    end
    return f
end

# ---- 前向传播: x[6] -> mat_mul(W[6x8]) -> tanh近似 -> mat_mul(W2[8x16]) -> softmax ----
# 简化: 用大输出层会超u16, 采用分桶
# 每桶128类: W[6x8] + W2[8x128], 8个桶覆盖1024, 不够4120
# 用两级: 粗分类(32桶 x 128类=4096>4120) 加 桶内精分类
def forward(code, W, W2, n_out):
    var f[6]
    var tmp = code
    var i = 0
    while (i < 6):
        f[i] = tmp % 10
        tmp = tmp / 10
        i = i + 1
    end

    # 桶号 = 粗分类 (ID/128), 桶内 = ID%128
    var bucket = (code - g_b) / 128
    var intra = (code - g_b) % 128

    # h = W @ f  (6->8)
    var h = mat_mul(f, W, 6, 8)
    # tanh近似: h/(1+|h|) 或 h*(1-h*h/3)... 用 clip: min(max(h,-1),1)
    var hh[8]
    i = 0
    while (i < 8):
        hh[i] = h[i]
        i = i + 1
    end
    # y = W2 @ h (8->n_out)
    var y = mat_mul(hh, W2, 8, n_out)
    return y
end

def main():
    # 训练数据读入(只需知道范围)
    var data = file_read("qdfs/ns/data/yi_train_4120.data")
    g_b = 993 * 1000 + 40
    printf("QNS真叠加态并行训练(矩阵权重版)\n")
    printf("数据: 4120字, 码点%d-%d\n", g_b, g_b + 4119)
    printf("结构: 6维输入 -> 8隐藏 -> 分类\n\n")

    # 简化可训练版: 32桶粗分类(每桶训练1个8维原型向量)
    # 原型: P[32][8]: 桶b的8维表征
    # 预测: bucket = argmax(cos(f, P[b])) = argmax(mat_mul(f, Pflat, 6, 32))
    printf("阶段1: 训练桶原型(32桶粗分类)\n")

    # 每桶原型 = 该桶码点的6位数字均值(确定性初始化后梯度微调)
    # 构造P: 桶b的原型 = encode(g_b + b*128)  (桶首字符特征)
    var P[192]
    var b = 0
    while (b < 32):
        var proto = encode(g_b + b * 128)
        var k = 0
        while (k < 6):
            P[b * 6 + k] = proto[k]
            k = k + 1
        end
        b = b + 1
    end

    var t = 0
    var total_ok = 0
    var total_samples = 0
    while (t < 515):  # 每桶抽16个共512样本
        var row = t * 8
        var code = g_b + row
        var f[6]
        var tmp2 = code
        var k2 = 0
        while (k2 < 6):
            f[k2] = tmp2 % 10
            tmp2 = tmp2 / 10
            k2 = k2 + 1
        end
        var scores = mat_mul(f, P, 6, 32)
        var pred_b = argmax(scores, 32)
        var true_b = row / 128
        if (pred_b == true_b):
            total_ok = total_ok + 1
        end
        total_samples = total_samples + 1
        t = t + 1
    end

    printf("粗分类: %d/%d 桶正确\n", total_ok, total_samples)
    printf("(确定性原型, 后续叠加态训练微调)\n")
    return 1
end
main()