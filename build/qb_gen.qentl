# qb_gen.qentl — QEntL自举生成引擎(纯QEntL, 4态叠加, 无Python)
# 4态点积相加到 g_score[81], 然后温度采样.
# 权重: qdfs/ns/models/qb_w{0-3}.txt 每行=W1或W2的6561空格数字串
var g_steps = 12
var g_W[6561]
var g_W2[6561]
var g_score[81]
var g_rnd = 0
var g_out = ""
var g_p1 = 3
var g_p2 = 13
var g_prev = 3
var g_phase = 0

# 解析空格数字串 到 g_W 或 g_W2 (由 g_phase 选择, 0=W 1=W2)
def parse_w(str):
    var i = 0
    while (i < 6561):
        var sp = str_index_of(str, " ")
        if (sp < 0): break end
        var tok = str_substring(str, 0, sp)
        var val = str_to_int(tok)
        if (g_phase == 0): g_W[i] = val end
        if (g_phase == 1): g_W2[i] = val end
        str = str_substring(str, sp + 1, 60000)
        i = i + 1
    end
end

def load_state(sidx):
    var f1 = "/root/QSM/QLife/qdfs/ns/models/qb_w"
    var f2 = int_to_str(sidx)
    var f3 = ".txt"
    var p1 = str_concat(f1, f2)
    var path = str_concat(p1, f3)
    var raw = file_read(path)
    var nl = str_index_of(raw, "\n")
    var wstr = str_substring(raw, 0, nl)
    var rest = str_substring(raw, nl + 1, 60000)
    g_phase = 0
    parse_w(wstr)
    g_phase = 1
    parse_w(rest)
end

# 对当前(g_W,g_W2)计算点积, 加到 g_score[81] (4态累加)
def accumulate(p1, p2):
    var i = 0
    var s1 = 0
    var s2 = 0
    while (i < 81):
        s1 = g_W[p1 * 81 + i]
        s2 = g_W2[p2 * 81 + i]
        g_score[i] = g_score[i] + s1 + s2
        i = i + 1
    end
end

def clear_score():
    var i = 0
    while (i < 81):
        g_score[i] = 0
        i = i + 1
    end
end

def sample_class(p1, p2, prev):
    clear_score()
    load_state(0)
    accumulate(p1, p2)
    load_state(1)
    accumulate(p1, p2)
    load_state(2)
    accumulate(p1, p2)
    load_state(3)
    accumulate(p1, p2)
    if (prev == 1):
        g_score[1] = g_score[1] - 20
    end
    if (prev == 80):
        g_score[80] = g_score[80] - 20
    end
    var minv = g_score[0]
    var k = 1
    while (k < 81):
        if (g_score[k] < minv): minv = g_score[k] end
        k = k + 1
    end
    var m = 0
    while (m < 81):
        g_score[m] = g_score[m] - minv
        m = m + 1
    end
    var total = 0
    var t = 0
    while (t < 81):
        total = total + g_score[t]
        t = t + 1
    end
    if (total <= 0):
        var best = g_score[0]
        var bi = 0
        var b = 1
        while (b < 81):
            if (g_score[b] > best): best = g_score[b] bi = b end
            b = b + 1
        end
        return bi
    end
    g_rnd = g_rnd + 31337
    g_rnd = (g_rnd * 11035) & 32767
    var target = g_rnd
    if (target < 0): target = -target end
    target = target % total
    var acc = 0
    var a = 0
    var chosen = 0
    while (a < 81):
        acc = acc + g_score[a]
        if (acc > target): chosen = a a = 81 end
        a = a + 1
    end
    return chosen
end

def gen():
    var out = ""
    var p1 = g_p1
    var p2 = g_p2
    var step = 0
    while (step < g_steps):
        var nc = sample_class(p1, p2, g_prev)
        out = str_concat(out, int_to_str(nc))
        out = str_concat(out, " ")
        g_prev = nc
        p1 = p2
        p2 = nc
        if (nc == 1):
            step = g_steps
        end
        if (nc == 80):
            step = g_steps
        end
        step = step + 1
    end
    g_out = out
end

def main():
    var pth = "/root/QSM/QLife/qdfs/ns/models/qb_seed.txt"
    var raw = file_read(pth)
    var sp = str_index_of(raw, " ")
    var a1 = str_to_int(str_substring(raw, 0, sp))
    var a2 = str_to_int(str_substring(raw, sp + 1, 5))
    g_p1 = a1
    g_p2 = a2
    gen()
    var out = str_concat("SEQ=", g_out)
    printf("%s", out)
end
main()
