# ================================================================
# build/yi_qdfs_import.qentl — 彝文知识库全量导入QDFS v1.0
# QDFS量子动态文件系统为核心地基
# 把 data/ 传统文件系统的彝文知识库
# 全量导入 QDFS 命名空间叠加态存储
# ================================================================

var NS_MODELS = "models"
var NS_SYSTEM = "system"
var g_root = "/tmp/qdfs"

def main():
    printf("============================================\n")
    printf("  彝文知识库全量导入QDFS v1.0\n")
    printf("  传统文件系统 → QDFS量子叠加态\n")
    printf("============================================\n")
    
    # 1. 初始化QDFS量子地基(项目内持久目录)
    printf("\n[1] 初始化QDFS量子地基\n")
    var init_ok = qdfs_init("/root/QSM/qdfs")
    printf("  QDFS根目录: /root/QSM/qdfs\n")
    printf("  叠加态/纠缠/命名空间: 就绪\n")
    
    # 2. 读取传统文件系统的彝文知识库
    printf("\n[2] 读取传统彝文知识库\n")
    var kb = file_read("/root/QSM/data/yi_data_simple.txt")
    var klen = str_len(kb)
    printf("  原数据: %d字节\n", klen)
    
    # 3. 逐行解析并导入QDFS
    printf("\n[3] 全量导入QDFS命名空间(models/yi)\n")
    var line_pos = 0
    var total = 0
    var block = 0
    var block_content = ""
    var block_count = 0
    
    while (line_pos < klen):
        var nl = str_index_of(str_substring(kb, line_pos, klen - line_pos), "\n")
        if (nl < 0):
            break
        end
        var line = str_substring(kb, line_pos, nl)
        total = total + 1
        
        # 每行: 码位\t字符\t含义
        var tab1 = str_index_of(line, "\t")
        if (tab1 >= 0):
            var codepoint = str_substring(line, 0, tab1)
            var rest = str_substring(line, tab1 + 1, str_len(line) - tab1 - 1)
            var tab2 = str_index_of(rest, "\t")
            if (tab2 >= 0):
                var yi_char = str_substring(rest, 0, tab2)
                var meaning = str_substring(rest, tab2 + 1, str_len(rest) - tab2 - 1)
                
                # 三路同时写入QDFS (叠加态并行存储)
                var key_char = "yi_char_"
                key_char = str_concat(key_char, int_to_str(total))
                qdfs_ns_write(NS_MODELS, key_char, yi_char)
                
                var key_cp = "yi_cp_"
                key_cp = str_concat(key_cp, int_to_str(total))
                qdfs_ns_write(NS_MODELS, key_cp, codepoint)
                
                var key_me = "yi_mean_"
                key_me = str_concat(key_me, int_to_str(total))
                qdfs_ns_write(NS_MODELS, key_me, meaning)
            end
        end
        
        if (total % 100 == 0):
            printf("  已导入 %d 字符...\n", total)
        end
        line_pos = line_pos + nl + 1
    end
    
    printf("  共导入 %d 个彝文字符\n", total)
    printf("  每字符三路: 字符/码位/含义\n")
    printf("  总计: %d 个QDFS文件\n", total * 3)
    
    # 4. 写入索引
    printf("\n[4] 写入QDFS索引\n")
    var idx = "彝文知识库索引: "
    idx = str_concat(idx, int_to_str(total))
    idx = str_concat(idx, "字符")
    qdfs_ns_write(NS_MODELS, "yi_index", idx)
    printf("  %s\n", idx)
    
    # 4.5 写入完整知识库叠加态文件 (QNS从这里读取全部数据训练)
    printf("\n[4.5] 写入完整知识库到QDFS叠加态\n")
    qdfs_ns_write(NS_MODELS, "yi_full", kb)
    printf("  完整知识库已入QDFS: %d字节\n", klen)
    
    # 5. 验证
    printf("\n[5] 验证QDFS存储\n")
    var t1 = file_read("/root/QSM/qdfs/ns/models/yi_char_1.data")
    var t2 = file_read("/root/QSM/qdfs/ns/models/yi_cp_1.data")
    var t3 = file_read("/root/QSM/qdfs/ns/models/yi_index.data")
    printf("  第1字符: [%s] 码位[%s]\n", t1, t2)
    printf("  索引: [%s]\n", t3)
    var t4 = file_read("/root/QSM/qdfs/ns/models/yi_full_4120.data")
    printf("  完整知识库: %d字节\n", str_len(t4))
    
    printf("\n============================================\n")
    printf("  ✅ 彝文知识库已全量导入QDFS\n")
    printf("  %d字符 × 3路 = %d个量子文件\n", total, total * 3)
    printf("  QDFS量子地基存储: 就绪\n")
    printf("============================================\n")
    return 1
end
main()