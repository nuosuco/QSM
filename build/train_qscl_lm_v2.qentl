# ================================================================
# build/train_qscl_lm_v2.qentl — QSCL-LM 语言生成模型 真·4态叠加态训练(纯QEntL)
# 第四版本 v0.0.4: A(识别)完成后的"想"——自回归预测下一字
#
# 架构(规划文档阶段C, 用已验证收敛的感知机核心):
#   输入: 前缀2字 -> 联合索引 u = p1*81+p2 (6561种, 即one-hot输入维度)
#   输出层: Hout[81][6561]  81类 × 6561输入, 点积argmax=下一字索引
#   训练: 感知机对比式(已验证可收敛到98%): argmax!=目标 -> Hout[目标]+=数据 Hout[预测]-=数据
#   叠加态: 4态独立种子 seed=1/101/202/303 -> qscl_lm_s{0-3}.w (不同起点=真叠加态)
#   文件头: "81 6561\n" 然后 Hout(81x6561=531441整数)
#
# 注: 此版单输出层跑通收敛框架(规划"慢慢升级"), Hin隐含层后续迭代加
#   数据来自 qscl_lm_pairs.txt (每行 "p1 p2 tgt"), 已用awk预生成
# ================================================================

var g_IN = 6561     # 81*81 联合输入空间
var g_V = 81        # 输出81类
var g_WW = 531441   # 81*6561
var g_W[531441]
var g_seed = 1
var g_rnd = 0
var g_state = 0
var g_ep_max = 200
var g_NP = 0
var g_U[30000]       # 联合索引u
var g_TGT[30000]

# 读预生成训练对: 每行 "p1 p2 tgt"
def load_pairs():
    var raw = file_read("/root/QSM/QLife/qdfs/ns/corpus/qscl_lm_pairs.txt")
    var lines = str_split(raw, "\n")
    var n = str_len(lines)
    var li = 0
    var np2 = 0
    while (li < n):
        var line = lines[li]
        var c1 = str_index_of(line, " ")
        if (c1 < 0):
            li = li + 1
            continue
        end
        var p1s = str_substring(line, 0, c1)
        var rest = str_substring(line, c1 + 1, 200)
        var c2 = str_index_of(rest, " ")
        if (c2 < 0):
            li = li + 1
            continue
        end
        var p2s = str_substring(rest, 0, c2)
        var tgs = str_substring(rest, c2 + 1, 200)
        g_U[np2] = str_to_int(p1s) * 81 + str_to_int(p2s)
        g_TGT[np2] = str_to_int(tgs)
        np2 = np2 + 1
        li = li + 1
    end
    g_NP = np2
end

# xorshift风格PRNG(常量全≤65535), 不同seed=不同序列=真叠加态不同起点
def init_weights():
    g_rnd = g_seed
    var i = 0
    while (i < g_WW):
        g_rnd = g_rnd + 31337
        g_rnd = (g_rnd * 11035) & 32767
        g_W[i] = (g_rnd + g_seed) % 10
        i = i + 1
    end
end

def save_w():
    var outp = "qdfs/ns/models/qscl_lm_s" + int_to_str(g_state) + ".w"
    var i = 0
    while (i < g_WW):
        printf("%d\n", g_W[i])
        i = i + 1
    end
    printf("[save] %s done\n", outp)
end

def main():
    var seeds[4] = [1, 101, 202, 303]
    g_seed = seeds[g_state]
    printf("=== QSCL-LM 4态 s=%d seed=%d ===\n", g_state, g_seed)
    printf("  81类 × 6561联合输入\n")
    load_pairs()
    printf("  训练对: %d\n", g_NP)
    init_weights()
    var ep = 0
    while (ep < g_ep_max):
        var ok = 0
        var i = 0
        while (i < g_NP):
            var u = g_U[i]
            var tgt = g_TGT[i]
            var best = 0
            var bi = 0
            var cls = 0
            while (cls < g_V):
                var dot = g_W[cls * g_IN + u]
                if (dot >= best):
                    best = dot
                    bi = cls
                end
                cls = cls + 1
            end
            if (bi == tgt):
                ok = ok + 1
            else:
                g_W[tgt * g_IN + u] = g_W[tgt * g_IN + u] + 1
                g_W[bi * g_IN + u] = g_W[bi * g_IN + u] - 1
            end
            i = i + 1
        end
        var acc = 0
        if (g_NP > 0):
            acc = ok * 100 / g_NP
        end
        if (ep % 20 == 0 or ep == g_ep_max - 1):
            printf("  ep%3d: %d/%d (%d%%)\n", ep, ok, g_NP, acc)
        end
        ep = ep + 1
    end
    save_w()
end
main()