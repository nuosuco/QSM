# qns_train.qentl — QNS真叠加态并行训练 (QSCL v3 定长格式)
# 每态学1030字符, 写入定长12字节行: "ID(4位补零) 码点(6位)\n"
# 训练=内化(码点,ID)映射到权重文件, 推理按位置索引O(1)
var g_sid = 0

def pad4(n):
    var s = int_to_str(n)
    while (str_len(s) < 4):
        s = str_concat("0", s)
    end
    return s
end

def pad6(n):
    var s = int_to_str(n)
    while (str_len(s) < 6):
        s = str_concat("0", s)
    end
    return s
end

def main():
    g_sid = qstate_id()
    var data = file_read("qdfs/ns/data/yi_train_4120.data")
    printf("[态%d] QSCL真叠加态训练启动\n", g_sid)

    var out = ""
    var row = g_sid
    var n = 0
    while (row < 4120):
        var pos = row * 9
        var code = str_to_int(str_substring(data, pos, 6))
        var line = str_concat(pad4(row), str_concat(" ", str_concat(pad6(code), "\n")))
        out = str_concat(out, line)
        row = row + 4
        n = n + 1
    end

    var path = str_concat("qdfs/ns/models/qns_shard_", str_concat(int_to_str(g_sid), ".weights"))
    file_write_bytes(path, out)
    printf("[态%d] 训练完成: %d字符内化 %d字节 -> %s\n", g_sid, n, str_len(out), path)
    return 1
end
main()