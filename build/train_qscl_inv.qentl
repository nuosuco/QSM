# build/train_qscl_inv.qentl — 统一生成核心 反向QSCL(画像素,不分类,4态叠加)
# class index -> 64 pixels. W[81][64]=5184. perceptron
# 4态seed→qscl_inv_s{0-3}.w  头 81
# pairs file: each line class + 64 bits 0/1
var g_V = 81
var g_P = 64
var g_WW = 5184
var g_seed = 1
var g_state = 0
var g_ep_max = 20
var g_NP = 0
var g_CLS[1000]
var g_PX[65535]
var g_rnd = 0
var g_W[5184]

def load_pairs():
    var raw = file_read("/root/QSM/QLife/qdfs/ns/corpus/qscl_inv_pairs.txt")
    var pos = 0
    var n = 0
    var c = 0
    var c2 = 0
    var cn = 0
    var cl = 0
    var cls_s = ""
    var pxs = ""
    while (1 == 1):
        if (pos >= str_len(raw)):
            break
        end
        c = str_index_of(str_substring(raw, pos, 60000), " ")
        if (c < 0):
            break
        end
        cls_s = str_substring(raw, pos, c)
        var cls = str_to_int(cls_s)
        pos = pos + c + 1
        var pxbase = n * g_P
        var k = 0
        while (k < g_P):
            c2 = str_index_of(str_substring(raw, pos, 60000), " ")
            cn = str_index_of(str_substring(raw, pos, 60000), "\n")
            cl = cn
            if (c2 > 0 && cn > 0 && c2 < cn):
                cl = c2
            end
            if (cl < 0):
                cl = str_len(raw) - pos
            end
            pxs = str_substring(raw, pos, cl)
            g_PX[pxbase + k] = str_to_int(pxs)
            pos = pos + cl + 1
            k = k + 1
        end
        g_CLS[n] = cls
        n = n + 1
        if (n >= 1000):
            break
        end
    end
    g_NP = n
end

def rand_init():
    g_rnd = g_seed
    var i = 0
    while (i < g_WW):
        g_rnd = g_rnd + 31337
        g_rnd = (g_rnd * 11035) & 32767
        g_W[i] = (g_rnd + g_seed) % 10 - 5
        i = i + 1
    end
end

def save_w():
    var outp = "qscl_inv_s" + int_to_str(g_state) + ".w"
    printf("%d\n", 81)
    printf("%d\n", 64)
    var i = 0
    while (i < g_WW):
        printf("%d\n", g_W[i])
        i = i + 1
    end
    printf("[save] %s done\n", outp)
end

def main():
    printf("QSCL-INV s=%d seed=%d ep=%d\n", g_state, g_seed, g_ep_max)
    load_pairs()
    printf("pairs=%d\n", g_NP)
    rand_init()
    var ep = 0
    while (ep < g_ep_max):
        var ok = 0
        var i = 0
        while (i < g_NP):
            var cls = g_CLS[i]
            var pxbase = i * g_P
            var base = cls * g_P
            var k = 0
            var right = 1
            while (k < g_P):
                var pred = g_W[base + k]
                var out = 0
                if (pred > 0):
                    out = 1
                end
                var tgt = g_PX[pxbase + k]
                if (out != tgt):
                    right = 0
                    if (tgt == 1):
                        g_W[base + k] = g_W[base + k] + 1
                    end
                    if (tgt == 0):
                        g_W[base + k] = g_W[base + k] - 1
                    end
                end
                k = k + 1
            end
            if (right == 1):
                ok = ok + 1
            end
            i = i + 1
        end
        var acc = 0
        if (g_NP > 0):
            acc = ok * 100 / g_NP
        end
        if (ep % 5 == 0 || ep == g_ep_max - 1):
            printf("ep=%d ok=%d acc=%d\n", ep, ok, acc)
        end
        ep = ep + 1
    end
    save_w()
end
main()

