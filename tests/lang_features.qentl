# 测试2：局部数组
def f_with_local_arr():
    var la[3]
    la[0] = 10
    la[1] = 20
    la[2] = la[0] + la[1]
    return la[2]
end
printf("local_arr=%d\n", f_with_local_arr())

# 测试3：数组存字符串+取回
def str_arr_test():
    var arr[2]
    arr[0] = "abc"
    arr[1] = str_concat(arr[0], "def")
    return str_len(arr[1])
end
printf("str_arr_len=%d\n", str_arr_test())

