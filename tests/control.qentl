# tests/control.qentl — 变量/算术/if/while
var x = 10
var y = 3
printf("x+y=%d\n", x + y)
printf("x-y=%d\n", x - y)
printf("x*y=%d\n", x * y)
printf("x/y=%d\n", x / y)
printf("x%%y=%d\n", x % y)
if (x > y):
    printf("x > y\n")
else:
    printf("x <= y\n")
end
var i = 0
var sum = 0
while (i < 10):
    sum = sum + i
    i = i + 1
end
printf("sum 0..9 = %d\n", sum)
