# Self-hosting QEntL Compiler
# Minimal version - reads input, compiles, writes output

def main():
    var input_file = "input.qentl"
    var output_file = "output.qbc"
    var src = file_read(input_file)
    if str_len(src) == 0:
        printf("Error: cannot read input file %s\n", input_file)
        return
    end
    printf("Input: %d bytes\n", str_len(src))
    
    # Simple tokenizer
    var tokens[4096]
    var types[4096]
    var tcount = 0
    var i = 0
    var slen = str_len(src)
    while i < slen:
        var c = str_sub(src, i, i + 1)
        if c == " ":
            i = i + 1
        else:
            if c == "\t" or c == "\n" or c == "\r":
                i = i + 1
            else:
                if c == "#":
                    while i < slen and str_sub(src, i, i + 1) != "\n":
                        i = i + 1
                    end
                else:
                    if c == '"':
                        var s = ""
                        i = i + 1
                        while i < slen:
                            var cc = str_sub(src, i, i + 1)
                            if cc == '"':
                                i = i + 1
                                break
                            end
                            if cc == "\\":
                                i = i + 1
                                if i < slen:
                                    s = s + str_sub(src, i, i + 1)
                                    i = i + 1
                                end
                            end
                            if cc != '"' and cc != "\\":
                                s = s + cc
                                i = i + 1
                            end
                        end
                        tokens[tcount] = s
                        types[tcount] = "str"
                        tcount = tcount + 1
                    else:
                        if c >= "0" and c <= "9":
                            var n = ""
                            while i < slen and str_sub(src, i, i + 1) >= "0" and str_sub(src, i, i + 1) <= "9":
                                n = n + str_sub(src, i, i + 1)
                                i = i + 1
                            end
                            tokens[tcount] = n
                            types[tcount] = "num"
                            tcount = tcount + 1
                        else:
                            if (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or c == "_":
                                var w = ""
                                while i < slen and ((str_sub(src, i, i + 1) >= "a" and str_sub(src, i, i + 1) <= "z") or (str_sub(src, i, i + 1) >= "A" and str_sub(src, i, i + 1) <= "Z") or (str_sub(src, i, i + 1) >= "0" and str_sub(src, i, i + 1) <= "9") or str_sub(src, i, i + 1) == "_"):
                                    w = w + str_sub(src, i, i + 1)
                                    i = i + 1
                                end
                                tokens[tcount] = w
                                types[tcount] = "id"
                                tcount = tcount + 1
                            else:
                                tokens[tcount] = c
                                types[tcount] = "op"
                                tcount = tcount + 1
                                i = i + 1
                            end
                        end
                    end
                end
            end
        end
    end
    tokens[tcount] = "eof"
    types[tcount] = "eof"
    tcount = tcount + 1
    printf("Tokens: %d\n", tcount)
    
    # Simple compiler - just copies input to output
    var buf[32768]
    var buf_len = 0
    buf[buf_len] = 20
    buf_len = buf_len + 1
    buf[buf_len] = 0
    buf_len = buf_len + 1
    buf[buf_len] = 0
    buf_len = buf_len + 1
    buf[buf_len] = 0
    buf_len = buf_len + 1
    buf[buf_len] = 4
    buf_len = buf_len + 1
    buf[buf_len] = 0
    buf_len = buf_len + 1
    buf[buf_len] = 120
    buf_len = buf_len + 1
    buf[buf_len] = 42
    buf_len = buf_len + 1
    buf[buf_len] = 0
    buf_len = buf_len + 1
    buf[buf_len] = 0
    buf_len = buf_len + 1
    buf[buf_len] = 0
    buf_len = buf_len + 1
    buf[buf_len] = 0
    buf_len = buf_len + 1
    
    var out_str = ""
    i = 0
    while i < buf_len:
        out_str = out_str + chr(buf[i])
        i = i + 1
    end
    file_write_bytes(output_file, out_str)
    printf("Output: %s %d bytes\n", output_file, buf_len)
end