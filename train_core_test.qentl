# 测训练核心：一个样本的 forward(515类内积) + update 的速度
var g_x[1024]
var g_W[64512]   # 64类×1024，先用64类小批测
var g_i = 0
var g_c = 0
var g_idx = 0
var g_score = 0
var g_max = -30000
var g_maxi = 0
var g_label = 0
var g_pred = 0
var g_diff = 0
var g_lr = 100
var g_s = 0

def main():
    printf("=== 训练核心速度测试(64类) ===\n")
    # 初始化权重
    g_i = 0
    while (g_i < 64512):
        g_W[g_i] = (g_i * 1103 + 12345) % 3
        g_i = g_i + 1
    end
    printf("权重初始化完成\n")
    # 加载1个样本
    flat_load("qdfs/ns/data/yi_glyph_4226_32x32_flat.data", g_x, 500, 1024)
    # 测 forward+update 100次
    g_s = 0
    while (g_s < 100):
        # forward: 64类内积
        g_max = -30000
        g_maxi = 0
        g_c = 0
        while (g_c < 64):
            g_score = 0
            g_idx = g_c * 1024
            g_i = 0
            while (g_i < 1024):
                g_score = g_score + g_W[g_idx + g_i] * g_x[g_i]
                g_i = g_i + 1
            end
            if (g_score > g_max):
                g_max = g_score
                g_maxi = g_c
            end
            g_c = g_c + 1
        end
        g_pred = g_maxi
        # update: 增强正确类
        g_idx = g_label * 1024
        g_i = 0
        while (g_i < 1024):
            g_diff = g_x[g_i] - g_W[g_idx + g_i]
            g_W[g_idx + g_i] = g_W[g_idx + g_i] + g_diff * g_lr / 100
            g_i = g_i + 1
        end
        g_s = g_s + 1
    end
    printf("100次 forward+update 完成 pred=%d\n", g_pred)
end

main()