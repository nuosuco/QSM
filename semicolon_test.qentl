# ================================================================
# semicolon_test.qentl — 分号多语句测试
# 验证一行多语句能力
# ================================================================
var a = 1; var b = 2; var c = a + b
printf("一行三语句: a=%d b=%d c=%d\n", a, b, c)

qreg q[2]; h q[0]; cx q[0], q[1]
var m0 = measure q[0]; var m1 = measure q[1]
printf("量子Bell态(分号版): %d%d\n", m0, m1)

var x = 0
while (x < 3): x = x + 1; printf("循环第%d次\n", x); end

printf("分号多语句测试: 通过\n")