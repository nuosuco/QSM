# ================================================================
# 3比特相位翻转码 — 正确实现
# 原理: 在X基下检测Z错误
# 编码: |0>L = |+++>, |1>L = |--- >
# Z错误在X基下等价于X错误
# 测量X基 syndrome 检测相位错误
# ================================================================

printf("=== 3比特相位翻转码测试 ===\n")
printf("原理: X基下测量, Z错误等价于X错误\n\n")

var anc1 = qreg_create(1)
var anc2 = qreg_create(1)
var total = 0
var ok = 0

# 测试3种不同的Z错误位置
var err_pos = 0
while (err_pos <= 2):
    var q = qreg_create(3)
    
    # 编码: |+++> (三个H门)
    apply_h(q, 0)
    apply_h(q, 1)
    apply_h(q, 2)
    
    # 注入Z错误
    apply_z(q, err_pos)
    printf("测试: Z错误在 q%d\n", err_pos)
    
    # 测量X基 syndrome
    # 方法: 对每个量子位应用H, 然后测量计算基 syndrome
    apply_h(q, 0)
    apply_h(q, 1)
    apply_cx(q, 0, anc1, 0)
    apply_cx(q, 1, anc1, 0)
    apply_h(q, 0)
    apply_h(q, 1)
    
    apply_h(q, 1)
    apply_h(q, 2)
    apply_cx(q, 1, anc2, 0)
    apply_cx(q, 2, anc2, 0)
    apply_h(q, 1)
    apply_h(q, 2)
    
    var s1 = measure(anc1, 0)
    var s2 = measure(anc2, 0)
    printf("  Syndrome: s1=%d, s2=%d\n", s1, s2)
    
    # 根据 syndrome 纠错
    # s1=1,s2=0 -> q0错误
    # s1=0,s2=1 -> q2错误  
    # s1=1,s2=1 -> q1错误
    if (s1 == 1 and s2 == 0):
        apply_x(q, 0)
        printf("  纠正: q0\n")
    else:
        if (s1 == 0 and s2 == 1):
            apply_x(q, 2)
            printf("  纠正: q2\n")
        else:
            if (s1 == 1 and s2 == 1):
                apply_x(q, 1)
                printf("  纠正: q1\n")
            end
        end
    end
    
    # 测量验证 (在X基)
    apply_h(q, 0)
    apply_h(q, 1)
    apply_h(q, 2)
    var m0 = measure(q, 0)
    var m1 = measure(q, 1)
    var m2 = measure(q, 2)
    printf("  测量(X基): q0=%d, q1=%d, q2=%d\n", m0, m1, m2)
    
    # 验证: 在X基下，|+> 测得0, |-> 测得1
    # 纠错后所有量子位应该相同
    if (m0 == m1 and m1 == m2):
        printf("  ✓ 纠错成功\n\n")
        ok = ok + 1
    else:
        printf("  ✗ 纠错失败\n\n")
    end
    
    total = total + 1
    err_pos = err_pos + 1
end

# 测试无错误情况
printf("测试: 无错误\n")
var q0 = qreg_create(3)
apply_h(q0, 0)
apply_h(q0, 1)
apply_h(q0, 2)

apply_h(q0, 0)
apply_h(q0, 1)
apply_cx(q0, 0, anc1, 0)
apply_cx(q0, 1, anc1, 0)
apply_h(q0, 0)
apply_h(q0, 1)
apply_h(q0, 1)
apply_h(q0, 2)
apply_cx(q0, 1, anc2, 0)
apply_cx(q0, 2, anc2, 0)
apply_h(q0, 1)
apply_h(q0, 2)

var s1_n = measure(anc1, 0)
var s2_n = measure(anc2, 0)
printf("  Syndrome: s1=%d, s2=%d\n", s1_n, s2_n)

apply_h(q0, 0)
apply_h(q0, 1)
apply_h(q0, 2)
var m0_n = measure(q0, 0)
var m1_n = measure(q0, 1)
var m2_n = measure(q0, 2)
printf("  测量(X基): q0=%d, q1=%d, q2=%d\n", m0_n, m1_n, m2_n)

if (m0_n == m1_n and m1_n == m2_n):
    printf("  ✓ 无错误验证通过\n\n")
    ok = ok + 1
else:
    printf("  ✗ 无错误验证失败\n\n")
end
total = total + 1

printf("=== 结果: %d/%d 通过 ===\n", ok, total)
