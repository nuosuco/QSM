# ================================================================
# examples/phase_flip_code.qentl — 3比特相位翻转码(真量子纠错)
# QEntL全栈v0.2.0能力实战: 防相位错误(经典码无法防)
#
# 原理: 逻辑态 |0>L = |+++>, |1>L = |--->  (X基编码)
#   编码: 先经典复制 |b>->|bbb>, 再对每比特施加H进入X基
#   注错: 对某一比特施加Z(相位翻转噪声)
#   解码: 对每比特施加H回到Z基, 然后多数表决
#   关键: Z|+>=|->, Z|->=|+>, H把相位错误转成比特错误后可纠正
# ================================================================

# 一轮完整实验: 逻辑比特b, 相位错误位置err_pos(-1=无错)
# 返回 1=纠错成功恢复b, 0=失败
def one_round(b, err_pos):
    var r = qreg_create(3)
    # 编码第一步: 经典复制
    if (b == 1):
        x r[0]
    end
    cx r[0], r[1]
    cx r[0], r[2]
    # 编码第二步: 进入X基 (|0>->|+>, |1>->|->)
    h r[0]
    h r[1]
    h r[2]
    # 注错: 单比特相位翻转
    if (err_pos == 0):
        z r[0]
    end
    if (err_pos == 1):
        z r[1]
    end
    if (err_pos == 2):
        z r[2]
    end
    # 解码: 回到Z基 (相位错误->比特错误)
    h r[0]
    h r[1]
    h r[2]
    # 多数表决恢复逻辑比特
    var m0 = measure(r, 0)
    var m1 = measure(r, 1)
    var m2 = measure(r, 2)
    var recovered = 0
    var ones = m0 + m1 + m2
    if (ones >= 2): recovered = 1 end
    qreg_free(r)
    if (recovered == b): return 1 end
    return 0
end

printf("=== 3比特相位翻转码 (真量子纠错) ===\n")
printf("逻辑态: |0>L=|+++>, |1>L=|--->\n")
printf("防相位错误Z, 经典重复码无法防御\n\n")

var total = 0
var ok = 0
var b = 0
while (b <= 1):
    var err = 0 - 1
    while (err <= 2):
        var i = 0
        while (i < 20):
            total = total + 1
            if (one_round(b, err) == 1):
                ok = ok + 1
            end
            i = i + 1
        end
        err = err + 1
    end
    b = b + 1
end

printf("测试矩阵: 2逻辑态 x 4错误位置 x 20轮 = %d 次\n", total)
printf("纠错成功: %d/%d\n", ok, total)

if (ok == total):
    printf("相位翻转码纠错: 通过 (单Z错误全部纠正)\n")
else:
    printf("相位翻转码纠错: 失败 (%d次未纠正)\n", total - ok)
end