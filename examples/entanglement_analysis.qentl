# ================================================================
# 量子乘积态 vs 纠缠态 — 量子关联对比
# 展示经典关联与量子纠缠的本质区别
# ================================================================

printf("=== 量子乘积态 vs 纠缠态 ===\n\n")
printf("乘积态: |ψ>⊗|φ> (可分离)\n")
printf("纠缠态: 不可分离的量子关联\n\n")

# 乘积态: H⊗H |00>
printf("--- 乘积态: H|0>⊗H|0> ---\n")
var prod_same = 0
var prod_diff = 0
var i = 0
while (i < 20):
    var q = qreg_create(2)
    h q[0]
    h q[1]
    var m0 = measure(q, 0)
    var m1 = measure(q, 1)
    if (m0 == m1): prod_same = prod_same + 1 end
    if (m0 != m1): prod_diff = prod_diff + 1 end
    qreg_free(q)
    i = i + 1
end
printf("  相同: %d, 不同: %d (独立随机)\n", prod_same, prod_diff)

# 纠缠态: Bell态
printf("\n--- 纠缠态: |Φ+> = (|00>+|11>)/√2 ---\n")
var ent_same = 0
var ent_diff = 0
i = 0
while (i < 20):
    var q = qreg_create(2)
    h q[0]
    cx q[0], q[1]
    var m0 = measure(q, 0)
    var m1 = measure(q, 1)
    if (m0 == m1): ent_same = ent_same + 1 end
    if (m0 != m1): ent_diff = ent_diff + 1 end
    qreg_free(q)
    i = i + 1
end
printf("  相同: %d, 不同: %d (纠缠关联)\n", ent_same, ent_diff)

# 对比
printf("\n--- 对比 ---\n")
printf("乘积态: 相同≈不同 (50/50 独立)\n")
printf("纠缠态: 相同=100% (量子关联)\n")
printf("量子纠缠: 比经典关联更强 ✅\n")

printf("\n=== 对比完成 ===\n")