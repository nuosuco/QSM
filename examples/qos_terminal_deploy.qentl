# 临时QDFS函数 (内联简化版)
var g_root_qos = ""
var g_meta_qos = ""

def qdfs_init_temp(root):
    g_root_qos = root
    mkdir(root)
    mkdir(str_concat(root, "/branches"))
    var mp = str_concat(root, "/meta")
    if (file_exists(mp) == 0):
        file_write_bytes(mp, "")
    end
    g_meta_qos = file_read(mp)
    return 1
end

def qdfs_write_temp(name, content):
    var path = str_concat(str_concat(str_concat(g_root_qos, "/"), name), ".data")
    file_write_bytes(path, content)
    g_meta_qos = str_concat(g_meta_qos, str_concat(str_concat(str_concat(str_concat(str_concat(name, "|0||-1|"), name), "\n"), " "), ""))
    file_write_bytes(str_concat(g_root_qos, "/meta"), g_meta_qos)
    return 1
end

def qdfs_superpose_temp(name, c0, c1):
    var bd = str_concat(str_concat(str_concat(g_root_qos, "/branches/"), name), "/")
    mkdir(str_concat(str_concat(g_root_qos, "/branches/"), name))
    file_write_bytes(str_concat(bd, "b0"), c0)
    file_write_bytes(str_concat(bd, "b1"), c1)
    g_meta_qos = str_concat(g_meta_qos, str_concat(str_concat(str_concat(str_concat(str_concat(name, "|1||-1|"), name), "\n"), " "), ""))
    file_write_bytes(str_concat(g_root_qos, "/meta"), g_meta_qos)
    return 1
end