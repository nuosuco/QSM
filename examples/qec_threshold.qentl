# ================================================================
# 量子容错阈值分析
# 分析不同量子纠错码的容错阈值
# ================================================================

printf("=== 量子容错阈值分析 ===\n\n")

printf("--- 容错阈值比较 ---\n")
printf("码类型\t\t\t距离\t阈值\t量子比特/逻辑\n")
printf("3比特翻转码\t\t3\t<10%\t\t\t3\n")
printf("5比特纠错码\t\t3\t<1%\t\t\t5\n")
printf("Steane [[7,1,3]]\t\t3\t<0.1%\t\t\t7\n")
printf("Surface码 [[5,1,3]]\t3\t<1%\t\t\t5\n")
printf("Surface码 [[13,1,5]]\t5\t<1.5%\t\t\t13\n")
printf("Shor码 [[9,1,3]]\t\t3\t<0.01%\t\t\t9\n\n")

printf("--- 阈值定理 ---\n")
printf("如果物理错误率 < 阈值, 可进行任意长计算\n")
printf("这是可扩展量子计算的理论基础\n\n")

printf("--- 3比特码阈值计算 ---\n")
printf("物理错误率p, 逻辑错误率p_L\n")
printf("p_L = 3p^2 (2个错误引起错误)\n")
printf("当p < 1/3时, p_L < p (有效纠错)\n\n")
printf("理论阈值: p < 1/3 ≈ 33%\n")
printf("实际阈值: p < 10% (考虑测量误差)\n\n")

printf("--- 表面码阈值 ---\n")
printf("Surface码阈值: ~1% (理论最优)\n")
printf("实际实现: ~0.1-0.5%\n")
printf("10000个Surface码逻辑比特: 需要~10^7物理比特\n\n")

printf("--- QEntL实现验证 ---\n")
printf("  3比特翻转码: 单比特错误纠正3/3\n")
printf("  相位翻转码: 真量子纠错160/160\n")
printf("  Surface码2x2: 稳定子测量\n")
printf("  Steane码: 7比特编码+6稳定子\n\n")

printf("--- 容错设计原则 ---\n")
printf("  1. 容错门: 避免单比特错误传播\n")
printf("  2. 容错测量: 非破坏性综合征测量\n")
printf("  3. 容错初始化: 编码态制备\n")
printf("  4. 容错纠错: 不破坏编码态\n\n")

printf("=== 容错阈值分析完成 ===\n")