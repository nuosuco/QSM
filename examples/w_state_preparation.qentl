# ================================================================
# 量子W态制备 — 另一种纠缠态
# W态: |W> = (|001>+|010>+|100>)/√3
# 不同于GHZ: W态对粒子丢失更鲁棒
# ================================================================

printf("=== 量子W态制备 ===\n\n")
printf("W态: (|001>+|010>+|100>)/√3\n")
printf("GHZ: 全同或全异\n")
printf("W: 恰好一个|1> (纠缠更鲁棒)\n\n")

# 3比特W态制备
# 电路: H→CX→X→CSWAP
# 简化: 用H+CX+Toffoli

printf("--- 3比特W态 ---\n")
var w1 = 0  # |001>
var w2 = 0  # |010>
var w3 = 0  # |100>
var w_other = 0  # 其他

var i = 0
while (i < 30):
    var q = qreg_create(3)
    
    # W态制备: 简化电路
    h q[0]
    cx q[0], q[1]
    x q[0]
    x q[1]
    ccx q[0], q[1], q[2]
    x q[0]
    x q[1]
    
    var m0 = measure(q, 0)
    var m1 = measure(q, 1)
    var m2 = measure(q, 2)
    var sum = m0 + m1 + m2
    
    # W态: 恰好一个|1>
    if (sum == 1):
        if (m2 == 1): w1 = w1 + 1 end
        if (m1 == 1): w2 = w2 + 1 end
        if (m0 == 1): w3 = w3 + 1 end
    else:
        w_other = w_other + 1
    end
    qreg_free(q)
    i = i + 1
end

printf("  |001>: %d/30\n", w1)
printf("  |010>: %d/30\n", w2)
printf("  |100>: %d/30\n", w3)
printf("  其他: %d/30\n", w_other)

var w_total = w1 + w2 + w3
printf("W态比例: %d/%d (%d%%)\n", w_total, 30, w_total * 100 / 30)

printf("\n=== W态制备完成 ===\n")