# ================================================================
# examples/teleport.qentl — 量子隐形传态
# 将量子态|1>从Alice传送到Bob
#
# 关键资源: 2量子位Bell纠缠对 + 2比特经典通信
# Alice测量后, Bob根据经典结果应用纠正门即恢复原态
# ================================================================

qreg q[3]

# q[0] = 要传送的态 |1>
x q[0]

# 制备Bell纠缠对 |Φ+> = (|00>+|11>)/√2
h q[1]
cx q[1], q[2]

# Alice的Bell测量: 将q[0]与q[1]纠缠
cx q[0], q[1]
h q[0]

# Alice测量她的两个qubit
var a0 = measure q[0]
var a1 = measure q[1]

# Bob根据经典通信应用纠正门
cx q[1], q[2]
cz q[0], q[2]

# 测量Bob的qubit: 必须得到|1>
var b = measure q[2]
printf("Teleport: Alice=%d%d Bob=%d\n", a0, a1, b)
if (b == 1):
    printf("隐形传态验证: 通过\n")
else:
    printf("隐形传态验证: 失败\n")
end