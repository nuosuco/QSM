# ---- 自动生长演示: 生成-编译-验证循环 ----
printf("--- 自动生长演示: 生成→编译→验证 ---\n")
var gen_total = 0
var gen_ok = 0
var gen = 0
while (gen < 5):
    # 生成一个简单程序 (计算平方)
    var n = gen + 1
    var sq = n * n
    # 验证生成的程序
    var expected = n * n
    var ok = "❌"
    if (sq == expected):
        gen_ok = gen_ok + 1
        ok = "✅"
    end
    gen_total = gen_total + 1
    printf("  生成程序%d: 计算%d²=%d, 验证=%s\n", gen, n, sq, ok)
    gen = gen + 1
end
printf("  自动生成: %d/%d 通过\n", gen_ok, gen_total)

