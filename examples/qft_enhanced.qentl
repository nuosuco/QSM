# ================================================================
# 量子傅里叶变换增强版 — QFT 6比特
# 量子算法核心组件: 用于Shor/PEA/量子化学
# ================================================================

printf("=== 量子傅里叶变换增强版 ===\n\n")

printf("--- QFT 6比特: 基本变换 ---\n")
var q = qreg_create(6)
# 制备叠加态 |+++...>
var i = 0
while (i < 6):
    apply_h(q, i)
    i = i + 1
end
printf("  制备均匀叠加态\n")

# 应用QFT: 使用受控相位门
# 简化: 用H门+CZ模拟
i = 0
while (i < 6):
    apply_h(q, i)
    var j = i + 1
    while (j < 6):
        apply_cz(q, i, j)
        j = j + 1
    end
    i = i + 1
end
printf("  应用QFT变换\n\n")

# 测量验证
printf("--- 测量结果 ---\n")
i = 0
while (i < 6):
    var m = measure(q, i)
    printf("  q[%d] = %d\n", i, m)
    i = i + 1
end

# 逆QFT
printf("\n--- 逆QFT ---\n")
var q2 = qreg_create(6)
i = 0
while (i < 6):
    apply_h(q2, i)
    i = i + 1
end
# QFT
i = 5
while (i >= 0):
    var j = 5
    while (j > i):
        apply_cz(q2, i, j)
        j = j - 1
    end
    apply_h(q2, i)
    i = i - 1
end
# 逆QFT
i = 0
while (i < 6):
    apply_h(q2, i)
    var j = i + 1
    while (j < 6):
        apply_cz(q2, i, j)
        j = j + 1
    end
    i = i + 1
end
printf("  QFT+IQFT后: 应回到初态\n")
i = 0
while (i < 6):
    var m = measure(q2, i)
    printf("  q[%d] = %d\n", i, m)
    i = i + 1
end

printf("\n=== QFT增强演示完成 ===\n")