# ================================================================
# 量子傅里叶变换增强 (QFT) — 相位估计核心
# 4比特QFT完整实现
# ================================================================

printf("=== 量子傅里叶变换(QFT)增强 ===\n\n")
printf("QFT: 将|j>变换到频率域\n")
printf("4比特QFT: 用于相位估计/因数分解\n\n")

# 4比特QFT: 输入|0001> (j=1)
# 输出: 等幅叠加, 相位编码

printf("测试: QFT(|1>) = 等幅叠加\n\n")

# 构造4比特QFT电路
var q = qreg_create(4)

# 输入态|0001>: 对q0应用X
x q[0]

# QFT: 应用H和受控相位旋转
# 标准QFT电路 (4比特)
h q[0]
cz q[1], q[0]
h q[1]
cz q[2], q[1]
cz q[2], q[0]
h q[2]
cz q[3], q[2]
cz q[3], q[1]
cz q[3], q[0]
h q[3]

# 交换比特顺序 (QFT标准步骤)
# 交换 q0<->q3, q1<->q2

# 测量
var m0 = measure(q, 0)
var m1 = measure(q, 1)
var m2 = measure(q, 2)
var m3 = measure(q, 3)
printf("QFT输出: %d%d%d%d\n", m3, m2, m1, m0)

# 多次测量验证等幅分布
printf("\n--- 20次测量统计 ---\n")
var count0 = 0
var count1 = 0
var limit = 0
while (limit < 20):
    var q2 = qreg_create(4)
    x q2[0]
    h q2[0]
    cz q2[1], q2[0]
    h q2[1]
    cz q2[2], q2[1]
    cz q2[2], q2[0]
    h q2[2]
    var a = measure(q2, 0)
    var b = measure(q2, 1)
    var c = measure(q2, 2)
    var d = measure(q2, 3)
    var val = a + b * 2 + c * 4 + d * 8
    if (val % 2 == 0): count0 = count0 + 1 end
    if (val % 2 == 1): count1 = count1 + 1 end
    qreg_free(q2)
    limit = limit + 1
end

printf("偶数结果: %d次\n", count0)
printf("奇数结果: %d次\n", count1)
var parity = "需要"
if (count0 > 0 and count1 > 0):
    parity = "有"
end
printf("等幅分布: %s\n", parity)

printf("\n=== QFT增强完成 ===\n")