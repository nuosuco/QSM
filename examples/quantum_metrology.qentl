# ================================================================
# 量子计量学 — 量子测量精度超经典极限
# 海森堡极限: 1/N vs 经典1/√N
# ================================================================

printf("=== 量子计量学 ===\n")
printf("量子测量精度: 超越经典极限\n")
printf("经典: 精度 ~ 1/√N (散粒噪声极限)\n")
printf("量子: 精度 ~ 1/N (海森堡极限)\n\n")

# ---- 经典独立测量 ----
printf("--- 经典独立测量 (N比特) ---\n")
printf("N个独立比特: 精度 = 1/√N\n")
var n = 100
var classic_precision = 1000 / n  # 精度 = 1/√N, 用整数表示
printf("N=%d, 经典精度: ~1/√%d = %d/1000\n", n, n, classic_precision)

# 经典测量模拟: 独立比特
var classic_correct = 0
var i = 0
while (i < n):
    qreg c[1]
    h c[0]
    var cm = measure c[0]
    # 期望值: 50% |0⟩, 50% |1⟩
    if (cm == 0):
        classic_correct = classic_correct + 1
    end
    i = i + 1
end
var classic_avg = classic_correct
printf("经典独立测量: %d/100 |0⟩ (偏差~%d%%)\n", classic_avg, 50 - classic_avg)

# ---- 量子纠缠测量 ----
printf("\n--- 量子纠缠测量 (GHZ) ---\n")
printf("N个纠缠比特: 精度 = 1/N\n")
var quantum_precision = 1000 / (n / 10)  # 1/N
printf("N=%d, 量子精度: ~1/%d = %d/1000\n", n/10, n/10, quantum_precision)

# 纠缠测量: GHZ态
var ent_correct = 0
i = 0
while (i < 10):
    qreg g[3]
    h g[0]
    cx g[0], g[1]
    cx g[0], g[2]
    var g0 = measure g[0]
    var g1 = measure g[1]
    var g2 = measure g[2]
    # GHZ纠缠: 全0或全1
    if (g0 == g1 and g1 == g2):
        ent_correct = ent_correct + 1
    end
    i = i + 1
end
printf("纠缠测量: %d/10 GHZ全关联\n", ent_correct)
printf("量子纠缠一致性: %d%%\n", ent_correct * 10)
if (ent_correct >= 5):
    printf("量子纠缠测量: 通过 ✅\n")
else:
    printf("量子纠缠测量: 需要改进\n")
end

# ---- 精度对比 ----
printf("\n--- 精度对比 ---\n")
printf("经典N=100: 精度~1/10=0.100\n")
printf("量子N=100: 精度~1/100=0.010\n")
printf("量子优势: 10倍精度提升\n")
printf("随N增长: 量子优势 = √N倍\n\n")

printf("=== 量子计量学完成 ===\n")