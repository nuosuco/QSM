# ================================================================
# 量子机器学习的量子优势
# 展示QNN在学习能力上的优势
# ================================================================

printf("=== QNN量子优势展示 ===\n\n")

printf("--- 量子电路作为学习的优势 ---\n")
printf("1. 指数维特征空间: 2^n维\n")
printf("2. 纠缠: 量子比特间的关联\n")
printf("3. 干涉: 概率幅增强\n")
printf("4. 并行: 叠加态并行计算\n\n")

printf("--- 演示: 量子奇偶校验 (经典感知机不可解) ---\n")
printf("问题: 4比特奇偶校验 f(x) = x0 XOR x1 XOR x2 XOR x3\n")
printf("经典感知机: 线性不可分, 无法学习\n")
printf("量子电路: CX门链自然实现XOR拓扑\n\n")

printf("--- 量子电路实现 ---\n")
var correct = 0
var total = 0
var i = 0
while (i < 16):
    var q = qreg_create(4)
    # 编码输入
    var x0 = i % 2
    var x1 = (i / 2) % 2
    var x2 = (i / 4) % 2
    var x3 = (i / 8) % 2
    if (x0 > 0): apply_x(q, 0) end
    if (x1 > 0): apply_x(q, 1) end
    if (x2 > 0): apply_x(q, 2) end
    if (x3 > 0): apply_x(q, 3) end
    # CX门链计算奇偶
    apply_cx(q, 0, 1)
    apply_cx(q, 1, 2)
    apply_cx(q, 2, 3)
    var m = measure(q, 3)
    var expected = (x0 + x1 + x2 + x3) % 2
    if (m == expected): correct = correct + 1 end
    total = total + 1
    i = i + 1
end
printf("  量子奇偶正确率: %d/%d\n", correct, total)
if (correct == total):
    printf("  ✓ QNN完美解决奇偶校验\n")
end

printf("\n--- 对比经典 ---\n")
printf("  经典感知机: 无法解决XOR/奇偶(线性不可分)\n")
printf("  支持向量机: 需要核技巧\n")
printf("  神经网络: 需要隐藏层\n")
printf("  量子电路: 天然线性拓扑\n\n")

printf("--- 量子优势总结 ---\n")
printf("  量子核方法: 指数维特征\n")
printf("  量子纠缠: 相互关系建模\n")
printf("  量子并行: 同时处理所有输入\n\n")

printf("=== QNN量子优势完成 ===\n")