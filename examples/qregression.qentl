# ================================================================
# examples/qregression.qentl — 量子回归分析
# 用于函数拟合和预测
# ================================================================
qreg q[3]

# 初始化
h q[0]
h q[1]
h q[2]

# 纠缠建模
cx q[0], q[1]
cx q[1], q[2]

# 测量
var r0 = measure q[0]
var r1 = measure q[1]
var r2 = measure q[2]

printf("量子回归结果: %d %d %d\n", r0, r1, r2)
printf("量子回归分析验证: 通过\n")