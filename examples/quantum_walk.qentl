# ================================================================
# 量子游走 (Quantum Walk) — 离散时间量子游走
# 每次循环释放qreg, 避免QREG_MAX=16溢出
# ================================================================

printf("=== 量子游走 (Quantum Walk) ===\n\n")
printf("离散时间量子游走: 硬币+位置两子系统\n")
printf("位置: 4格环形格子, 硬币: 2维\n\n")

# 量子游走: 每次独立实验, 释放qreg
var pos_hist0 = 0
var pos_hist1 = 0
var pos_hist2 = 0
var pos_hist3 = 0

var step = 0
while (step < 20):
    var q = qreg_create(3)
    
    # 初始化: 硬币翻转
    h q[0]
    
    # 条件移位: 硬币控制位置移动
    cx q[0], q[2]
    ccx q[0], q[2], q[1]
    
    # 一次测量
    var p1 = measure(q, 1)
    var p2 = measure(q, 2)
    
    if (p1 >= 0):
        var pos = p1 * 2 + p2
        if (pos == 0): pos_hist0 = pos_hist0 + 1 end
        if (pos == 1): pos_hist1 = pos_hist1 + 1 end
        if (pos == 2): pos_hist2 = pos_hist2 + 1 end
        if (pos == 3): pos_hist3 = pos_hist3 + 1 end
    end
    
    qreg_free(q)
    step = step + 1
end

printf("20步量子游走分布:\n")
var total = pos_hist0 + pos_hist1 + pos_hist2 + pos_hist3
printf("  位置0: %d次 (%d%%)\n", pos_hist0, pos_hist0 * 100 / total)
printf("  位置1: %d次 (%d%%)\n", pos_hist1, pos_hist1 * 100 / total)
printf("  位置2: %d次 (%d%%)\n", pos_hist2, pos_hist2 * 100 / total)
printf("  位置3: %d次 (%d%%)\n", pos_hist3, pos_hist3 * 100 / total)

printf("\n经典游走: 二项分布, 对称分布\n")
printf("量子游走: 干涉偏斜, 扩散更快\n\n")

# 量子游走搜索: 每次独立实验, 释放qreg
printf("--- 量子游走搜索 ---\n")
printf("在4格中搜索目标位置2:\n")

var hit = 0
var miss = 0
var r = 0
while (r < 20):
    var q2 = qreg_create(3)
    
    # 初始化叠加态
    h q2[1]
    h q2[2]
    
    # 硬币翻转
    h q2[0]
    
    # 条件移位
    cx q2[0], q2[2]
    ccx q2[0], q2[2], q2[1]
    
    # 一次测量
    var p1 = measure(q2, 1)
    var p2 = measure(q2, 2)
    
    if (p1 >= 0):
        var pos = p1 * 2 + p2
        if (pos == 2):
            hit = hit + 1
        else:
            miss = miss + 1
        end
    end
    
    qreg_free(q2)
    r = r + 1
end

printf("  命中位置2: %d/20 (%d%%)\n", hit, hit * 5)
printf("  未命中: %d/20 (%d%%)\n", miss, miss * 5)

printf("\n=== 量子游走演示完成 ===\n")