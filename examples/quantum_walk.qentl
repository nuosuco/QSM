# ================================================================
# 量子行走 (Quantum Walk) — 连续时间版本
# 展示量子随机游走与经典游走的差异
# ================================================================

printf("=== 量子行走 (Quantum Walk) ===\n\n")

printf("--- 原理 ---\n")
printf("经典随机游走: 每一步随机选择方向，扩散速度 ~ sqrt(t)\n")
printf("量子行走: 叠加态演化，扩散速度 ~ t (二次加速)\n\n")

printf("--- 1D 量子行走 (5节点环) ---\n")
# 使用2量子比特表示位置 (0-3)，coin为第4个量子比特
var q = qreg_create(4)
var pos = 0
var coin = 3

# 初始状态: |0001> (位置0, coin=|1>)
apply_x(q, coin)

# 初始化位置叠加态
apply_h(q, 0)
apply_h(q, 1)

# 初始化coin叠加
apply_h(q, coin)

# 量子行走步骤
printf("  步骤1: 叠加态制备完成\n")

# 应用位移算子 (受控移位)
# |coin=0> 左移, |coin=1> 右移
# 简化演示: 展示叠加态演化
apply_cx(q, coin, 0)
apply_cx(q, coin, 1)

printf("  步骤2: 位移操作完成\n")

# 测量位置
var m0 = measure(q, 0)
var m1 = measure(q, 1)
var pos_result = m0 + m1 * 2
printf("  位置测量: %d\n", pos_result)

# 对比经典随机游走
printf("\n--- 经典 vs 量子对比 ---\n")
printf("  经典游走100步后: 位置分布~正态, 标准差~10\n")
printf("  量子游走100步后: 位置分布~双峰, 标准差~100\n")
printf("  量子扩散速度比经典快一个数量级\n")

printf("\n--- 应用场景 ---\n")
printf("  - 图遍历问题: 二次加速\n")
printf("  - 搜索问题: 与Grover等效\n")
printf("  - 量子机器学习: 核方法加速\n")

printf("\n=== 量子行走演示完成 ===\n")