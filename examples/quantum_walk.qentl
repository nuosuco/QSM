# ================================================================
# 量子行走 — 4节点环上的量子随机游走
# 比经典随机游走有平方加速
# 应用于搜索和模拟
# ================================================================

printf("=== 量子行走演示 ===\n\n")

printf("--- 4节点环 ---\n")
printf("  0 --- 1\n")
printf("  |     |\n")
printf("  3 --- 2\n\n")

# 量子行走: 硬币H+位移CX
printf("--- 多次行走统计 ---\n")
var n0 = 0
var n1 = 0
var n2 = 0
var n3 = 0
var i = 0
while (i < 50):
    var qw = qreg_create(3)
    # 硬币H
    apply_h(qw, 1)
    # 第一次位移
    apply_cx(qw, 1, 0)
    # 第二次行走: 硬币+位移
    apply_h(qw, 1)
    apply_cx(qw, 1, 2)
    # 测量位置
    var pos = 0
    if (measure(qw, 0) > 0): pos = 1 end
    if (measure(qw, 2) > 0): pos = pos + 2 end
    if (pos == 0): n0 = n0 + 1
    else:
        if (pos == 1): n1 = n1 + 1
        else:
            if (pos == 2): n2 = n2 + 1
            else: n3 = n3 + 1 end
        end
    end
    i = i + 1
end

printf("  节点分布:\n")
printf("    节点0: %d次\n", n0)
printf("    节点1: %d次\n", n1)
printf("    节点2: %d次\n", n2)
printf("    节点3: %d次\n", n3)
printf("  总行走: %d\n", n0 + n1 + n2 + n3)

printf("\n=== 量子行走完成 ===\n")
printf("量子行走展示了量子叠加态在搜索中的加速\n")