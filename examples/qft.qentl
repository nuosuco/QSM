# ================================================================
# examples/qft.qentl — 量子傅里叶变换(QFT) 3量子位
# Shor算法的核心组件
#
# 验证方法: 准备|101>, QFT, 逆QFT, 测量 → 必须恒等于|101>
# (QFT ∘ QFT† = I 是量子傅里叶变换正确性的黄金标准)
# ================================================================

qreg q[3]

# 准备初始态 |101> (q0=1, q2=1)
x q[0]
x q[2]

# ---- QFT (3量子位) ----
# h q0, 然后从高位qubit来的受控相位
h q[0]
cphase q[0], q[1], 1
cphase q[0], q[2], 2
h q[1]
cphase q[1], q[2], 1
h q[2]
# 位反转交换 q0 <-> q2 (3个CNOT)
cx q[0], q[2]
cx q[2], q[0]
cx q[0], q[2]

# ---- 逆QFT (门序反转+共轭) ----
cx q[0], q[2]
cx q[2], q[0]
cx q[0], q[2]
h q[2]
icphase q[1], q[2], 1
h q[1]
icphase q[0], q[2], 2
icphase q[0], q[1], 1
h q[0]

# 测量: 必须得到 |101>
var m0 = measure q[0]
var m1 = measure q[1]
var m2 = measure q[2]
printf("QFT|101> -> QFT^-1 -> %d%d%d\n", m0, m1, m2)
if (m0 == 1 and m1 == 0 and m2 == 1):
    printf("QFT往返验证: 通过\n")
else:
    printf("QFT往返验证: 失败!\n")
end
