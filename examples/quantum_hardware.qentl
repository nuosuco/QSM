# ================================================================
# 量子硬件平台综述
# 展示各类量子计算硬件实现方案
# ================================================================

printf("=== 量子硬件平台综述 ===\n\n")

printf("--- 1. 超导量子处理器 ---\n")
printf("  代表: IBM Quantum, Google Sycamore\n")
printf("  比特数: 127+ (IBM Eagle)\n")
printf("  相干时间: 100微秒\n")
printf("  门保真度: 单比特99.9%, 双比特99.5%\n")
printf("  优势: 可扩展性好, 制造工艺成熟\n")
printf("  挑战: 需要极低温环境(10mK)\n\n")

printf("--- 2. 离子阱量子处理器 ---\n")
printf("  代表: IonQ, Quantinuum\n")
printf("  比特数: 30+ ( Quantinuum H2)\n")
printf("  相干时间: 秒级\n")
printf("  门保真度: 单比特99.99%, 双比特99.9%\n")
printf("  优势: 全连接, 高保真度\n")
printf("  挑战: 扩展性受限\n\n")

printf("--- 3. 中性原子量子处理器 ---\n")
printf("  代表: Pasqal, QuEra\n")
printf("  比特数: 256+ (QuEra\n")
printf("  相干时间: 秒级\n")
printf("  优势: 大规模可扩展, 阵列可调\n")
printf("  挑战:  gate速度慢\n\n")

printf("--- 4. 光量子处理器 ---\n")
printf("  代表: Xanadu, PsiQuantum\n")
printf("  比特数: 光子数可变\n")
printf("  优势: 室温运行, 低噪声\n")
printf("  挑战: 确定性双光子门难\n\n")

printf("--- 5. 拓扑量子处理器 ---\n")
printf("  代表: Microsoft (理论)\n")
printf("  原理: 马约拉纳零模\n")
printf("  优势: 本征容错\n")
printf("  挑战: 实验验证困难\n\n")

printf("--- 6. 硅基量子处理器 ---\n")
printf("  代表: Silicon Quantum Computing\n")
printf("  原理: 量子点自旋\n")
printf("  优势: 与CMOS兼容\n")
printf("  挑战: 低温控制\n\n")

printf("=== 量子硬件平台完成 ===\n")