# ================================================================
# QDFS深度建设 — 量子叠加态文件系统综合演示
# 文件叠加态 + 纠缠文件 + 量子搜索（非破坏性）
# ================================================================

# 内联 QDFS 库
var g_root = ""
var g_meta = ""
def meta_field(line, idx):
    var i = 0
    var n = str_len(line)
    var f = 0
    var start = 0
    while (i <= n):
        var issep = 0
        if (i == n):
            issep = 1
        else:
            var ch = str_char_at(line, i)
            if (str_eq(ch, "|")):
                issep = 1
            end
        end
        if (issep == 1):
            if (f == idx):
                return str_substring(line, start, i - start)
            end
            f = f + 1
            start = i + 1
        end
        i = i + 1
    end
    return ""
end
def meta_find(name):
    var s = str_concat("\n", g_meta)
    var key = str_concat(str_concat("\n", name), "|")
    var i = str_index_of(s, key)
    if (i < 0):
        return ""
    end
    var rest = str_substring(s, i + 1, str_len(s) - i - 1)
    var j = str_index_of(rest, "\n")
    if (j < 0):
        return rest
    end
    return str_substring(rest, 0, j)
end
def meta_remove(name):
    var s = str_concat("\n", g_meta)
    var key = str_concat(str_concat("\n", name), "|")
    var i = str_index_of(s, key)
    if (i < 0):
        return 0
    end
    var rest = str_substring(s, i + 1, str_len(s) - i - 1)
    var j = str_index_of(rest, "\n")
    var oldlen = j + 1
    if (j < 0):
        oldlen = str_len(rest)
    end
    g_meta = str_concat(str_substring(g_meta, 0, i), str_substring(g_meta, i + oldlen, str_len(g_meta) - i - oldlen))
    file_write_bytes(str_concat(g_root, "/meta"), g_meta)
    return 1
end
def meta_set(name, state, partner, collapsed, owner):
    meta_remove(name)
    var l1 = str_concat(name, "|")
    var l2 = str_concat(l1, state)
    var l3 = str_concat(l2, "|")
    var l4 = str_concat(l3, partner)
    var l5 = str_concat(l4, "|")
    var l6 = str_concat(l5, collapsed)
    var l7 = str_concat(l6, "|")
    var newline = str_concat(str_concat(l7, owner), "\n")
    g_meta = str_concat(g_meta, newline)
    file_write_bytes(str_concat(g_root, "/meta"), g_meta)
    return 1
end
def meta_set_collapse(name, idx):
    var line = meta_find(name)
    if (str_len(line) == 0):
        return 0
    end
    meta_set(name, meta_field(line, 1), meta_field(line, 2), int_to_str(idx), meta_field(line, 4))
    return 1
end
def qdfs_init(root):
    g_root = root
    mkdir(root)
    mkdir(str_concat(root, "/branches"))
    var mp = str_concat(root, "/meta")
    if (file_exists(mp) == 0):
        file_write_bytes(mp, "")
    end
    g_meta = file_read(mp)
    return 1
end
def qdfs_write(name, content):
    var path = str_concat(str_concat(str_concat(g_root, "/"), name), ".data")
    file_write_bytes(path, content)
    meta_set(name, "0", "", "-1", name)
    return 1
end
def qdfs_superpose(name, c0, c1):
    var bd = str_concat(str_concat(str_concat(g_root, "/branches/"), name), "/")
    mkdir(str_concat(str_concat(g_root, "/branches/"), name))
    file_write_bytes(str_concat(bd, "b0"), c0)
    file_write_bytes(str_concat(bd, "b1"), c1)
    meta_set(name, "1", "", "-1", name)
    return 1
end
def qdfs_entangle(a, b, c0, c1):
    var bd = str_concat(str_concat(str_concat(g_root, "/branches/"), a), "/")
    mkdir(str_concat(str_concat(g_root, "/branches/"), a))
    file_write_bytes(str_concat(bd, "b0"), c0)
    file_write_bytes(str_concat(bd, "b1"), c1)
    meta_set(a, "2", b, "-1", a)
    meta_set(b, "2", a, "-1", a)
    return 1
end
def qdfs_read(name):
    var line = meta_find(name)
    if (str_len(line) == 0):
        return ""
    end
    var state = meta_field(line, 1)
    if (str_eq(state, "0")):
        return file_read(str_concat(str_concat(str_concat(g_root, "/"), name), ".data"))
    end
    var collapsed = str_to_int(meta_field(line, 3))
    if (collapsed < 0):
        collapsed = rand_int(2)
        meta_set_collapse(name, collapsed)
        var partner = meta_field(line, 2)
        if (str_len(partner) > 0):
            meta_set_collapse(partner, collapsed)
        end
    end
    var owner = meta_field(line, 4)
    var bd = str_concat(str_concat(str_concat(g_root, "/branches/"), owner), "/")
    if (collapsed == 0):
        return file_read(str_concat(bd, "b0"))
    end
    return file_read(str_concat(bd, "b1"))
end
def qdfs_info(name):
    var line = meta_find(name)
    if (str_len(line) == 0):
        return str_concat(name, ": 不存在")
    end
    var state = meta_field(line, 1)
    var collapsed = meta_field(line, 3)
    if (str_eq(state, "0")):
        return str_concat(name, ": 经典态")
    end
    if (str_eq(state, "1")):
        if (str_eq(collapsed, "-1")):
            return str_concat(name, ": 叠加态(未观测)")
        end
        return str_concat(str_concat(str_concat(name, ": 叠加态 已坍缩->"), collapsed), "分支")
    end
    var partner = meta_field(line, 2)
    if (str_eq(collapsed, "-1")):
        return str_concat(str_concat(str_concat(name, ": 纠缠<->"), partner), "(未观测)")
    end
    return str_concat(str_concat(str_concat(str_concat(name, ": 纠缠<->"), partner), " 已坍缩->"), collapsed)
end
def qdfs_ls():
    var out = ""
    var s = g_meta
    while (str_len(s) > 0):
        var j = str_index_of(s, "\n")
        var line = s
        var rest = ""
        if (j >= 0):
            line = str_substring(s, 0, j)
            rest = str_substring(s, j + 1, str_len(s) - j - 1)
        end
        if (str_len(line) > 0):
            out = str_concat(str_concat(out, qdfs_info(meta_field(line, 0))), "\n")
        end
        s = rest
    end
    return out
end
def qdfs_delete(name):
    var line = meta_find(name)
    if (str_len(line) == 0):
        return 0
    end
    file_delete(str_concat(str_concat(str_concat(g_root, "/"), name), ".data"))
    var bd = str_concat(str_concat(str_concat(g_root, "/branches/"), name), "/")
    file_delete(str_concat(bd, "b0"))
    file_delete(str_concat(bd, "b1"))
    meta_remove(name)
    return 1
end
def qdfs_search(name, keyword):
    var line = meta_find(name)
    if (str_len(line) == 0):
        return -3
    end
    var state = meta_field(line, 1)
    if (str_eq(state, "0")):
        var content = file_read(str_concat(str_concat(str_concat(g_root, "/"), name), ".data"))
        if (str_index_of(content, keyword) >= 0):
            return 0
        end
        return -1
    end
    var owner = meta_field(line, 4)
    var bd = str_concat(str_concat(str_concat(g_root, "/branches/"), owner), "/")
    var c0 = file_read(str_concat(bd, "b0"))
    var c1 = file_read(str_concat(bd, "b1"))
    var found_b0 = 0
    var found_b1 = 0
    if (str_index_of(c0, keyword) >= 0):
        found_b0 = 1
    end
    if (str_index_of(c1, keyword) >= 0):
        found_b1 = 1
    end
    if (found_b0 == 1 and found_b1 == 1):
        return -2
    end
    if (found_b0 == 1):
        return 0
    end
    if (found_b1 == 1):
        return 1
    end
    return -1
end
def qdfs_search_all(keyword, state_filter):
    var out = ""
    var s = g_meta
    while (str_len(s) > 0):
        var j = str_index_of(s, "\n")
        var line = s
        var rest = ""
        if (j >= 0):
            line = str_substring(s, 0, j)
            rest = str_substring(s, j + 1, str_len(s) - j - 1)
        end
        if (str_len(line) > 0):
            var name = meta_field(line, 0)
            var st = meta_field(line, 1)
            if (str_len(state_filter) == 0 or str_eq(st, state_filter)):
                var r = qdfs_search(name, keyword)
                if (r == -2):
                    out = str_concat(str_concat(str_concat(str_concat(out, name), ":b0|"), name), ":b1\n")
                else:
                    if (r == 0):
                        out = str_concat(str_concat(out, name), ":b0\n")
                    end
                    if (r == 1):
                        out = str_concat(str_concat(out, name), ":b1\n")
                    end
                end
            end
        end
        s = rest
    end
    if (str_len(out) == 0):
        return "未找到匹配"
    end
    return out
end

# ====== QDFS深度建设演示 ======
printf("=== QDFS深度建设 ===\n")
printf("文件叠加态 + 纠缠文件 + 量子搜索(非破坏性)\n\n")

# 1. 初始化
qdfs_init("/tmp/qdfs_demo")
printf("1. 初始化QDFS根目录: /tmp/qdfs_demo\n\n")

# 2. 经典文件
qdfs_write("hello", "Hello QEntL World!")
printf("2. 经典文件: hello = \"Hello QEntL World!\"\n")
printf("   读取: %s\n\n", qdfs_read("hello"))

# 3. 叠加态文件 (两个分支)
qdfs_superpose("data", "黄金价格: 450", "黄金价格: 520")
printf("3. 叠加态文件: data (分支0=\"黄金价格: 450\", 分支1=\"黄金价格: 520\")\n")
printf("   状态: %s\n", qdfs_info("data"))

# 4. 量子搜索 (非破坏性: 不坍缩叠加态)
printf("\n4. 量子搜索 (非破坏性):\n")
var r = qdfs_search("data", "450")
printf("   搜索\"450\"在data中: 分支%d\n", r)
r = qdfs_search("data", "520")
printf("   搜索\"520\"在data中: 分支%d\n", r)
r = qdfs_search("data", "黄金")
printf("   搜索\"黄金\"在data中: 分支%d (两种分支都匹配)\n", r)

# 验证搜索后文件仍处于叠加态(未坍缩)
printf("   搜索后状态: %s ✅ (非破坏性验证)\n", qdfs_info("data"))

# 5. 纠缠文件
qdfs_entangle("x", "y", "纠缠态A", "纠缠态B")
printf("\n5. 纠缠文件: x<->y\n")
printf("   状态: %s\n", qdfs_info("x"))
printf("   状态: %s\n", qdfs_info("y"))

# 6. 全库搜索
printf("\n6. 全库搜索关键词\"黄金\":\n%s\n", qdfs_search_all("黄金", ""))

# 7. 读取叠加态文件(观测→坍缩)
var val = qdfs_read("data")
printf("7. 读取叠加态文件(观测): %s\n", val)
printf("   读取后状态: %s\n", qdfs_info("data"))

# 8. 文件列表
printf("\n8. QDFS文件列表:\n%s\n", qdfs_ls())

printf("=== QDFS深度建设完成 ===\n")