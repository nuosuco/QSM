# ================================================================
# examples/qml_density.qentl — 量子密度矩阵
# 表示量子混合态
# ================================================================

qreg q[3]

# 创建混合态
h q[0]
h q[1]
h q[2]

# 测量
var m0 = measure q[0]
var m1 = measure q[1]
var m2 = measure q[2]

printf("量子密度: %d %d %d\n", m0, m1, m2)

# 验证
if (m0 >= 0 and m1 >= 0 and m2 >= 0):
    printf("量子密度矩阵验证: 通过\n")
else:
    printf("量子密度矩阵验证: 失败\n")
end
