# ================================================================
# examples/grover5.qentl — 5量子位Grover搜索 (32候选)
# 搜索目标 |10101>
#
# 经典: 平均16次, 最坏32次
# Grover: 最优约4次迭代
#
# 核心门: CCCZ(三控制Z)用于预言机和扩散算子
# ================================================================

qreg q[5]

# 初始化: 均匀叠加 |+++++>
h q[0]
h q[1]
h q[2]
h q[3]
h q[4]

var iter = 0
while (iter < 4):
    # ---- 预言机: 标记|10101> ----
    # q[1]=0, q[3]=0, 先X翻转
    x q[1]
    x q[3]
    cccz q[0], q[1], q[2], q[4]
    x q[1]
    x q[3]

    # ---- 扩散算子: 2|00000><00000| - I ----
    h q[0]
    h q[1]
    h q[2]
    h q[3]
    h q[4]
    x q[0]
    x q[1]
    x q[2]
    x q[3]
    x q[4]
    cccz q[0], q[1], q[2], q[4]
    x q[0]
    x q[1]
    x q[2]
    x q[3]
    x q[4]
    h q[0]
    h q[1]
    h q[2]
    h q[3]
    h q[4]

    iter = iter + 1
end

# 测量
var m0 = measure q[0]
var m1 = measure q[1]
var m2 = measure q[2]
var m3 = measure q[3]
var m4 = measure q[4]
printf("Grover5结果: %d%d%d%d%d\n", m0, m1, m2, m3, m4)
if (m0 == 1 and m1 == 0 and m2 == 1 and m3 == 0 and m4 == 1):
    printf("命中目标|10101>\n")
else:
    printf("未命中\n")
end