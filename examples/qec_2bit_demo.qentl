# ================================================================
# 2比特量子纠错演示
# 演示量子纠错的基本原理
# ================================================================

printf("=== 2比特量子纠错演示 ===\n\n")

var anc = qreg_create(1)
var total = 0
var ok = 0

# 测试1: 无错误
printf("--- 测试1: 无错误 ---\n")
var q1 = qreg_create(2)
apply_h(q1, 0)
apply_cx(q1, 0, 1)

apply_cx(q1, 0, anc, 0)
apply_cx(q1, 1, anc, 0)
var s1 = measure(anc, 0)
printf("  Syndrome: %d (期望0)\n", s1)

var m0 = measure(q1, 0)
var m1 = measure(q1, 1)
printf("  测量: q0=%d, q1=%d (期望相同)\n", m0, m1)
if (m0 == m1):
    printf("  ✓ 通过\n\n")
    ok = ok + 1
else:
    printf("  ✗ 失败\n\n")
end
total = total + 1

# 测试2: q0 X错误
printf("--- 测试2: q0 X错误 ---\n")
var q2 = qreg_create(2)
apply_h(q2, 0)
apply_cx(q2, 0, 1)
apply_x(q2, 0)

apply_cx(q2, 0, anc, 0)
apply_cx(q2, 1, anc, 0)
var s2 = measure(anc, 0)
printf("  Syndrome: %d (期望1)\n", s2)

if (s2 == 1):
    apply_x(q2, 0)
    printf("  纠正: 应用 X 到 q0\n")
end

var m0b = measure(q2, 0)
var m1b = measure(q2, 1)
printf("  测量: q0=%d, q1=%d\n", m0b, m1b)
if (m0b == m1b):
    printf("  ✓ 通过\n\n")
    ok = ok + 1
else:
    printf("  ✗ 失败\n\n")
end
total = total + 1

# 测试3: q1 X错误
printf("--- 测试3: q1 X错误 ---\n")
var q3 = qreg_create(2)
apply_h(q3, 0)
apply_cx(q3, 0, 1)
apply_x(q3, 1)

apply_cx(q3, 0, anc, 0)
apply_cx(q3, 1, anc, 0)
var s3 = measure(anc, 0)
printf("  Syndrome: %d (期望1)\n", s3)

if (s3 == 1):
    apply_x(q3, 1)
    printf("  纠正: 应用 X 到 q1\n")
end

var m0c = measure(q3, 0)
var m1c = measure(q3, 1)
printf("  测量: q0=%d, q1=%d\n", m0c, m1c)
if (m0c == m1c):
    printf("  ✓ 通过\n\n")
    ok = ok + 1
else:
    printf("  ✗ 失败\n\n")
end
total = total + 1

# 测试4: 纠缠验证
printf("--- 测试4: 纠缠验证 ---\n")
var q4 = qreg_create(2)
apply_h(q4, 0)
apply_cx(q4, 0, 1)

var same_count = 0
var i = 0
while (i < 10):
    var m0d = measure(q4, 0)
    var m1d = measure(q4, 1)
    if (m0d == m1d):
        same_count = same_count + 1
    end
    apply_h(q4, 0)
    apply_cx(q4, 0, 1)
    i = i + 1
end
printf("  10次测量中 %d 次结果相同\n", same_count)
if (same_count == 10):
    printf("  ✓ 纠缠验证通过\n\n")
    ok = ok + 1
else:
    printf("  ✗ 纠缠验证失败\n\n")
end
total = total + 1

printf("=== 演示完成: %d/%d 通过 ===\n", ok, total)
