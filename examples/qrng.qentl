# ================================================================
# 量子随机数生成器 (QRNG) - 简化版
# 验证量子测量随机性
# ================================================================

printf("=== 量子随机数生成器 (QRNG) ===\n\n")

printf("--- 原理 ---\n")
printf("量子测量本质是随机的，H门创建叠加态后测量产生真随机比特\n")
printf("与经典伪随机数不同，量子随机数是真正不可预测的\n\n")

# 生成单个随机比特
printf("--- 单个随机比特 ---\n")
var q = qreg_create(1)
apply_h(q, 0)
var bit = measure(q, 0)
printf("  随机比特: %d\n", bit)

# 多次测量验证随机性
printf("\n--- 10次测量统计 ---\n")
var ones = 0
var zeros = 0
var i = 0
while (i < 10):
    var q2 = qreg_create(1)
    apply_h(q2, 0)
    var m = measure(q2, 0)
    if (m == 1):
        ones = ones + 1
    else:
        zeros = zeros + 1
    end
    i = i + 1
end
printf("  1的个数: %d, 0的个数: %d\n", ones, zeros)
printf("  比例: 1占%.0f%% (期望50%%)\n", ones * 100 / 10)

# 生成3比特随机数 (0-7)
printf("\n--- 生成3比特随机数 ---\n")
var q3 = qreg_create(3)
var k = 0
while (k < 3):
    apply_h(q3, k)
    k = k + 1
end
var r0 = measure(q3, 0)
var r1 = measure(q3, 1)
var r2 = measure(q3, 2)
var rand3 = r0 + r1 * 2 + r2 * 4
printf("  随机3比特: %d (二进制: %d%d%d)\n", rand3, r2, r1, r0)

# 生成5比特随机数 (0-31)
printf("\n--- 生成5比特随机数 ---\n")
var q5 = qreg_create(5)
k = 0
while (k < 5):
    apply_h(q5, k)
    k = k + 1
end
var b0 = measure(q5, 0)
var b1 = measure(q5, 1)
var b2 = measure(q5, 2)
var b3 = measure(q5, 3)
var b4 = measure(q5, 4)
var rand5 = b0 + b1 * 2 + b2 * 4 + b3 * 8 + b4 * 16
printf("  随机5比特: %d (二进制: %d%d%d%d%d)\n", rand5, b4, b3, b2, b1, b0)

printf("\n=== QRNG演示完成 ===\n")
printf("量子随机数在密码学、蒙特卡洛模拟等领域有重要应用\n")