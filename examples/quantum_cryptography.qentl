printf("=== 量子密码学综述 ===\n\n")

printf("--- 1. 量子密钥分发 (QKD) ---\n")
printf("  a. BB84协议: 最早且最实用的QKD协议\n")
printf("  b. E91协议: 基于纠缠的QKD\n")
printf("  c. B92协议: 简化版BB84\n")
printf("  d. 优势: 理论无条件安全 (物理定律保证)\n\n")

printf("--- 2. 量子安全直接通信 (QSDC) ---\n")
printf("  a. 直接传输信息而非密钥\n")
printf("  b. 更高效的信息传输\n")
printf("  c. 基于纠缠的通信\n\n")

printf("--- 3. 量子数字签名 ---\n")
printf("  a. 不可伪造性\n")
printf("  b. 不可抵赖性\n")
printf("  c. 可验证性\n\n")

printf("--- 4. 后量子密码学 ---\n")
printf("  a. 格基密码 (Lattice-based)\n")
printf("  b. 编码基密码 (Code-based)\n")
printf("  c. 多变量密码 (Multivariate)\n")
printf("  d. 哈希基密码 (Hash-based)\n\n")

printf("--- 5. 量子随机数生成 (QRNG) ---\n")
printf("  a. 基于测量坍缩的真随机\n")
printf("  b. 不可预测性\n")
printf("  c. 应用于密码学\n")
printf("  d. 演示: H门测量生成随机比特\n\n")

printf("--- 6. 应用案例 ---\n")
printf("  银行: 量子安全金融交易\n")
printf("  政府: 量子安全通信\n")
printf("  军事: 量子加密通信\n")
printf("  能源: 电网安全通信\n\n")

printf("=== 量子密码学完成 ===\n")