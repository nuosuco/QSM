# ================================================================
# 量子化学模拟 — H2分子基态能量
# 2比特H2分子哈密顿量
# 使用变分量子本征值求解器(VQE)
# ================================================================

printf("=== H2分子量子化学模拟 ===\n\n")

printf("--- H2哈密顿量 ---\n")
printf("H = h0 + h1*Z1 + h2*Z0 + h3*Z0Z1 + h4*X0X1\n")
printf("系数: h0=0.2252, h1=0.3435, h2=0.3435, h3=0.0897, h4=0.1456\n\n")

# 变分拟设: ansatz(t) = e^{-i*t*XX} |00>
# 测量: <H> = sum h_i * <O_i>
printf("--- 变分搜索 ---\n")
var best_energy = 100
var best_t = 0
var t = 0
while (t <= 3141):
    var q = qreg_create(2)
    # 拟设: RY(t) + CX
    apply_ry(q, 0, t)
    apply_ry(q, 1, t)
    apply_cx(q, 0, 1)
    # 测量Z0, Z1, Z0Z1
    var z0 = measure(q, 0)
    var z1 = measure(q, 1)
    if (z0 == 0): z0 = 1 else: z0 = -1 end
    if (z1 == 0): z1 = 1 else: z1 = -1 end
    var z0z1 = z0 * z1
    # 重新制备并测量X0X1
    var q2 = qreg_create(2)
    apply_ry(q2, 0, t)
    apply_ry(q2, 1, t)
    apply_cx(q2, 0, 1)
    apply_h(q2, 0)
    apply_h(q2, 1)
    var x0 = measure(q2, 0)
    var x1 = measure(q2, 1)
    if (x0 == 0): x0 = 1 else: x0 = -1 end
    if (x1 == 0): x1 = 1 else: x1 = -1 end
    var x0x1 = x0 * x1
    # 能量计算 (毫哈特里, 不缩放)
    var energy = 2252 + 3435*z0 + 3435*z1 + 897*z0z1 + 1456*x0x1
    if (energy < best_energy):
        best_energy = energy
        best_t = t
        printf("  新最优: t=%d, E=%d mHa\n", t, energy)
    end
    t = t + 500
end

printf("\n--- 结果 ---\n")
printf("  最优参数: t=%d\n", best_t)
printf("  基态能量: E=%d mHa\n", best_energy)
printf("  理论值: -860 mHa\n")

if (best_energy < -800):
    printf("  ✓ H2分子基态接近理论值!\n")
else:
    printf("  需更多迭代或更优拟设\n")
end

printf("\n=== H2分子模拟完成 ===\n")
printf("这是量子化学在NISQ设备上的重要应用\n")