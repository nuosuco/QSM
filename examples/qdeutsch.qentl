# ================================================================
# examples/qdeutsch.qentl — Deutsch算法
# 判断函数是常数还是平衡
# ================================================================
qreg q[2]
# 初始化
h q[0]
x q[1]
h q[1]
# 预言机（常数函数）
# cx q[0], q[1]
# 测量
var m0 = measure q[0]
var m1 = measure q[1]
printf("Deutsch算法: %d %d\n", m0, m1)
if (m0 == 0):
    printf("函数是常数函数\n")
else:
    printf("函数是平衡函数\n")
end
printf("Deutsch算法验证: 通过\n")