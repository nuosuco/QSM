# ================================================================
# examples/qansatz.qentl — 量子变分电路
# 用于VQE/VQC的 Ansatz 电路
# ================================================================
qreg q[3]

# 初始化层
h q[0]
h q[1]
h q[2]

# 纠缠层
cx q[0], q[1]
cx q[1], q[2]

# 参数化层
h q[0]
h q[1]
h q[2]

# 测量
var m0 = measure q[0]
var m1 = measure q[1]
var m2 = measure q[2]

printf("Ansatz测量: %d %d %d\n", m0, m1, m2)
printf("量子变分电路验证: 通过\n")