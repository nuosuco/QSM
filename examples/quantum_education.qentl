# ================================================================
# 量子计算教育演示
# 面向初学者的量子计算入门
# ================================================================

printf("=== 量子计算教育演示 ===\n\n")

printf("--- 第1讲: 量子比特基础 ---\n")
printf("  经典比特: 0或1\n")
printf("  量子比特: a|0> + b|1>, |a|^2 + |b|^2 = 1\n")
printf("  叠加态: 同时处于0和1的叠加\n\n")

printf("--- 第2讲: 量子门 ---\n")
printf("  Hadamard门 (H):\n")
printf("    H|0> = (|0> + |1>)/sqrt(2)\n")
printf("    H|1> = (|0> - |1>)/sqrt(2)\n\n")

printf("--- 第3讲: 量子纠缠 ---\n")
printf("  Bell态: |Phi+> = (|00> + |11>)/sqrt(2)\n")
printf("  特点: 两个粒子状态完全相关\n")
printf("  测量一个立即影响另一个\n\n")

printf("--- 第4讲: 量子算法 ---\n")
printf("  Grover搜索: O(sqrt(N)) vs 经典O(N)\n")
printf("  Shor算法: 指数级加速因子分解\n")
printf("  QFT: 量子傅里叶变换核心\n\n")

printf("--- 第5讲: 量子纠错 ---\n")
printf("  问题: 量子态脆弱，易受噪声影响\n")
printf("  方案: 编码+综合征测量+纠正\n")
printf("  3比特码: 编码|0>L=|000>, |1>L=|111>\n\n")

printf("--- 动手实验 ---\n")
printf("  运行以下示例:\n")
printf("    bell_state: 制备Bell态\n")
printf("    grover_search: Grover搜索\n")
printf("    teleport: 隐形传态\n")
printf("    qec: 量子纠错\n\n")

printf("=== 教育演示完成 ===\n")