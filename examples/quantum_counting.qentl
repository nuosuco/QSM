# ================================================================
# 量子计数算法 — Grover+QFT结合
# 估计解的个数 (量子加速)
# ================================================================

printf("=== 量子计数算法 ===\n\n")
printf("原理: 结合Grover迭代+QFT估计目标个数\n")
printf("经典: 需逐个检查所有元素\n")
printf("量子: 只需O(√N)次查询\n\n")

# 量子计数: 4元素数据库, 估计解个数
# 有2个解 (目标2,3)
# 通过Grover迭代次数估计解比例

printf("数据库: 4元素, 2个解 (元素2,3)\n\n")

# 方法: 测量Grover迭代后的概率分布
# 解比例 ≈ 测量命中率

var hit = 0
var total = 0
var r = 0
while (r < 20):
    total = total + 1
    var q = qreg_create(3)
    
    # 初始化叠加
    h q[0]
    h q[1]
    
    # Oracle: 标记元素2和3
    cz q[0], q[1]
    
    # 扩散
    h q[0]
    h q[1]
    x q[0]
    x q[1]
    cz q[0], q[1]
    x q[0]
    x q[1]
    h q[0]
    h q[1]
    
    # 测量
    var m0 = measure(q, 0)
    var m1 = measure(q, 1)
    var val = m0 + m1 * 2
    if (val == 2 or val == 3):
        hit = hit + 1
    end
    qreg_free(q)
    r = r + 1
end

printf("测量命中解: %d/20\n", hit)
printf("估计解比例: %d%%\n", hit * 100 / 20)
printf("实际解比例: 50% (2/4)\n")

# 估计解的个数
var est = hit * 4 / 20
printf("估计解个数: %d (实际2)\n", est)

printf("\n=== 量子计数完成 ===\n")