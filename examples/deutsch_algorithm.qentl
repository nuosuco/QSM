# ================================================================
# 量子Deutsch算法 — 量子优势的最小演示
# 判断函数是常数还是平衡, 只需1次查询
# ================================================================

printf("=== 量子Deutsch算法 ===\n\n")
printf("经典: 需要2次查询\n")
printf("量子: 只需1次查询\n\n")

# Deutsch算法: 判断f(x)是常数还是平衡
# 输入: 2比特 (x + 工作比特)
# 4种可能函数: f0=0(常数), f1=x(平衡), f2=NOT x(平衡), f3=1(常数)

# 量子电路: |0>|1> → H⊗H → Uf → H → 测量q0
# 结果: 0=常数, 1=平衡

var deutsch_ok = 0
var deutsch_total = 0

# 测试4种函数
var f = 0
while (f < 4):
    var r = 0
    while (r < 10):
        deutsch_total = deutsch_total + 1
        var q = qreg_create(2)
        
        # 初始化: |0>|1>
        x q[1]
        
        # 叠加态
        h q[0]
        h q[1]
        
        # Oracle Uf (根据f类型)
        if (f == 0):
            # f(x)=0: 恒等变换 (常数)
            pass
        end
        if (f == 1):
            # f(x)=x: CNOT q[0]->q[1] (平衡)
            cx q[0], q[1]
        end
        if (f == 2):
            # f(x)=NOT x: CNOT后X (平衡)
            cx q[0], q[1]
            x q[1]
        end
        if (f == 3):
            # f(x)=1: X q[1] (常数)
            x q[1]
        end
        
        # 干涉
        h q[0]
        
        # 测量q0
        var m = measure(q, 0)
        
        # 结果: 0=常数(f=0或3), 1=平衡(f=1或2)
        var expected = 0
        if (f == 1 or f == 2): expected = 1 end
        
        if (m == expected):
            deutsch_ok = deutsch_ok + 1
        end
        qreg_free(q)
        r = r + 1
    end
    f = f + 1
end

printf("Deutsch算法: %d/%d 正确\n", deutsch_ok, deutsch_total)
if (deutsch_ok == deutsch_total):
    printf("Deutsch算法: 通过 ✅ (量子优势: 1次查询)\n")
else:
    printf("Deutsch算法: 部分错误\n")
end

printf("\n=== Deutsch算法完成 ===\n")