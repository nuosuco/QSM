# ================================================================
# 量子优化算法综述
# 展示QAOA、VQE等变分量子算法
# ================================================================

printf("=== 量子优化算法综述 ===\n\n")

printf("--- 1. QAOA (量子近似优化算法) ---\n")
printf("  应用: MaxCut、图划分、组合优化\n")
printf("  原理: 交替应用成本哈密顿量和混合哈密顿量\n")
printf("  优势: 深度浅，适合NISQ设备\n")
printf("  演示: MaxCut 4节点 3/3最优解\n\n")

printf("--- 2. VQE (变分量子本征求解器) ---\n")
printf("  应用: 量子化学、分子基态能量\n")
printf("  原理: 变分原理 + 经典优化器\n")
printf("  优势: 深度短，噪声鲁棒\n")
printf("  演示: H2分子基态能量-2265mHa\n\n")

printf("--- 3. QAOA增强版 ---\n")
printf("  多参数优化: 层数p增加提升精度\n")
printf("  经典预热: 初始参数选择\n")
printf("  梯度优化: 参数更新策略\n\n")

printf("--- 4. 应用场景 ---\n")
printf("  金融: 投资组合优化\n")
printf("  物流: 车辆路径规划\n")
printf("  药物: 分子对接优化\n")
printf("  AI: 神经网络训练\n\n")

printf("=== 量子优化算法完成 ===\n")