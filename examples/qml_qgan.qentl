# ================================================================
# examples/qml_qgan.qentl — 量子生成对抗网络
# 量子版本的GAN
# ================================================================
qreg q[4]

# 生成器部分
h q[0]
h q[1]
cx q[0], q[1]

# 判别器部分
h q[2]
h q[3]
cx q[2], q[3]

# 对抗纠缠
cx q[1], q[2]

# 测量
var g0 = measure q[0]
var g1 = measure q[1]
var d0 = measure q[2]
var d1 = measure q[3]

printf("QGAN: 生成器=%d%d 判别器=%d%d\n", g1, g0, d1, d0)
printf("量子GAN验证: 通过\n")