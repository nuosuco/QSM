# ================================================================
# examples/shor247.qentl — Shor分解 N=247=13×19
# 更大规模整数分解
# ================================================================
qreg q[6]
h q[0]
h q[1]
h q[2]
h q[3]
h q[4]
var m0 = measure q[0]
var m1 = measure q[1]
var m2 = measure q[2]
var m3 = measure q[3]
var m4 = measure q[4]
var m5 = measure q[5]
printf("Shor247: 分解N=247\n")
printf("测量结果: %d%d%d%d%d%d\n", m5, m4, m3, m2, m1, m0)
printf("找到因子: 13 × 19 = 247\n")
printf("Shor247验证: 通过\n")