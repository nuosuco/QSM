# examples/grover_opt.qentl — Grover搜索优化版
# 最优迭代次数: R ≈ π/4 × √N
# 对于N=16 (4量子位), R ≈ π/4 × 4 ≈ 3次迭代
qreg q[4]
h q[0]
h q[1]
h q[2]
h q[3]
var iter = 0
while (iter < 3):
    # 预言机: 标记|1011>
    x q[1]
    x q[3]
    cccz q[0], q[1], q[2], q[3]
    x q[1]
    x q[3]
    # 扩散算子
    h q[0]
    h q[1]
    h q[2]
    h q[3]
    x q[0]
    x q[1]
    x q[2]
    x q[3]
    cccz q[0], q[1], q[2], q[3]
    x q[0]
    x q[1]
    x q[2]
    x q[3]
    h q[0]
    h q[1]
    h q[2]
    h q[3]
    iter = iter + 1
end
var m0 = measure q[0]
var m1 = measure q[1]
var m2 = measure q[2]
var m3 = measure q[3]
printf("Grover优化结果: %d%d%d%d\n", m0, m1, m2, m3)
if (m0 == 1 and m1 == 0 and m2 == 1 and m3 == 1):
    printf("命中目标|1011>, 迭代次数: 3 (最优)\n")
else:
    printf("未命中\n")
end