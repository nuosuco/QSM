# ================================================================
# examples/qdfs_advanced.qentl — QDFS高级操作演示
# 测试QDFS量子文件系统的完整功能
# ================================================================

# 初始化QDFS，使用/tmp/qdfs作为根目录
qdfs_init("/tmp/qdfs")

# 创建叠加态文件
var f1 = qdfs_write("quantum_data", "版本A")
printf("创建叠加态文件: quantum_data\n")

# 写入多个版本到叠加态文件
qdfs_write("quantum_data", "版本B")
qdfs_write("quantum_data", "版本C")
printf("写入3个版本\n")

# 读取坍缩（随机选择一个版本）
var read1 = qdfs_read("quantum_data")
printf("读取坍缩: %s\n", read1)

# 验证读取结果
if (read1 == "版本A" or read1 == "版本B" or read1 == "版本C"):
    printf("QDFS叠加态读取验证: 通过\n")
else:
    printf("QDFS叠加态读取验证: 失败, 得到: %s\n", read1)
end

# 创建纠缠文件对
qdfs_entangle("entangled_A", "entangled_B", "纠缠态0", "纠缠态1")
printf("创建纠缠文件对: entangled_A ↔ entangled_B\n")

# 读取纠缠文件A
var ent_read = qdfs_read("entangled_A")
printf("纠缠文件A读取: %s\n", ent_read)

# 读取纠缠文件B（应与A同步）
var ent_b = qdfs_read("entangled_B")
printf("纠缠文件B读取: %s\n", ent_b)

# 验证纠缠同步
if (ent_read == ent_b):
    printf("纠缠同步验证: 通过\n")
else:
    printf("纠缠同步验证: 失败\n")
end

# 文件列表
printf("文件列表:\n%s", qdfs_ls())

# 获取文件信息
var info1 = qdfs_info("quantum_data")
printf("%s\n", info1)

var info2 = qdfs_info("entangled_A")
printf("%s\n", info2)

printf("QDFS高级操作演示完成\n")