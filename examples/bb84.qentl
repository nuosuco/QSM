# ================================================================
# examples/bb84.qentl — BB84量子密钥分发协议
#
# BB84协议简化演示:
# 1. Alice制备量子态（随机基+比特）
# 2. Bob用相同基测量
# 3. 验证密钥一致性
#
# 基选择:
# - 基0 (标准基 Z): |0> → 0, |1> → 1
# - 基1 (Hadamard基 X): |+> → 0, |-> → 1
#
# 态制备:
# - 基0, 比特0: |0> (无操作)
# - 基0, 比特1: |1> (x门)
# - 基1, 比特0: |+> (h门)
# - 基1, 比特1: |-> (x then h = h x)
#
# 测量:
# - 基0: 直接测量
# - 基1: h门 + 测量 (逆Hadamard变换)
# ================================================================

qreg q[4]

# Alice发送序列: 比特=1,0,1,1, 基=0,1,0,1
# q[0]: 基0, 比特1 -> |1>
x q[0]

# q[1]: 基1, 比特0 -> |+>
h q[1]

# q[2]: 基0, 比特1 -> |1>
x q[2]

# q[3]: 基1, 比特1 -> |->
h q[3]
x q[3]

# Bob测量（使用相同基）
# 基0的qubit直接测量
var b0 = measure q[0]
var b2 = measure q[2]

# 基1的qubit先逆Hadamard再测量
h q[1]
var b1 = measure q[1]

h q[3]
var b3 = measure q[3]

printf("Alice发送: 1011 (基:0101)\n")
printf("Bob测量: %d%d%d%d\n", b0, b1, b2, b3)

# 验证: 基匹配时比特应一致
if (b0 == 1 and b1 == 0 and b2 == 1 and b3 == 1):
    printf("BB84协议验证: 通过\n")
    printf("共享密钥: 1011\n")
else:
    printf("BB84协议验证: 失败\n")
    printf("期望: 1011, 实际: %d%d%d%d\n", b0, b1, b2, b3)
end