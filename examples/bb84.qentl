# ================================================================
# examples/bb84.qentl — BB84量子密钥分发协议
#
# BB84协议:
# 1. Alice随机选择基和比特, 制备量子态发送
# 2. Bob随机选择基测量
# 3. 公开比较基, 保留相同基的比特作为密钥
# 4. 抽样验证无窃听
#
# 本例演示: Alice发送4比特, Bob测量, 后处理得到密钥
# ================================================================

# Alice的发送端: 准备4个量子比特
qreg q[4]

# Alice随机选择: 基0(标准基)或基1(Hadamard基)
# 本例使用固定模式演示
# 比特序列: 1, 0, 1, 1
# 基序列: 0, 1, 0, 1

# 制备量子态
# q[0]: 比特1, 基0 (标准基) -> |1>
x q[0]

# q[1]: 比特0, 基1 (Hadamard基) -> |->
h q[1]
x q[1]

# q[2]: 比特1, 基0 -> |1>
x q[2]

# q[3]: 比特1, 基1 -> |+>
h q[3]

# Bob的接收端: 随机选择基测量
# 假设Bob选择的基: 0, 1, 0, 1 (与Alice完全一致)
# 测量
var b0 = measure q[0]
var b1 = measure q[1]
var b2 = measure q[2]
var b3 = measure q[3]
printf("Bob测量结果: %d%d%d%d\n", b0, b1, b2, b3)

# 经典后处理: 比对基
# 本例中所有基都匹配
printf("基匹配率: 100%%\n")

# 密钥: 匹配的比特
var key = b0 * 8 + b1 * 4 + b2 * 2 + b3
printf("共享密钥: %d (=%d)\n", key, key)

# 验证: 如果基完全匹配, 比特应该与Alice发送的一致
if (b0 == 1 and b1 == 0 and b2 == 1 and b3 == 1):
    printf("BB84协议验证: 通过\n")
else:
    printf("BB84协议验证: 失败\n")
end