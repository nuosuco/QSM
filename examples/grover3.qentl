# ================================================================
# examples/grover3.qentl — 3量子位Grover搜索 (8候选)
# 搜索目标 |101>
#
# 经典: 平均4次, 最坏8次
# Grover: 2次迭代, 命中率≈94% (最优迭代数≈π/4·√8≈2.2)
#
# 核心门: CCZ(双控制Z)用于预言机和扩散算子
# ================================================================

qreg q[3]

# 初始化: 均匀叠加 |+++>
h q[0]
h q[1]
h q[2]

# ---- 第1次Grover迭代 ----
# 预言机: 标记|101>, 翻转其相位
#   q[1]目标值为0, 先X翻转使其为1, CCZ后翻回
x q[1]
ccz q[0], q[1], q[2]
x q[1]

# 扩散算子: 2|000><000| - I
h q[0]
h q[1]
h q[2]
x q[0]
x q[1]
x q[2]
ccz q[0], q[1], q[2]
x q[0]
x q[1]
x q[2]
h q[0]
h q[1]
h q[2]

# ---- 第2次Grover迭代 ----
x q[1]
ccz q[0], q[1], q[2]
x q[1]

h q[0]
h q[1]
h q[2]
x q[0]
x q[1]
x q[2]
ccz q[0], q[1], q[2]
x q[0]
x q[1]
x q[2]
h q[0]
h q[1]
h q[2]

# 测量
var m0 = measure q[0]
var m1 = measure q[1]
var m2 = measure q[2]
printf("Grover3结果: %d%d%d\n", m0, m1, m2)
if (m0 == 1 and m1 == 0 and m2 == 1):
    printf("命中目标|101>\n")
else:
    printf("未命中\n")
end
