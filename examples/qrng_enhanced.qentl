# ================================================================
# 量子随机数生成器(QRNG) — 增强版
# 利用量子叠加态产生真随机数
# 比经典伪随机数生成器更安全
# ================================================================

printf("=== 量子随机数生成器(QRNG)增强版 ===\n\n")
printf("原理: 量子测量本质随机, 产生真随机数\n\n")

# 生成8比特随机数
var bytes[8]
var i = 0
while (i < 8):
    var q = qreg_create(1)
    h q[0]
    var m = measure(q, 0)
    bytes[i] = m
    qreg_free(q)
    i = i + 1
end

printf("8比特随机数: ")
i = 0
while (i < 8):
    printf("%d", bytes[i])
    i = i + 1
end
printf("\n")

# 生成8比特随机数 (重复, 验证独立性)
printf("8比特随机数: ")
i = 0
while (i < 8):
    var q = qreg_create(1)
    h q[0]
    var m = measure(q, 0)
    printf("%d", m)
    qreg_free(q)
    i = i + 1
end
printf("\n")

# 统计检验: 100比特, 计算0/1比例
printf("\n--- 统计检验(100比特) ---\n")
var zeros = 0
var ones = 0
i = 0
while (i < 100):
    var q = qreg_create(1)
    h q[0]
    var m = measure(q, 0)
    if (m == 0): zeros = zeros + 1 end
    if (m == 1): ones = ones + 1 end
    qreg_free(q)
    i = i + 1
end

printf("0: %d次 (%d%%)\n", zeros, zeros)
printf("1: %d次 (%d%%)\n", ones, ones)
if (zeros > 35 and zeros < 65):
    printf("分布均匀: 通过 ✅\n")
else:
    printf("分布偏差: 需检查 ⚠️\n")
end

printf("\n=== QRNG增强版完成 ===\n")