# ================================================================
# Surface码 [[7,1,3]] Steane码演示
# 量子纠错里程碑: 第一个真正实用的量子纠错码
# ================================================================

printf("=== [[7,1,3]] Steane码演示 ===\n")
printf("原理: CSS码, 6个稳定子生成元\n")
printf("X型稳定子: 纠Z错误\n")
printf("Z型稳定子: 纠X错误\n\n")

# 稳定子生成元 (二进制表示)
# X型: 1110100, 1101010, 1011001
# Z型: 1110100, 1101010, 1011001

printf("--- 测试1: 无错误编码验证 ---\n")
var q1 = qreg_create(7)
var anc1 = qreg_create(3)

# 编码: 从 |0000000> 开始，应用编码电路
# 这里简化演示，直接验证稳定子测量
apply_h(q1, 0)
apply_cx(q1, 0, 1)
apply_cx(q1, 0, 2)
apply_cx(q1, 0, 4)

# 测量X型稳定子 (纠Z错误)
# S1 = XXXZIII
apply_h(q1, 0)
apply_h(q1, 1)
apply_h(q1, 2)
apply_cx(q1, 0, anc1, 0)
apply_cx(q1, 1, anc1, 0)
apply_cx(q1, 2, anc1, 0)
apply_cx(q1, 3, anc1, 0)
apply_h(q1, 0)
apply_h(q1, 1)
apply_h(q1, 2)
var s1 = measure(anc1, 0)

# S2 = XZXZXII
apply_h(q1, 0)
apply_h(q1, 2)
apply_h(q1, 4)
apply_cx(q1, 0, anc1, 1)
apply_cx(q1, 2, anc1, 1)
apply_cx(q1, 4, anc1, 1)
apply_h(q1, 0)
apply_h(q1, 2)
apply_h(q1, 4)
var s2 = measure(anc1, 1)

# S3 = XXZZXXI
apply_h(q1, 0)
apply_h(q1, 1)
apply_h(q1, 2)
apply_h(q1, 3)
apply_cx(q1, 0, anc1, 2)
apply_cx(q1, 1, anc1, 2)
apply_cx(q1, 2, anc1, 2)
apply_cx(q1, 3, anc1, 2)
apply_h(q1, 0)
apply_h(q1, 1)
apply_h(q1, 2)
apply_h(q1, 3)
var s3 = measure(anc1, 2)

printf("  X型稳定子: s1=%d, s2=%d, s3=%d (期望 0 0 0)\n", s1, s2, s3)

# 测量Z型稳定子 (纠X错误)
# S4 = ZZZIIII
apply_cx(q1, 0, anc1, 0)
apply_cx(q1, 1, anc1, 0)
apply_cx(q1, 2, anc1, 0)
apply_cx(q1, 3, anc1, 0)
var sz1 = measure(anc1, 0)

# S5 = ZZIZIZI
apply_cx(q1, 0, anc1, 1)
apply_cx(q1, 2, anc1, 1)
apply_cx(q1, 4, anc1, 1)
var sz2 = measure(anc1, 1)

# S6 = ZIZZII
apply_cx(q1, 0, anc1, 2)
apply_cx(q1, 1, anc1, 2)
apply_cx(q1, 3, anc1, 2)
apply_cx(q1, 4, anc1, 2)
var sz3 = measure(anc1, 2)

printf("  Z型稳定子: s1=%d, s2=%d, s3=%d (期望 0 0 0)\n", sz1, sz2, sz3)

if (s1 == 0 and s2 == 0 and s3 == 0 and sz1 == 0 and sz2 == 0 and sz3 == 0):
    printf("  ✓ 稳定子测量通过\n\n")
else:
    printf("  ✗ 稳定子测量失败\n\n")
end

printf("--- 测试2: X错误注入与纠正 ---\n")
var q2 = qreg_create(7)
var anc2 = qreg_create(3)

# 编码
apply_h(q2, 0)
apply_cx(q2, 0, 1)
apply_cx(q2, 0, 2)
apply_cx(q2, 0, 4)

# 注入X错误到 q3
apply_x(q2, 3)
printf("  注入X错误到 q3\n")

# 测量Z型稳定子 (检测X错误)
apply_cx(q2, 0, anc2, 0)
apply_cx(q2, 1, anc2, 0)
apply_cx(q2, 2, anc2, 0)
apply_cx(q2, 3, anc2, 0)
var ex1 = measure(anc2, 0)

apply_cx(q2, 0, anc2, 1)
apply_cx(q2, 2, anc2, 1)
apply_cx(q2, 4, anc2, 1)
var ex2 = measure(anc2, 1)

apply_cx(q2, 0, anc2, 2)
apply_cx(q2, 1, anc2, 2)
apply_cx(q2, 3, anc2, 2)
apply_cx(q2, 4, anc2, 2)
var ex3 = measure(anc2, 2)

printf("  Z型稳定子: s1=%d, s2=%d, s3=%d\n", ex1, ex2, ex3)

# 解码X错误
if (ex1 == 1 and ex2 == 0 and ex3 == 1):
    printf("  定位: q3 X错误\n")
    apply_x(q2, 3)
    printf("  纠正: 应用 X 到 q3\n")
end

printf("  ✓ X错误纠正演示完成\n\n")

printf("--- 测试3: Z错误注入与纠正 ---\n")
var q3 = qreg_create(7)
var anc3 = qreg_create(3)

# 编码
apply_h(q3, 0)
apply_cx(q3, 0, 1)
apply_cx(q3, 0, 2)
apply_cx(q3, 0, 4)

# 注入Z错误到 q1
apply_z(q3, 1)
printf("  注入Z错误到 q1\n")

# 测量X型稳定子 (检测Z错误)
apply_h(q3, 0)
apply_h(q3, 1)
apply_h(q3, 2)
apply_cx(q3, 0, anc3, 0)
apply_cx(q3, 1, anc3, 0)
apply_cx(q3, 2, anc3, 0)
apply_h(q3, 0)
apply_h(q3, 1)
apply_h(q3, 2)
var ez1 = measure(anc3, 0)

apply_h(q3, 0)
apply_h(q3, 2)
apply_h(q3, 4)
apply_cx(q3, 0, anc3, 1)
apply_cx(q3, 2, anc3, 1)
apply_cx(q3, 4, anc3, 1)
apply_h(q3, 0)
apply_h(q3, 2)
apply_h(q3, 4)
var ez2 = measure(anc3, 1)

apply_h(q3, 0)
apply_h(q3, 1)
apply_h(q3, 2)
apply_h(q3, 3)
apply_cx(q3, 0, anc3, 2)
apply_cx(q3, 1, anc3, 2)
apply_cx(q3, 2, anc3, 2)
apply_cx(q3, 3, anc3, 2)
apply_h(q3, 0)
apply_h(q3, 1)
apply_h(q3, 2)
apply_h(q3, 3)
var ez3 = measure(anc3, 2)

printf("  X型稳定子: s1=%d, s2=%d, s3=%d\n", ez1, ez2, ez3)

printf("  ✓ Z错误检测演示完成\n\n")

printf("=== Steane码 [[7,1,3]] 演示完成 ===\n")
printf("该码可以纠正任意单量子位错误\n")
