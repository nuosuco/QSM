# ================================================================
# examples/qoptimization.qentl — 量子优化算法
# 使用Grover搜索最优解 |1011> (3次迭代)
# ================================================================

qreg q[4]

# 初始化叠加态
h q[0]
h q[1]
h q[2]
h q[3]

# Grover迭代 (3次)
# 迭代1
x q[1]
cccz q[0], q[1], q[2], q[3]
x q[1]
h q[0]
h q[1]
h q[2]
h q[3]
x q[0]
x q[1]
x q[2]
x q[3]
cccz q[0], q[1], q[2], q[3]
x q[0]
x q[1]
x q[2]
x q[3]
h q[0]
h q[1]
h q[2]
h q[3]

# 迭代2
x q[1]
cccz q[0], q[1], q[2], q[3]
x q[1]
h q[0]
h q[1]
h q[2]
h q[3]
x q[0]
x q[1]
x q[2]
x q[3]
cccz q[0], q[1], q[2], q[3]
x q[0]
x q[1]
x q[2]
x q[3]
h q[0]
h q[1]
h q[2]
h q[3]

# 迭代3
x q[1]
cccz q[0], q[1], q[2], q[3]
x q[1]
h q[0]
h q[1]
h q[2]
h q[3]
x q[0]
x q[1]
x q[2]
x q[3]
cccz q[0], q[1], q[2], q[3]
x q[0]
x q[1]
x q[2]
x q[3]
h q[0]
h q[1]
h q[2]
h q[3]

# 测量
var r0 = measure q[0]
var r1 = measure q[1]
var r2 = measure q[2]
var r3 = measure q[3]
printf("量子优化结果: %d%d%d%d\n", r0, r1, r2, r3)
if (r0 == 1 and r1 == 0 and r2 == 1 and r3 == 1):
    printf("命中目标|1011>, 迭代次数: 3\n")
else:
    printf("未命中\n")
end