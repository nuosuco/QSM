# ================================================================
# 量子主方程模拟 — 退相干与耗散
# 模拟量子系统与环境的相互作用
# ================================================================

printf("=== 量子主方程模拟 ===\n\n")

printf("--- 原理 ---\n")
printf("Lindblad主方程描述开放量子系统演化:\n")
printf("dρ/dt = -i[H,ρ] + Σγ_i(L_i ρ L_i† - 0.5{L_i†L_i, ρ})\n\n")

printf("--- 简化模拟: 振幅阻尼 (T1弛豫) ---\n")
printf("描述激发态自发辐射: |1> -> |0>\n")
printf("密度矩阵演化:\n")
printf("  ρ_00(t) = ρ_00(0) + (1-e^{-γt})(ρ_11(0)-ρ_00(0))\n")
printf("  ρ_11(t) = e^{-γt}ρ_11(0)\n")
printf("  ρ_01(t) = e^{-γt/2}ρ_01(0)\n\n")

printf("--- 演示: 初始态|1>的演化 ---\n")
# 使用经典概率模拟量子退相干
var p1 = 1.0
var p0 = 0.0
var gamma_t = 0.5
var decay = 1 - exp(-gamma_t)

# 迭代计算
printf("  时间步骤: |1>态概率p1\n")
i = 0
while (i < 10):
    printf("    t=%d: p1=%.3f, p0=%.3f\n", i, p1, p0)
    p1 = p1 * (1 - decay)
    p0 = 1 - p1
    i = i + 1
end

printf("\n--- 相位阻尼 (T2弛豫) ---\n")
printf("描述纯退相位: 非对角元衰减\n")
printf("  ρ_01(t) = e^{-γt/2}ρ_01(0)\n")
printf("  不改变布居数, 只破坏相干性\n\n")

printf("--- 应用 ---\n")
printf("  1. 量子门保真度分析\n")
printf("  2. 量子纠错阈值计算\n")
printf("  3. 最优脉冲序列设计\n")

printf("\n=== 量子主方程模拟完成 ===\n")