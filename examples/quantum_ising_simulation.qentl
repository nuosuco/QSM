# ================================================================
# 量子哈密顿量模拟 — 2比特Ising模型
# 量子模拟的核心应用: 模拟量子系统
# ================================================================

printf("=== 量子哈密顿量模拟 ===\n\n")
printf("系统: 2比特Ising模型\n")
printf("哈密顿量: H = J*Z0*Z1 + h*X0 + h*X1\n\n")

# Ising模型: 2自旋耦合+横向场
# 参数: J=1 (耦合强度), h=0.5 (横向场)
# 基态: 顺磁相 (h>J时所有自旋沿X方向)

printf("参数: J=1, h=0.5\n")
printf("预测基态: 顺磁相 (|++>)\n\n")

# 模拟Ising模型时间演化
# 用Trotter分解: e^{-iHt} ≈ (e^{-iJZ0Z1Δt} e^{-ihX0Δt} e^{-ihX1Δt})^n

printf("--- Trotter时间演化 ---\n")
printf("时间步数: 10, 步长: 0.1\n\n")

# 初始化: |++> (基态)
var q = qreg_create(2)
h q[0]
h q[1]

# 演化: 10步
var step = 0
while (step < 10):
    # 耦合项: e^{-iJZ0Z1Δt} = CZ (J*Δt=π/2, 用CZ)
    cz q[0], q[1]
    
    # 横向场: e^{-ihXΔt} = H * e^{-ihZΔt} * H
    h q[0]
    h q[1]
    # 相位: 用Z门模拟 (h*Δt=π/4)
    # 简化为: 应用Z门
    z q[0]
    z q[1]
    h q[0]
    h q[1]
    
    step = step + 1
end

# 测量
var m0 = measure(q, 0)
var m1 = measure(q, 1)
printf("演化后: q0=%d, q1=%d\n", m0, m1)
var is_gs = "需检查"
if (m0 == m1):
    is_gs = "是"
end
printf("在|++>基态附近: %s\n", is_gs)

# 多次测量统计
printf("\n--- 20次测量统计 ---\n")
var p00 = 0
var p11 = 0
var other = 0
var i = 0
while (i < 20):
    var q2 = qreg_create(2)
    h q2[0]
    h q2[1]
    var s = 0
    while (s < 10):
        cz q2[0], q2[1]
        h q2[0]
        h q2[1]
        z q2[0]
        z q2[1]
        h q2[0]
        h q2[1]
        s = s + 1
    end
    var a = measure(q2, 0)
    var b = measure(q2, 1)
    if (a == 0 and b == 0): p00 = p00 + 1 end
    if (a == 1 and b == 1): p11 = p11 + 1 end
    if (a != b): other = other + 1 end
    qreg_free(q2)
    i = i + 1
end

printf("  |00>: %d次\n", p00)
printf("  |11>: %d次\n", p11)
printf("  其他: %d次\n", other)

printf("\n=== 量子哈密顿量模拟完成 ===\n")