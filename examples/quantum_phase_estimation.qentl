# ================================================================
# 量子相位估计 — Shor算法核心
# 估计U|ψ> = e^{2πiθ}|ψ>中的θ
# ================================================================

printf("=== 量子相位估计(QPE) ===\n\n")
printf("QPE: 估计酉算符U的特征相位\n")
printf("核心: Shor/QFT/量子计数的基础\n\n")

# 简化QPE: 2比特+1目标
# U = T门 (相位=π/4)
# 控制旋转: CU门

printf("估计T门相位: θ = π/4 = 0.25\n\n")

# 控制-T门: 通过相位门实现
# T|1> = e^{iπ/4}|1>
# 相位估计: 测量控制比特

var phase_sum = 0
var r = 0
while (r < 20):
    var q = qreg_create(3)
    
    # 初始化: 控制|+>, 目标|1>
    h q[0]
    h q[1]
    x q[2]
    
    # 控制-U^(2^0) = 控制-T
    # T门: 用相位门模拟
    # 控制-T: 控制q[0]时对q[2]应用相位
    # 简化: 用CX模拟
    cx q[0], q[2]
    
    # 控制-U^(2^1) = 控制-T^2
    # T^2 = S门 (相位π/2)
    cx q[1], q[2]
    
    # 逆QFT (2比特)
    h q[0]
    cz q[1], q[0]
    h q[1]
    
    # 测量相位
    var m0 = measure(q, 0)
    var m1 = measure(q, 1)
    var phase = m0 + m1 * 2
    
    phase_sum = phase_sum + phase
    qreg_free(q)
    r = r + 1
end

var avg_phase = phase_sum / 20
printf("估计相位(×4): %d (期望1)\n", avg_phase)
printf("估计θ: %d/4\n", avg_phase)

printf("\n=== QPE完成 ===\n")