# ================================================================
# examples/qml_classifier.qentl — 量子分类器
# 多分类问题演示
# ================================================================
qreg q[3]

# 编码输入
h q[0]
cx q[0], q[1]
cx q[1], q[2]

# 分类决策边界
h q[0]
h q[1]
h q[2]

# 测量
var c0 = measure q[0]
var c1 = measure q[1]
var c2 = measure q[2]

printf("量子分类: %d %d %d\n", c0, c1, c2)

# 验证
if (c0 >= 0 and c1 >= 0 and c2 >= 0):
    printf("量子分类器验证: 通过\n")
else:
    printf("量子分类器验证: 失败\n")
end