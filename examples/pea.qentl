# ================================================================
# examples/pea.qentl — 量子相位估计 (Phase Estimation)
# Shor算法的核心: 用逆QFT提取酉算子的特征相位
#
# 估计 U = T门 (相位 π/4) 在特征态|1⟩上的特征值 e^(iπ/4)
# 相位 θ = (π/4)/2π = 1/8 = 0.001 (二进制小数)
# 3个计数qubit可精确恢复 001
# ================================================================

qreg q[4]

# 目标qubit q[3] 准备为T门的特征态 |1>
x q[3]

# 3个计数qubit叠加
h q[0]
h q[1]
h q[2]

# 受控U^(2^k):
#   q[0] (MSB, 2^2=4): 受控-T^4 = 受控相位 π   = cphase k=0
#   q[1] (2^1=2):      受控-T^2 = 受控相位 π/2 = cphase k=1
#   q[2] (LSB, 2^0=1): 受控-T   = 受控相位 π/4 = cphase k=2
cphase q[0], q[3], 0
cphase q[1], q[3], 1
cphase q[2], q[3], 2

# 对计数qubit做逆QFT (q[0],q[1],q[2])
cx q[0], q[2]
cx q[2], q[0]
cx q[0], q[2]
h q[2]
icphase q[1], q[2], 1
h q[1]
icphase q[0], q[2], 2
icphase q[0], q[1], 1
h q[0]

# 测量计数qubit: 期望得到 θ = 1/8 = 001
var m0 = measure q[0]
var m1 = measure q[1]
var m2 = measure q[2]
printf("相位估计(T门): %d%d%d\n", m0, m1, m2)
if (m0 == 0 and m1 == 0 and m2 == 1):
    printf("PEA验证: 通过 (θ=1/8)\n")
else:
    printf("PEA验证: 失败\n")
end
