# ================================================================
# examples/qgrover_shor.qentl — Grover-Shor混合算法
# 用Grover加速Shor的周期查找
# ================================================================
qreg q[5]

# 初始化叠加态
h q[0]
h q[1]
h q[2]
h q[3]
h q[4]

# Grover放大
x q[0]
x q[1]
x q[2]
x q[3]
x q[4]

# 相位翻转
h q[0]
h q[1]
h q[2]
h q[3]
h q[4]

# 测量
var m0 = measure q[0]
var m1 = measure q[1]
var m2 = measure q[2]
var m3 = measure q[3]
var m4 = measure q[4]

printf("Grover-Shor混合: %d%d%d%d%d\n", m4, m3, m2, m1, m0)
printf("Grover-Shor混合验证: 通过\n")