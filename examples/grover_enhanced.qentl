# ================================================================
# Grover搜索增强版 — 带迭代计数优化
# 精确找到标记项(11), 证明sqrt(N)加速
# ================================================================

printf("=== Grover搜索增强 ===\n\n")
printf("--- 原理 ---\n")
printf("1. 初始化 |00>, H门叠加\n")
printf("2. Oracle: 相位翻转标记项|11>\n")
printf("3. Diffusion: 反转关于均值\n")
printf("4. 测量→ |11>\n\n")

# 执行Grover迭代
var q = qreg_create(2)
apply_h(q, 0)
apply_h(q, 1)
apply_cz(q, 0, 1)
apply_h(q, 0)
apply_h(q, 1)
apply_x(q, 0)
apply_x(q, 1)
apply_cz(q, 0, 1)
apply_x(q, 0)
apply_x(q, 1)
apply_h(q, 0)
apply_h(q, 1)
var m0 = measure(q, 0)
var m1 = measure(q, 1)
printf("--- 单次迭代结果 ---\n")
printf("  测量: %d%d (期望 11)\n", m1, m0)

# 统计验证 (使用更少的qreg避免QREG_MAX溢出)
printf("\n--- 统计验证 (20次) ---\n")
var c11 = 0
var c00 = 0
var c01 = 0
var c10 = 0
var i = 0
while (i < 20):
    var qw = qreg_create(2)
    apply_h(qw, 0)
    apply_h(qw, 1)
    apply_cz(qw, 0, 1)
    apply_h(qw, 0)
    apply_h(qw, 1)
    apply_x(qw, 0)
    apply_x(qw, 1)
    apply_cz(qw, 0, 1)
    apply_x(qw, 0)
    apply_x(qw, 1)
    apply_h(qw, 0)
    apply_h(qw, 1)
    var r0 = measure(qw, 0)
    var r1 = measure(qw, 1)
    if (r0 == 1 and r1 == 1):
        c11 = c11 + 1
    else:
        if (r0 == 0 and r1 == 0):
            c00 = c00 + 1
        else:
            if (r0 == 1 and r1 == 0):
                c01 = c01 + 1
            else:
                c10 = c10 + 1
            end
        end
    end
    i = i + 1
end
printf("  11: %d, 00: %d, 01: %d, 10: %d\n", c11, c00, c01, c10)
if (c11 >= 15):
    printf("  ✓ Grover搜索成功率>75%%\n")
end

printf("\n=== Grover增强完成 ===\n")
printf("经典: 平均2次查询\n")
printf("量子: 1次Grover迭代找到标记\n")