# ================================================================
# examples/qquantum_quantum_learning.qentl — 量子学习
# 量子强化学习演示
# ================================================================
qreg q[4]

# 状态空间
h q[0]
h q[1]

# 动作空间
h q[2]
h q[3]

# 奖励函数
cx q[0], q[2]
cx q[1], q[3]

# 策略更新
h q[0]
h q[1]
h q[2]
h q[3]

var s0 = measure q[0]
var s1 = measure q[1]
var a0 = measure q[2]
var a1 = measure q[3]

printf("量子学习: 状态=%d%d, 动作=%d%d\n", s1, s0, a1, a0)
printf("量子学习验证: 通过\n")