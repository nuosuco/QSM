# ================================================================
# 量子波动算法演示
# 展示量子态的概率特征
# ================================================================

printf("=== 量子波动与概率 ===\n\n")

printf("--- 原理 ---\n")
printf("量子态描述: 概率幅(复数)而非概率\n")
printf("概率 = |概率幅|^2\n")
printf("干涉: 概率幅相加(可相消或相长)\n\n")

printf("--- 演示: H门概率幅演化 ---\n")
printf("H|0> = (|0> + |1>)/sqrt(2)\n")
printf("测量概率: P(0) = |1/sqrt(2)|^2 = 1/2\n")
printf("         P(1) = |1/sqrt(2)|^2 = 1/2\n\n")

printf("--- 测量统计验证 ---\n")
var ones = 0
var zeros = 0
var i = 0
while (i < 50):
    var q = qreg_create(1)
    apply_h(q, 0)
    var m = measure(q, 0)
    if (m == 1): ones = ones + 1 else: zeros = zeros + 1 end
    i = i + 1
end
printf("  50次测量: 0=%d, 1=%d\n", zeros, ones)
printf("  比例: 0占%.1f%%, 1占%.1f%%\n", zeros * 2, ones * 2)

printf("\n--- 干涉演示 ---\n")
printf("Hadamard干涉仪:\n")
printf("H|0> -> H(|0>+|1>)/sqrt(2) -> |0>\n")
printf("两次H门 = 恒等(相消干涉)\n")
var q2 = qreg_create(1)
apply_h(q2, 0)
apply_h(q2, 1)
# 注意: 这里用两次H在同一比特
var m2 = measure(q2, 0)
apply_h(q2, 0)
apply_h(q2, 0)
var final = measure(q2, 0)
printf("  两次H门后: %d (干扰效应)\n", final)

printf("\n--- 物理意义 ---\n")
printf("  - 量子算法利用干涉增强目标态\n")
printf("  - Grover扩散算子产生干涉\n")
printf("  - 量子纠错利用概率幅保真\n\n")

printf("=== 量子波动演示完成 ===\n")