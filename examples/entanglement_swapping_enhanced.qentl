# ================================================================
# 量子纠缠交换 — 远程纠缠建立
# 量子网络核心: 连接两个独立纠缠对
# ================================================================

printf("=== 量子纠缠交换 ===\n\n")
printf("原理: 连接两个独立Bell对, 建立远程纠缠\n")
printf("Alice: q0-q1 (Bell对1)\n")
printf("Bob: q2-q3 (Bell对2)\n")
printf("对q1,q2做Bell测量, q0和q3建立纠缠\n\n")

# 纠缠交换协议
# 1. 准备两个独立Bell对
# 2. 对q1,q2做Bell测量
# 3. q0和q3建立远程纠缠

var ok = 0
var total = 0
var r = 0
while (r < 20):
    total = total + 1
    var q = qreg_create(4)
    
    # 准备两个Bell对
    h q[0]
    cx q[0], q[1]   # Bell对1: q0-q1
    h q[2]
    cx q[2], q[3]   # Bell对2: q2-q3
    
    # Bell测量: q1和q2
    cx q[1], q[2]
    h q[1]
    var m1 = measure(q, 1)
    var m2 = measure(q, 2)
    
    # 纠正: 根据测量结果恢复q3
    if (m2 == 1):
        x q[3]
    end
    if (m1 == 1):
        z q[3]
    end
    
    # 验证: q0和q3应纠缠
    # 测量q0和q3, 应相同
    var a = measure(q, 0)
    var b = measure(q, 3)
    if (a == b):
        ok = ok + 1
    end
    qreg_free(q)
    r = r + 1
end

printf("纠缠交换后: q0-q3纠缠匹配 %d/20\n", ok)
if (ok >= 10):
    printf("纠缠交换: 通过 ✅ (量子网络核心)\n")
else:
    printf("纠缠交换: 需检查\n")
end

printf("\n=== 纠缠交换完成 ===\n")