# ================================================================
# examples/bench.qentl — QVM性能基准测试
# 大量量子门操作测试QVM执行速度
# ================================================================

qreg q[4]

# 均匀叠加
h q[0]
h q[1]
h q[2]
h q[4]

# 大量Hadamard和CNOT
var i = 0
while (i < 500):
    h q[0]
    h q[1]
    cx q[0], q[1]
    h q[2]
    h q[3]
    cx q[2], q[3]
    i = i + 1
end

# 测量
var m0 = measure q[0]
var m1 = measure q[1]
var m2 = measure q[2]
var m3 = measure q[3]
printf("Bench: %d%d%d%d\n", m0, m1, m2, m3)
printf("Bench完成\n")