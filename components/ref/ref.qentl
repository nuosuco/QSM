# ---- Ref自编程智力：反省报告代码生成器 ----
def ref_code_gen(func_name, style):
    var code = ""
    if (str_eq(style, "health")):
        code = str_concat("def ", func_name)
        code = str_concat(code, "():\n")
        code = str_concat(code, "    var health = 80\n")
        code = str_concat(code, "    if (health < 60):\n")
        code = str_concat(code, "        health = 60\n")
        code = str_concat(code, "    end\n")
        code = str_concat(code, "    return health\nend\n")
    else:
        if (str_eq(style, "report")):
            code = str_concat("def ", func_name)
            code = str_concat(code, "():\n")
            code = str_concat(code, "    var lines = 0\n")
            code = str_concat(code, "    var k = 0\n")
            code = str_concat(code, "    while (k < 4):\n")
            code = str_concat(code, "        lines = lines + 1\n")
            code = str_concat(code, "        k = k + 1\n")
            code = str_concat(code, "    end\n")
            code = str_concat(code, "    return lines\nend\n")
        else:
            code = str_concat("def ", func_name)
            code = str_concat(code, "():\n")
            code = str_concat(code, "    var ready = 0\n")
            code = str_concat(code, "    if (file_exists(\"components/ref/ref.qentl\")):\n")
            code = str_concat(code, "        ready = 1\n")
            code = str_concat(code, "    end\n")
            code = str_concat(code, "    return ready\nend\n")
        end
    end
    return code
end

# Ref叠加态并行自编程：3方案并行编译选优
def ref_parallel_program(func_name):
    printf("\n=== Ref 叠加态并行自编程 ===\n")
    var p1 = ref_code_gen(func_name, "health")
    var p2 = ref_code_gen(func_name, "report")
    var p3 = ref_code_gen(func_name, "ready")
    printf("生成: health=%d字节 report=%d字节 ready=%d字节\n", str_len(p1), str_len(p2), str_len(p3))
    var w1 = file_write_bytes("/tmp/ref_plan_1.qentl", p1)
    var w2 = file_write_bytes("/tmp/ref_plan_2.qentl", p2)
    var w3 = file_write_bytes("/tmp/ref_plan_3.qentl", p3)
    var e1 = exec("cd /root/QSM && cp run/qcl.qbc target.qbc && cp /tmp/ref_plan_1.qentl input.qentl && timeout 30 bin/q_bootstrap run run/qvm.qbc 2>&1 | grep -o 'errors=[0-9]*'")
    var e2 = exec("cd /root/QSM && cp run/qcl.qbc target.qbc && cp /tmp/ref_plan_2.qentl input.qentl && timeout 30 bin/q_bootstrap run run/qvm.qbc 2>&1 | grep -o 'errors=[0-9]*'")
    var e3 = exec("cd /root/QSM && cp run/qcl.qbc target.qbc && cp /tmp/ref_plan_3.qentl input.qentl && timeout 30 bin/q_bootstrap run run/qvm.qbc 2>&1 | grep -o 'errors=[0-9]*'")
    printf("坍缩: 1=%s 2=%s 3=%s\n", e1, e2, e3)
    var best = "P1"
    if (str_index_of(e1, "errors=0") < 0):
        best = "P2"
    end
    if (str_index_of(e2, "errors=0") < 0):
        best = "P3"
    end
    if (str_index_of(e3, "errors=0") < 0):
        best = "FAIL"
    end
    printf("最优方案: %s\n", best)
    return best
end

# 彝文认知: 统计知识库规模+识别彝文领域
def ref_yi_cognition():
    printf("\n=== ref 彝文认知 ===\n")
    var kb = file_read("data/yi_data_simple.txt")
    var klen = str_len(kb)
    var chars = 0
    var pos = 0
    while (pos < klen):
        var nl = str_index_of(str_substring(kb, pos, klen - pos), "\n")
        if (nl < 0):
            break
        end
        chars = chars + 1
        pos = pos + nl + 1
    end
    printf("彝文知识库: %d字符\n", chars)
    printf("✅ ref彝文认知就绪\n")
    return chars
end

# ---- Ref自举生长运维: 检查系统组件+三副本一致性+生成生长报告 ----
def ref_growth_maintenance():
    printf("\n=== Ref 自举生长运维 ===\n")
    printf("职责: 自反省→维护→运维→自举生长\n")
    
    # 1. 检查核心组件
    printf("【核心组件检查】\n")
    var qcl_size = str_len(file_read("components/qcl/qcl.qentl"))
    var qvm_size = str_len(file_read("components/qvm/qvm.qentl"))
    var qns_size = str_len(file_read("components/qns/qns.qentl"))
    var qsm_size = str_len(file_read("components/qsm/qsm.qentl"))
    var qdfs_size = str_len(file_read("components/qdfs/qdfs.qentl"))
    printf("  QCL: %d字节 (编译器)\n", qcl_size)
    printf("  QVM: %d字节 (运行时)\n", qvm_size)
    printf("  QNS: %d字节 (神经叠加态)\n", qns_size)
    printf("  QSM: %d字节 (主模型/量子态传送)\n", qsm_size)
    printf("  QDFS: %d字节 (并行存储)\n", qdfs_size)
    
    # 2. 三副本数据一致性
    printf("【数据一致性检查】\n")
    var main_kb = file_read("storage/main/yi_kb.txt")
    var back_kb = file_read("storage/backup/yi_kb.txt")
    var mirr_kb = file_read("storage/mirror/yi_kb.txt")
    var ml = str_len(main_kb)
    var bl = str_len(back_kb)
    var ll = str_len(mirr_kb)
    printf("  main: %d字节\n", ml)
    printf("  backup: %d字节\n", bl)
    printf("  mirror: %d字节\n", ll)
    if (ml == bl and bl == ll):
        printf("  ✅ 三副本一致\n")
    else:
        printf("  ⚠️ 三副本不一致, 需要修复\n")
    end
    
    # 3. 彝文知识库统计
    var chars = 0
    var pos = 0
    while (pos < str_len(file_read("data/yi_data_simple.txt"))):
        var nl = str_index_of(str_substring(file_read("data/yi_data_simple.txt"), pos), "\n")
        if (nl < 0):
            break
        end
        chars = chars + 1
        pos = pos + nl + 1
    end
    printf("【彝文知识库】\n")
    printf("  已收录: %d个彝文字符\n", chars)
    
    # 4. 生长版本
    var ver = file_read(".current_version")
    printf("【当前版本】\n")
    printf("  v%s\n", ver)
    
    printf("\n✅ Ref自举生长运维完成\n")
    return 1
end

# ================================================================
# v0.0.2 真·叠加态并行worker — 单QVM内N量子态共享同一波函数
# 每个量子态用qstate_id()识别自身,各检查一个组件
# 结果写QDFS叠加态视图qs_<态>/ref_work.txt互不踩踏
# ================================================================
# 真叠加态分片: 各态检查不同组件, 数据按qstate_id分片
def ref_qs_check():
    var sid = qstate_id()
    var fname = "ref_work.txt"
    var outp = ""
    if (sid > 0):
        var qd = str_concat("/root/QSM/qdfs/ns/qs_", int_to_str(sid))
        exec(str_concat("mkdir -p ", qd))
        outp = str_concat(str_concat(qd, "/"), fname)
    else:
        outp = str_concat("/root/QSM/qdfs/ns/", fname)
    end
    var comp = "qsm"
    var ok = 0
    if (sid == 1):
        comp = "qcl"
        ok = ref_check_qcl()
    end
    if (sid == 2):
        comp = "qvm"
        ok = ref_check_qvm()
    end
    if (sid == 3):
        comp = "qdfs"
        ok = ref_check_qdfs()
    end
    if (sid == 0):
        ok = ref_check_qns()
        comp = "qns"
    end
    var result = str_concat(str_concat(str_concat(str_concat("[Ref态", int_to_str(sid)), "] 组件="), comp), str_concat(" 通过=", int_to_str(ok)))
    file_write_bytes(outp, result)
    printf("[Ref态%d] 组件%s=通过%d\n", sid, comp, ok)
    return ok
end

