end

# ---- WeQ智力：核心人物识别 ----
def weq_find_core_person():
    printf("\n=== WeQ 核心人物识别 ===\n")
    
    var top_friend = ""
    var highest_influence = 0
    var i = 0
    
    while (i < g_friend_count):
        var friend_name = str_substring(g_friends, i * 10, 10)
        var msg_count = 0
        
        # 计算该好友的消息数
        var j = 0
        while (j < g_msg_count):
            if (str_index_of(str_concat("[", int_to_str(j)), g_messages) >= 0):
                msg_count = msg_count + 1
            end
            j = j + 1
        end
        
        if (msg_count > highest_influence):
            highest_influence = msg_count
            top_friend = friend_name
        end
        i = i + 1
    end
    
    printf("  核心人物: %s (影响力: %d)\n", top_friend, highest_influence)
    return highest_influence
end

# ---- WeQ智力：社交情感分析（分析消息情感倾向） ----
def weq_emotion_analysis():
    printf("\n=== WeQ 社交情感分析 ===\n")
    
    var positive_count = 0
    var negative_count = 0
    var neutral_count = 0
    
    # 分析消息内容（简化版）
    var msg_content = g_messages
    var i = 0
    while (i < str_len(msg_content) - 2):
        # 检测正面词汇
        if (str_index_of(str_substring(msg_content, i, 3), "好") >= 0 or str_index_of(str_substring(msg_content, i, 3), "棒") >= 0):
            positive_count = positive_count + 1
        else:
            # 检测负面词汇
            if (str_index_of(str_substring(msg_content, i, 3), "坏") >= 0 or str_index_of(str_substring(msg_content, i, 3), "差") >= 0):
                negative_count = negative_count + 1
            else:
                neutral_count = neutral_count + 1
            end
        end
        i = i + 3
    end
    
    printf("  正面消息: %d\n", positive_count)
    printf("  负面消息: %d\n", negative_count)
    printf("  中性消息: %d\n", neutral_count)
    
    printf("\n【情感健康评估】\n")
    if (positive_count > negative_count * 2):
        printf("  ✅ 情感健康，积极氛围\n")
        return 1
    else:
        if (negative_count > positive_count):
            printf("  ⚠️ 情感需要关注，负面情绪较多\n")
            return 0
        else:
            printf("  △ 情感正常，保持平衡\n")
            return 1
        end
    end
end

# ---- WeQ智力：社交关系深度分析（识别核心关系） ----
def weq_deep_relationship_analysis():
    printf("\n=== WeQ 社交关系深度分析 ===\n")
    
    printf("  好友总数: %d\n", g_friend_count)
    printf("  消息总数: %d\n", g_msg_count)
    
    var avg_msg_per_friend = 0
    if (g_friend_count > 0):
        avg_msg_per_friend = g_msg_count / g_friend_count
    end
    
    printf("  人均消息数: %.1f\n", avg_msg_per_friend)
    
    printf("\n【关系质量评估】\n")
    if (avg_msg_per_friend > 5 and g_friend_count > 5):
        printf("  ✅ 深度社交，关系稳固\n")
        printf("  建议: 继续保持良好互动\n")
    else:
        if (avg_msg_per_friend < 2 and g_friend_count < 5):
            printf("  ⚠️ 社交轻度，需要拓展\n")
            printf("  建议: 增加社交活动，主动联系\n")
        else:
            printf("  △ 社交正常，可适度加强\n")
            printf("  建议: 偶尔主动联系好友\n")
        end
    end
    
    return avg_msg_per_friend
end

# ---- WeQ智力：社交关系预测（预测关系变化） ----
def weq_relationship_predict():
    printf("\n=== WeQ 社交关系预测 ===\n")
    
    # 分析好友关系趋势
    var prediction = "稳定"
    var confidence = 50
    
    if (g_friend_count > 10 and g_msg_count > 50):
        prediction = "增长"
        confidence = 80
    else:
        if (g_friend_count < 5 and g_msg_count < 20):
            prediction = "萎缩"
            confidence = 70
        else:
            prediction = "稳定"
            confidence = 60
        end
    end
    
    printf("【当前状态】\n")
    printf("  好友数: %d\n", g_friend_count)
    printf("  消息数: %d\n", g_msg_count)
    printf("  活跃度: %.1f\n", g_msg_count / g_friend_count)
    
    printf("\n【预测结果】\n")
    printf("  预测趋势: %s\n", prediction)
    printf("  置信度: %d%%\n", confidence)
    
    printf("\n【建议】\n")
    if (str_eq(prediction, "增长")):
        printf("  ✓ 社交活跃，继续保持\n")
        printf("  建议: 拓展更多社交圈\n")
    else:
        if (str_eq(prediction, "萎缩")):
            printf("  ⚠️ 社交需要加强\n")
            printf("  建议: 主动联系好友，增加互动\n")
        else:
            printf("  △ 社交正常，保持稳定\n")
            printf("  建议: 偶尔主动联系好友\n")
        end
    end
    
    return confidence
end

# ---- WeQ智力：社交影响力评估（量化影响力） ----
def weq_influence_assessment():
    printf("\n=== WeQ 社交影响力评估 ===\n")
    
    var influence_score = 0
    
    # 好友数量影响
    if (g_friend_count > 20):
        influence_score = influence_score + 30
        printf("  ✓ 好友众多 (+30)\n")
    else:
        if (g_friend_count > 10):
            influence_score = influence_score + 20
            printf("  △ 好友较多 (+20)\n")
        else:
            if (g_friend_count > 5):
                influence_score = influence_score + 10
                printf("  ○ 好友一般 (+10)\n")
            else:
                printf("  ✗ 好友较少 (0)\n")
            end
        end
    end
    
    # 消息活跃度影响
    if (g_msg_count > 100):
        influence_score = influence_score + 30
        printf("  ✓ 消息频繁 (+30)\n")
    else:
        if (g_msg_count > 50):
            influence_score = influence_score + 20
            printf("  △ 消息较多 (+20)\n")
        else:
            if (g_msg_count > 20):
                influence_score = influence_score + 10
                printf("  ○ 消息一般 (+10)\n")
            else:
                printf("  ✗ 消息较少 (0)\n")
            end
        end
    end
    
    # 社交网络密度影响
    var density = 0
    if (g_friend_count > 1):
        density = g_msg_count * 100 / (g_friend_count * (g_friend_count - 1))
        if (density > 50):
            influence_score = influence_score + 20
            printf("  ✓ 网络密集 (+20)\n")
        else:
            if (density > 20):
                influence_score = influence_score + 10
                printf("  △ 网络中等 (+10)\n")
            else:
                printf("  ✗ 网络稀疏 (0)\n")
            end
        end
    end
    
    printf("\n【影响力评分】\n")
    printf("  总分: %d/100\n", influence_score)
    
    if (influence_score >= 80):
        printf("  评价: ✅ 社交影响力优秀\n")
    else:
        if (influence_score >= 60):
            printf("  评价: ⚡ 社交影响力良好\n")
        else:
            if (influence_score >= 40):
                printf("  评价: △ 社交影响力一般\n")
            else:
                printf("  评价: ⚠️ 社交影响力需要提升\n")
            end
        end
    end
    
    return influence_score
end

# ---- WeQ自编程智力：社交网络代码生成器 ----
def weq_code_gen(func_name, style):
    var code = ""
    if (str_eq(style, "friends")):
        code = str_concat("def ", func_name)
        code = str_concat(code, "():\n")
        code = str_concat(code, "    var friends = 0\n")
        code = str_concat(code, "    if (friends < 3):\n")
        code = str_concat(code, "        friends = friends + 1\n")
        code = str_concat(code, "    end\n")
        code = str_concat(code, "    return friends\nend\n")
    else:
        if (str_eq(style, "messages")):
            code = str_concat("def ", func_name)
            code = str_concat(code, "():\n")
            code = str_concat(code, "    var count = 0\n")
            code = str_concat(code, "    var j = 0\n")
            code = str_concat(code, "    while (j < 6):\n")
            code = str_concat(code, "        count = count + 1\n")
            code = str_concat(code, "        j = j + 1\n")
            code = str_concat(code, "    end\n")
            code = str_concat(code, "    return count\nend\n")
        else:
            code = str_concat("def ", func_name)
            code = str_concat(code, "():\n")
            code = str_concat(code, "    var status = 0\n")
            code = str_concat(code, "    if (file_exists(\"components/weq/weq.qentl\")):\n")
            code = str_concat(code, "        status = 1\n")
            code = str_concat(code, "    end\n")
            code = str_concat(code, "    return status\nend\n")
        end
    end
    return code
end

# WeQ叠加态并行自编程：3方案并行编译选优
def weq_parallel_program(func_name):
    printf("\n=== WeQ 叠加态并行自编程 ===\n")
    var p1 = weq_code_gen(func_name, "friends")
    var p2 = weq_code_gen(func_name, "messages")
    var p3 = weq_code_gen(func_name, "status")
    printf("生成: friends=%d字节 messages=%d字节 status=%d字节\n", str_len(p1), str_len(p2), str_len(p3))
    var w1 = file_write_bytes("/tmp/weq_plan_1.qentl", p1)
    var w2 = file_write_bytes("/tmp/weq_plan_2.qentl", p2)
    var w3 = file_write_bytes("/tmp/weq_plan_3.qentl", p3)
    var e1 = exec("cd /root/QSM && cp run/qcl.qbc target.qbc && cp /tmp/weq_plan_1.qentl input.qentl && timeout 30 bin/q_bootstrap run run/qvm.qbc 2>&1 | grep -o 'errors=[0-9]*'")
    var e2 = exec("cd /root/QSM && cp run/qcl.qbc target.qbc && cp /tmp/weq_plan_2.qentl input.qentl && timeout 30 bin/q_bootstrap run run/qvm.qbc 2>&1 | grep -o 'errors=[0-9]*'")
    var e3 = exec("cd /root/QSM && cp run/qcl.qbc target.qbc && cp /tmp/weq_plan_3.qentl input.qentl && timeout 30 bin/q_bootstrap run run/qvm.qbc 2>&1 | grep -o 'errors=[0-9]*'")
    printf("坍缩: 1=%s 2=%s 3=%s\n", e1, e2, e3)
    var best = "P1"
    if (str_index_of(e1, "errors=0") < 0):
        best = "P2"
    end
    if (str_index_of(e2, "errors=0") < 0):
        best = "P3"
    end
    if (str_index_of(e3, "errors=0") < 0):
        best = "FAIL"
    end
    printf("最优方案: %s\n", best)
    return best
end

# 彝文认知: 统计知识库规模+识别彝文领域
def weq_yi_cognition():
    printf("\n=== weq 彝文认知 ===\n")
    var kb = file_read("data/yi_data_simple.txt")
    var klen = str_len(kb)
    var chars = 0
    var pos = 0
    while (pos < klen):
        var nl = str_index_of(str_substring(kb, pos, klen - pos), "\n")
        if (nl < 0):
            break
        end
        chars = chars + 1
        pos = pos + nl + 1
    end
    printf("彝文知识库: %d字符\n", chars)
    printf("✅ weq彝文认知就绪\n")
    return chars
end

# ================================================================
# v0.0.2 真·叠加态并行worker — 单QVM内N量子态共享同一波函数
# 每个量子态用qstate_id()识别自身,各分析一个社交维度,
# 结果写QDFS叠加态视图qs_<态>/weq_work.txt互不踩踏
# ================================================================
# 真叠加态分片: 各态分析不同社交维度, 数据按qstate_id分片
def weq_qs_work():
    var sid = qstate_id()
    var fname = "weq_work.txt"
    var outp = ""
    if (sid > 0):
        var qd = str_concat("/root/QSM/qdfs/ns/qs_", int_to_str(sid))
        exec(str_concat("mkdir -p ", qd))
        outp = str_concat(str_concat(qd, "/"), fname)
    else:
        outp = str_concat("/root/QSM/qdfs/ns/", fname)
    end
    var dim = "社交默认维度"
    if (sid == 1):
        dim = "好友关系图谱"
    end
    if (sid == 2):
        dim = "消息流量分析"
    end
    if (sid == 3):
        dim = "群组协作网络"
    end
    var fc = weq_friend_count()
    var result = str_concat(str_concat(str_concat(str_concat("[WeQ态", int_to_str(sid)), "] 维度="), dim), str_concat(" 好友数=", int_to_str(fc)))
    file_write_bytes(outp, result)
    printf("[WeQ态%d] %s 好友=%d\n", sid, dim, fc)
    return sid
end

