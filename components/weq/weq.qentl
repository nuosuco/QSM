# ---- WeQ智力：社交网络分析（找出核心节点） ----
def weq_network_analysis():
    printf("\n=== WeQ 社交网络分析 ===\n")
    
    var node_count = g_friend_count
    var edge_count = g_msg_count
    var density = 0
    
    if (node_count > 1):
        var max_edges = node_count * (node_count - 1)
        if (max_edges > 0):
            density = edge_count * 100 / max_edges
        end
    end
    
    printf("  节点数: %d\n", node_count)
    printf("  边数: %d\n", edge_count)
    printf("  网络密度: %d%%\n", density)
    
    if (density > 50):
        printf("  状态: ✅ 密集网络，传播快\n")
    else:
        if (density > 20):
            printf("  状态: ⚡ 中等密度\n")
