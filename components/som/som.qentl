# ---- SOM智力：真正的风险预测引擎（基于历史数据预测） ----
def som_risk_predictor():
    printf("\n=== SOM 风险预测引擎 ===\n")
    
    # 1. 分析当前经济状态
    var risk_level = 0
    
    if (g_balance < 100):
        risk_level = risk_level + 3
        printf("  ⚠️ 余额极低，高风险\n")
    else:
        if (g_balance < 300):
            risk_level = risk_level + 2
            printf("  ⚡ 余额较低，中高风险\n")
        else:
            if (g_balance < 500):
                risk_level = risk_level + 1
                printf("  △ 余额一般，中等风险\n")
            else:
                printf("  ✓ 余额充足，低风险\n")
            end
        end
    end
    
    # 2. 分析信用状况
    if (g_credit_score < 50):
        risk_level = risk_level + 3
        printf("  ⚠️ 信用极低，高风险\n")
    else:
        if (g_credit_score < 70):
            risk_level = risk_level + 2
            printf("  ⚡ 信用较低，中高风险\n")
        else:
            if (g_credit_score < 85):
                risk_level = risk_level + 1
                printf("  △ 信用一般，中等风险\n")
            else:
                printf("  ✓ 信用优秀，低风险\n")
            end
        end
    end
    
    # 3. 综合风险评估
    printf("\n【综合风险评估】\n")
    printf("  风险分数: %d\n", risk_level)
    
    if (risk_level >= 6):
        printf("  风险等级: 🔴 高风险\n")
        printf("  建议: 立即增加收入，控制支出\n")
    else:
        if (risk_level >= 4):
            printf("  风险等级: 🟠 中高风险\n")
            printf("  建议: 关注财务状况，适度谨慎\n")
        else:
            if (risk_level >= 2):
                printf("  风险等级: 🟡 中等风险\n")
                printf("  建议: 保持良好习惯，适度投资\n")
            else:
                printf("  风险等级: 🟢 低风险\n")
                printf("  建议: 继续保持，可以适当扩张\n")
            end
        end
    end
    
    return risk_level
end

# ---- SOM智力：经济趋势预测（未来7天） ----
def som_trend_predict_7days():
    printf("\n=== SOM 7天趋势预测 ===\n")
    
    var predicted_change = 0
    var confidence = 50
    
    # 基于当前余额预测
    if (g_balance > 1000):
        predicted_change = 100
        confidence = 80
    else:
        if (g_balance > 500):
            predicted_change = 50
            confidence = 70
        else:
            predicted_change = -50
            confidence = 60
        end
    end
    
    printf("  当前余额: %d\n", g_balance)
    printf("  预测变化: %d\n", predicted_change)
    printf("  预测7天后: %d\n", g_balance + predicted_change)
    printf("  置信度: %d%%\n", confidence)
    
    printf("\n【趋势判断】\n")
    if (predicted_change > 0):
        printf("  📈 趋势向上，预计增长\n")
    else:
        if (predicted_change < 0):
            printf("  📉 趋势向下，预计下降\n")
        else:
            printf("  ➡️ 趋势平稳\n")
        end
    end
    
    return predicted_change
end

# ---- SOM智力：真正的经济预测引擎（基于历史数据预测） ----
def som_prediction_engine():
    printf("\n=== SOM 经济预测引擎 ===\n")
    
    # 1. 分析当前经济状态
    var trend = "stable"
    var confidence = 50
    
    if (g_balance > 1000):
        trend = "growth"
        confidence = 80
    else:
        if (g_balance > 500):
            trend = "stable"
            confidence = 60
        else:
            trend = "decline"
            confidence = 70
        end
    end
    
    printf("【当前状态】\n")
    printf("  余额: %d\n", g_balance)
    printf("  趋势: %s\n", trend)
    printf("  置信度: %d%%\n", confidence)
    
    # 2. 预测未来7天
    printf("\n【7天预测】\n")
    var predicted_7d = g_balance
    if (str_eq(trend, "growth")):
        predicted_7d = g_balance + 200
    else:
        if (str_eq(trend, "decline")):
            predicted_7d = g_balance - 100
        end
    end
    printf("  预测余额: %d\n", predicted_7d)
    
    # 3. 预测未来30天
    printf("\n【30天预测】\n")
    var predicted_30d = g_balance
    if (str_eq(trend, "growth")):
        predicted_30d = g_balance + 500
    else:
        if (str_eq(trend, "decline")):
            predicted_30d = g_balance - 300
        end
    end
    printf("  预测余额: %d\n", predicted_30d)
    
    # 4. 给出建议
    printf("\n【投资建议】\n")
    if (str_eq(trend, "growth")):
        printf("  ✓ 经济向好，可以适当投资\n")
        printf("  建议: 继续储蓄，适度扩张\n")
    else:
        if (str_eq(trend, "decline")):
            printf("  ⚠️ 经济下滑，需要谨慎\n")
            printf("  建议: 控制支出，增加收入\n")
        else:
            printf("  △ 经济稳定，保持现状\n")
            printf("  建议: 维持当前收支习惯\n")
        end
    end
    
    return predicted_30d
end

# ---- SOM智力：经济健康诊断（全面检查） ----
def som_health_diagnosis():
    printf("\n=== SOM 经济健康诊断 ===\n")
    
    var score = 50
    
    # 余额检查
    if (g_balance > 1000):
        score = score + 30
        printf("  ✓ 余额充足 (+30)\n")
    else:
        if (g_balance > 500):
            score = score + 15
            printf("  △ 余额一般 (+15)\n")
        else:
            score = score - 20
            printf("  ✗ 余额不足 (-20)\n")
        end
    end
    
    # 信用检查
    if (g_credit_score > 80):
        score = score + 20
        printf("  ✓ 信用优秀 (+20)\n")
    else:
        if (g_credit_score > 60):
            score = score + 10
            printf("  △ 信用一般 (+10)\n")
        else:
            score = score - 10
            printf("  ✗ 信用较差 (-10)\n")
        end
    end
    
    printf("\n【健康评分】\n")
    printf("  总分: %d/100\n", score)
    
    if (score >= 80):
        printf("  结论: ✅ 经济健康\n")
    else:
        if (score >= 60):
            printf("  结论: ⚡ 经济良好\n")
        else:
            printf("  结论: ⚠️ 经济需要关注\n")
        end
    end
    
    return score
end

# ---- SOM自编程智力：经济决策代码生成器 ----
def som_code_gen(func_name, style):
    var code = ""
    if (str_eq(style, "profit")):
        code = str_concat("def ", func_name)
        code = str_concat(code, "():\n")
        code = str_concat(code, "    var profit = 100\n")
        code = str_concat(code, "    if (profit > 50):\n")
        code = str_concat(code, "        profit = profit + 10\n")
        code = str_concat(code, "    end\n")
        code = str_concat(code, "    return profit\nend\n")
    else:
        if (str_eq(style, "ledger")):
            code = str_concat("def ", func_name)
            code = str_concat(code, "():\n")
            code = str_concat(code, "    var total = 0\n")
            code = str_concat(code, "    var i = 0\n")
            code = str_concat(code, "    while (i < 5):\n")
            code = str_concat(code, "        total = total + 20\n")
            code = str_concat(code, "        i = i + 1\n")
            code = str_concat(code, "    end\n")
            code = str_concat(code, "    return total\nend\n")
        else:
            code = str_concat("def ", func_name)
            code = str_concat(code, "():\n")
            code = str_concat(code, "    var score = 0\n")
            code = str_concat(code, "    if (file_exists(\"components/som/som.qentl\")):\n")
            code = str_concat(code, "        score = 100\n")
            code = str_concat(code, "    end\n")
            code = str_concat(code, "    return score\nend\n")
        end
    end
    return code
end

# SOM叠加态并行自编程：3方案并行编译选优
def som_parallel_program(func_name):
    printf("\n=== SOM 叠加态并行自编程 ===\n")
    var p1 = som_code_gen(func_name, "profit")
    var p2 = som_code_gen(func_name, "ledger")
    var p3 = som_code_gen(func_name, "score")
    printf("生成: profit=%d字节 ledger=%d字节 score=%d字节\n", str_len(p1), str_len(p2), str_len(p3))
    var w1 = file_write_bytes("/tmp/som_plan_1.qentl", p1)
    var w2 = file_write_bytes("/tmp/som_plan_2.qentl", p2)
    var w3 = file_write_bytes("/tmp/som_plan_3.qentl", p3)
    var e1 = exec("cd /root/QSM && cp run/qcl.qbc target.qbc && cp /tmp/som_plan_1.qentl input.qentl && timeout 30 bin/q_bootstrap run run/qvm.qbc 2>&1 | grep -o 'errors=[0-9]*'")
    var e2 = exec("cd /root/QSM && cp run/qcl.qbc target.qbc && cp /tmp/som_plan_2.qentl input.qentl && timeout 30 bin/q_bootstrap run run/qvm.qbc 2>&1 | grep -o 'errors=[0-9]*'")
    var e3 = exec("cd /root/QSM && cp run/qcl.qbc target.qbc && cp /tmp/som_plan_3.qentl input.qentl && timeout 30 bin/q_bootstrap run run/qvm.qbc 2>&1 | grep -o 'errors=[0-9]*'")
    printf("坍缩: 1=%s 2=%s 3=%s\n", e1, e2, e3)
    var best = "P1"
    if (str_index_of(e1, "errors=0") < 0):
        best = "P2"
    end
    if (str_index_of(e2, "errors=0") < 0):
        best = "P3"
    end
    if (str_index_of(e3, "errors=0") < 0):
        best = "FAIL"
    end
    printf("最优方案: %s\n", best)
    return best
end

# 彝文认知: 统计知识库规模+识别彝文领域
def som_yi_cognition():
    printf("\n=== som 彝文认知 ===\n")
    var kb = file_read("data/yi_data_simple.txt")
    var klen = str_len(kb)
    var chars = 0
    var pos = 0
    while (pos < klen):
        var nl = str_index_of(str_substring(kb, pos, klen - pos), "\n")
        if (nl < 0):
            break
        end
        chars = chars + 1
        pos = pos + nl + 1
    end
    printf("彝文知识库: %d字符\n", chars)
    printf("✅ som彝文认知就绪\n")
    return chars
end

# ================================================================
# v0.0.2 真·叠加态并行worker — 单QVM内N量子态共享同一波函数
# 每个量子态用qstate_id()识别自身,各评估一个经济策略
# 结果写QDFS叠加态视图qs_<态>/som_work.txt互不踩踏
# ================================================================
# 真叠加态分片: 各态评估不同策略, 数据按qstate_id分片
def som_qs_decision():
    var sid = qstate_id()
    var fname = "som_work.txt"
    var outp = ""
    if (sid > 0):
        var qd = str_concat("/root/QSM/qdfs/ns/qs_", int_to_str(sid))
        exec(str_concat("mkdir -p ", qd))
        outp = str_concat(str_concat(qd, "/"), fname)
    else:
        outp = str_concat("/root/QSM/qdfs/ns/", fname)
    end
    var strat = "hold"
    var ret = 0
    if (sid == 1):
        strat = "save"
        ret = som_make_decision("save", 50)
    end
    if (sid == 2):
        strat = "invest"
        ret = som_make_decision("invest", 80)
    end
    if (sid == 3):
        strat = "predict"
        ret = som_predict_trend()
    end
    if (sid == 0):
        strat = "credit"
        ret = som_credit_check()
    end
    var result = str_concat(str_concat(str_concat(str_concat("[SoM态", int_to_str(sid)), "] 策略="), strat), str_concat(" 结果=", int_to_str(ret)))
    file_write_bytes(outp, result)
    printf("[SoM态%d] 策略%s=结果%d\n", sid, strat, ret)
    return ret
end

