# ================================================================
# lib/qns.qentl — 量子神经叠加态 (Quantum Neural Superposition)
# v8-生长: 新增代码生成能力
# 每个量子应用独立拥有QNS+QDFS两个基础
# QNS基于QDFS实现自动合并/分离 + 源码升级 + 代码生成
# 自举生长: QNS能自己生成QEntL源码函数
# ================================================================

# ---- QNS常量定义 ----
var NS_SYSTEM = "system"
var NS_MODELS = "models"

# ---- QNS实例创建 ----
def qns_instance_create(qdfs_base, app_name):
    var root = qdfs_instance_create(qdfs_base, app_name)
    qdfs_ns_write(NS_SYSTEM, "qns_meta", "QNS: 就绪 v39")
    qdfs_ns_write(NS_MODELS, "qns_weights", "权重: 生长态")
    printf(" QNS实例创建: %s\n", root)
    return root
end

# ---- QNS算力合并 ----
def qns_merge(ns_a, ns_b):
    var out = qdfs_ns_merge(ns_a, ns_b)
    printf(" QNS合并: %s\n", out)
    return out
end

# ---- QNS算力分离 ----
def qns_split(ns_a, ns_b, prefix):
    var out = qdfs_ns_split(ns_a, ns_b, prefix)
    printf(" QNS分离: %s\n", out)
    return out
end

# ---- QNS生成函数定义 ----
def qns_gen_func(name, args, body):
    var line = "\n# QNS生成的函数\n"
    line = str_concat(line, "def ")
    line = str_concat(line, name)
    line = str_concat(line, "(")
    line = str_concat(line, args)
    line = str_concat(line, "):\n    ")
    line = str_concat(line, body)
    line = str_concat(line, "\nend\n")
    printf(" QNS: 生成函数 %s\n", name)
    return line
end

# ---- QNS生成变量声明 ----
def qns_gen_var(name, value):
    var line = str_concat("var ", name)
    line = str_concat(line, " = ")
    line = str_concat(line, value)
    line = str_concat(line, "\n")
    printf(" QNS: 生成变量 %s\n", name)
    return line
end

# ---- QNS生成注释 ----
def qns_gen_comment(text):
    return str_concat("# ", str_concat(text, "\n"))
end

# ---- QNS在标记后添加函数 ----
def qns_add_func(source, marker, new_func):
    return qns_insert_after(source, marker, new_func)
end

# ---- QNS自动生长：生成并添加新函数 ----
def qns_grow(component, marker, name, args, body):
    printf(" QNS: 自动生长 %s\n", component)
    var filepath = str_concat("components/", str_concat(component, "/"))
    filepath = str_concat(filepath, str_concat(component, ".qentl"))
    var source = qns_read_source(filepath)
    if (str_len(source) == 0):
        return 0
    end
    var new_func = qns_gen_func(name, args, body)
    var new_source = qns_add_func(source, marker, new_func)
    if (str_eq(new_source, source)):
        printf(" QNS: 插入失败\n")
        return 0
    end
    qns_save_source(filepath, new_source)
    printf(" QNS: 自动生长完成！\n")
    return 1
end

# ---- QNS源码读取 ----
def qns_read_source(filepath):
    var content = file_read(filepath)
    if (str_len(content) == 0):
        printf(" QNS: 无法读取 %s\n", filepath)
        return ""
    end
    printf(" QNS: 读取 %s (%d 字节)\n", filepath, str_len(content))
    return content
end

# ---- QNS源码查找 ----
def qns_find(source, keyword):
    return str_index_of(source, keyword)
end

# ---- QNS源码替换 ----
def qns_replace(source, old, new):
    var idx = str_index_of(source, old)
    if (idx < 0):
        printf(" QNS: 未找到 '%s'\n", old)
        return source
    end
    var before = str_substring(source, 0, idx)
    var after = str_substring(source, idx + str_len(old), str_len(source) - idx - str_len(old))
    printf(" QNS: 替换 '%s' -> '%s' (位置 %d)\n", old, new, idx)
    return str_concat(before, str_concat(new, after))
end

# ---- QNS源码插入 ----
def qns_insert_after(source, marker, new_code):
    var idx = str_index_of(source, marker)
    if (idx < 0):
        printf(" QNS: 未找到标记 '%s'\n", marker)
        return source
    end
    var pos = idx + str_len(marker)
    var before = str_substring(source, 0, pos)
    var after = str_substring(source, pos, str_len(source) - pos)
    printf(" QNS: 在 '%s' 后插入 (位置 %d)\n", marker, pos)
    return str_concat(before, str_concat(new_code, after))
end

# ---- QNS保存源码 ----
def qns_save_source(filepath, content):
    var ret = file_write_bytes(filepath, content)
    printf(" QNS: 保存 %s (%d 字节)\n", filepath, str_len(content))
    return ret
end

# ---- QNS版本标记 ----
def qns_add_version_marker(source, component, version):
    var old_ver = "v2: QEntL"
    var new_ver = str_concat("v", str_concat(version, ": QEntL"))
    return qns_replace(source, old_ver, new_ver)
end

# ---- QNS升级组件 ----
def qns_upgrade(component_name):
    var filepath = str_concat("components/", str_concat(component_name, "/"))
    filepath = str_concat(filepath, str_concat(component_name, ".qentl"))
    printf(" QNS: 升级 %s\n", component_name)
    var source = qns_read_source(filepath)
    if (str_len(source) == 0):
        printf(" QNS: 升级失败！\n")
        return 0
    end
    var new_source = qns_add_version_marker(source, component_name, "8生长")
    if (str_eq(new_source, source)):
        printf(" QNS: 无需修改\n")
        return 0
    end
    qns_save_source(filepath, new_source)
    printf(" QNS: 升级完成！\n")
    return 1
end

# ---- QNS状态报告 ----
def qns_status():
    printf(" QNS状态: 就绪 v39\n")
    printf(" QNS能力: 实例创建, 算力合并/分离, 源码升级, 代码生成 v39\n")
    return 1
end


# ---- QNS生成QSM主模型 ----
def qns_gen_qsm_model(name, qbits, desc):
    var code = "# ================================================================\n"
    code = str_concat(code, "# components/qsm/")
    code = str_concat(code, name)
    code = str_concat(code, ".qentl — ")
    code = str_concat(code, desc)
    code = str_concat(code, "\n# 构建于QNS之上\n")
    code = str_concat(code, "# ================================================================\n")
    code = str_concat(code, "qreg q[")
    code = str_concat(code, qbits)
    code = str_concat(code, "]\n\n")
    
    var n = str_to_int(qbits)
    var i = 0
    while (i < n):
        code = str_concat(code, "h q[")
        code = str_concat(code, int_to_str(i))
        code = str_concat(code, "]\n")
        i = i + 1
    end
    code = str_concat(code, "\n")
    
    i = 0
    while (i < n - 1):
        code = str_concat(code, "cx q[")
        code = str_concat(code, int_to_str(i))
        code = str_concat(code, "], q[")
        code = str_concat(code, int_to_str(i + 1))
        code = str_concat(code, "]\n")
        i = i + 1
    end
    
    code = str_concat(code, "\nvar r0 = measure q[0]\n")
    code = str_concat(code, "printf(\"模型验证: 通过\\n\")\n")
    code = str_concat(code, "\n")
    
    printf(" QNS: 生成QSM模型 %s (qbits=%d)\n", name, n)
    return code
end

# ---- QNS生成QSM四大模型 ----
def qns_gen_all_qsm():
    printf(" QNS: 生成QSM四大模型...\n")
    
    var code = qns_gen_qsm_model("qsm_main", "4", "QSM主模型")
    file_write_bytes("components/qsm/qsm_main.qentl", code)
    printf(" ✓ 保存 qsm_main (%d字节)\n", str_len(code))
    
    code = qns_gen_qsm_model("som_economy", "3", "SOM经济模型")
    file_write_bytes("components/qsm/som_economy.qentl", code)
    printf(" ✓ 保存 som_economy (%d字节)\n", str_len(code))
    
    code = qns_gen_qsm_model("qsm_social", "3", "WeQ社交模型")
    file_write_bytes("components/qsm/qsm_social.qentl", code)
    printf(" ✓ 保存 qsm_social (%d字节)\n", str_len(code))
    
    code = qns_gen_qsm_model("qsm_reflect", "3", "ReF自反省模型")
    file_write_bytes("components/qsm/qsm_reflect.qentl", code)
    printf(" ✓ 保存 qsm_reflect (%d字节)\n", str_len(code))
    
    printf(" QNS: QSM四大模型生成完成\n")
    return 1
end

# ---- QNS自动生长：生成生长库 ----
def qns_build_growth_lib():
    printf("\n=== QNS 自举生长 ===\n")
    
    # 1. 读取当前版本
    var ver = file_read(".current_version")
    if (str_len(ver) == 0):
        ver = "0"
    else:
        # 去掉末尾的换行符
        if (str_char_at(ver, str_len(ver) - 1) == chr(10)):
            ver = str_substring(ver, 0, str_len(ver) - 1)
        end
    end
    printf(" 当前版本: v%s\n", ver)
    
    # 2. 生成生长库内容
    var lib = "# QNS自动生成的生长库 v"
    lib = str_concat(lib, ver)
    lib = str_concat(lib, "\n# 由QNS自举生成，无需人工编辑\n")
    
    # 3. 生成版本函数
    lib = str_concat(lib, "\n# QNS版本函数\n")
    lib = str_concat(lib, "def qns_lib_version():\n")
    lib = str_concat(lib, "    printf(\"QNS生长库 v")
    lib = str_concat(lib, ver)
    lib = str_concat(lib, chr(92))
    lib = str_concat(lib, "n\")\n")
    lib = str_concat(lib, "    return 1\n")
    lib = str_concat(lib, "end\n")
    
    # 4. 生成健康检查函数
    lib = str_concat(lib, "\n# QNS健康检查\n")
    lib = str_concat(lib, "def qns_health():\n")
    lib = str_concat(lib, "    var q = file_exists(\"run/qcl.qbc\")\n")
    lib = str_concat(lib, "    var v = file_exists(\"run/qvm.qbc\")\n")
    lib = str_concat(lib, "    printf(\"健康检查: QCL=%d QVM=%d\\n\", q, v)\n")
    lib = str_concat(lib, "    return 1\n")
    lib = str_concat(lib, "end\n")
    
    # 5. 生成SOM检查函数
    lib = str_concat(lib, "\n# SOM经济检查\n")
    lib = str_concat(lib, "def som_check():\n")
    lib = str_concat(lib, "    printf(\"SOM经济模型: 正常\n\")
")
    lib = str_concat(lib, "    return 1\n")
    lib = str_concat(lib, "end\n")
    
    # 6. 保存
    var fpath = "lib/qns_growth.qentl"
    qns_save_source(fpath, lib)
    
    printf(" ✓ 生长库已生成: %s (%d字节)\n", fpath, str_len(lib))
    
    # 生成QVM统计库
    var vmlib = "# QVM统计库 v"
    vmlib = str_concat(vmlib, ver)
    vmlib = str_concat(vmlib, "\n# QNS生成\n\n")
    vmlib = str_concat(vmlib, "def qvm_stats_check():
")
    vmlib = str_concat(vmlib, "    printf(\"QVM统计库: 正常\n\")
")
    vmlib = str_concat(vmlib, "    return 1
")
    vmlib = str_concat(vmlib, "end
")
    qns_save_source("lib/qvm_stats.qentl", vmlib)
    printf(" QNS: 生成QVM统计库 v%s\n", ver)
    
    # 生成版本报告库
    var vlib = "# QNS版本报告 v"
    vlib = str_concat(vlib, ver)
    vlib = str_concat(vlib, "\n# QNS生成\n\n")
    vlib = str_concat(vlib, "def qns_version_report():
")
    vlib = str_concat(vlib, "    printf(\"QNS版本报告: 正常\n\")
")
    vlib = str_concat(vlib, "    return 1
")
    vlib = str_concat(vlib, "end
")
    qns_save_source("lib/qns_version_report.qentl", vlib)
    printf(" QNS: 生成版本报告库 v%s\n", ver)
    
    # 生成QCL增强库
    var clib = "# QCL增强库 v"
    clib = str_concat(clib, ver)
    clib = str_concat(clib, "\n# QNS生成\n\n")
    clib = str_concat(clib, "def qcl_enhanced_check():\n")
    clib = str_concat(clib, "    printf(\"QCL增强库: 正常\n\")
")
    clib = str_concat(clib, "    return 1\n")
    clib = str_concat(clib, "end\n")
    qns_save_source("lib/qcl_enhanced.qentl", clib)
    printf(" QNS: 生成QCL增强库 v%s\n", ver)
    
    # 生成QDFS功能库
    var dlib = "# QDFS功能库 v"
    dlib = str_concat(dlib, ver)
    dlib = str_concat(dlib, "\n# QNS生成\n\n")
    dlib = str_concat(dlib, "def qdfs_health():\n")
    dlib = str_concat(dlib, "    printf(\"QDFS功能库: 正常\n\")
")
    dlib = str_concat(dlib, "    return 1\n")
    dlib = str_concat(dlib, "end\n")
    qns_save_source("lib/qdfs_func.qentl", dlib)
    printf(" QNS: 生成QDFS功能库 v%s\n", ver)
    
    # 生成QSM增强版
    qns_gen_qsm_model("qsm_enhanced", "5", "QSM增强版")
    
    printf("=== QNS 自举生长完成 ===\n")
    return 1
end

# ---- QNS入口 ----
qns_status()
qns_build_growth_lib()
qns_gen_all_qsm()

