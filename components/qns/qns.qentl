    vmlib = str_concat(vmlib, "    printf(\\\"QVM统计: QCL=%d QVM=%d\\\\n\\\", qcl_ok, qvm_ok)\\n")
    vmlib = str_concat(vmlib, "    return 1\n")
    vmlib = str_concat(vmlib, "end\n")
    qns_save_source("lib/qvm_stats.qentl", vmlib)
    printf(" QNS: 生成QVM统计库 v%s\n", ver)
    
    # 生成版本报告库
