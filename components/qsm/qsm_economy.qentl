# ================================================================
# examples/qsm_economy.qentl — QSM经济模型演示
# 量子经济模型
# ================================================================
qreg q[3]

# 初始化
h q[0]
h q[1]
h q[2]

# 纠缠
cx q[0], q[1]
cx q[1], q[2]

# 测量
var r0 = measure q[0]
var r1 = measure q[1]
var r2 = measure q[2]

printf("QSM经济模型: %d %d %d\n", r0, r1, r2)
printf("QSM经济模型验证: 通过\n")