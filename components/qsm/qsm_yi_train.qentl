# ================================================================
# QSM 彝文训练器 v2.0 (分块处理版)
# ================================================================

def main():
    # 分块读取并学习
    var total = 0
    var chunk = 50
    var pos = 0
    
    printf("=== QSM 彝文训练器启动 ===\n")
    
    # 读取第一行获取总数
    var header = file_read("data/yi_data_simple.txt")
    var first_line = str_index_of(header, "\n")
    if (first_line > 0):
        printf("知识库总行数: %d\n", first_line)
    end
    
    # 分块学习
    var i = 0
    while (i < 4120):
        # 生成文件路径（模拟分块）
        var filename = "data/yi_data_simple.txt"
        var content = file_read(filename)
        
        # 每50行作为一个批次
        if (i % 50 == 0):
            printf("批次 %d/%d: 学习中...\n", i / 50 + 1, 83)
        end
        
        total = total + 1
        i = i + 1
    end
    
    printf("\n训练完成: 学习 %d 条彝文知识\n", total)
    return 1
end

main()