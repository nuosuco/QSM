# ================================================================
# components/qsm/qsm_main.qentl — QSM主模型 (量子叠加态)
# 构建于QNS之上，QNS是基础框架
# ================================================================
qreg q[4]

# QSM主模型初始化 (叠加态)
h q[0]
h q[1]
h q[2]
h q[3]

# 纠缠
cx q[0], q[1]
cx q[2], q[3]

# 测量
var r0 = measure q[0]
var r1 = measure q[1]
var r2 = measure q[2]
var r3 = measure q[3]

printf("QSM主模型: %d %d %d %d\n", r0, r1, r2, r3)
printf("QSM主模型验证: 通过\n")
# QNS生成的提升
var qns_state = 1
if (qns_state == 1):
    printf("QSM主模型已由QNS生成/提升\n")
end
