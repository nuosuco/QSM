# ================================================================
# components/qsm/qsm_reflect.qentl — ReF自反省模型
# 构建于QNS之上
# ================================================================
qreg q[3]

h q[0]
h q[1]
h q[2]

cx q[0], q[1]
cx q[1], q[2]

var r0 = measure q[0]
var r1 = measure q[1]
var r2 = measure q[2]

printf("ReF自反省模型: %d %d %d\n", r0, r1, r2)
printf("ReF自反省模型验证: 通过\n")
