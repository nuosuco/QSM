# QEntL全栈QSM — 构建产物与缓存不入库
# 源码(.qentl/.c)入库，产物不入库

# 构建产物
build/
output.qbc
target.qbc
input.qentl

# Python缓存
__pycache__/
*.pyc
*.pyo

# 数据库和日志
*.db
*.log
server/server.log

# 环境变量
.env
config/api_keys.json
qnt/config/api_keys.json
/root/.qnt_env
.qnt_env
*.env
!*.env.example

# 服务端数据
server/data/
server/llm_providers.json
miniprogram/private.key
web/uploads/

# 备份文件
*.bak*

# 临时
/tmp/*
# 密钥（绝不允许进仓库）
server/.llm_keys
server/llm_providers.json
*.key
*.env
# 运行时数据库与日志
data/trading_system/*.db
data/trading_system/*.db-shm
data/trading_system/*.db-wal
qnt/*.db
qnt/*.log*
qnt/data/
qnt/data/**
data/trading_system/
data/trading_system/**
# 运行时报告（太大不进仓库，只进备份）
qnt/evolution_reports/
qnt/evolution_reports/**
