end

# ---- 运行用户代码（QCL全量编译+沙箱执行） ----
def run_code(code):
    var n = str_len(code)
    if (n == 0):
        return "代码为空"
    end
    if (n > 16000):
        return "代码太长（上限16KB）"
    end
    var w = file_write_bytes("/root/QSM/input.qentl", code)
    if (w < 0):
        return "写入失败"
    end
    var comp = exec("cd /root/QSM && timeout 20 bin/qcl_bootstrap run build/qcl.qbc 2>&1")
    var res = ""
    if (str_index_of(comp, "错误") >= 0):
        res = str_concat(res, "[编译错误]\n")
        res = str_concat(res, comp)
    else:
        var run_out = exec("cd /root/QSM && timeout 15 bin/qcl_bootstrap run --sandbox output.qbc 2>&1")
        res = str_concat(res, "[运行输出]\n")
        res = str_concat(res, run_out)
    end
    return res
end

# ---- 路由 ----
def route(path, req):
    if (str_eq(path, "/ide")):
        return http_response("200 OK", "text/html; charset=utf-8", ide_page())
    end
    if (str_eq(path, "/api/run")):
        var body = http_body(req)
        var code = ""
        var idx = str_index_of(body, "code=")
        if (idx >= 0):
            code = url_decode(str_substring(body, idx + 5, str_len(body) - idx - 5))
        end
        var out = run_code(code)
        return http_response("200 OK", "text/plain; charset=utf-8", out)
    end
    if (str_eq(path, "/")):
