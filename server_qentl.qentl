# QEntL HTTP服务器 v6 — 多模态统一生成
# 架构: QEntL只做HTTP解析+路由,字符串/JSON/HTML全部交给qscl_engine.sh生成
#   (str_concat循环32960次会OOM,QEntL只做轻薄请求壳)
# 路由: /api/generate GET ?k=N | /api/recognize POST 64像素 | /api/image POST 文件路径
#        /api/yi /api/xiaoqu /api/status / /ide
# 在QVM常驻,启动用qvm_boot.qentl,qcl_bootstrap只点火
var g_port = 9802

def find_next(s, start, ch):
    var i = start
    var L = str_len(s)
    while (i < L):
        if (str_char_at(s, i) == ch): return i end
        i = i + 1
    end
    return -1
end

def parse_url(data):
    var s1 = str_index_of(data, " ")
    if (s1 < 0): return "/" end
    var s2 = find_next(data, s1 + 1, " ")
    if (s2 <= s1): return "/" end
    var raw = str_substring(data, s1 + 1, s2 - s1 - 1)
    var q = str_index_of(raw, "?")
    if (q >= 0): raw = str_substring(raw, 0, q) end
    return raw
end

def parse_body(req):
    var idx = str_index_of(req, "\r\n\r\n")
    if (idx < 0): return "" end
    return str_substring(req, idx + 4, str_len(req) - idx - 4)
end

def parse_method(req):
    var m = ""
    if (str_index_of(req, "GET ") >= 0): m = "GET" end
    if (str_index_of(req, "POST ") >= 0): m = "POST" end
    return m
end

def query_k(req):
    var qi = str_index_of(req, "?k=")
    if (qi < 0): return "0" end
    var start = qi + 3
    var L = str_len(req)
    var e = start
    while (e < L):
        var ch = str_char_at(req, e)
        if (str_eq(ch, "&") or str_eq(ch, " ") or str_eq(ch, "\r")): break end
        e = e + 1
    end
    return str_substring(req, start, e - start)
end

def http_response(code, ct, body):
    var l = str_len(body)
    var r = "HTTP/1.1 "
    r = str_concat(r, code)
    r = str_concat(r, "\r\nContent-Type: ")
    r = str_concat(r, ct)
    r = str_concat(r, "\r\nContent-Length: ")
    r = str_concat(r, int_to_str(l))
    r = str_concat(r, "\r\n\r\n")
    r = str_concat(r, body)
    return r
end

def call_engine(op):
    var cmd = "/root/QSM/QLife/build/qscl_engine.sh"
    cmd = str_concat(cmd, " ")
    cmd = str_concat(cmd, op)
    return exec(cmd)
end

def call_gen(k):
    var cmd = "/root/QSM/QLife/build/qscl_engine.sh"
    cmd = str_concat(cmd, " gen ")
    cmd = str_concat(cmd, k)
    return exec(cmd)
end

def call_argmax(pxs):
    var cmd = "/root/QSM/QLife/build/qscl_engine.sh"
    cmd = str_concat(cmd, " argmax ")
    cmd = str_concat(cmd, pxs)
    return exec(cmd)
end

def call_img(path):
    var cmd = "/root/QSM/QLife/build/qscl_engine.sh"
    cmd = str_concat(cmd, " img ")
    cmd = str_concat(cmd, path)
    return exec(cmd)
end

def call_page(slug):
    var cmd = "/root/QSM/QLife/build/qscl_engine.sh"
    cmd = str_concat(cmd, " json_page ")
    cmd = str_concat(cmd, slug)
    return exec(cmd)
end

def call_xiaoqu(body):
    var cmd = "/root/QSM/QLife/build/qscl_engine.sh"
    cmd = str_concat(cmd, " json_page xiaoqu ")
    cmd = str_concat(cmd, body)
    return exec(cmd)
end

def route(data):
    var path = parse_url(data)
    var body = parse_body(data)
    var out = ""
    var ct = "text/plain; charset=utf-8"
    if (str_eq(path, "/")):
        out = call_page("index")
        ct = "text/html; charset=utf-8"
    end
    if (str_eq(path, "/ide")):
        out = call_page("ide")
        ct = "text/html; charset=utf-8"
    end
    if (str_eq(path, "/api/status")):
        out = call_page("status")
        ct = "application/json; charset=utf-8"
    end
    if (str_eq(path, "/api/generate")):
        var k = query_k(data)
        out = call_gen(k)
        ct = "application/json; charset=utf-8"
    end
    if (str_eq(path, "/api/recognize")):
        out = call_argmax(body)
        ct = "application/json; charset=utf-8"
    end
    if (str_eq(path, "/api/image")):
        out = call_img(body)
        ct = "application/json; charset=utf-8"
    end
    if (str_eq(path, "/api/yi")):
        out = call_argmax(body)
    end
    if (str_eq(path, "/api/xiaoqu")):
        out = call_xiaoqu(body)
    end
    if (str_len(out) == 0):
        out = "404"
    end
    return http_response("200 OK", ct, out)
end

def main():
    printf("[QSM] v6多模态统一生成 启动于端口 %d\n", g_port)
    printf("[QSM] 生成=识别对称反向 | W=515x64 | 4态真并行\n")
    var srv = tcp_listen(g_port)
    if (srv < 0):
        printf("[QSM] 端口监听失败\n")
        return 1
    end
    while (1 == 1):
        var cli = tcp_accept(srv)
        if (cli >= 0):
            var data = tcp_recv(cli, 65535)
            if (str_len(data) > 0):
                var resp = route(data)
                if (str_len(resp) > 0):
                    tcp_send(cli, resp)
                end
            end
            tcp_close(cli)
        end
    end
    return 0
end

main()
