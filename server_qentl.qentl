# ================================================================
# QEntL HTTP服务器 v4 — 真实QSCL权重推理
# 加载8个权重文件(4态E+4态W), 彝文识别用4态投票
# ================================================================

var g_port = 9802

# ---- 权重存储: 4态×(E[128]+W[128]) ----
var g_E1[128]
var g_W1[128]
var g_E2[128]
var g_W2[128]
var g_E3[128]
var g_W3[128]
var g_E4[128]
var g_W4[128]

# ---- 定义N/D/K常量(与训练一致) ----
var g_N = 16
var g_D = 8
var g_K = 16

# ---- 解析一行 "E1:5:68" 返回索引和值 ----
def parse_line(line, prefix):
    var pl = str_len(prefix)
    if (str_len(line) <= pl + 2): return -1 end
    # 检查前缀(精确匹配, 前缀后必须是':')
    var i = 0
    while (i < pl):
        if (str_char_at(line, i) != str_char_at(prefix, i)): return -1 end
        i = i + 1
    end
    # 检查前缀后紧跟':'
    if (str_eq(str_substring(line, pl, 1), ":") == 0): return -1 end
    # 找到第一个:
    var c1 = str_index_of(line, ":")
    if (c1 < 0): return -1 end
    # 找到第二个:
    var c2 = str_index_of(str_substring(line, c1 + 1, 60000), ":")
    if (c2 < 0): return -1 end
    c2 = c1 + 1 + c2
    # 索引 = line[c1+1 .. c2-1]
    var idx_str = str_substring(line, c1 + 1, c2 - c1 - 1)
    var idx = str_to_int(idx_str)
    # 值 = line[c2+1 .. ]
    var val_str = str_substring(line, c2 + 1, str_len(line) - c2 - 1)
    var val = str_to_int(val_str)
    return idx * 1024 + val
end

# ---- 加载权重文件到数组 ----
def load_arr(path, prefix, arr):
    var data = file_read(path)
    if (str_len(data) == 0):
        printf("[QSCL] 加载失败: %s\n", path)
        return 0
    end
    # 逐行解析
    var pos = 0
    var count = 0
    var dl = str_len(data)
    while (pos < dl):
        var nl = str_index_of(str_substring(data, pos, 60000), "\n")
        var line = ""
        if (nl < 0):
            line = str_substring(data, pos, dl - pos)
            pos = dl
        else:
            line = str_substring(data, pos, nl)
            pos = pos + nl + 1
        end
        var r = parse_line(line, prefix)
        if (r >= 0):
            var idx = r / 1024
            var val = r % 1024
            if (idx >= 0 and idx < 128):
                arr[idx] = val
                count = count + 1
            end
        end
    end
    printf("[QSCL] 加载 %s: %d 个权重\n", prefix, count)
    return count
end

# ---- 加载全部权重(从单个合并文件) ----
def load_weights():
    var model = "/root/QSM/QLife/v0.0.3/qdfs/ns/models/qscl_model.w"
    load_arr(model, "E1", g_E1)
    load_arr(model, "W1", g_W1)
    load_arr(model, "E2", g_E2)
    load_arr(model, "W2", g_W2)
    load_arr(model, "E3", g_E3)
    load_arr(model, "W3", g_W3)
    load_arr(model, "E4", g_E4)
    load_arr(model, "W4", g_W4)
    printf("[QSCL] 全部权重加载完成 (来自: qscl_model.w)\n")
end

# ---- 字符串工具: 从指定位置找空格(自写,避免builtin限制) ----
def find_pos(s, start, ch):
    var i = start
    var L = str_len(s)
    while (i < L):
        if (str_char_at(s, i) == ch):
            return i
        end
        i = i + 1
    end
    return -1
end

# ---- HTTP工具 ----
def http_response(code, content_type, body):
    var resp = "HTTP/1.1 "
    resp = str_concat(resp, code)
    resp = str_concat(resp, "\r\nContent-Type: ")
    resp = str_concat(resp, content_type)
    resp = str_concat(resp, "\r\nContent-Length: ")
    resp = str_concat(resp, int_to_str(str_len(body)))
    resp = str_concat(resp, "\r\nConnection: close\r\n\r\n")
    resp = str_concat(resp, body)
    return resp
end

def http_body(req):
    var idx = str_index_of(req, "\r\n\r\n")
    if (idx < 0): return "" end
    return str_substring(req, idx + 4, str_len(req) - idx - 4)
end

# ---- 单态预测: embedding+mat_mul+argmax ----
def state_predict(code, E, W):
    # embedding: 取E[code]行(8维)
    var x[16]
    x = embedding(code, 8, E)
    var logits[32]
    logits = mat_mul(x, W, 8, 16)
    return argmax(logits, 16)
end

# ---- QSCL彝文识别(真推理: 4态投票, 纯权重计算, 无硬编码) ----
def yi_recognize(code_str):
    # 只接受6位十进制码点
    if (str_len(code_str) != 6):
        return "请输入6位十进制码点(993040-993190)"
    end
    var c0 = str_char_at(code_str, 0)
    var c1 = str_char_at(code_str, 1)
    var c2 = str_char_at(code_str, 2)
    var c3 = str_char_at(code_str, 3)
    var c4 = str_char_at(code_str, 4)
    var c5 = str_char_at(code_str, 5)
    # 检查前3位是"993"
    if (str_eq(c0, "9") == 0): return "码点超出模型范围(993040-993190)" end
    if (str_eq(c1, "9") == 0): return "码点超出模型范围(993040-993190)" end
    if (str_eq(c2, "3") == 0): return "码点超出模型范围(993040-993190)" end
    # 计算char_id = (后3位 - 40) / 10
    var d3 = str_to_int(c3)
    var d4 = str_to_int(c4)
    var d5 = str_to_int(c5)
    var char_id = (d3 * 100 + d4 * 10 + d5 - 40) / 10
    if (char_id < 0): return "码点超出模型范围(993040-993190)" end
    if (char_id >= 16): return "码点超出模型范围(993040-993190)" end

    # 4态各自预测(纯权重计算)
    var p1 = state_predict(char_id, g_E1, g_W1)
    var p2 = state_predict(char_id, g_E2, g_W2)
    var p3 = state_predict(char_id, g_E3, g_W3)
    var p4 = state_predict(char_id, g_E4, g_W4)

    # 投票
    var votes[16]
    var i = 0
    while (i < 16):
        votes[i] = 0
        i = i + 1
    end
    votes[p1] = votes[p1] + 1
    votes[p2] = votes[p2] + 1
    votes[p3] = votes[p3] + 1
    votes[p4] = votes[p4] + 1
    var best = 0
    var bv = 0
    i = 0
    while (i < 16):
        if (votes[i] > bv):
            bv = votes[i]
            best = i
        end
        i = i + 1
    end

    var result = "QSCL叠加态识别结果:\n"
    result = str_concat(result, "输入码点: ")
    result = str_concat(result, code_str)
    result = str_concat(result, "\n真实标签: ")
    result = str_concat(result, int_to_str(char_id))
    result = str_concat(result, "\n4态预测: [")
    result = str_concat(result, int_to_str(p1))
    result = str_concat(result, ",")
    result = str_concat(result, int_to_str(p2))
    result = str_concat(result, ",")
    result = str_concat(result, int_to_str(p3))
    result = str_concat(result, ",")
    result = str_concat(result, int_to_str(p4))
    result = str_concat(result, "]\n坍缩结果: ")
    result = str_concat(result, int_to_str(best))
    result = str_concat(result, " (票数")
    result = str_concat(result, int_to_str(bv))
    result = str_concat(result, "/4)")
    result = str_concat(result, "\n\n(权重计算: embedding->mat_mul->argmax, 无硬编码)")
    return result
end

# ---- 路由 ----
def route(path, req):
    # 首页(含/qdesktop别名,适配nginx代理)
    if (str_eq(path, "/")):
        var html = file_read("/root/QSM/QLife/v0.0.3/web/qdesktop.html")
        if (str_len(html) == 0):
            html = "<html><body><h1>QDesktop未找到</h1></body></html>"
        end
        return http_response("200 OK", "text/html; charset=utf-8", html)
    end
    if (str_eq(path, "/qdesktop")):
        var html2 = file_read("/root/QSM/QLife/v0.0.3/web/qdesktop.html")
        if (str_len(html2) == 0):
            html2 = "<html><body><h1>QDesktop未找到</h1></body></html>"
        end
        return http_response("200 OK", "text/html; charset=utf-8", html2)
    end
    if (str_eq(path, "/index.html")):
        var html3 = file_read("/root/QSM/QLife/v0.0.3/web/qdesktop.html")
        if (str_len(html3) == 0):
            html3 = "<html><body><h1>QDesktop未找到</h1></body></html>"
        end
        return http_response("200 OK", "text/html; charset=utf-8", html3)
    end

    # 在线IDE
    if (str_eq(path, "/ide")):
        var ide_html = "<!DOCTYPE html><html><head><meta charset='utf-8'><title>QEntL IDE</title></head><body><h1>QEntL IDE</h1></body></html>"
        return http_response("200 OK", "text/html; charset=utf-8", ide_html)
    end

    # 系统状态
    if (str_eq(path, "/api/status")):
        var body = "{\"server\":\"QEntL/2.0\",\"status\":\"running\",\"qscl\":\"trained\",\"yi_recognition\":\"active\",\"weights\":\"qscl_model.w (single file)\"}"
        return http_response("200 OK", "application/json", body)
    end

    # 彝文识别（真实推理）
    if (str_eq(path, "/api/yi")):
        var body = http_body(req)
        var code_str = body
        if (str_len(body) == 0):
            code_str = "993040"
        else:
            if (str_index_of(body, "{") >= 0):
                # JSON: {"text":"993040"} - 用find_pos逐步解析(避免builtin 2参限制)
                var tq = str_index_of(body, "\"text\":\"")
                if (tq >= 0):
                    var vstart = tq + 8
                    var vend = find_pos(body, vstart, "\"")
                    if (vend > vstart):
                        code_str = str_substring(body, vstart, vend - vstart)
                    end
                end
            end
        end
        var result = yi_recognize(code_str)
        return http_response("200 OK", "text/plain; charset=utf-8", result)
    end

    # 小趣QSM对话
    if (str_eq(path, "/api/xiaoqu")):
        var body = http_body(req)
        var reply = "小趣QSM已就绪，正在运行QEntL量子操作系统"
        if (str_len(body) > 0):
            reply = str_concat(reply, "\n你对我说: ")
            reply = str_concat(reply, body)
        end
        return http_response("200 OK", "text/plain; charset=utf-8", reply)
    end

    # 404
    return http_response("404 Not Found", "text/plain", "404 - QEntL Server")
end

# ---- 主循环 ----
def main():
    load_weights()

    var srv = tcp_listen(g_port)
    if (srv < 0):
        printf("[http] 端口%d监听失败\n", g_port)
        return 1
    end

    printf("[http] QEntL QSCL服务器启动于端口%d\n", g_port)
    printf("[http] 路由: / /ide /api/status /api/yi /api/xiaoqu\n")

    while (1 == 1):
        var cli = tcp_accept(srv)
        if (cli >= 0):
            var data = tcp_recv(cli, 65535)
            if (str_len(data) > 0):
                var sp1 = find_pos(data, 0, " ")
                var sp2 = find_pos(data, sp1 + 1, " ")
                if (sp1 < 0 or sp2 < 0): sp1 = 0 end
                var raw_path = ""
                if (sp2 > sp1):
                    raw_path = str_substring(data, sp1 + 1, sp2 - sp1 - 1)
                end
                var path = raw_path
                var q_idx = str_index_of(raw_path, "?")
                if (q_idx >= 0):
                    path = str_substring(raw_path, 0, q_idx)
                end
                var resp = route(path, data)
                if (str_len(resp) > 0):
                    tcp_send(cli, resp)
                end
            end
            tcp_close(cli)
        end
    end
    return 0
end

main()