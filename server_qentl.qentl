# ================================================================
# QEntL HTTP服务器 — 纯QEntL实现（QEntL全栈Web的心脏）
# 依赖原语: tcp_listen/accept/recv/send/close（C种子系统接口层）
# 用法: QVM执行此程序，nginx反代到本端口，qsm.som.top访问
# ================================================================

# ---- HTTP请求解析 ----
# 从请求行提取方法: "GET /path HTTP/1.1" -> "GET"
def http_method(req):
    var i = 0
    while (i < str_len(req)):
        if (str_eq(str_char_at(req, i), " ")):
            return str_substring(req, 0, i)
        end
        i = i + 1
    end
    return ""
end

# 从请求行提取路径: "GET /path HTTP/1.1" -> "/path"
def http_path(req):
    var i = 0
    var start = -1
    while (i < str_len(req)):
        var ch = str_char_at(req, i)
        if (str_eq(ch, " ") and start < 0):
            start = i + 1
        else:
            if (str_eq(ch, " ") and start >= 0):
                return str_substring(req, start, i - start)
            end
        end
        i = i + 1
    end
    return "/"
end

# ---- 响应构造 ----
def http_response(status, ctype, body):
    var head = str_concat("HTTP/1.1 ", status)
    head = str_concat(head, "\r\nContent-Type: ")
    head = str_concat(head, ctype)
    head = str_concat(head, "\r\nContent-Length: ")
    head = str_concat(head, int_to_str(str_len(body)))
    head = str_concat(head, "\r\nConnection: close\r\nServer: QEntL/1.0\r\n\r\n")
    return str_concat(head, body)
end

# 取POST请求体（\r\n\r\n之后的部分）
def http_body(req):
    var i = str_index_of(req, "\r\n\r\n")
    if (i < 0):
        return ""
    end
    return str_substring(req, i + 4, str_len(req) - i - 4)
end

# 16进制字符转数值
def hex_val(ch):
    var d = ord(ch)
    if (d >= 48 and d <= 57):
        return d - 48
    end
    if (d >= 65 and d <= 70):
        return d - 55
    end
    if (d >= 97 and d <= 102):
        return d - 87
    end
    return 0
end

# URL解码: %XX转义 + '+'转空格
def url_decode(s):
    var out = ""
    var i = 0
    var n = str_len(s)
    while (i < n):
        var ch = str_char_at(s, i)
        if (str_eq(ch, "%") and i + 2 < n):
            var c = hex_val(str_char_at(s, i + 1)) * 16 + hex_val(str_char_at(s, i + 2))
            out = str_concat(out, chr(c))
            i = i + 3
        else:
            if (str_eq(ch, "+")):
                out = str_concat(out, " ")
            else:
                out = str_concat(out, ch)
            end
            i = i + 1
        end
    end
    return out
end

# HTML转义（用户输出嵌入<pre>防XSS）
def html_escape(s):
    var out = ""
    var i = 0
    var n = str_len(s)
    while (i < n):
        var ch = str_char_at(s, i)
        if (str_eq(ch, "&")):
            out = str_concat(out, "&amp;")
        else:
            if (str_eq(ch, "<")):
                out = str_concat(out, "&lt;")
            else:
                if (str_eq(ch, ">")):
                    out = str_concat(out, "&gt;")
                else:
                    out = str_concat(out, ch)
                end
            end
        end
        i = i + 1
    end
    return out
end

# ---- IDE页面 ----
def ide_page():
