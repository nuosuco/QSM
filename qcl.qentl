# ============================================================
# qcl.qentl — QCL 编译器 v2（QEntL自举编译器）
# 读取 input.qentl，输出 output.qbc（QBC1格式）
# 用法: qcl_bootstrap run qcl.qbc [input] [output]
#
# 修复v1两个致命bug：
#   1) 字符串池偏移（分隔符导致+1错位）
#   2) 函数内符号表重置后全局变量不可见（0x8000编码+全局回退）
# 代码布局: JMP main | FUNC区(偏移3) | MAIN区(偏移3+flen) | HALT
# ============================================================

# Token类型
var T_IDENT = 1
var T_NUMBER = 2
var T_STRING = 3
var T_DEF = 4
var T_VAR = 5
var T_IF = 6
var T_ELSE = 7
var T_WHILE = 8
var T_RETURN = 9
var T_END = 10
var T_LAND = 11
var T_LOR = 12
var T_PLUS = 13
var T_MINUS = 14
var T_MUL = 15
var T_DIV = 16
var T_MOD = 17
var T_EQ = 18
var T_NEQ = 19
var T_LT = 20
var T_GT = 21
var T_LE = 22
var T_GE = 23
var T_NOT = 24
var T_ASSIGN = 25
var T_LPAREN = 26
var T_RPAREN = 27
var T_LBRACKET = 28
var T_RBRACKET = 29
var T_COLON = 30
var T_COMMA = 31
var T_EOF = 32
var T_BREAK = 33
var T_QREG = 34

# Opcode（QBC1规格）
var OP_PUSH_INT = 1
var OP_PUSH_STR = 2
var OP_LOAD_VAR = 3
var OP_STORE_VAR = 4
var OP_ADD = 5
var OP_SUB = 6
var OP_MUL = 7
var OP_DIV = 8
var OP_MOD = 9
var OP_EQ = 10
var OP_NEQ = 11
var OP_LT = 12
var OP_GT = 13
var OP_LE = 14
var OP_GE = 15
var OP_JMP = 16
var OP_JMP_FALSE = 17
var OP_CALL = 18
var OP_RET = 19
var OP_HALT = 20
var OP_BUILTIN = 21
var OP_ARRAY_NEW = 22
var OP_ARRAY_GET = 23
var OP_ARRAY_SET = 24
var OP_POP = 25
var OP_NEG = 26
var OP_NOT = 27
var OP_AND = 28
var OP_OR = 29
var OP_FUNC_DEF = 30
var OP_FUNC_END = 31

# ---- 全局状态 ----
var g_input_file = "input.qentl"
var g_output_file = "output.qbc"
var g_src = ""
var g_src_len = 0

var g_tok_type[16384]
var g_tok_start[16384]
var g_tok_len[16384]
var g_tok_count = 0
var g_parse_pos = 0

# 代码缓冲：f=函数区 m=主区（int数组，emit后转字节串）
# 65535 = u16字面量上限，也是QBC1 code_len上限
var g_code[65535]
var g_fc = 0
var g_mc = 0
var g_in_func = 0
var g_main_jmp_fix = 0

# 字符串池
var g_pool = ""
var g_pool_len = 0

# 符号表：局部+全局（slot编码：局部原值，全局带0x8000即32768）
var g_ls[512]
var g_ll[512]
var g_lslot[512]
var g_lc = 0
var g_ln = 0
var g_gs[2048]
var g_gl[2048]
var g_gslot[2048]
var g_gc = 0
var g_gn = 0

var g_errors = 0
var g_abort = 0

# 函数定义参数暂存
var g_p_s[64]
var g_p_l[64]

# 跳转修正表（函数区内部跳转，组装时加基址3）
var g_fx_pos[4096]
var g_fx_val[4096]
var g_fxc = 0
# 主区跳转修正表（组装时加基址3+g_fc）
var g_mx_pos[4096]
var g_mx_val[4096]
var g_mxc = 0
# break支持：未解析break JMP操作数位置栈
var g_bk_pos[1024]
var g_bk_top = 0
var g_loop_depth = 0

# ---- 辅助 ----
def sub_eq(a, as, al, b, bs, bl):
    if (al != bl): return 0 end
    var x = str_substring(a, as, al)
    var y = str_substring(b, bs, bl)
    return str_eq(x, y)
end

def is_space(ch):
    if (str_eq(ch, " ")): return 1 end
    if (str_eq(ch, "\t")): return 1 end
    if (str_eq(ch, "\n")): return 1 end
    if (str_eq(ch, "\r")): return 1 end
    return 0
end

def is_digit(ch):
    if (str_eq(ch, "0")): return 1 end
    if (str_eq(ch, "1")): return 1 end
    if (str_eq(ch, "2")): return 1 end
    if (str_eq(ch, "3")): return 1 end
    if (str_eq(ch, "4")): return 1 end
    if (str_eq(ch, "5")): return 1 end
    if (str_eq(ch, "6")): return 1 end
    if (str_eq(ch, "7")): return 1 end
    if (str_eq(ch, "8")): return 1 end
    if (str_eq(ch, "9")): return 1 end
    return 0
end

def is_ident_char(ch):
    if (is_space(ch)): return 0 end
    if (str_eq(ch, "(")): return 0 end
    if (str_eq(ch, ")")): return 0 end
    if (str_eq(ch, "[")): return 0 end
    if (str_eq(ch, "]")): return 0 end
    if (str_eq(ch, ":")): return 0 end
    if (str_eq(ch, ",")): return 0 end
    if (str_eq(ch, "+")): return 0 end
    if (str_eq(ch, "-")): return 0 end
    if (str_eq(ch, "*")): return 0 end
    if (str_eq(ch, "/")): return 0 end
    if (str_eq(ch, "%")): return 0 end
    if (str_eq(ch, "=")): return 0 end
    if (str_eq(ch, "!")): return 0 end
    if (str_eq(ch, "<")): return 0 end
    if (str_eq(ch, ">")): return 0 end
    if (str_eq(ch, "&")): return 0 end
    if (str_eq(ch, "|")): return 0 end
    if (str_eq(ch, "\"")): return 0 end
    if (str_eq(ch, "#")): return 0 end
    if (str_eq(ch, "'")): return 0 end
    if (str_eq(ch, ";")): return 0 end
    if (str_eq(ch, ".")): return 0 end
    return 1
end

def is_ident_start(ch):
    if (is_digit(ch)): return 0 end
    return is_ident_char(ch)
end

# ---- token访问 ----
def cur_type():
    if (g_parse_pos < g_tok_count):
        return g_tok_type[g_parse_pos]
    end
    return T_EOF
end

def cur_text():
    if (g_parse_pos < g_tok_count):
        return str_substring(g_src, g_tok_start[g_parse_pos], g_tok_len[g_parse_pos])
    end
    return ""
end

def advance():
    if (g_parse_pos < g_tok_count):
        g_parse_pos = g_parse_pos + 1
    end
end

# ---- token访问：窥探下一个token类型（不移动位置）----
def peek_type():
    if (g_parse_pos + 1 < g_tok_count):
        return g_tok_type[g_parse_pos + 1]
    end
    return T_EOF
end

def expect(tt, msg):
    if (g_abort == 1): return end
    if (cur_type() != tt):
        printf("qcl: 语法错误: %s (tok %d)\n", msg, g_parse_pos)
        g_errors = g_errors + 1
        g_abort = 1
    end
    advance()
end

# ---- 词法 ----
def tok_push(tt, ts, tl):
    g_tok_type[g_tok_count] = tt
    g_tok_start[g_tok_count] = ts
    g_tok_len[g_tok_count] = tl
    g_tok_count = g_tok_count + 1
end

def lex_run():
    var pos = 0
    var n = g_src_len
    while (pos < n):
        var ch = str_char_at(g_src, pos)
        var ch_ord = str_to_int(int_to_str(str_char_at(ch, 0)))
        var handled = 0
        # 跳过非ASCII字节（UTF-8多字节字符的高字节）
        if (ch_ord > 127):
            pos = pos + 1
            handled = 1
        end
        if (handled == 0):
            # --- whitespace ---
            if (is_space(ch)):
                pos = pos + 1
                handled = 1
            end
        end
        if (handled == 0):
            # --- comment: # to end of line ---
            if (str_eq(ch, "#")):
                var in_cmt = 1
                while (pos < n and in_cmt == 1):
                    pos = pos + 1
                    if (pos < n):
                        var cc = str_char_at(g_src, pos)
                        if (str_eq(cc, "\n")):
                            in_cmt = 0
                            pos = pos + 1
                        end
                    end
                end
                handled = 1
            end
        end
        if (handled == 0):
            # --- semicolon: 语句分隔符，跳过（支持一行多语句）---
            if (str_eq(ch, ";")):
                pos = pos + 1
                handled = 1
            end
        end
        if (handled == 0):
            # --- string literal "..." ---
            if (str_eq(ch, "\"")):
                var s_start = pos
                pos = pos + 1
                var in_str = 1
                var first_escape = -1
                while (pos < n and in_str == 1):
                    var sc = str_char_at(g_src, pos)
                    if (str_eq(sc, "\\")):
                        # 记录第一个转义位置，用于process_string_lit
                        if (first_escape < 0):
                            first_escape = pos - s_start
                        end
                        pos = pos + 2  # 跳过转义序列（如\r, \n等）
                    else:
                        if (str_eq(sc, "\"")):
                            in_str = 0
                            pos = pos + 1
                        else:
                            pos = pos + 1
                        end
                    end
                end
                # 如果有转义，标记为需要处理的字符串
                if (first_escape >= 0):
                    # 记录原始字符串，让process_string_lit处理
                    tok_push(T_STRING, s_start, pos - s_start)
                else:
                    tok_push(T_STRING, s_start, pos - s_start)
                end
                handled = 1
            end
        end
        if (handled == 0):
            # --- number ---
            if (is_digit(ch)):
                var n_start = pos
                var reading = 1
                while (pos < n and reading == 1):
                    var dc = str_char_at(g_src, pos)
                    if (is_digit(dc)):
                        pos = pos + 1
                    else:
                        reading = 0
                    end
                end
                tok_push(T_NUMBER, n_start, pos - n_start)
                handled = 1
            end
        end
        if (handled == 0):
            # --- identifier / keyword ---
            if (is_ident_start(ch)):
                var i_start = pos
                var reading = 1
                while (pos < n and reading == 1):
                    var ic = str_char_at(g_src, pos)
                    if (is_ident_char(ic)):
                        pos = pos + 1
                    else:
                        reading = 0
                    end
                end
                var word = str_substring(g_src, i_start, pos - i_start)
                var tt = T_IDENT
                if (str_eq(word, "def")):    tt = T_DEF end
                if (str_eq(word, "var")):    tt = T_VAR end
                if (str_eq(word, "if")):     tt = T_IF end
                if (str_eq(word, "else")):   tt = T_ELSE end
                if (str_eq(word, "while")):  tt = T_WHILE end
                if (str_eq(word, "return")): tt = T_RETURN end
                if (str_eq(word, "end")):    tt = T_END end
                if (str_eq(word, "and")):    tt = T_LAND end
                if (str_eq(word, "or")):     tt = T_LOR end
                if (str_eq(word, "break")):  tt = T_BREAK end
                if (str_eq(word, "qreg")):   tt = T_QREG end
                tok_push(tt, i_start, pos - i_start)
                handled = 1
            end
        end
        if (handled == 0):
            # --- two-char operators: == != <= >= && || ---
            if (str_eq(ch, "=")):
                if (pos + 1 < n):
                    var nx = str_char_at(g_src, pos + 1)
                    if (str_eq(nx, "=")):
                        tok_push(T_EQ, pos, 2)
                        pos = pos + 2
                        handled = 1
                    end
                end
                if (handled == 0):
                    tok_push(T_ASSIGN, pos, 1)
                    pos = pos + 1
                    handled = 1
                end
            end
        end
        if (handled == 0):
            if (str_eq(ch, "!")):
                if (pos + 1 < n):
                    var nx = str_char_at(g_src, pos + 1)
                    if (str_eq(nx, "=")):
                        tok_push(T_NEQ, pos, 2)
                        pos = pos + 2
                        handled = 1
                    end
                end
                if (handled == 0):
                    tok_push(T_NOT, pos, 1)
                    pos = pos + 1
                    handled = 1
                end
            end
        end
        if (handled == 0):
            if (str_eq(ch, "<")):
                if (pos + 1 < n):
                    var nx = str_char_at(g_src, pos + 1)
                    if (str_eq(nx, "=")):
                        tok_push(T_LE, pos, 2)
                        pos = pos + 2
                        handled = 1
                    end
                end
                if (handled == 0):
                    tok_push(T_LT, pos, 1)
                    pos = pos + 1
                    handled = 1
                end
            end
        end
        if (handled == 0):
            if (str_eq(ch, ">")):
                if (pos + 1 < n):
                    var nx = str_char_at(g_src, pos + 1)
                    if (str_eq(nx, "=")):
                        tok_push(T_GE, pos, 2)
                        pos = pos + 2
                        handled = 1
                    end
                end
                if (handled == 0):
                    tok_push(T_GT, pos, 1)
                    pos = pos + 1
                    handled = 1
                end
            end
        end
        if (handled == 0):
            if (str_eq(ch, "+")): tok_push(T_PLUS, pos, 1)
            pos = pos + 1
            handled = 1
            end
        end
        if (handled == 0):
            if (str_eq(ch, "-")): tok_push(T_MINUS, pos, 1)
            pos = pos + 1
            handled = 1
            end
        end
        if (handled == 0):
            if (str_eq(ch, "*")): tok_push(T_MUL, pos, 1)
            pos = pos + 1
            handled = 1
            end
        end
        if (handled == 0):
            if (str_eq(ch, "/")): tok_push(T_DIV, pos, 1)
            pos = pos + 1
            handled = 1
            end
        end
        if (handled == 0):
            if (str_eq(ch, "%")): tok_push(T_MOD, pos, 1)
            pos = pos + 1
            handled = 1
            end
        end
        if (handled == 0):
            if (str_eq(ch, "(")): tok_push(T_LPAREN, pos, 1)
            pos = pos + 1
            handled = 1
            end
        end
        if (handled == 0):
            if (str_eq(ch, ")")): tok_push(T_RPAREN, pos, 1)
            pos = pos + 1
            handled = 1
            end
        end
        if (handled == 0):
            if (str_eq(ch, "[")): tok_push(T_LBRACKET, pos, 1)
            pos = pos + 1
            handled = 1
            end
        end
        if (handled == 0):
            if (str_eq(ch, "]")): tok_push(T_RBRACKET, pos, 1)
            pos = pos + 1
            handled = 1
            end
        end
        if (handled == 0):
            if (str_eq(ch, ":")): tok_push(T_COLON, pos, 1)
            pos = pos + 1
            handled = 1
            end
        end
        if (handled == 0):
            if (str_eq(ch, ",")): tok_push(T_COMMA, pos, 1)
            pos = pos + 1
            handled = 1
            end
        end
        if (handled == 0):
            printf("qcl: 词法错误: 字符 0x%s 位置 %d\n", int_to_str(ch_ord), pos)
            g_errors = g_errors + 1
            pos = pos + 1
        end
    end
    tok_push(T_EOF, n, 0)
end

# ---- 符号表 ----
def sym_reset_local():
    g_lc = 0
    g_ln = 0
end

def sym_resolve(sname, slen):
    var i = g_lc - 1
    while (i >= 0):
        if (sub_eq(g_src, g_ls[i], g_ll[i], g_src, sname, slen)):
            return g_lslot[i]
        end
        i = i - 1
    end
    i = g_gc - 1
    while (i >= 0):
        if (sub_eq(g_src, g_gs[i], g_gl[i], g_src, sname, slen)):
            return g_gslot[i]
        end
        i = i - 1
    end
    return 0 - 1
end

def sym_add_local(s, l):
    var slot = g_ln
    g_ls[g_lc] = s
    g_ll[g_lc] = l
    g_lslot[g_lc] = slot
    g_lc = g_lc + 1
    g_ln = g_ln + 1
    return slot
end

def sym_add_global(s, l):
    var slot = g_gn + 32768
    g_gs[g_gc] = s
    g_gl[g_gc] = l
    g_gslot[g_gc] = slot
    g_gc = g_gc + 1
    g_gn = g_gn + 1
    return slot
end

def sym_add_assign(s, l):
    var r = sym_resolve(s, l)
    if (r >= 0): return r end
    if (g_in_func == 1):
        return sym_add_local(s, l)
    end
    return sym_add_global(s, l)
end

# ---- 字符串池（修复v1偏移bug：先加分隔符再取偏移）----
def pool_add_substr(s, l):
    if (g_pool_len > 0):
        g_pool = str_concat(g_pool, str_from_char(0))
        g_pool_len = g_pool_len + 1
    end
    var off = g_pool_len
    g_pool = str_concat(g_pool, str_substring(g_src, s, l))
    g_pool_len = g_pool_len + l
    return off
end

def pool_add_string(x):
    if (str_len(x) == 0):
        return g_pool_len
    end
    if (g_pool_len > 0):
        g_pool = str_concat(g_pool, str_from_char(0))
        g_pool_len = g_pool_len + 1
    end
    var off = g_pool_len
    g_pool = str_concat(g_pool, x)
    g_pool_len = g_pool_len + str_len(x)
    return off
end

# ---- 代码emit（单缓冲分区：[0..2]主JMP | [3..3+fc)函数区 | [3+fc..)主区）----
# 注意：跳转操作数必须由调用方显式fix_add登记，emit_u16不做自动登记
# （自动登记会把FUNC_DEF/CALL/BUILTIN头部误判为跳转）
def emit_byte(b):
    if (g_in_func == 1):
        g_code[3 + g_fc] = b
        g_fc = g_fc + 1
    else:
        # 主区写入数组后半段，与函数区(3+g_fc)隔离，避免全局var声明被函数体覆盖
        g_code[32768 + g_mc] = b
        g_mc = g_mc + 1
    end
end

def emit_u16(v):
    emit_byte(v % 256)
    emit_byte(v / 256)
end

def code_pos():
    if (g_in_func == 1): return g_fc end
    return g_mc
end

# fix_add: 记录待回填的跳转。函数区→f表(+基址3)，主区→m表(+基址3+g_fc)
def fix_add(idx, val):
    if (g_in_func == 1):
        g_fx_pos[g_fxc] = idx
        g_fx_val[g_fxc] = val
        g_fxc = g_fxc + 1
    else:
        g_mx_pos[g_mxc] = idx
        g_mx_val[g_mxc] = val
        g_mxc = g_mxc + 1
    end
end

def emit_jmp():
    emit_byte(OP_JMP)
    var idx = code_pos()
    emit_u16(0)
    return idx
end

def emit_jmp_false():
    emit_byte(OP_JMP_FALSE)
    var idx = code_pos()
    emit_u16(0)
    return idx
end

# ---- 内置函数名检测 ----
def is_builtin(nm):
    if (str_eq(nm, "printf")): return 1 end
    if (str_eq(nm, "str_len")): return 1 end
    if (str_eq(nm, "str_char_at")): return 1 end
    if (str_eq(nm, "str_substring")): return 1 end
    if (str_eq(nm, "str_concat")): return 1 end
    if (str_eq(nm, "str_eq")): return 1 end
    if (str_eq(nm, "str_index_of")): return 1 end
    if (str_eq(nm, "str_from_char")): return 1 end
    if (str_eq(nm, "str_to_int")): return 1 end
    if (str_eq(nm, "int_to_str")): return 1 end
    if (str_eq(nm, "len")): return 1 end
    if (str_eq(nm, "file_read")): return 1 end
    if (str_eq(nm, "file_write_bytes")): return 1 end
    if (str_eq(nm, "file_exists")): return 1 end
    if (str_eq(nm, "file_delete")): return 1 end
    if (str_eq(nm, "file_list")): return 1 end
    if (str_eq(nm, "mkdir")): return 1 end
    if (str_eq(nm, "rand_int")): return 1 end
    if (str_eq(nm, "exec")): return 1 end
    if (str_eq(nm, "ord")): return 1 end
    if (str_eq(nm, "chr")): return 1 end
    if (str_eq(nm, "tcp_listen")): return 1 end
    if (str_eq(nm, "tcp_accept")): return 1 end
    if (str_eq(nm, "tcp_recv")): return 1 end
    if (str_eq(nm, "tcp_send")): return 1 end
    if (str_eq(nm, "tcp_close")): return 1 end
    if (str_eq(nm, "tcp_shutdown")): return 1 end
    if (str_eq(nm, "qreg_create")): return 1 end
    if (str_eq(nm, "qreg_free")): return 1 end
    if (str_eq(nm, "apply_h")): return 1 end
    if (str_eq(nm, "apply_t")): return 1 end
    if (str_eq(nm, "apply_cx")): return 1 end
    if (str_eq(nm, "apply_ccx")): return 1 end
    if (str_eq(nm, "apply_ccz")): return 1 end
    if (str_eq(nm, "apply_cccz")): return 1 end
    if (str_eq(nm, "apply_ccccz")): return 1 end
    if (str_eq(nm, "apply_phase")): return 1 end
    if (str_eq(nm, "apply_iphase")): return 1 end
    if (str_eq(nm, "apply_cphase")): return 1 end
    if (str_eq(nm, "apply_icphase")): return 1 end
    if (str_eq(nm, "measure")): return 1 end
    return 0
end

# ---- 字符串字面量处理（去引号+转义）----
def process_string_lit(idx):
    var raw_start = g_tok_start[idx] + 1
    var raw_len = g_tok_len[idx] - 2
    var result = ""
    var i = 0
    while (i < raw_len):
        var ch = str_char_at(g_src, raw_start + i)
        if (str_eq(ch, "\\")):
            i = i + 1
            if (i < raw_len):
                var esc = str_char_at(g_src, raw_start + i)
                # 比较单个字符，不是转义序列字符串
                if (str_eq(esc, "n")):
                    result = str_concat(result, "\n")
                else:
                    if (str_eq(esc, "r")):
                        result = str_concat(result, "\r")
                    else:
                        if (str_eq(esc, "t")):
                            result = str_concat(result, "\t")
                        else:
                            if (str_eq(esc, "\\")):
                                result = str_concat(result, "\\")
                            else:
                                if (str_eq(esc, "\"")):
                                    result = str_concat(result, "\"")
                                else:
                                    result = str_concat(result, "\\")
                                    result = str_concat(result, esc)
                                end
                            end
                        end
                    end
                end
            end
        else:
            result = str_concat(result, ch)
        end
        i = i + 1
    end
    return pool_add_string(result)
end

def tok_num(idx):
    var v = 0
    var i = 0
    var l = g_tok_len[idx]
    var s = g_tok_start[idx]
    while (i < l):
        var d = str_char_at(g_src, s + i)
        if (str_eq(d, "0")): v = v * 10 + 0 end
        if (str_eq(d, "1")): v = v * 10 + 1 end
        if (str_eq(d, "2")): v = v * 10 + 2 end
        if (str_eq(d, "3")): v = v * 10 + 3 end
        if (str_eq(d, "4")): v = v * 10 + 4 end
        if (str_eq(d, "5")): v = v * 10 + 5 end
        if (str_eq(d, "6")): v = v * 10 + 6 end
        if (str_eq(d, "7")): v = v * 10 + 7 end
        if (str_eq(d, "8")): v = v * 10 + 8 end
        if (str_eq(d, "9")): v = v * 10 + 9 end
        i = i + 1
    end
    return v
end

# ---- 表达式解析（优先级爬升）----
def parse_expr():
    # 检查EOF，避免在语句结束后继续解析
    if (cur_type() == T_EOF):
        return
    end
    parse_or()
end

def parse_or():
    if (cur_type() == T_EOF):
        return
    end
    parse_and()
    while (cur_type() == T_LOR):
        advance()
        parse_and()
        emit_byte(OP_OR)
    end
end

def parse_and():
    parse_eqx()
    while (cur_type() == T_LAND):
        advance()
        parse_eqx()
        emit_byte(OP_AND)
    end
end

def parse_eqx():
    parse_cmp()
    var done = 0
    while (done == 0):
        if (cur_type() == T_EQ):
            advance()
            parse_cmp()
            emit_byte(OP_EQ)
        else:
            if (cur_type() == T_NEQ):
                advance()
                parse_cmp()
                emit_byte(OP_NEQ)
            else:
                done = 1
            end
        end
    end
end

def parse_cmp():
    parse_addx()
    var done = 0
    while (done == 0):
        if (cur_type() == T_LT):
            advance()
            parse_addx()
            emit_byte(OP_LT)
        else:
            if (cur_type() == T_GT):
                advance()
                parse_addx()
                emit_byte(OP_GT)
            else:
                if (cur_type() == T_LE):
                    advance()
                    parse_addx()
                    emit_byte(OP_LE)
                else:
                    if (cur_type() == T_GE):
                        advance()
                        parse_addx()
                        emit_byte(OP_GE)
                    else:
                        done = 1
                    end
                end
            end
        end
    end
end

def parse_addx():
    parse_mulx()
    var done = 0
    while (done == 0):
        if (cur_type() == T_PLUS):
            advance()
            parse_mulx()
            emit_byte(OP_ADD)
        else:
            if (cur_type() == T_MINUS):
                advance()
                parse_mulx()
                emit_byte(OP_SUB)
            else:
                done = 1
            end
        end
    end
end

def parse_mulx():
    parse_unary()
    var done = 0
    while (done == 0):
        if (cur_type() == T_MUL):
            advance()
            parse_unary()
            emit_byte(OP_MUL)
        else:
            if (cur_type() == T_DIV):
                advance()
                parse_unary()
                emit_byte(OP_DIV)
            else:
                if (cur_type() == T_MOD):
                    advance()
                    parse_unary()
                    emit_byte(OP_MOD)
                else:
                    done = 1
                end
            end
        end
    end
end

def parse_unary():
    if (cur_type() == T_MINUS):
        advance()
        parse_unary()
        emit_byte(OP_NEG)
    else:
        if (cur_type() == T_NOT):
            advance()
            parse_unary()
            emit_byte(OP_NOT)
        else:
            parse_primary()
        end
    end
end

def parse_primary():
    var t = cur_type()
    if (t == T_NUMBER):
        var v = tok_num(g_parse_pos)
        emit_byte(OP_PUSH_INT)
        emit_u16(v)
        advance()
    else:
        if (t == T_STRING):
            var pid = process_string_lit(g_parse_pos)
            emit_byte(OP_PUSH_STR)
            emit_u16(pid)
            advance()
        else:
            if (t == T_IDENT):
                var ns = g_tok_start[g_parse_pos]
                var nl = g_tok_len[g_parse_pos]
                advance()
                if (cur_type() == T_LPAREN):
                    parse_call(ns, nl)
                else:
                    if (cur_type() == T_LBRACKET):
                        advance()
                        parse_expr()
                        expect(T_RBRACKET, "数组读缺]")
                        var slot = sym_resolve(ns, nl)
                        if (slot < 0):
                            printf("qcl: 错误: 未定义数组变量\n")
                            g_errors = g_errors + 1
                            slot = 0
                        end
                        emit_byte(OP_ARRAY_GET)
                        emit_u16(slot)
                    else:
                        var slot = sym_resolve(ns, nl)
                        if (slot < 0):
                            var varname = str_substring(g_src, ns, nl)
                            printf("qcl: 错误: 未定义变量 %s\n", varname)
                            g_errors = g_errors + 1
                            slot = 0
                        end
                        emit_byte(OP_LOAD_VAR)
                        emit_u16(slot)
                    end
                end
            else:
                if (t == T_LPAREN):
                    advance()
                    parse_expr()
                    expect(T_RPAREN, "缺)")
                else:
                    printf("qcl: 错误: 表达式中意外token %d\n", t)
                    g_errors = g_errors + 1
                    g_abort = 1
                    advance()
                end
            end
        end
    end
end

def parse_call(ns, nl):
    advance()
    var nargs = 0
    if (cur_type() != T_RPAREN):
        parse_expr()
        nargs = 1
        while (cur_type() == T_COMMA):
            advance()
            parse_expr()
            nargs = nargs + 1
        end
    end
    expect(T_RPAREN, "调用缺)")
    var nm = str_substring(g_src, ns, nl)
    var pid = pool_add_substr(ns, nl)
    if (is_builtin(nm)):
        emit_byte(OP_BUILTIN)
        emit_u16(pid)
        emit_byte(nargs)
    else:
        emit_byte(OP_CALL)
        emit_u16(pid)
        emit_byte(nargs)
    end
end

# ---- 语句 ----
def parse_statement():
    var t = cur_type()
    if (t == T_VAR):
        parse_var_decl()
    else:
        if (t == T_QREG):
            parse_qreg_decl()
        else:
            if (t == T_IDENT):
                var ident_ns = g_tok_start[g_parse_pos]
                var ident_nl = g_tok_len[g_parse_pos]
                var ident_nm = str_substring(g_src, ident_ns, ident_nl)
                if ((str_eq(ident_nm, "h") or str_eq(ident_nm, "t") or str_eq(ident_nm, "x") or str_eq(ident_nm, "z")) and peek_type() != T_ASSIGN):
                    parse_quantum_gate_1arg(ident_ns, ident_nl)
                else:
                    if (str_eq(ident_nm, "cx") or str_eq(ident_nm, "cz")):
                        parse_quantum_cx(ident_ns, ident_nl)
                    else:
                        if (str_eq(ident_nm, "ccx") or str_eq(ident_nm, "ccz")):
                            parse_quantum_ccx(ident_ns, ident_nl)
                        else:
                            if (str_eq(ident_nm, "cccz")):
                                parse_quantum_cccz(ident_ns, ident_nl)
                            else:
                                if (str_eq(ident_nm, "ccccz")):
                                    parse_quantum_ccccz(ident_ns, ident_nl)
                                else:
                                    if (str_eq(ident_nm, "phase") or str_eq(ident_nm, "iphase")):
                                parse_quantum_phase(ident_ns, ident_nl)
                            else:
                                if (str_eq(ident_nm, "cphase") or str_eq(ident_nm, "icphase")):
                                    parse_quantum_cphase(ident_ns, ident_nl)
                                else:
                                    if (str_eq(ident_nm, "measure")):
                                        parse_quantum_measure(ident_ns, ident_nl)
                                    else:
                                        parse_ident_stmt()
                                    end
                            end
                        end
                    end
                end
            end
        end
    end
    else:
        if (t == T_IF):
                    parse_if()
                else:
                    if (t == T_WHILE):
                        parse_while()
                    else:
                        if (t == T_BREAK):
                            parse_break()
                        else:
                            if (t == T_RETURN):
                                parse_return()
                            else:
                                parse_expr()
                                emit_byte(OP_POP)
                            end
                        end
                    end
                end
            end
        end
    end
end



# qreg q[N]
def parse_qreg_decl():
    advance()
    var ns = g_tok_start[g_parse_pos]
    var nl = g_tok_len[g_parse_pos]
    advance()
    expect(T_LBRACKET, "qreg缺[")
    var size = 0
    if (cur_type() == T_NUMBER):
        size = str_to_int(str_substring(g_src, g_tok_start[g_parse_pos], g_tok_len[g_parse_pos]))
        advance()
    end
    expect(T_RBRACKET, "qreg缺]")
    emit_byte(OP_PUSH_INT)
    emit_u16(size)
    emit_byte(OP_BUILTIN)
    emit_u16(pool_add_string("qreg_create"))
    emit_byte(1)
    var slot = 0
    if (g_in_func == 1):
        slot = sym_add_local(ns, nl)
    else:
        slot = sym_add_global(ns, nl)
    end
    emit_byte(OP_STORE_VAR)
    emit_u16(slot)
end

# h q[0]
def parse_quantum_gate_1arg(ns, nl):
    var gate_nm = str_substring(g_src, ns, nl)
    advance()
    var reg_ns = g_tok_start[g_parse_pos]
    var reg_nl = g_tok_len[g_parse_pos]
    advance()
    expect(T_LBRACKET, "量子门缺[")
    var idx = 0
    if (cur_type() == T_NUMBER):
        idx = str_to_int(str_substring(g_src, g_tok_start[g_parse_pos], g_tok_len[g_parse_pos]))
        advance()
    end
    expect(T_RBRACKET, "量子门缺]")
    emit_byte(OP_LOAD_VAR)
    emit_u16(sym_resolve(reg_ns, reg_nl))
    emit_byte(OP_PUSH_INT)
    emit_u16(idx)
    emit_byte(OP_BUILTIN)
    var bname = "apply_h"
    if (str_eq(gate_nm, "t")): bname = "apply_t" end
    if (str_eq(gate_nm, "x")): bname = "apply_x" end
    if (str_eq(gate_nm, "z")): bname = "apply_z" end
    emit_u16(pool_add_string(bname))
    emit_byte(2)
    emit_byte(OP_POP)
end

