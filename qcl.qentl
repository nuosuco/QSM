    emit_byte(OP_PUSH_INT)
    emit_u16(t_idx)
    emit_byte(OP_PUSH_INT)
    emit_u16(kval2)
    emit_byte(OP_BUILTIN)
    emit_u16(pool_add_string(bname5))
    emit_byte(4)
    emit_byte(OP_POP)
end

# measure q[0]
def parse_quantum_measure(ns, nl):
    # ns/nl already consumed the gate name, current token is register name
    var reg_ns = g_tok_start[g_parse_pos]
    var reg_nl = g_tok_len[g_parse_pos]
    advance()
    expect(T_LBRACKET, "measure缺[")
    var idx = 0
    if (cur_type() == T_NUMBER):
        idx = str_to_int(str_substring(g_src, g_tok_start[g_parse_pos], g_tok_len[g_parse_pos]))
        advance()
    end
    expect(T_RBRACKET, "measure缺]")
    emit_byte(OP_LOAD_VAR)
    emit_u16(sym_resolve(reg_ns, reg_nl))
    emit_byte(OP_PUSH_INT)
    emit_u16(idx)
    emit_byte(OP_BUILTIN)
    emit_u16(pool_add_string("measure"))
    emit_byte(2)
    emit_byte(OP_POP)
end

def parse_var_decl():
    advance()  # consume 'var'
    var ns = g_tok_start[g_parse_pos]
    var nl = g_tok_len[g_parse_pos]
    advance()  # consume name
    expect(T_ASSIGN, "var缺=")
    # 检查是否是量子门赋值: var m0 = measure q[0]
    var cur_t = cur_type()
    if (cur_t == T_IDENT):
        var gate_ns = g_tok_start[g_parse_pos]
        var gate_nl = g_tok_len[g_parse_pos]
        var gate_nm = str_substring(g_src, gate_ns, gate_nl)
        if (str_eq(gate_nm, "h") or str_eq(gate_nm, "t") or str_eq(gate_nm, "cx") or str_eq(gate_nm, "measure")):
            advance()  # consume gate name
            # 发射量子门代码（不POP，让结果留在栈上供STORE_VAR）
            if (str_eq(gate_nm, "h") or str_eq(gate_nm, "t")):
                # 发射 apply_h/register, index
                emit_byte(OP_LOAD_VAR)
                emit_u16(sym_resolve(gate_ns, gate_nl))
                # 跳过register name token
                advance()
                expect(T_LBRACKET, "量子门缺[")
                var idx = 0
                if (cur_type() == T_NUMBER):
                    idx = str_to_int(str_substring(g_src, g_tok_start[g_parse_pos], g_tok_len[g_parse_pos]))
                    advance()
                end
                expect(T_RBRACKET, "量子门缺]")
                emit_byte(OP_PUSH_INT)
                emit_u16(idx)
                emit_byte(OP_BUILTIN)
                var bname = "apply_h"
                if (str_eq(gate_nm, "t")): bname = "apply_t" end
                emit_u16(pool_add_string(bname))
                emit_byte(2)
                # 不POP，让结果留在栈上
            else:
                if (str_eq(gate_nm, "cx")):
                    # 发射 apply_cx/register, ctrl_idx, tgt_idx
                    advance()  # 跳过cx
                    var ctrl_ns = g_tok_start[g_parse_pos]
                    var ctrl_nl = g_tok_len[g_parse_pos]
                    advance()
                    expect(T_LBRACKET, "cx缺[")
                    var ctrl_idx = 0
                    if (cur_type() == T_NUMBER):
                        ctrl_idx = str_to_int(str_substring(g_src, g_tok_start[g_parse_pos], g_tok_len[g_parse_pos]))
                        advance()
                    end
                    expect(T_RBRACKET, "cx缺]")
                    if (cur_type() == T_COMMA):
                        advance()
                    end
                    var tgt_ns = g_tok_start[g_parse_pos]
                    var tgt_nl = g_tok_len[g_parse_pos]
                    advance()
                    expect(T_LBRACKET, "cx缺[")
                    var tgt_idx = 0
                    if (cur_type() == T_NUMBER):
                        tgt_idx = str_to_int(str_substring(g_src, g_tok_start[g_parse_pos], g_tok_len[g_parse_pos]))
                        advance()
                    end
                    expect(T_RBRACKET, "cx缺]")
                    emit_byte(OP_LOAD_VAR)
                    emit_u16(sym_resolve(ctrl_ns, ctrl_nl))
                    emit_byte(OP_PUSH_INT)
                    emit_u16(ctrl_idx)
                    emit_byte(OP_PUSH_INT)
                    emit_u16(tgt_idx)
                    emit_byte(OP_BUILTIN)
                    emit_u16(pool_add_string("apply_cx"))
                    emit_byte(3)
                    # 不POP
                else:
                    # measure q[0]
                    var reg_ns = g_tok_start[g_parse_pos]
                    var reg_nl = g_tok_len[g_parse_pos]
                    advance()
                    expect(T_LBRACKET, "measure缺[")
                    var idx = 0
                    if (cur_type() == T_NUMBER):
                        idx = str_to_int(str_substring(g_src, g_tok_start[g_parse_pos], g_tok_len[g_parse_pos]))
                        advance()
                    end
                    expect(T_RBRACKET, "measure缺]")
                    emit_byte(OP_LOAD_VAR)
                    emit_u16(sym_resolve(reg_ns, reg_nl))
                    emit_byte(OP_PUSH_INT)
                    emit_u16(idx)
                    emit_byte(OP_BUILTIN)
                    emit_u16(pool_add_string("measure"))
                    emit_byte(2)
                    # 不POP，让结果留在栈上
                end
            end
            var slot = 0
            if (g_in_func == 1):
                slot = sym_add_local(ns, nl)
            else:
                slot = sym_add_global(ns, nl)
            end
            emit_byte(OP_STORE_VAR)
            emit_u16(slot)
            return
        end
    end
    # 普通赋值
    parse_expr()
    var slot = 0
    if (g_in_func == 1):
        slot = sym_add_local(ns, nl)
    else:
        slot = sym_add_global(ns, nl)
    end
    emit_byte(OP_STORE_VAR)
    emit_u16(slot)
end

def parse_if():
    advance()
    expect(T_LPAREN, "if缺(")
    parse_expr()
    expect(T_RPAREN, "if缺)")
    expect(T_COLON, "if缺:")
    var ep = emit_jmp_false()
    parse_block()
    if (cur_type() == T_ELSE):
        advance()
        expect(T_COLON, "else缺:")
        var xp = emit_jmp()
        fix_add(ep, code_pos())
        parse_block()
        fix_add(xp, code_pos())
    else:
        fix_add(ep, code_pos())
    end
    expect(T_END, "if缺end")
end

def parse_while():
    advance()
    expect(T_LPAREN, "while缺(")
    var top = code_pos()
    parse_expr()
    expect(T_RPAREN, "while缺)")
    expect(T_COLON, "while缺:")
    var ep = emit_jmp_false()
    var break_start = g_bk_top
    g_loop_depth = g_loop_depth + 1
    parse_block()
    g_loop_depth = g_loop_depth - 1
    emit_byte(OP_JMP)
    var bidx = code_pos()
    emit_u16(0)
    fix_add(bidx, top)
    fix_add(ep, code_pos())
    # 回填本层所有break到循环出口
    var k = break_start
    while (k < g_bk_top):
        fix_add(g_bk_pos[k], code_pos())
        k = k + 1
    end
    g_bk_top = break_start
    expect(T_END, "while缺end")
end

def parse_break():
    advance()
    if (g_loop_depth <= 0):
        printf("qcl: 错误: break在循环外\n")
        g_errors = g_errors + 1
        return
    end
    emit_byte(OP_JMP)
    var p = code_pos()
    emit_u16(0)
    g_bk_pos[g_bk_top] = p
    g_bk_top = g_bk_top + 1
end

def parse_return():
    advance()
    var t = cur_type()
    if (t == T_END):
        emit_byte(OP_PUSH_INT)
        emit_u16(0)
    else:
        if (t == T_ELSE):
            emit_byte(OP_PUSH_INT)
            emit_u16(0)
        else:
            if (t == T_EOF):
                emit_byte(OP_PUSH_INT)
                emit_u16(0)
            else:
                parse_expr()
            end
        end
    end
    emit_byte(OP_RET)
end

def parse_ident_stmt():
    var ns = g_tok_start[g_parse_pos]
    var nl = g_tok_len[g_parse_pos]
    advance()
    if (cur_type() == T_ASSIGN):
        advance()
        parse_expr()
        var slot = sym_add_assign(ns, nl)
        emit_byte(OP_STORE_VAR)
        emit_u16(slot)
    else:
        if (cur_type() == T_LBRACKET):
            advance()
            parse_expr()
            expect(T_RBRACKET, "数组写缺]")
            if (cur_type() == T_ASSIGN):
                advance()
                parse_expr()
                var slot = sym_resolve(ns, nl)
                if (slot < 0):
                    printf("qcl: 错误: 数组赋值未定义数组\n")
                    g_errors = g_errors + 1
                    slot = 0
                end
                emit_byte(OP_ARRAY_SET)
                emit_u16(slot)
            else:
                var slot = sym_resolve(ns, nl)
                if (slot < 0):
                    printf("qcl: 错误: 未定义数组\n")
                    g_errors = g_errors + 1
                    slot = 0
                end
                emit_byte(OP_ARRAY_GET)
                emit_u16(slot)
                emit_byte(OP_POP)
            end
        else:
            if (cur_type() == T_LPAREN):
                parse_call(ns, nl)
                emit_byte(OP_POP)
            else:
                var slot = sym_add_assign(ns, nl)
                emit_byte(OP_LOAD_VAR)
                emit_u16(slot)
                emit_byte(OP_POP)
            end
        end
    end
end

def parse_block():
    while (cur_type() != T_END and cur_type() != T_ELSE and cur_type() != T_EOF):
        parse_statement()
    end
end

def parse_func_def():
    advance()
    var fs = g_tok_start[g_parse_pos]
    var fl = g_tok_len[g_parse_pos]
    advance()
    expect(T_LPAREN, "def缺(")
    var np = 0
    if (cur_type() != T_RPAREN):
        g_p_s[0] = g_tok_start[g_parse_pos]
        g_p_l[0] = g_tok_len[g_parse_pos]
        np = 1
        advance()
        while (cur_type() == T_COMMA):
            advance()
            g_p_s[np] = g_tok_start[g_parse_pos]
            g_p_l[np] = g_tok_len[g_parse_pos]
            np = np + 1
            advance()
        end
    end
    expect(T_RPAREN, "def缺)")
    expect(T_COLON, "def缺:")
    # 必须在emit FUNC_DEF前设g_in_func=1，否则函数定义头被写入主区
    g_in_func = 1
    var fpid = pool_add_substr(fs, fl)
    emit_byte(OP_FUNC_DEF)
    emit_u16(fpid)
    emit_byte(np)
    var i = 0
    while (i < np):
        emit_u16(pool_add_substr(g_p_s[i], g_p_l[i]))
        i = i + 1
    end
    sym_reset_local()
    i = 0
    while (i < np):
        sym_add_local(g_p_s[i], g_p_l[i])
        i = i + 1
    end
    g_in_func = 1
    parse_block()
    emit_byte(OP_PUSH_INT)
    emit_u16(0)
    emit_byte(OP_RET)
    emit_byte(OP_FUNC_END)
    g_in_func = 0
    expect(T_END, "def缺end")
    # 函数局部作用域不泄漏到主代码
    sym_reset_local()
end

def parse_program():
    # 原版策略：直接遍历，遇到def就解析函数，其他语句顺序处理
    var safety = 0
    while (safety < g_tok_count):
        var t = cur_type()
        if (t == T_EOF):
            break
        end
        if (t == T_DEF):
            parse_func_def()
        else:
            parse_statement()
        end
        safety = safety + 1
    end
    # 添加HALT
    if (g_errors == 0):
        emit_byte(OP_HALT)
    end
end

# ---- 输出：回填两个修正表，组装完整QBC一次性写入 ----
def byte_char(v):
    return str_from_char(v % 256)
end

def build_full_qbc():
    var total = 3 + g_fc + g_mc + 1
    # 函数区跳转回填：索引在g_code[3..]，目标绝对=3+相对
    var i = 0
    while (i < g_fxc):
        var p = 3 + g_fx_pos[i]
        var tgt = 3 + g_fx_val[i]
        g_code[p] = tgt % 256
        g_code[p + 1] = tgt / 256
        i = i + 1
    end
    # 主区跳转回填：索引在g_code[32768..]，目标绝对=3+g_fc+相对
    var mbase = 3 + g_fc
    i = 0
    while (i < g_mxc):
        var p = 32768 + g_mx_pos[i]
        var tgt = mbase + g_mx_val[i]
        g_code[p] = tgt % 256
        g_code[p + 1] = tgt / 256
        i = i + 1
    end
    # 主JMP目标 = 主区起点（绝对）
    g_code[1] = mbase % 256
    g_code[2] = mbase / 256
    g_code[32768 + g_mc] = OP_HALT
    # 组装: QBC1 + code_len + 代码 + pool_len + pool
    var out = str_concat("QBC1", byte_char(total % 256))
    out = str_concat(out, byte_char(total / 256))
    var chunk = ""
    var chunk_n = 0
    i = 0
    while (i < total):
        var byte_val = 0
        if (i < mbase):
            # JMP头 + 函数区（连续存放在g_code[0..3+g_fc)）
            byte_val = g_code[i]
        else:
            # 主区（存放在g_code[32768..]）
            byte_val = g_code[32768 + (i - mbase)]
        end
        chunk = str_concat(chunk, byte_char(byte_val))
        chunk_n = chunk_n + 1
        i = i + 1
        if (chunk_n == 128):
            out = str_concat(out, chunk)
            chunk = ""
            chunk_n = 0
        end
    end
    if (chunk_n > 0):
        out = str_concat(out, chunk)
    end
    out = str_concat(out, byte_char(g_pool_len % 256))
    out = str_concat(out, byte_char(g_pool_len / 256))
    out = str_concat(out, g_pool)
    file_write_bytes(g_output_file, out)
    return str_len(out)
end

# ---- 主 ----
printf("qcl v2: QEntL自举编译器\n")

# 命令行参数通过全局变量预设（C启动器run模式不支持传参给QBC）
g_src = file_read(g_input_file)
g_src_len = str_len(g_src)

if (g_src_len == 0):
    printf("qcl: 错误: 无法读取 %s\n", g_input_file)
else:
    g_fc = 0
    g_mc = 0
    g_in_func = 0
    g_pool = ""
    g_pool_len = 0
    g_lc = 0
    g_ln = 0
    # 注意：不重置g_gc和g_gn，保留全局符号表
    # g_gc = 0
    # g_gn = 0
    g_errors = 0
    g_abort = 0
    g_tok_count = 0
    g_parse_pos = 0
    g_fxc = 0
    g_mxc = 0
    # 主JMP头直接写g_code[0..2]（不走emit_byte，避免落入函数区）
    g_code[0] = OP_JMP
    g_code[1] = 0
    g_code[2] = 0
    printf("qcl: lex运行中...\n")
    lex_run()
    printf("qcl: lex完成，tokens=%d\n", g_tok_count)
    printf("qcl: parse运行中...\n")
    parse_program()
    printf("qcl: parse完成，errors=%d\n", g_errors)
    if (g_errors > 0):
        printf("qcl: %d 个错误，放弃输出\n", g_errors)
    else:
        printf("qcl: 开始构建QBC...\n")
        var written = build_full_qbc()
        printf("qcl: %s -> %s code=%d pool=%d 总=%d字节\n", g_input_file, g_output_file, 3 + g_fc + g_mc + 1, g_pool_len, written)
    end
end
