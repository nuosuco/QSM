            advance()
        end
        expect(T_RBRACKET, "cccz缺]")
        if (i == 0): c2_ns = r_ns; c2_nl = r_nl; c2_idx = r_idx end
        if (i == 1): c3_ns = r_ns; c3_nl = r_nl; c3_idx = r_idx end
        if (i == 2): t_ns = r_ns; t_nl = r_nl; t_idx = r_idx end
        i = i + 1
    end
    emit_byte(OP_LOAD_VAR)
    emit_u16(sym_resolve(c1_ns, c1_nl))
    emit_byte(OP_PUSH_INT)
    emit_u16(c1_idx)
    emit_byte(OP_PUSH_INT)
    emit_u16(c2_idx)
    emit_byte(OP_PUSH_INT)
    emit_u16(c3_idx)
    emit_byte(OP_PUSH_INT)
    emit_u16(t_idx)
    emit_byte(OP_BUILTIN)
    emit_u16(pool_add_string("apply_cccz"))
    emit_byte(5)
    emit_byte(OP_POP)
end

