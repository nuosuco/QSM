# cccz q[a], q[b], q[c], q[d] — 三控制Z门 (4量子位)
def parse_quantum_cccz(ns, nl):
    advance()
    var c1_ns = g_tok_start[g_parse_pos]
    var c1_nl = g_tok_len[g_parse_pos]
    advance()
