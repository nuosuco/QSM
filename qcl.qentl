        advance()
    end
    expect(T_RBRACKET, "cccz缺]")
    var i = 0
    while (i < 3):
        if (cur_type() == T_COMMA): advance() end
        var r_ns = g_tok_start[g_parse_pos]
        var r_nl = g_tok_len[g_parse_pos]
        advance()
        expect(T_LBRACKET, "cccz缺[")
